@using BiztvillCRM.Shared.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Sablon mezők: @Sablon?.Nev
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" 
                       OnClick="UjMezo" Size="Size.Small">
                Új mező
            </MudButton>

            @if (Sablon?.Mezok.Any() == true)
            {
                <MudTable Items="Sablon.Mezok.OrderBy(m => m.Sorrend)" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Sorrend</MudTh>
                        <MudTh>Név</MudTh>
                        <MudTh>Típus</MudTh>
                        <MudTh>Kötelező</MudTh>
                        <MudTh>Műveletek</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Sorrend">@context.Sorrend</MudTd>
                        <MudTd DataLabel="Név">@context.MezoNev</MudTd>
                        <MudTd DataLabel="Típus">@context.MezoTipus</MudTd>
                        <MudTd DataLabel="Kötelező">
                            <MudCheckBox Value="@context.Kotelezo" ReadOnly="true" Color="Color.Primary" />
                        </MudTd>
                        <MudTd DataLabel="Műveletek">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                           OnClick="@(() => OnSzerkesztes.InvokeAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" 
                                           OnClick="@(() => OnTorles.InvokeAsync(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Még nincsenek mezők megadva.</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public UzemeltetoSablon? Sablon { get; set; }

    [Parameter]
    public EventCallback OnUjMezo { get; set; }

    [Parameter]
    public EventCallback<UzemeltetoSablonMezo> OnSzerkesztes { get; set; }

    [Parameter]
    public EventCallback<UzemeltetoSablonMezo> OnTorles { get; set; }

    private void UjMezo() => OnUjMezo.InvokeAsync();

    private void Close() => MudDialog.Close();
}
