@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Shared.Models
@using Microsoft.AspNetCore.Identity
@inject IUzemeltetoSablonFelhasznaloService SablonFelhasznaloService
@inject UserManager<Felhasznalo> UserManager
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info">
                Itt rendelhetsz hozzá üzemeltető felhasználókat ehhez a sablonhoz. 
                Az üzemeltető felhasználók csak az itt meghatározott sablonokhoz tudnak adatot rögzíteni.
            </MudAlert>

            @if (_betoltes)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else
            {
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Új üzemeltető hozzárendelése</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudSelect T="string" @bind-Value="_kivalasztottFelhasznaloId" Label="Válassz felhasználót" 
                                   Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                   Style="flex:1;">
                            @foreach (var user in _elerhetoFelhasznalok)
                            {
                                <MudSelectItem Value="@user.Id">@user.Nev (@user.Email)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                   OnClick="HozzarendelesAsync" 
                                   Disabled="@(string.IsNullOrEmpty(_kivalasztottFelhasznaloId))">
                            Hozzárendelés
                        </MudButton>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Hozzárendelt üzemeltetők</MudText>
                    @if (!_hozzarendeltFelhasznalok.Any())
                    {
                        <MudText Color="Color.Secondary">Még nincs hozzárendelt üzemeltető.</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Striped="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>Név</th>
                                    <th>Email</th>
                                    <th>Beosztás</th>
                                    <th>Hozzárendelte</th>
                                    <th>Létrehozva</th>
                                    <th>Műveletek</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hozzarendeles in _hozzarendeltFelhasznalok)
                                {
                                    <tr>
                                        <td>@hozzarendeles.Felhasznalo.Nev</td>
                                        <td>@hozzarendeles.Felhasznalo.Email</td>
                                        <td>@hozzarendeles.Felhasznalo.Beosztas</td>
                                        <td>@hozzarendeles.HozzarendeloFelhasznalo?.Nev</td>
                                        <td>@hozzarendeles.Letrehozva.ToString("yyyy.MM.dd HH:mm")</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                                           Color="Color.Error" OnClick="@(() => TorlesAsync(hozzarendeles))" 
                                                           Title="Hozzárendelés törlése" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int SablonId { get; set; }
    [Parameter] public string SablonNev { get; set; } = string.Empty;

    private bool _betoltes = true;
    private string? _kivalasztottFelhasznaloId;
    private List<Felhasznalo> _elerhetoFelhasznalok = new();
    private List<UzemeltetoSablonFelhasznalo> _hozzarendeltFelhasznalok = new();

    protected override async Task OnInitializedAsync()
    {
        await BetoltesAsync();
    }

    private async Task BetoltesAsync()
    {
        _betoltes = true;

        try
        {
            // Hozzárendelt üzemeltetők betöltése
            _hozzarendeltFelhasznalok = await SablonFelhasznaloService.GetBySablonIdAsync(SablonId);

            // Összes üzemeltető szerepkörű felhasználó betöltése
            var osszesUzemelteto = await UserManager.GetUsersInRoleAsync(FelhasznaloSzerepkor.Uzemelteto.ToString());

            // Már hozzárendelt felhasználók ID-i
            var hozzarendeltIds = _hozzarendeltFelhasznalok.Select(h => h.FelhasznaloId).ToHashSet();

            // Csak azok, akik még nincsenek hozzárendelve
            _elerhetoFelhasznalok = osszesUzemelteto
                .Where(u => !hozzarendeltIds.Contains(u.Id) && u.Aktiv)
                .OrderBy(u => u.Nev)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a betöltés során: {ex.Message}", Severity.Error);
        }
        finally
        {
            _betoltes = false;
        }
    }

    private async Task HozzarendelesAsync()
    {
        if (string.IsNullOrEmpty(_kivalasztottFelhasznaloId))
            return;

        try
        {
            await SablonFelhasznaloService.HozzarendelAsync(SablonId, _kivalasztottFelhasznaloId);
            Snackbar.Add("Üzemeltető sikeresen hozzárendelve!", Severity.Success);

            _kivalasztottFelhasznaloId = null;
            await BetoltesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba történt: {ex.Message}", Severity.Error);
        }
    }

    private async Task TorlesAsync(UzemeltetoSablonFelhasznalo hozzarendeles)
    {
        try
        {
            await SablonFelhasznaloService.TorlesAsync(hozzarendeles.Id);
            Snackbar.Add("Hozzárendelés törölve!", Severity.Success);
            await BetoltesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba történt: {ex.Message}", Severity.Error);
        }
    }
}
