@using BiztvillCRM.Shared.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(UjMezo ? "Új mező" : "Mező szerkesztése")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (UjMezo)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Mező neve *</MudText>
                <MudPaper Elevation="1" Class="pa-2" Style="max-height: 400px; overflow-y: auto;">
                    @if (ElerhetoMezok != null)
                    {
                        @foreach (var modulCsoport in ElerhetoMezok
                            .Where(m => !FoglaltMezok.Contains(m.Nev) || m.Nev == Mezo.MezoNev)
                            .GroupBy(m => m.Modul)
                            .OrderBy(g => g.Key))
                        {
                            <MudExpansionPanels>
                                <MudExpansionPanel>
                                    <TitleContent>
                                        <div class="d-flex align-center">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 600;">
                                                @GetModulIcon(modulCsoport.Key) @modulCsoport.Key
                                            </MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">
                                                @modulCsoport.Count() db
                                            </MudChip>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        <MudList T="string" Clickable="true" Dense="true">
                                            @foreach (var mezoInfo in modulCsoport.OrderBy(m => m.Nev))
                                            {
                                                <MudListItem T="string" OnClick="@(() => MezoKivalasztas(mezoInfo.Nev))"
                                                             Style="@(Mezo.MezoNev == mezoInfo.Nev ? "background-color: var(--mud-palette-action-default-hover);" : "")">
                                                    <MudText>@mezoInfo.Nev</MudText>
                                                </MudListItem>
                                            }
                                        </MudList>
                                    </ChildContent>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    }
                </MudPaper>

                @if (!string.IsNullOrEmpty(Mezo.MezoNev))
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">
                        Kiválasztva: @Mezo.MezoNev
                    </MudChip>
                }
            }
            else
            {
                <MudTextField @bind-Value="Mezo.MezoNev" Label="Mező neve" Required="true" Disabled="true" />
            }

            <MudNumericField @bind-Value="Mezo.Sorrend" Label="Sorrend" Min="0" />
            <MudCheckBox @bind-Value="Mezo.Kotelezo" Label="Kötelező" Color="Color.Primary" />
            <MudTextField @bind-Value="Mezo.Sugo" Label="Megjegyzés" Lines="2" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Mentés</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public UzemeltetoSablonMezo Mezo { get; set; } = null!;

    [Parameter]
    public bool UjMezo { get; set; }

    [Parameter]
    public List<MezoInfo>? ElerhetoMezok { get; set; }

    [Parameter]
    public HashSet<string> FoglaltMezok { get; set; } = new();

    private void Cancel() => MudDialog.Cancel();

    private void MezoKivalasztas(string mezoNev)
    {
        Mezo.MezoNev = mezoNev;
        StateHasChanged();
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(Mezo.MezoNev))
        {
            return;
        }

        // Mező típusa mindig dátum
        Mezo.MezoTipus = "Datum";

        MudDialog.Close(DialogResult.Ok(Mezo));
    }

    private string GetModulIcon(string modulNev) => modulNev switch
    {
        "Hitelesítések" => "🔒",
        "Mérések" => "📊",
        "Karbantartások" => "🔧",
        "Munkavédelem" => "👷",
        "Tűzvédelem" => "🔥",
        "Környezetvédelem" => "🌱",
        _ => "📋"
    };

    public class MezoInfo
    {
        public string Nev { get; set; } = string.Empty;
        public string Modul { get; set; } = string.Empty;
        public string Tipus { get; set; } = "Text";
    }
}
