                <MudList T="string" Dense="true">
                    <MudListItem T="string">legalább 10 mm vastag, 500 °C feletti olvadáspontú, vagy</MudListItem>
                    <MudListItem T="string">legalább 5 mm vastag, 800 °C feletti olvadáspontú fémlemezből készült</MudListItem>
                </MudList>
                és nem alakul ki fölötte robbanóképes légtér.
            </MudListItem>
        </MudList>

