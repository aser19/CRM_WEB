            Fémtartályok tetejének villámvédelmi csoportosítása
        </MudText>

        <MudText Typo="Typo.body2" Class="mb-2"><strong>T2</strong> csoportba kell sorolni:</MudText>
        <MudList T="string" Dense="true">
            <MudListItem T="string">az R1 csoportba tartozó tartályokat,</MudListItem>
            <MudListItem T="string">
