<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/download.js"></script>
    <script>
        // Fallback: ha a download.js nem töltődött be rendesen
        if (!window.downloadFileFromStream) {
            console.warn('downloadFileFromStream fallback activated');
            window.downloadFileFromStream = async function (fileName, contentStreamReference) {
                try {
                    const arrayBuffer = await contentStreamReference.arrayBuffer();

                    const mimeTypes = {
                        '.pdf': 'application/pdf',
                        '.docx': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                        '.xlsx': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    };

                    const ext = fileName.substring(fileName.lastIndexOf('.'));
                    const mimeType = mimeTypes[ext] || 'application/octet-stream';

                    const blob = new Blob([arrayBuffer], { type: mimeType });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                } catch (error) {
                    console.error('Error in downloadFileFromStream fallback:', error);
                    alert('Hiba a fájl letöltése során: ' + error.message);
                }
            };
        }

        if (!window.downloadFileFromBytes) {
            console.warn('downloadFileFromBytes fallback activated');
            window.downloadFileFromBytes = function (fileName, mimeType, byteArray) {
                try {
                    const uint8Array = new Uint8Array(byteArray);
                    const blob = new Blob([uint8Array], { type: mimeType });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                } catch (error) {
                    console.error('Error in downloadFileFromBytes fallback:', error);
                    alert('Hiba a fájl letöltése során: ' + error.message);
                }
            };
        }

        window.downloadFileFromByteArray = function (fileName, mimeType, byteArray) {
            const blob = new Blob([byteArray], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };

        window.submitLoginForm = function (email, password, rememberMe) {
            console.log('submitLoginForm called');
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/account/login';
            function addField(name, value) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                form.appendChild(input);
            }
            addField('email', email);
            addField('password', password);
            addField('rememberMe', rememberMe.toString());
            document.body.appendChild(form);
            form.submit();
        };
    </script>
</body>
</html>

@code {
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;


    private async Task HandleNavigation(Microsoft.AspNetCore.Components.Routing.NavigationContext args)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user == null || !user.Identity?.IsAuthenticated == true)
        {
            var publicPaths = new[] { "bejelentkezes", "lekerdezes" };

            bool isPublic = publicPaths.Any(p =>
                args.Path.Contains(p, StringComparison.OrdinalIgnoreCase));

            if (!isPublic && !Navigation.Uri.Contains("/bejelentkezes"))
            {
                Navigation.NavigateTo("/bejelentkezes", true);
            }
        }
    }
}

