@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Style="white-space: pre-line;">@Uzenet</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Cancel()))" Color="Color.Default">Mégsem</MudButton>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Ok("Nem")))" Color="Color.Info" Variant="Variant.Outlined">Nem</MudButton>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Ok("Igen")))" Color="Color.Primary" Variant="Variant.Filled">Igen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Uzenet { get; set; } = string.Empty;
}
