@using BiztvillCRM.Shared.Models

<MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@Cim</MudText>
<MudSimpleTable Dense="true" Hover="true">
    <thead>
        <tr>
            <th>Ellenőrzött tétel</th>
            <th style="width:110px">Megfelelő</th>
            <th>Megjegyzés</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tetel in Tetelek)
        {
            <tr>
                <td>@tetel.Szoveg</td>
                <td><MudCheckBox T="bool" Value="@tetel.Megfelelt" ValueChanged="@(v => OnMegfeleltValtozott(tetel, v))" Color="Color.Success" Dense="true" /></td>
                <td><MudTextField @bind-Value="tetel.Megjegyzes" Variant="Variant.Text" Dense="true" /></td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter, EditorRequired]
    public string Cim { get; set; } = "";

    [Parameter, EditorRequired]
    public List<RbCheckTetel> Tetelek { get; set; } = new();

    /// <summary>Meghívódik, ha bármely tétel Megfelelt jelölése megváltozik (pl. a felette lévő hibalista frissítéséhez).</summary>
    [Parameter]
    public EventCallback OnValtozas { get; set; }

    private async Task OnMegfeleltValtozott(RbCheckTetel tetel, bool ujErtek)
    {
        tetel.Megfelelt = ujErtek;
        await OnValtozas.InvokeAsync();
    }
}
