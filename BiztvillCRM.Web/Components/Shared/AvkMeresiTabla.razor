@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Services
@inject IAvkVedelemTipusService AvkTipusService
@inject ISnackbar Snackbar

<MudText Typo="Typo.subtitle1" Class="mb-2">
    <MudIcon Icon="@Icons.Material.Filled.ElectricalServices" Class="mr-1" />
    Áramvédő kapcsolók (RCD/RCBO) mérési adatok
</MudText>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
    <strong>Hálózat: @(HalozatTipus ?? "TN")</strong> —
    Megengedett max: IΔn mért ≤ <strong>@AvkHatarertekService.GetHatarertekek(HalozatTipus, null).MaxIDnMa mA</strong> |
    t1× ≤ <strong>@AvkHatarertekService.GetHatarertekek(HalozatTipus, null).MaxT1x_s ms</strong> |
    t5× ≤ <strong>@AvkHatarertekService.GetHatarertekek(HalozatTipus, null).MaxT5x_s ms</strong>
</MudAlert>

@* Drag&drop: MudTable helyett saját HTML tábla, hogy a tr-re is tehessünk drag eseményeket *@
<div style="overflow-x:auto;">
<table class="mud-table mud-table-dense mud-table-hover mud-table-striped mud-table-bordered" style="width:100%">
    <thead>
        <tr>
            <th style="width:40px">#</th>
            <th style="width:36px"></th>
            <th style="width:70px">Jele</th>
            <th style="width:180px">Típus</th>
            <th style="width:110px">Helye</th>
            <th style="width:70px">In [A]</th>
            <th style="width:80px">IΔn névl. [mA]</th>
            <th style="width:120px">IΔn mért [mA]</th>
            <th style="width:70px">Un [V]</th>
            <th style="width:70px">Pólus</th>
            <th style="width:110px">t1× [ms]</th>
            <th style="width:110px">t5× [ms]</th>
            <th style="width:90px">Eredmény</th>
            <th style="width:36px"></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Sorok.Count; i++)
        {
            var idx = i;
            var sor = Sorok[idx];
            var isDragOver = _dragOverIndex == idx;
            var rowStyle = isDragOver
                ? "border-top: 3px solid var(--mud-palette-primary); cursor:default;"
                : "cursor:default;";

            <tr style="@rowStyle"
                draggable="false"
                @ondragover="@(() => OnDragOver(idx))"
                @ondragover:preventDefault="true"
                @ondrop="@(() => OnDrop(idx))"
                @ondrop:preventDefault="true">

                <td class="mud-table-cell">@sor.Sorsz</td>

                @* Drag handle – csak ez a cella draggable *@
                <td class="mud-table-cell"
                    style="cursor:grab; text-align:center; padding:0;"
                    draggable="true"
                    @ondragstart="@(() => OnDragStart(idx))"
                    @ondragend="OnDragEnd">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                             Size="Size.Small" Color="Color.Default" />
                </td>

                <td class="mud-table-cell">
                    <MudTextField @bind-Value="sor.Jele" Variant="Variant.Text" Placeholder="pl. F1" />
                </td>

                <td class="mud-table-cell">
                    <MudAutocomplete T="string"
                                     Value="@sor.TipusNev"
                                     ValueChanged="@((string nev) => AvkTipusTextChanged(sor, nev))"
                                     SearchFunc="@KeresAvkTipusNevek"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     ResetValueOnEmptyText="false"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     SelectValueOnTab="false"
                                     DebounceInterval="300"
                                     Placeholder="Típus keresése..."
                                     OnBlur="@(() => AvkTipusBlur(sor))">
                        <ItemTemplate Context="item">
                            @if (!_tipusok.Any(t => t.Nev.Equals(item, StringComparison.OrdinalIgnoreCase)))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Small" />
                                    <MudText>@item</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">új</MudChip>
                                </MudStack>
                            }
                            else
                            {
                                <MudText>@item</MudText>
                            }
                        </ItemTemplate>
                    </MudAutocomplete>
                </td>

                <td class="mud-table-cell">
                    <MudTextField @bind-Value="sor.Helye" Variant="Variant.Text" Placeholder="pl. Főelosztó" />
                </td>

                <td class="mud-table-cell">
                    <MudText Typo="Typo.body2" Class="text-center">
                        @(string.IsNullOrEmpty(sor.In) ? "–" : sor.In)
                    </MudText>
                </td>

                <td class="mud-table-cell">
                    <MudText Typo="Typo.body2" Class="text-center"
                             Style="color: var(--mud-palette-text-secondary);">
                        @(string.IsNullOrEmpty(sor.IDn) ? "–" : sor.IDn)
                    </MudText>
                </td>

                @* IΔn mért – egyfázis: 1 mező, háromfázis: L1/L2/L3 *@
                <td class="mud-table-cell" style="@(IsIdnTullepve(sor) ? "background:#fff3f3" : "")">
                    @if (sor.IsNegyPolus)
                    {
                        <MudStack Spacing="1">
                            <MudNumericField T="decimal?"
                                             Value="@(decimal.TryParse(sor.IDnMertL1, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var l1) ? l1 : null)"
                                             ValueChanged="@((decimal? val) => { sor.IDnMertL1 = val?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""; AutoEredmeny(sor); })"
                                             Variant="Variant.Text" Placeholder="L1" Immediate="true" Label="L1" Min="0m" />
                            <MudNumericField T="decimal?"
                                             Value="@(decimal.TryParse(sor.IDnMertL2, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var l2) ? l2 : null)"
                                             ValueChanged="@((decimal? val) => { sor.IDnMertL2 = val?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""; AutoEredmeny(sor); })"
                                             Variant="Variant.Text" Placeholder="L2" Immediate="true" Label="L2" Min="0m" />
                            <MudNumericField T="decimal?"
                                             Value="@(decimal.TryParse(sor.IDnMertL3, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var l3) ? l3 : null)"
                                             ValueChanged="@((decimal? val) => { sor.IDnMertL3 = val?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""; AutoEredmeny(sor); })"
                                             Variant="Variant.Text" Placeholder="L3" Immediate="true" Label="L3" Min="0m" />
                        </MudStack>
                    }
                    else
                    {
                        <MudNumericField T="decimal?"
                                         Value="@(decimal.TryParse(sor.IDnMert, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var mv) ? mv : null)"
                                         ValueChanged="@((decimal? val) => { sor.IDnMert = val?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ""; AutoEredmeny(sor); })"
                                         Variant="Variant.Text"
                                         Placeholder="mA"
                                         Immediate="true"
                                         Min="0m" />
                    }
                    @if (IsIdnTullepve(sor))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            max: @AvkHatarertekService.GetHatarertekek(HalozatTipus, sor.TipusKod).MaxIDnMa mA
                        </MudText>
                    }
                </td>

                <td class="mud-table-cell">
                    <MudText Typo="Typo.body2" Class="text-center">
                        @(string.IsNullOrEmpty(sor.Un) ? "–" : sor.Un)
                    </MudText>
                </td>

                <td class="mud-table-cell">
                    <MudText Typo="Typo.body2" Class="text-center">
                        @(string.IsNullOrEmpty(sor.Polusszam) ? "–" : sor.Polusszam)
                    </MudText>
                </td>

                @* t1× *@
                <td class="mud-table-cell" style="@(IsT1Tullepve(sor) ? "background:#fff3f3" : "")">
                    @if (sor.IsNegyPolus)
                    {
                        <MudStack Spacing="1">
                            <MudTextField Value="@sor.T1xL1" ValueChanged="@((string v) => { sor.T1xL1 = CsakEgesz(v); AutoEredmeny(sor); })"
                                          Variant="Variant.Text" Placeholder="L1 ms" Immediate="true" Label="L1" />
                            <MudTextField Value="@sor.T1xL2" ValueChanged="@((string v) => { sor.T1xL2 = CsakEgesz(v); AutoEredmeny(sor); })"
                                          Variant="Variant.Text" Placeholder="L2 ms" Immediate="true" Label="L2" />
                            <MudTextField Value="@sor.T1xL3" ValueChanged="@((string v) => { sor.T1xL3 = CsakEgesz(v); AutoEredmeny(sor); })"
                                          Variant="Variant.Text" Placeholder="L3 ms" Immediate="true" Label="L3" />
                        </MudStack>
                    }
                    else
                    {
                        <MudTextField Value="@sor.T1x" ValueChanged="@((string v) => { sor.T1x = CsakEgesz(v); AutoEredmeny(sor); })"
                                      Variant="Variant.Text" Placeholder="ms" Immediate="true" />
                    }
                    @if (IsT1Tullepve(sor))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            max: @AvkHatarertekService.GetHatarertekek(HalozatTipus, sor.TipusKod).MaxT1x_s ms
                        </MudText>
                    }
                </td>

                @* t5× *@
                <td class="mud-table-cell" style="@(IsT5Tullepve(sor) ? "background:#fff3f3" : "")">
                    @if (sor.IsNegyPolus)
                    {
                        <MudStack Spacing="1">
                            <MudTextField Value="@sor.T5xL1" ValueChanged="@((string v) => { sor.T5xL1 = CsakEgesz(v); AutoEredmeny(sor); })"
                                          Variant="Variant.Text" Placeholder="L1 ms" Immediate="true" Label="L1" />
                            <MudTextField Value="@sor.T5xL2" ValueChanged="@((string v) => { sor.T5xL2 = CsakEgesz(v); AutoEredmeny(sor); })"
                                          Variant="Variant.Text" Placeholder="L2 ms" Immediate="true" Label="L2" />
                            <MudTextField Value="@sor.T5xL3" ValueChanged="@((string v) => { sor.T5xL3 = CsakEgesz(v); AutoEredmeny(sor); })"
                                          Variant="Variant.Text" Placeholder="L3 ms" Immediate="true" Label="L3" />
                        </MudStack>
                    }
                    else
                    {
                        <MudTextField Value="@sor.T5x" ValueChanged="@((string v) => { sor.T5x = CsakEgesz(v); AutoEredmeny(sor); })"
                                      Variant="Variant.Text" Placeholder="ms" Immediate="true" />
                    }
                    @if (IsT5Tullepve(sor))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            max: @AvkHatarertekService.GetHatarertekek(HalozatTipus, sor.TipusKod).MaxT5x_s ms
                        </MudText>
                    }
                </td>

                <td class="mud-table-cell">
                    <MudToggleGroup T="string" @bind-Value="sor.Eredmeny"
                                    Color="Color.Primary" Dense="true" Rounded="true">
                        <MudToggleItem Value="@("MF")" Text="MF" />
                        <MudToggleItem Value="@("NMF")" Text="NMF" />
                    </MudToggleGroup>
                </td>

                <td class="mud-table-cell">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => SorTorlese(sor))" />
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="UjSorHozzaadas"
               Disabled="@(MaxSorok.HasValue && Sorok.Count >= MaxSorok.Value)">
        Új sor
    </MudButton>
    @if (MaxSorok.HasValue)
    {
        <MudText Typo="Typo.caption" Color="@(Sorok.Count >= MaxSorok.Value ? Color.Error : Color.Secondary)">
            @Sorok.Count / @MaxSorok sor
            @if (Sorok.Count >= MaxSorok.Value)
            {
                <span> — limit elérve</span>
            }
        </MudText>
    }
</MudStack>

@* === ÚJ ÁVK TÍPUS DIALOG === *@
<MudDialog @bind-Visible="_ujAvkTipusDialogNyitva"
           Options="@(new DialogOptions { CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
            Új ÁVK típus létrehozása
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_ujAvkTipus is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Ez az ÁVK típus még nem szerepel a rendszerben. Add meg az adatokat!
            </MudAlert>
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_ujAvkTipus.Nev"
                                  Label="Típus megnevezése *"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="_ujAvkTipus.TipusKod"
                               Label="Típuskód *"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("AC")">AC</MudSelectItem>
                        <MudSelectItem Value="@("A")">A</MudSelectItem>
                        <MudSelectItem Value="@("B")">B</MudSelectItem>
                        <MudSelectItem Value="@("F")">F</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_ujAvkTipus.In"
                                     Label="In (névleges áram) *"
                                     Min="0m" Max="1000m"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End"
                                     AdornmentText="A" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_ujAvkTipus.IDn"
                                     Label="IΔn (kioldóáram) *"
                                     Min="0m" Max="10000m"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End"
                                     AdornmentText="mA" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_ujAvkTipus.Un"
                                     Label="Un (feszültség) *"
                                     Min="0m" Max="1000m"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End"
                                     AdornmentText="V" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_ujAvkTipus.Polusszam"
                                     Label="Pólusszám *"
                                     Min="1" Max="4"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_ujAvkTipus.Leiras"
                                  Label="Megjegyzés"
                                  Lines="2"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="UjAvkTipusDialogBezarasa">Mégsem</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UjAvkTipusMentese">
            Létrehozás
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public List<AvkSor> Sorok { get; set; } = new();

    [Parameter]
    public EventCallback<List<AvkSor>> SorokChanged { get; set; }

    [Parameter]
    public string? HalozatTipus { get; set; }

    /// <summary>
    /// Ha meg van adva, maximum ennyi sort lehet hozzáadni.
    /// Az EgyMeresSzerkesztőből a kipipált ÁVK sorok száma adódik át.
    /// </summary>
    [Parameter]
    public int? MaxSorok { get; set; }

    private List<AvkVedelemTipus> _tipusok = new();
    private int _dragSourceIndex = -1;
    private int _dragOverIndex = -1;
    private Dictionary<AvkSor, System.Threading.CancellationTokenSource> _avkTipusTimers = new();

    protected override async Task OnInitializedAsync()
    {
        _tipusok = await AvkTipusService.GetAktivTipusokAsync();
        ResolveAvkTipusIdok();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Ha új sorok érkeznek (pl. OCR import után @key újrarender)
        if (_tipusok.Any())
            ResolveAvkTipusIdok();
    }

    /// <summary>
    /// OCR csak TipusNev-et tölt, AvkTipusId null marad.
    /// Ez párosítja név alapján a meglévő típusokhoz.
    /// </summary>
    private void ResolveAvkTipusIdok()
    {
        foreach (var sor in Sorok.Where(s => s.AvkTipusId == null && !string.IsNullOrWhiteSpace(s.TipusNev)))
        {
            var talalat = _tipusok.FirstOrDefault(t =>
                t.Nev.Equals(sor.TipusNev, StringComparison.OrdinalIgnoreCase));

            if (talalat != null)
            {
                sor.AvkTipusId = talalat.Id;
                sor.TipusKod   = talalat.TipusKod;
                // In, IDn, Un, Polusszam csak ha üres (OCR kitölthette már)
                if (string.IsNullOrEmpty(sor.In))        sor.In        = talalat.In.ToString("0.#");
                if (string.IsNullOrEmpty(sor.IDn))       sor.IDn       = talalat.IDn.ToString("0.#");
                if (string.IsNullOrEmpty(sor.Un))        sor.Un        = talalat.Un.ToString("0.#");
                if (string.IsNullOrEmpty(sor.Polusszam)) sor.Polusszam = talalat.Polusszam.ToString();
            }
        }
    }

    // === DRAG AND DROP ===
    private void OnDragStart(int index)
    {
        _dragSourceIndex = index;
    }

    private void OnDragOver(int index)
    {
        if (_dragOverIndex != index)
        {
            _dragOverIndex = index;
            StateHasChanged();
        }
    }

    private void OnDrop(int targetIndex)
    {
        if (_dragSourceIndex < 0 || _dragSourceIndex == targetIndex)
        {
            OnDragEnd();
            return;
        }
        var sor = Sorok[_dragSourceIndex];
        Sorok.RemoveAt(_dragSourceIndex);
        Sorok.Insert(targetIndex, sor);
        SzamozasAktualizalas();
        OnDragEnd();
    }

    private void OnDragEnd()
    {
        _dragSourceIndex = -1;
        _dragOverIndex = -1;
        StateHasChanged();
    }

    // === INPUT NORMALIZÁLÁS ===

    /// <summary>Vesszőt pontra cserél, betűket és egyéb karaktereket kiszűr (IΔn mért mezőhöz).</summary>
    private static string NormalizalTizedes(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "";

        var normalized = v.Replace(',', '.');

        // Csak számjegyek és legfeljebb egy tizedes pont engedett
        var sb = new System.Text.StringBuilder();
        bool hasDot = false;
        foreach (var c in normalized)
        {
            if (char.IsDigit(c))
                sb.Append(c);
            else if (c == '.' && !hasDot)
            {
                sb.Append(c);
                hasDot = true;
            }
        }
        return sb.ToString();
    }

    /// <summary>Csak egész számot enged (t1×, t5× [ms] mezőkhöz). Tizedes és utána mindent levág.</summary>
    private static string CsakEgesz(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "";
        // pont vagy vessző előtti részt vesszük
        var normalized = v.Replace(',', '.');
        var dotIdx = normalized.IndexOf('.');
        var egeszResz = dotIdx >= 0 ? normalized[..dotIdx] : normalized;
        // csak számjegyeket hagyunk
        return new string(egeszResz.Where(char.IsDigit).ToArray());
    }

    // === HATÁRÉRTÉK ELLENŐRZÉS ===
    private bool IsIdnTullepve(AvkSor sor)
    {
        var hatar = AvkHatarertekService.GetHatarertekek(HalozatTipus, sor.TipusKod);
        var cult  = System.Globalization.CultureInfo.InvariantCulture;
        var style = System.Globalization.NumberStyles.Any;

        // Névleges IDn alapján határérték
        decimal maxIdn = hatar.MaxIDnMa;
        if (decimal.TryParse(sor.IDn, style, cult, out var nevleges) && nevleges > 0)
            maxIdn = nevleges;

        if (sor.IsNegyPolus)
        {
            foreach (var ertek in new[] { sor.IDnMertL1, sor.IDnMertL2, sor.IDnMertL3 })
                if (decimal.TryParse(ertek, style, cult, out var v) && v > maxIdn)
                    return true;
            return false;
        }

        return !string.IsNullOrEmpty(sor.IDnMert) &&
               decimal.TryParse(sor.IDnMert, style, cult, out var mv) &&
               mv > maxIdn;
    }

    private bool IsT1Tullepve(AvkSor sor)
    {
        var hatar = AvkHatarertekService.GetHatarertekek(HalozatTipus, sor.TipusKod);
        return !string.IsNullOrEmpty(sor.T1x) &&
               decimal.TryParse(sor.T1x, System.Globalization.NumberStyles.Any,
                   System.Globalization.CultureInfo.InvariantCulture, out var v) &&
               v > hatar.MaxT1x_s;
    }

    private bool IsT5Tullepve(AvkSor sor)
    {
        var hatar = AvkHatarertekService.GetHatarertekek(HalozatTipus, sor.TipusKod);
        return !string.IsNullOrEmpty(sor.T5x) &&
               decimal.TryParse(sor.T5x, System.Globalization.NumberStyles.Any,
                   System.Globalization.CultureInfo.InvariantCulture, out var v) &&
               v > hatar.MaxT5x_s;
    }

    // === AUTOMATIKUS EREDMÉNY ===
    private void AutoEredmeny(AvkSor sor)
    {
        if (sor.IsNegyPolus)
        {
            var cult  = System.Globalization.CultureInfo.InvariantCulture;
            var style = System.Globalization.NumberStyles.Any;
            var maxIdn = new[] { sor.IDnMertL1, sor.IDnMertL2, sor.IDnMertL3 }
                .Select(s => decimal.TryParse(s, style, cult, out var v) ? v : 0m)
                .DefaultIfEmpty(0m).Max();
            var maxT1x = new[] { sor.T1xL1, sor.T1xL2, sor.T1xL3 }
                .Select(s => decimal.TryParse(s, style, cult, out var v) ? v : 0m)
                .DefaultIfEmpty(0m).Max();
            var maxT5x = new[] { sor.T5xL1, sor.T5xL2, sor.T5xL3 }
                .Select(s => decimal.TryParse(s, style, cult, out var v) ? v : 0m)
                .DefaultIfEmpty(0m).Max();

            sor.Eredmeny = AvkHatarertekService.SzamitEredmenyNevlegesAlapjan(
                HalozatTipus, sor.TipusKod, sor.IDn,
                maxIdn.ToString(cult), maxT1x.ToString(cult), maxT5x.ToString(cult));
        }
        else
        {
            sor.Eredmeny = AvkHatarertekService.SzamitEredmenyNevlegesAlapjan(
                HalozatTipus, sor.TipusKod, sor.IDn,
                sor.IDnMert, sor.T1x, sor.T5x);
        }
        StateHasChanged();
    }

    // === TÍPUS KERESÉS ===
    private Task<IEnumerable<string>> KeresAvkTipusNevek(string szoveg, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(szoveg))
            return Task.FromResult(_tipusok.Select(t => t.Nev));

        var talalatok = _tipusok
            .Where(t => t.Nev.Contains(szoveg, StringComparison.OrdinalIgnoreCase))
            .Select(t => t.Nev)
            .ToList();

        // Ha a keresett érték pontosan NEM található a listában, hozzáadjuk
        if (!string.IsNullOrWhiteSpace(szoveg) && 
            !talalatok.Any(t => t.Equals(szoveg, StringComparison.OrdinalIgnoreCase)))
        {
            // Az aktuális gépelt szöveget is hozzáadjuk, hogy ne tűnjön el
            talalatok.Insert(0, szoveg);
        }

        return Task.FromResult<IEnumerable<string>>(talalatok);
    }

    private async void AvkTipusTextChanged(AvkSor sor, string tipusNev)
    {
        sor.TipusNev = tipusNev;

        if (string.IsNullOrWhiteSpace(tipusNev))
        {
            sor.AvkTipusId = null;
            sor.TipusKod = "";
            sor.In = sor.IDn = sor.Un = sor.Polusszam = "";
            AutoEredmeny(sor);
            return;
        }

        // Keresés létező típusok között
        var talalat = _tipusok.FirstOrDefault(t => 
            t.Nev.Equals(tipusNev, StringComparison.OrdinalIgnoreCase));

        if (talalat != null)
        {
            // Létező típus - kitöltjük az adatokat
            sor.AvkTipusId = talalat.Id;
            sor.TipusKod   = talalat.TipusKod;
            sor.In         = talalat.In.ToString("0.#");
            sor.IDn        = talalat.IDn.ToString("0.#");
            sor.Un         = talalat.Un.ToString("0.#");
            sor.Polusszam  = talalat.Polusszam.ToString();
        }

        AutoEredmeny(sor);

        // NEM indítunk időzítőt - csak az OnBlur-ben ellenőrzünk
    }

    private async void AvkTipusBlur(AvkSor sor)
    {
        // Várunk, hogy a ValueChanged biztosan lefusson
        await Task.Delay(200);

        var tipusNev = sor.TipusNev;

        if (!string.IsNullOrWhiteSpace(tipusNev))
        {
            var letezik = _tipusok.Any(t => 
                t.Nev.Equals(tipusNev, StringComparison.OrdinalIgnoreCase));

            if (!letezik)
            {
                await UjAvkTipusDialogMegnyitasa(tipusNev);
            }
        }
    }

    // === LISTA KEZELÉS ===
    private void UjSorHozzaadas()
    {
        if (MaxSorok.HasValue && Sorok.Count >= MaxSorok.Value)
            return;

        Sorok.Add(new AvkSor { Sorsz = Sorok.Count + 1 });
        SzamozasAktualizalas();
    }

    private void SorTorlese(AvkSor sor)
    {
        Sorok.Remove(sor);
        SzamozasAktualizalas();
    }

    private void SzamozasAktualizalas()
    {
        for (int i = 0; i < Sorok.Count; i++)
            Sorok[i].Sorsz = i + 1;
        StateHasChanged();
    }

    // === ÚJ ÁVK TÍPUS DIALOG ===
    private bool _ujAvkTipusDialogNyitva = false;
    private AvkVedelemTipus? _ujAvkTipus;

    private async Task UjAvkTipusDialogMegnyitasa(string tipusNev)
    {
        _ujAvkTipus = new AvkVedelemTipus
        {
            Nev = tipusNev,
            TipusKod = "AC",
            In = KiolvasNevlegesAramot(tipusNev),
            IDn = KiolvasIDn(tipusNev),
            Un = 230,
            Polusszam = 2,
            Aktiv = true,
            FelulvizsgalasraVar = true,
            Leiras = "Mérés során automatikusan létrehozott típus"
        };
        _ujAvkTipusDialogNyitva = true;
        StateHasChanged();
    }

    private void UjAvkTipusDialogBezarasa()
    {
        _ujAvkTipusDialogNyitva = false;
        _ujAvkTipus = null;
    }

    private async Task UjAvkTipusMentese()
    {
        if (_ujAvkTipus is null || string.IsNullOrWhiteSpace(_ujAvkTipus.Nev))
        {
            Snackbar.Add("A típus megnevezése kötelező!", Severity.Warning);
            return;
        }

        try
        {
            await AvkTipusService.MentesAsync(_ujAvkTipus);
            _tipusok.Add(_ujAvkTipus);
            Snackbar.Add($"'{_ujAvkTipus.Nev}' ÁVK típus létrehozva - felülvizsgálatra vár!", Severity.Success);
            UjAvkTipusDialogBezarasa();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
    }

    private static decimal KiolvasNevlegesAramot(string tipusNev)
    {
        var match = System.Text.RegularExpressions.Regex.Match(tipusNev, @"[AaBbCcDd]?(\d+(?:\.\d+)?)");
        return match.Success && decimal.TryParse(match.Groups[1].Value,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var aram) ? aram : 25m;
    }

    private static decimal KiolvasIDn(string tipusNev)
    {
        var match = System.Text.RegularExpressions.Regex.Match(tipusNev, @"[/\-_](\d+(?:\.\d+)?)\s*(?:mA)?");
        if (match.Success && decimal.TryParse(match.Groups[1].Value,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var idn))
        {
            return idn < 1 ? idn * 1000 : idn;
        }
        return 30m;
    }
}