    private string GetJavasoltKovetkezoFelulvizsgalat()
    {
        if (_vizsgalatDatum == null)
            return "Nem számítható";
        
        var tipus = _tipusok.FirstOrDefault(t => t.Id == _kivalasztottTipusId);
        var honap = tipus?.ErvenyessegHonap ?? 12;
        var kovetkezoDatum = honap > 0
            ? _vizsgalatDatum.Value.AddMonths(honap)
            : _vizsgalatDatum.Value.AddYears(1);
        return kovetkezoDatum.ToString("yyyy.MM.dd");
    }

