@code {
    [Parameter] public int? MeresId { get; set; }

    private MudStepper? _stepper;
    private int _activeStep = 0; // ÚJ: step index követése

    private List<MeresTipus> _tipusok = [];
    private List<Ugyfel> _ugyfelek = [];
    private List<Telephely> _telephelyek = [];
    private List<Telephely> _szurtTelephelyek = [];

    private int _kivalasztottTipusId;
    private string? _kivalasztottTipusNev;
    private int _kivalasztottUgyfelId;
    private int _kivalasztottTelephelyId;
    private DateTime? _vizsgalatDatum = DateTime.Today;
    private bool _feldolgozas;

    private JegyzokonyvAdatok _adatok = new();

    private List<Felulvizsgalo> _osszFelulvizsgalo = [];
    private List<Felulvizsgalo> _jogosultFelulvizsgalok = [];

    private int? _kivalasztottFelulvizsgaloId;
    private int? _kivalasztottSegitoId;

    private int? _matricaSorszamTol;
    private int? _matricaSorszamIg;
    private bool _matricaValidaciosHiba;
    private string _matricaHibaSzoveg = "";
    private int? _matricakSzama;
    private List<Eszkoz> _muszerek = [];
    private string? _cegMatricaElotag;

    private string? _feltoltottFajlNev;
    private bool _ocrFeldolgozas;
    private int _importaltEszkozokSzama;
    
    // ✅ ÚJ: Hiányzó változó
    private JegyzokonyvImportAdatok importAdatok = new();
    
    // ✅ ÚJ: Feszültség, földelés, érintésvédelem

    private bool _legutolsoFelujitasElott = false;

    private string GetFelujitasEv()
    {
        var ertek = _adatok.LegutolsoFelujitas;
        if (string.IsNullOrEmpty(ertek) || ertek == "Ismeretlen") return "Ismeretlen";
        return ertek.TrimStart('<');
    }

    private void OnFelujitasEvValtozas(string ev)
    {
        if (ev == "Ismeretlen")
        {
            _legutolsoFelujitasElott = false;
            _adatok.LegutolsoFelujitas = "Ismeretlen";
        }
        else
        {
            _adatok.LegutolsoFelujitas = _legutolsoFelujitasElott ? $"<{ev}" : ev;
        }
    }

    private void OnFelujitasElottValtozas(bool elott)
    {
        _legutolsoFelujitasElott = elott;
        var ev = GetFelujitasEv();
        if (ev != "Ismeretlen")
            _adatok.LegutolsoFelujitas = elott ? $"<{ev}" : ev;
    }

    protected override async Task OnInitializedAsync()
    {
        _tipusok = await MeresTipusService.GetAllAsync();
        _ugyfelek = await UgyfelService.GetAllAsync();
        _telephelyek = await TelephelyService.GetAllAsync();
        _osszFelulvizsgalo = await FelulvizsgaloService.GetAllAsync();
        _muszerek = await EszkozService.GetAllAsync();

        await BetoltCegAdatokAsync();

        _adatok.Eredmeny = "MEGFELELT";
        _adatok.VegsoMinosites = "MEGFELELT";

        var cegId = TenantService.GetCurrentCegId();
        var ceg = await CegService.GetByIdAsync(cegId);
        _cegMatricaElotag = ceg?.MatricaElotag;

        if (MeresId.HasValue)
            await BetoltMeresbolAsync(MeresId.Value);
    }

    private async Task OnTipusValtozas(int tipusId)
    {
        _kivalasztottTipusId = tipusId;
        var tipus = _tipusok.FirstOrDefault(t => t.Id == tipusId);
        _kivalasztottTipusNev = tipus?.Nev;

        // ✅ JAVÍTÁS: Töröljük a munkaszámot, hogy újragenerálódjon az új prefix-szel
        _adatok.JegyzokonyvSzam = "";
        _adatok.Munkaszam = "";

        // ✅ ÚJ: Ha az ID=5 (Mérési pontok táblázat), automatikusan állítsd "TN"-re
        if (tipusId == 5)
        {
            _adatok.MeresiRendszerTipus = "TN";
            var honap = tipus?.ErvenyessegHonap ?? 12;
            _adatok.KovetkezoFelulvizsgalatDatum = honap > 0
                ? _vizsgalatDatum?.AddMonths(honap)
                : _vizsgalatDatum?.AddYears(1);
        }

        if (tipusId > 0)
            _jogosultFelulvizsgalok = await JuegosultsagService.GetJogosultFelulvizsgalokAsync(tipusId);
        else
            _jogosultFelulvizsgalok = _osszFelulvizsgalo;

        // OnTipusValtozas metódusba, a végére:
    if (tipusId > 0)
    {
        var hozzaRendeltek = await MeresTipusService.GetJogszabalyokByTipusIdAsync(tipusId);
        _adatok.KijeloltJogszabalyok = hozzaRendeltek.Select(x => new KijeloltJogszabaly
        {
            JogszabalyId  = x.JogszabalyId,
            Szam          = x.Jogszabaly?.Szam ?? "",
            Cim           = x.Jogszabaly?.Cim ?? "",
            Kivalasztva   = true,
            IsSzabvany    = x.Jogszabaly?.Tipus == JogszabalyTipus.Szabvany // ÚJ
        }).ToList();
    }
    }

    private void OnUgyfelValtozas(int ugyfelId)
    {
        _kivalasztottUgyfelId = ugyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == ugyfelId).ToList();
        _kivalasztottTelephelyId = _szurtTelephelyek.FirstOrDefault()?.Id ?? 0;

        var ugyfel = _ugyfelek.FirstOrDefault(u => u.Id == ugyfelId);
        if (ugyfel != null)
            _adatok.Megrendelo = ugyfel.Nev;
    }

    private void VisszaEggyetLepes()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
    }
    
    private async Task ValidalasEsTovabblepesAsync()
    {
        if (_kivalasztottTipusId == 0) { Snackbar.Add("Válassz jegyzőkönyv típust!", Severity.Warning); return; }
        if (_kivalasztottUgyfelId == 0) { Snackbar.Add("Válassz ügyfelet!", Severity.Warning); return; }
        if (_kivalasztottTelephelyId == 0) { Snackbar.Add("Válassz telephelyet!", Severity.Warning); return; }
        if (_vizsgalatDatum == null) { Snackbar.Add("Add meg a vizsgálat dátumát!", Severity.Warning); return; }

        if (string.IsNullOrEmpty(_adatok.JegyzokonyvSzam))
        {
            var cegId = TenantService.GetCurrentCegId();
            var munkaszam = await MunkaszamService.GeneralKovetkezoMunkaszamAsync(cegId, _kivalasztottTipusId);
            _adatok.Munkaszam = munkaszam;
            _adatok.JegyzokonyvSzam = munkaszam;
        }

        var telephely = _telephelyek.FirstOrDefault(t => t.Id == _kivalasztottTelephelyId);
        if (telephely != null)
            _adatok.VizsgalatHelye = $"{telephely.Nev} - {telephely.Cim}";

        _activeStep++; // Továbblépés
    }

    private async Task Lepes2ValidalasEsTovabbAsync()
    {
        if (_kivalasztottFelulvizsgaloId == null) 
        { 
            Snackbar.Add("Válassz felelős felülvizsgálót!", Severity.Warning); 
            return; 
        }
        
        if (string.IsNullOrEmpty(_adatok.Eredmeny)) 
        { 
            Snackbar.Add("Add meg a vizsgálat eredményét!", Severity.Warning); 
            return; 
        }

        // Legalább 1 műszer kiválasztása kötelező
        var vanKivalasztottMuszer = _adatok.Muszerek.Any(m => !string.IsNullOrEmpty(m.Tipus));
        if (!vanKivalasztottMuszer)
        {
            Snackbar.Add("Legalább 1 műszer kiválasztása kötelező!", Severity.Warning);
            return;
        }

        await (_stepper?.NextStepAsync() ?? Task.CompletedTask);
    }

    private async Task Lepes3ValidalasEsTovabbAsync()
    {
        if (IsHordozhatoTipus())
        {
            MatricaValidalas();
            if (_matricaValidaciosHiba)
            {
                Snackbar.Add(_matricaHibaSzoveg, Severity.Warning);
                return;
            }
        }

        await (_stepper?.NextStepAsync() ?? Task.CompletedTask);
    }

    private bool IsHordozhatoTipus()
    {
        if (string.IsNullOrEmpty(_kivalasztottTipusNev)) return false;
        return _kivalasztottTipusNev.Contains("Hordozható", StringComparison.OrdinalIgnoreCase) ||
               _kivalasztottTipusNev.Contains("E+G", StringComparison.OrdinalIgnoreCase);
    }

    private void OnEredmenyValtozas(string eredmeny)
    {
        _adatok.Eredmeny = eredmeny;
        _adatok.VegsoMinosites = eredmeny;
    }

    private Task OnFelulvizsgaloValtozasAsync(int? felulvizsgaloId)
    {
        _kivalasztottFelulvizsgaloId = felulvizsgaloId;

        if (felulvizsgaloId.HasValue)
        {
            var felulvizsgalo = _jogosultFelulvizsgalok.FirstOrDefault(f => f.Id == felulvizsgaloId.Value);
            if (felulvizsgalo != null)
            {
                _adatok.FelulvizsgaloNev = felulvizsgalo.Nev;
                _adatok.FelulvizsgaloBizonyitvany = string.Join(", ",
                    felulvizsgalo.Kepzesek.Where(k => !string.IsNullOrEmpty(k.BizonyitvanySzam)).Select(k => k.BizonyitvanySzam));
                _adatok.FelulvizsgaloKepzes = string.Join(", ",
                    felulvizsgalo.Kepzesek.Where(k => k.KepzesTipus != null).Select(k => k.KepzesTipus!.Nev));
            }
        }
        else
        {
            _adatok.FelulvizsgaloNev = "";
            _adatok.FelulvizsgaloBizonyitvany = "";
            _adatok.FelulvizsgaloKepzes = "";
        }
        return Task.CompletedTask;
    }

    private Task OnSegitoValtozasAsync(int? segitoId)
    {
        _kivalasztottSegitoId = segitoId;

        if (segitoId.HasValue)
        {
            var segito = _jogosultFelulvizsgalok.FirstOrDefault(f => f.Id == segitoId.Value);
            if (segito != null)
            {
                _adatok.SegitoFelulvizsgalo = segito.Nev;
                _adatok.SegitoBizonyitvany = string.Join(", ",
                    segito.Kepzesek.Where(k => !string.IsNullOrEmpty(k.BizonyitvanySzam)).Select(k => k.BizonyitvanySzam));
                _adatok.SegitoKepzes = string.Join(", ",
                    segito.Kepzesek.Where(k => k.KepzesTipus != null).Select(k => k.KepzesTipus!.Nev));
            }
        }
        else
        {
            _adatok.SegitoFelulvizsgalo = "";
            _adatok.SegitoBizonyitvany = "";
            _adatok.SegitoKepzes = "";
        }
        return Task.CompletedTask;
    }

    private Task<IEnumerable<string>> EllenorKereses(string value, CancellationToken token)
    {
        var nevek = _osszFelulvizsgalo.Where(f => f.LehetEllenor).Select(f => f.Nev).ToList();
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<string>>(nevek);
        return Task.FromResult<IEnumerable<string>>(nevek.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task LetoltesAsync()
    {
        try
        {
            _feldolgozas = true;
            StateHasChanged();

            var meresId = MeresId ?? 0;
            var tipus = _tipusok.FirstOrDefault(t => t.Id == _kivalasztottTipusId);
            var sablonId = tipus?.SablonId ?? "VBF_KIF_MINTA";

            // ✅ MENTÉS ADATBÁZISBA
            if (meresId > 0)
            {
                await MeresService.MentesJegyzokonyvAdatokkalAsync(meresId, _adatok);
            }

            var wordBytes = await JegyzokonyvWordService.GeneralasAsync(meresId, _adatok, sablonId);
            var fileName = $"{_adatok.JegyzokonyvSzam.Replace("/", "-")}.docx";

            using var streamRef = new DotNetStreamReference(new MemoryStream(wordBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Snackbar.Add("Jegyzőkönyv sikeresen legenerálva és mentve!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba történt: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

    private async Task BetoltCegAdatokAsync()
    {
        try
        {
            var cegId = TenantService.GetCurrentCegId();
            if (cegId > 0)
            {
                var ceg = await CegService.GetByIdAsync(cegId);
                if (ceg != null)
                {
                    _adatok.CegNev = ceg.Nev ?? "";
                    _adatok.CegCim = ceg.Cim ?? "";
                    _adatok.CegWeb = ceg.Weboldal ?? "";
                    _adatok.CegTelefon = ceg.Telefon ?? "";
                }
            }
        }
        catch
        {
            _adatok.CegNev = "";
            _adatok.CegCim = "";
        }
    }

    private async Task BetoltMeresbolAsync(int meresId)
    {
        var meres = await MeresService.GetByIdAsync(meresId);
        if (meres != null)
        {
            _kivalasztottTipusId = meres.MeresTipusId;
            _kivalasztottUgyfelId = meres.UgyfelId;
            _kivalasztottTelephelyId = meres.TelephelyId;
            _vizsgalatDatum = meres.Datum;

            await OnTipusValtozas(_kivalasztottTipusId);
            OnUgyfelValtozas(_kivalasztottUgyfelId);

            // ✅ JEGYZŐKÖNYV ADATOK BETÖLTÉSE
            if (!string.IsNullOrEmpty(meres.JegyzokonyvAdatokJson))
            {
                try
                {
                    var mentettAdatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
                        meres.JegyzokonyvAdatokJson,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );
                    
                    if (mentettAdatok != null)
                    {
                        _adatok = mentettAdatok;
                        
                        // Ha nincs MeresiPontok lista, inicializáljuk
                        _adatok.MeresiPontok ??= new List<MeresiPontSor>();
                        
                        // Felülvizsgálók újra-beállítása (ID alapján)
                        var felelosNev = _adatok.FelulvizsgaloNev;
                        var segitoNev = _adatok.SegitoFelulvizsgalo;
                        
                        _kivalasztottFelulvizsgaloId = _jogosultFelulvizsgalok
                            .FirstOrDefault(f => f.Nev == felelosNev)?.Id;
                        _kivalasztottSegitoId = _jogosultFelulvizsgalok
                            .FirstOrDefault(f => f.Nev == segitoNev)?.Id;

                        // Matricák visszatöltése
                        if (!string.IsNullOrEmpty(_adatok.MatricaSorszamTol))
                        {
