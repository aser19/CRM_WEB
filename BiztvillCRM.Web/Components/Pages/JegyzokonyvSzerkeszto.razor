    private void MatricaValidalas()
    {
        if (!_matricaSorszamTol.HasValue && !_matricaSorszamIg.HasValue)
        {
            _matricaValidaciosHiba = false;
            _matricaHibaSzoveg = "";
            _matricakSzama = null;
            return;
        }

        if (!_matricaSorszamTol.HasValue || !_matricaSorszamIg.HasValue)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = "Mindkét matrica sorszámot meg kell adni!";
            _matricakSzama = null;
            return;
        }

        if (_matricaSorszamTol.Value > _matricaSorszamIg.Value)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = "A 'tól' érték nem lehet nagyobb mint az 'ig' érték!";
            _matricakSzama = null;
            return;
        }

        var matricakSzama = _matricaSorszamIg.Value - _matricaSorszamTol.Value + 1;

        // Javított validáció: ha van matrica de nincs eszköz, vagy több a matrica
        if (_adatok.Eszkozok.Count == 0)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = "Nincs eszköz megadva a matricákhoz!";
            _matricakSzama = matricakSzama;
            return;
        }

        if (matricakSzama > _adatok.Eszkozok.Count)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = $"Több matrica ({matricakSzama} db) van megadva mint eszköz ({_adatok.Eszkozok.Count} db)!";
            _matricakSzama = matricakSzama;
            return;
        }

        _matricaValidaciosHiba = false;
        _matricaHibaSzoveg = "";
        _matricakSzama = matricakSzama;

        _adatok.MatricaSorszamTol = GetTeljesMatricaSzam(_matricaSorszamTol);
        _adatok.MatricaSorszamIg = GetTeljesMatricaSzam(_matricaSorszamIg);
    }

