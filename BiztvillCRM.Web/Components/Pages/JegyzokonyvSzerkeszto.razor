        return _kivalasztottTipusNev.Contains("Mérési pont", StringComparison.OrdinalIgnoreCase)
            || _kivalasztottTipusId == 5;
    }

    private bool IsIdoszakosVBFTipus()
    {
        if (_kivalasztottTipusId == 0) return false;
        if (IsHordozhatoTipus()) return false;
        if (_kivalasztottTipusId == 5) return false;
        if (IsEgyMeresTipus()) return false;
        if (IsMellekletTipus()) return false;
        return true;
    }

