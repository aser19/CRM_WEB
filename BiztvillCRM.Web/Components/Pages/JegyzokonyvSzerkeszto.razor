@page "/jegyzokonyv/{MeresId:int?}"
@page "/jegyzokonyv/uj"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Services
@using BiztvillCRM.Shared.Enums
@inject IMeresService MeresService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject IMeresTipusService MeresTipusService
@inject IJegyzokonyvWordService JegyzokonyvWordService
@inject IJegyzokonyvJogosultsagService JogosultsagService
@inject IFelulvizsgaloService FelulvizsgaloService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ITenantService TenantService
@inject ICegService CegService
@inject IEszkozService EszkozService
@inject IKalibracioService KalibracioService
@inject IMunkaszamService MunkaszamService
@inject IMatricaValidatorService MatricaValidator
@inject IJegyzokonyvOcrService OcrService
@inject IMellekletJegyzokonyvService MellekletService
@inject IJegyzokonyvSablonService JegyzokonyvSablonService
@inject ISablonService SablonService
@inject IVizsgalatiSablonService VizsgalatiSablonService

<PageTitle>Jegyzőkönyv szerkesztő</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
    Jegyzőkönyv szerkesztő
</MudText>

<MudStepper @ref="_stepper" @bind-ActiveIndex="_activeStep" Linear="false" Color="Color.Primary">
    
    @* === 1. LÉPÉS: KIVÁLASZTÁS === *@
    <MudStep Title="Kiválasztás" Icon="@Icons.Material.Filled.ListAlt">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">Jegyzőkönyv típusa és ügyfél</MudText>
            <MudTooltip Text="@(_mutatAlmereseketIs ? "Almérések elrejtése" : "Almérések megjelenítése")">
                <MudChip T="string"
                         Icon="@(_mutatAlmereseketIs ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                         Color="@(_mutatAlmereseketIs ? Color.Warning : Color.Default)"
                         OnClick="@(() => _mutatAlmereseketIs = !_mutatAlmereseketIs)"
                         Variant="Variant.Outlined"
                         Size="Size.Small">
                    Almérések
                </MudChip>
            </MudTooltip>
        </MudStack>
        
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="int" Value="_kivalasztottTipusId" Label="Jegyzőkönyv típusa *"
                           ValueChanged="OnTipusValtozas"
                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                           ToStringFunc="@(id => _osszesTipus.FirstOrDefault(t => t.Id == id)?.Nev ?? "-- Válassz --")">
                    <MudSelectItem Value="0">-- Válassz típust --</MudSelectItem>
                    @foreach (var tipus in SzurtTipusok)
                    {
                        <MudSelectItem Value="@tipus.Id">
                            @tipus.Nev
                            @if (!tipus.FoMeres)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">melléklet</MudChip>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
                @if (_vizsgalatiKategoriak.Count > 0)
                {
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_kivalasztottKategoria"
                                   Label="Vizsgálati sablon"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Clearable="true"
                                   HelperText="Sablon kiválasztásával az értékek automatikusan kitöltődnek">
                            @foreach (var kat in _vizsgalatiKategoriak)
                            {
                                <MudSelectItem Value="@kat">@kat</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_kivalasztottUgyfelId" Label="Ügyfél *"
                               ValueChanged="OnUgyfelValtozas" Variant="Variant.Outlined"
                               ToStringFunc="@(id => _ugyfelek.FirstOrDefault(u => u.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz ügyfelet --</MudSelectItem>
                        @foreach (var ugyfel in _ugyfelek)
                        {
                            <MudSelectItem Value="@ugyfel.Id">@ugyfel.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_kivalasztottTelephelyId" Label="Telephely *"
                               Variant="Variant.Outlined" Disabled="@(_szurtTelephelyek.Count == 0)"
                               ToStringFunc="@(id => _szurtTelephelyek.FirstOrDefault(t => t.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz telephelyet --</MudSelectItem>
                        @foreach (var telephely in _szurtTelephelyek)
                        {
                            <MudSelectItem Value="@telephely.Id">@telephely.Nev - @telephely.Cim</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="_vizsgalatDatum"
                                   DateChanged="OnVizsgalatDatumValtozas"
                                   Label="Vizsgálat dátuma *"
                                   Variant="Variant.Outlined" DateFormat="yyyy.MM.dd" />
                </MudItem>
                
                @* === ÚJ RÉSZ: FÁJL FELTÖLTŐ === *@
                <MudItem xs="12" Class="mt-4">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />
                        Korábbi jegyzőkönyv importálása (opcionális)
                    </MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        PDF vagy kép formátumú jegyzőkönyvet tölthetsz fel az adatok automatikus kitöltéséhez
                    </MudAlert>
                    
                    <MudFileUpload T="IBrowserFile" 
                                   Accept=".pdf,.jpg,.jpeg,.png" 
                                   FilesChanged="KorabbiJegyzokonyvFeltoltesAsync"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="_ocrFeldolgozas">
                                @(_ocrFeldolgozas ? "Feldolgozás..." : "Fájl kiválasztása")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    
                    @if (_ocrFeldolgozas)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-1">
                            OCR feldolgozás folyamatban...
                        </MudText>
                    }
                    
                    @if (!string.IsNullOrEmpty(_feltoltottFajlNev))
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 OnClose="FeltoltottFajlTorles"
                                 Class="mt-2">
                            @_feltoltottFajlNev (@_importaltEszkozokSzama eszköz)
                        </MudChip>
                    }
                </MudItem>
                
                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="ValidalasEsTovabblepesAsync"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Tovább az adatok megadásához
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>
    
    @* === 2. LÉPÉS: ADATOK KITÖLTÉSE === *@
    <MudStep Title="Adatok megadása" Icon="@Icons.Material.Filled.Edit">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Vizsgálat adatai</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.JegyzokonyvSzam" Label="Jegyzőkönyv száma"
                                  Variant="Variant.Outlined"
                                  Placeholder="Automatikusan generálódik a 'Tovább' gombra kattintva" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.CegNev" Label="Vizsgáló cég neve"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.CegCim" Label="Vizsgáló cég címe"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.VizsgalatHelye" Label="Vizsgálat helye"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                @if (!IsHordozhatoTipus() && !IsMeresTipus())
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgalatTargya" Label="Vizsgálat tárgya"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgaltBerendezes" Label="Vizsgált berendezés"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                }
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.Megrendelo" Label="Megrendelő neve"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                @if (!IsHordozhatoTipus() && !IsMeresTipus())
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgalatIdotartama" Label="Vizsgálat időtartama"
                                      Variant="Variant.Outlined" Placeholder="pl. 2 óra" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_adatok.Megjegyzes" Label="Megjegyzések"
                                      Variant="Variant.Outlined" Lines="3"
                                      Placeholder="pl. A vizsgálat különleges körülményei, eltérések, megjegyzések..." />
                    </MudItem>
                }
                
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Vizsgálat eredménye</MudText>
                    <MudToggleGroup T="string" Value="_adatok.Eredmeny"
                                    ValueChanged="OnEredmenyValtozas"
                                    Color="Color.Primary" Rounded="true" CheckMark="true">
                        <MudToggleItem Value="@("MEGFELELT")" Text="Megfelelt" />
                        <MudToggleItem Value="@("NEM FELELT MEG")" Text="Nem felelt meg" />
                    </MudToggleGroup>
                </MudItem>
                
                <MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.UzemiKisero" Label="Üzemi kísérő" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.KapcsolatTarto" Label="Kapcsolattartó" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Felülvizsgálók</MudText>
                    @if (_jogosultFelulvizsgalok.Count == 0 && _kivalasztottTipusId > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">
                            Nincs jogosult felülvizsgáló ehhez a jegyzőkönyv típushoz!
                        </MudAlert>
                    }
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?" Label="Felelős felülvizsgáló *"
                               Value="_kivalasztottFelulvizsgaloId"
                               ValueChanged="OnFelulvizsgaloValtozasAsync"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                        @foreach (var szemely in _jogosultFelulvizsgalok.Where(f => f.LehetFelelosFelulvizsgalo))
                        {
                            <MudSelectItem T="int?" Value="@szemely.Id">
                                @szemely.Nev (@szemely.Jogosultsag)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.FelulvizsgaloBizonyitvany" Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.FelulvizsgaloKepzes" Label="Továbbképzés(ek)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?" Label="Segítő-felülvizsgáló"
                               Value="_kivalasztottSegitoId"
                               ValueChanged="OnSegitoValtozasAsync"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                        @foreach (var szemely in _jogosultFelulvizsgalok)
                        {
                            <MudSelectItem T="int?" Value="@szemely.Id">@szemely.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.SegitoBizonyitvany" Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.SegitoKepzes" Label="Továbbképzés(ek)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string"
                                     Label="Ellenőrizte"
                                     @bind-Value="_adatok.Ellenor"
                                     SearchFunc="EllenorKereses"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Placeholder="Válassz vagy írd be..."
                                     AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                     ResetValueOnEmptyText="false"
                                     Immediate="true"
                                     DebounceInterval="300" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.EllenorBizonyitvany"
                                  Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined"
                                  Placeholder="pl. VF-12345/2024" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        <em>Tartalmi és formai ellenőrzés</em>
                    </MudAlert>
                </MudItem>
                @* === MŰSZEREK SZEKCIÓ === *@
                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-2" Color="Color.Warning" />
                        Használt műszerek
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">kötelező</MudChip>
                    </MudText>
                    @if (!_adatok.Muszerek.Any(m => !string.IsNullOrEmpty(m.Tipus)))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Legalább 1 műszer kiválasztása szükséges a továbblépéshez!
                        </MudAlert>
                    }
                </MudItem>

                @for (int i = 0; i < GetLathatoMuszerekSzama(); i++)
                {
                    var index = i;
                    var aktualisMuszer = index < _adatok.Muszerek.Count ? _adatok.Muszerek[index] : null;
                    var vanKitoltve = !string.IsNullOrEmpty(aktualisMuszer?.Tipus);
    
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?"
                                   Value="@GetMuszerEszkozId(index)"
                                   ValueChanged="@(async (int? id) => await OnMuszerValtozasAsync(index, id))"
                                   Label="@($"Műszer {index + 1}")"
                                   Variant="Variant.Outlined"
                                   Clearable="true">
                            <MudSelectItem T="int?" Value="null">-- Válassz műszert --</MudSelectItem>
                            @foreach (var muszer in _muszerek)
                            {
                                <MudSelectItem T="int?" Value="@muszer.Id">
                                    @muszer.Nev @(string.IsNullOrEmpty(muszer.Tipus) ? "" : $"({muszer.Tipus})")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Value="@(aktualisMuszer?.GyariSzam ?? "")"
                                      Label="Gyári szám"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="@(!vanKitoltve)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @{
                            var kalLejart = IsKalibracioLejart(aktualisMuszer);
                        }
                        <MudTextField Value="@(aktualisMuszer?.Kalibralas ?? "")"
                                      Label="Utolsó kalibráció"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="@(!vanKitoltve)"
                                      Style="@(kalLejart ? "background-color:#fff3e0;" : "")" />
                        @if (kalLejart && vanKitoltve)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Style="display:flex; align-items:center; gap:4px; margin-top:2px;">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                                A kalibráció 2 évnél régebbi!
                            </MudText>
                        }
                    </MudItem>
                }
                @* === HORDOZHATÓ TÍPUSNÁL: navigáció a külön szerkesztőhöz === *@
                @if (IsHordozhatoTipus())
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                        <MudAlert Severity="Severity.Info" Dense="true">
                            A hordozható eszközök adatait (jármuadatok, eszközlista, matricák) a külön szerkesztőben töltheted ki.
                        </MudAlert>
                    </MudItem>
                }
                <MudItem xs="12" Class="mt-4">
                    @if (GetAktualisTipusKod() == "AVK")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2AvkTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább az AVK adatok kitöltéséhez
                        </MudButton>
                    }
                    else if (IsHordozhatoTipus())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2HordozhatoTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább a hordozható eszközök vizsgálatához
                        </MudButton>
                    }
                    else if (IsIdoszakosVBFTipus())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2IdoszakosVbfTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább az időszakos VBF szerkesztőhöz
                        </MudButton>
                    }
                    else if (IsEgyMeresTipus())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2EgyMeresTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább a mérés kitöltéséhez
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2ValidalasEsTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább a 3. oldal kitöltéséhez
                        </MudButton>
                    }
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    @if (GetAktualisTipusKod() == "AVK")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2AvkTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább az AVK adatok kitöltéséhez
                        </MudButton>
                    }
                    else if (IsHordozhatoTipus())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2HordozhatoTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább a hordozható eszközök vizsgálatához
                        </MudButton>
                    }
                    else if (IsIdoszakosVBFTipus())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2IdoszakosVbfTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább az időszakos VBF szerkesztőhöz
                        </MudButton>
                    }
                    else if (IsEgyMeresTipus())
                    {
                        @* Egymérés: nincs 3. oldal, csak a mérés kitöltése – a fenti gomb elegendő *@
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes2ValidalasEsTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább a 3. oldal kitöltéséhez
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>

    @* === 8. LÉPÉS: ÖSSZEGEZÉS === *@
    <MudStep Title="Összegzés" Icon="@Icons.Material.Filled.Summarize">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Summarize" Class="mr-2" />
                Jegyzőkönyv összegzése
            </MudText>

            <MudGrid>
                <MudItem xs="12">
                    <MudSimpleTable Dense="true" Bordered="true" Class="mb-4">
                        <tbody>
                            <tr><td><strong>Jegyzőkönyv száma</strong></td><td>@_adatok.JegyzokonyvSzam</td></tr>
                            <tr><td><strong>Ügyfél</strong></td><td>@_adatok.Megrendelo</td></tr>
                            <tr><td><strong>Helyszín</strong></td><td>@_adatok.VizsgalatHelye</td></tr>
                            <tr><td><strong>Felelős felülvizsgáló</strong></td><td>@_adatok.FelulvizsgaloNev</td></tr>
                            <tr><td><strong>Bizonyítványok</strong></td><td>@_adatok.FelulvizsgaloBizonyitvany</td></tr>
                            <tr>
                                <td><strong>Eredmény</strong></td>
                                <td><MudChip T="string" Color="@(_adatok.Eredmeny == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.Eredmeny</MudChip></td>
                            </tr>
                            <tr>
