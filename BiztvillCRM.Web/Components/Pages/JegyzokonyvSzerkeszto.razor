    private void OnNevlegesFeszultsegValtozas(string tipusKod)
    {
        _adatok.NevlegesFeszultsegTipus = tipusKod;
        _adatok.NevlegesFeszultseg = tipusKod switch
        {
            "1fazis"  => "230V",
            "3fazis"  => "3x230V / 400V",
            _         => ""
        };
    }

    private void OnFoldelesiTipusValtozas(string tipusKod)
    {
        _adatok.FoldelesiTipusKod = tipusKod;
        _adatok.FoldelesiTipus = tipusKod switch
        {
            "szonda"    => "A",
            "vizszintes"=> "B",
            "mindketto" => "A + B",
            _           => ""
        };
    }

    private void OnLegutolsoFelujitasValtozas(string ertek)
    {
        _adatok.LegutolsoFelujitas = ertek;
    }
