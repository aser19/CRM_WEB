@page "/jegyzokonyv/{MeresId:int?}"
@page "/jegyzokonyv/uj"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Services
@inject IMeresService MeresService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject IMeresTipusService MeresTipusService
@inject IJegyzokonyvWordService JegyzokonyvWordService
@inject IJegyzokonyvJogosultsagService JuegosultsagService
@inject IFelulvizsgaloService FelulvizsgaloService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ITenantService TenantService
@inject ICegService CegService
@inject IEszkozService EszkozService
@inject IKalibracioService KalibracioService
@inject IMunkaszamService MunkaszamService
@inject IMatricaValidatorService MatricaValidator
@inject IJegyzokonyvOcrService OcrService

<PageTitle>Jegyzőkönyv szerkesztő</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
    Jegyzőkönyv szerkesztő
</MudText>

<MudStepper @ref="_stepper" @bind-ActiveIndex="_activeStep" Linear="false" Color="Color.Primary">
    
    @* === 1. LÉPÉS: KIVÁLASZTÁS === *@
    <MudStep Title="Kiválasztás" Icon="@Icons.Material.Filled.ListAlt">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Jegyzőkönyv típusa és ügyfél</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_kivalasztottTipusId" Label="Jegyzőkönyv típusa *"
                               ValueChanged="OnTipusValtozas"
                               Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               ToStringFunc="@(id => _tipusok.FirstOrDefault(t => t.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz típust --</MudSelectItem>
                        @foreach (var tipus in _tipusok)
                        {
                            <MudSelectItem Value="@tipus.Id">@tipus.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_kivalasztottUgyfelId" Label="Ügyfél *"
                               ValueChanged="OnUgyfelValtozas" Variant="Variant.Outlined"
                               ToStringFunc="@(id => _ugyfelek.FirstOrDefault(u => u.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz ügyfelet --</MudSelectItem>
                        @foreach (var ugyfel in _ugyfelek)
                        {
                            <MudSelectItem Value="@ugyfel.Id">@ugyfel.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_kivalasztottTelephelyId" Label="Telephely *"
                               Variant="Variant.Outlined" Disabled="@(_szurtTelephelyek.Count == 0)"
                               ToStringFunc="@(id => _szurtTelephelyek.FirstOrDefault(t => t.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz telephelyet --</MudSelectItem>
                        @foreach (var telephely in _szurtTelephelyek)
                        {
                            <MudSelectItem Value="@telephely.Id">@telephely.Nev - @telephely.Cim</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="_vizsgalatDatum"
                                   DateChanged="OnVizsgalatDatumValtozas"
                                   Label="Vizsgálat dátuma *"
                                   Variant="Variant.Outlined" DateFormat="yyyy.MM.dd" />
                </MudItem>
                
                @* === ÚJ RÉSZ: FÁJL FELTÖLTŐ === *@
                <MudItem xs="12" Class="mt-4">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />
                        Korábbi jegyzőkönyv importálása (opcionális)
                    </MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        PDF vagy kép formátumú jegyzőkönyvet tölthetsz fel az adatok automatikus kitöltéséhez
                    </MudAlert>
                    
                    <MudFileUpload T="IBrowserFile" 
                                   Accept=".pdf,.jpg,.jpeg,.png" 
                                   FilesChanged="KorabbiJegyzokonyvFeltoltesAsync"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="_ocrFeldolgozas">
                                @(_ocrFeldolgozas ? "Feldolgozás..." : "Fájl kiválasztása")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    
                    @if (_ocrFeldolgozas)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-1">
                            OCR feldolgozás folyamatban...
                        </MudText>
                    }
                    
                    @if (!string.IsNullOrEmpty(_feltoltottFajlNev))
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 OnClose="FeltoltottFajlTorles"
                                 Class="mt-2">
                            @_feltoltottFajlNev (@_importaltEszkozokSzama eszköz)
                        </MudChip>
                    }
                </MudItem>
                
                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="ValidalasEsTovabblepesAsync"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Tovább az adatok megadásához
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>
    
    @* === 2. LÉPÉS: ADATOK KITÖLTÉSE === *@
    <MudStep Title="Adatok megadása" Icon="@Icons.Material.Filled.Edit">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Vizsgálat adatai</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.JegyzokonyvSzam" Label="Jegyzőkönyv száma"
                                  Variant="Variant.Outlined"
                                  Placeholder="Automatikusan generálódik a 'Tovább' gombra kattintva" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.CegNev" Label="Vizsgáló cég neve"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.CegCim" Label="Vizsgáló cég címe"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.VizsgalatHelye" Label="Vizsgálat helye"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                @if (!IsHordozhatoTipus() && !IsMeresTipus())
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgalatTargya" Label="Vizsgálat tárgya"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgaltBerendezes" Label="Vizsgált berendezés"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                }
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.Megrendelo" Label="Megrendelő neve"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                @if (!IsHordozhatoTipus() && !IsMeresTipus())
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgalatIdotartama" Label="Vizsgálat időtartama"
                                      Variant="Variant.Outlined" Placeholder="pl. 2 óra" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_adatok.Megjegyzes" Label="Megjegyzések"
                                      Variant="Variant.Outlined" Lines="3"
                                      Placeholder="pl. A vizsgálat különleges körülményei, eltérések, megjegyzések..." />
                    </MudItem>
                }
                
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Vizsgálat eredménye</MudText>
                    <MudToggleGroup T="string" Value="_adatok.Eredmeny"
                                    ValueChanged="OnEredmenyValtozas"
                                    Color="Color.Primary" Rounded="true" CheckMark="true">
                        <MudToggleItem Value="@("MEGFELELT")" Text="Megfelelt" />
                        <MudToggleItem Value="@("NEM FELELT MEG")" Text="Nem felelt meg" />
                    </MudToggleGroup>
                </MudItem>
                
                <MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.UzemiKisero" Label="Üzemi kísérő" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.KapcsolatTarto" Label="Kapcsolattartó" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Felülvizsgálók</MudText>
                    @if (_jogosultFelulvizsgalok.Count == 0 && _kivalasztottTipusId > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">
                            Nincs jogosult felülvizsgáló ehhez a jegyzőkönyv típushoz!
                        </MudAlert>
                    }
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?" Label="Felelős felülvizsgáló *"
                               Value="_kivalasztottFelulvizsgaloId"
                               ValueChanged="OnFelulvizsgaloValtozasAsync"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                        @foreach (var szemely in _jogosultFelulvizsgalok.Where(f => f.LehetFelelosFelulvizsgalo))
                        {
                            <MudSelectItem T="int?" Value="@szemely.Id">
                                @szemely.Nev (@szemely.Jogosultsag)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.FelulvizsgaloBizonyitvany" Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.FelulvizsgaloKepzes" Label="Továbbképzés(ek)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?" Label="Segítő-felülvizsgáló"
                               Value="_kivalasztottSegitoId"
                               ValueChanged="OnSegitoValtozasAsync"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                        @foreach (var szemely in _jogosultFelulvizsgalok)
                        {
                            <MudSelectItem T="int?" Value="@szemely.Id">@szemely.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.SegitoBizonyitvany" Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.SegitoKepzes" Label="Továbbképzés(ek)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string"
                                     Label="Ellenőrizte"
                                     @bind-Value="_adatok.Ellenor"
                                     SearchFunc="EllenorKereses"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Placeholder="Válassz vagy írd be..."
                                     AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                     ResetValueOnEmptyText="false"
                                     Immediate="true"
                                     DebounceInterval="300" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.EllenorBizonyitvany"
                                  Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined"
                                  Placeholder="pl. VF-12345/2024" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        <em>Tartalmi és formai ellenőrzés</em>
                    </MudAlert>
                </MudItem>
                @* === MŰSZEREK SZEKCIÓ === *@
                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-2" Color="Color.Warning" />
                        Használt műszerek
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">kötelező</MudChip>
                    </MudText>
                    @if (!_adatok.Muszerek.Any(m => !string.IsNullOrEmpty(m.Tipus)))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Legalább 1 műszer kiválasztása szükséges a továbblépéshez!
                        </MudAlert>
                    }
                </MudItem>

                @for (int i = 0; i < GetLathatoMuszerekSzama(); i++)
                {
                    var index = i;
                    var aktualisMuszer = index < _adatok.Muszerek.Count ? _adatok.Muszerek[index] : null;
                    var vanKitoltve = !string.IsNullOrEmpty(aktualisMuszer?.Tipus);
    
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?"
                                   Value="@GetMuszerEszkozId(index)"
                                   ValueChanged="@(async (int? id) => await OnMuszerValtozasAsync(index, id))"
                                   Label="@($"Műszer {index + 1}")"
                                   Variant="Variant.Outlined"
                                   Clearable="true">
                            <MudSelectItem T="int?" Value="null">-- Válassz műszert --</MudSelectItem>
                            @foreach (var muszer in _muszerek)
                            {
                                <MudSelectItem T="int?" Value="@muszer.Id">
                                    @muszer.Nev @(string.IsNullOrEmpty(muszer.Tipus) ? "" : $"({muszer.Tipus})")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Value="@(aktualisMuszer?.GyariSzam ?? "")"
                                      Label="Gyári szám"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="@(!vanKitoltve)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Value="@(aktualisMuszer?.Kalibralas ?? "")"
                                      Label="Utolsó kalibráció"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="@(!vanKitoltve)" />
                    </MudItem>
                }
                @* === HORDOZHATÓ TÍPUSNÁL: JÁRMŰADATOK ÉS ESZKÖZLISTA === *@
                @if (IsHordozhatoTipus())
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.h6" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Class="mr-2" />
                            Járműadatok (opcionális)
                        </MudText>
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.DolgozoNeve" Label="Dolgozó neve"
                                      Variant="Variant.Outlined" Placeholder="pl. Kovács Péter" />
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.ForgalmiRendszam" Label="Forgalmi rendszám"
                                      Variant="Variant.Outlined" Placeholder="pl. ABC-123" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.ElectricalServices" Class="mr-2" />
                            Hordozható készülékek listája
                        </MudText>
                    </MudItem>
                    
                    <MudItem xs="12">
                        <HordozhatoEszkozLista 
        Eszkozok="_adatok.Eszkozok" 
        EszkozokChanged="OnEszkozokValtozas" />
                    </MudItem>
                }
                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="Lepes2ValidalasEsTovabbAsync"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Tovább a 3. oldal kitöltéséhez
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>

    @* === 3. LÉPÉS: 3. OLDAL - MINDKÉT TÍPUSNÁL === *@
    <MudStep Title="3. oldal" Icon="@Icons.Material.Filled.FactCheck"
             Disabled="@(_kivalasztottFelulvizsgaloId == null)">
        <MudPaper Class="pa-4">
            <MudGrid>
                @if (IsHordozhatoTipus())
                {
                    @* === HORDOZHATÓ TÍPUS: MATRICÁK === *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.QrCode2" Class="mr-2" />
                            Felülvizsgálati matricák
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_cegMatricaElotag))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                A cég matrica előtagja: <b>@_cegMatricaElotag</b> - automatikusan hozzáfűzésre kerül
                            </MudText>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                Nincs beállítva matrica előtag a cégnél!
                            </MudAlert>
                        }
                    </MudItem>
                    
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_matricaSorszamTol"
                                         Label="Matrica sorszám -tól"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Placeholder="pl. 1234"
                                         Adornment="Adornment.Start"
                                         AdornmentText="@_cegMatricaElotag"
                                         Error="@_matricaValidaciosHiba"
                                         ErrorText="@_matricaHibaSzoveg"
                                         OnBlur="MatricaValidalas" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_matricaSorszamIg"
                                         Label="Matrica sorszám -ig"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Placeholder="pl. 1250"
                                         Adornment="Adornment.Start"
                                         AdornmentText="@_cegMatricaElotag"
                                         Error="@_matricaValidaciosHiba"
                                         ErrorText="@_matricaHibaSzoveg"
                                         OnBlur="MatricaValidalas" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        @if (_matricaValidaciosHiba)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="flex-grow-1">
                                @_matricaHibaSzoveg
                            </MudAlert>
                        }
                        else if (_matricakSzama.HasValue && _matricakSzama > 0)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="flex-grow-1">
                                <b>@_matricakSzama db</b> matrica
                            </MudAlert>
                        }
                    </MudItem>
                }
                else if (_kivalasztottTipusId == 5)
                {
                    @* === ID=5 SABLON: MÉRÉSI PONTOK TÁBLÁZAT + KÖVETKEZŐ FELÜLVIZSGÁLAT === *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
                            Vizsgált berendezés mérési pontjai (3. oldal)
                        </MudText>
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MeresiPontLista MeresiPontok="_adatok.MeresiPontok" 
                                       RendszerTipus="_adatok.MeresiRendszerTipus"
                                       RendszerTipusChanged="(tipus) => _adatok.MeresiRendszerTipus = tipus"
                                       OnChange="StateHasChanged" />
                    </MudItem>
                    
                    @* === ÚJ: KÖVETKEZŐ FELÜLVIZSGÁLAT DÁTUMA === *@
                    <MudItem xs="12" Class="mt-4">
                        <MudDivider />
                    </MudItem>
                    
                    <MudItem xs="12" Class="mt-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" />
                            Következő felülvizsgálat időpontja
                        </MudText>
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_adatok.KovetkezoFelulvizsgalatDatum"
                                       Label="Következő felülvizsgálat határideje *"
                                       Variant="Variant.Outlined" 
                                       DateFormat="yyyy.MM.dd"
                                       HelperText="Automatikusan számított időpont alapértelmezetten" />
                    </MudItem>
                    
                    <MudItem xs="12" md="6" Class="d-flex align-center">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="flex-grow-1">
                            <strong>Javasolt időpont:</strong> @GetJavasoltKovetkezoFelulvizsgalat()
                        </MudAlert>
                    </MudItem>
                }
                else
                {
                    @* === EGYÉB TÍPUSOK: MINŐSÍTŐ IRAT MEZŐK === *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
                            Minősítő irat (3. oldal)
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Az érvényességi feltételek betartása esetén a villamos berendezés következő időszakos villamos biztonsági felülvizsgálatát:
                        </MudText>

                        @* === 3 ÉVES CSOPORT (301-305) === *@
                        <MudRadioGroup T="string" Value="_adatok.KovetkezoFelulvizsgalatTipus"
                                       ValueChanged="@((string v) => { _adatok.KovetkezoFelulvizsgalatTipus = v; _adatok.HataridoTipus = null; _adatok.HataridoEgyeb = null; })"
                                       Class="d-flex flex-column gap-1">
                            <MudRadio Value="@("50kW")" Color="Color.Primary" Dense="true" Style="width:100%">
                                az épületnek nem minősülő műtárgy <strong>50 kW</strong>-ot meghaladó csatlakozási teljesítményű villamos berendezésén
                            </MudRadio>
                            <MudRadio Value="@("32A")" Color="Color.Primary" Dense="true" Style="width:100%">
                                a fázisonként <strong>32 A</strong>-nél nagyobb névleges áramerősségű túráramvédelemmel korlátozott villamos berendezésén
                            </MudRadio>
                            <MudRadio Value="@("VMBSZ")" Color="Color.Primary" Dense="true" Style="width:100%">
                                a <strong>VMBSZ</strong> szerint lakóépület, kommunális épület, valamint egyéb épület villamos berendezésén
                            </MudRadio>
                            <MudRadio Value="@("RV300")" Color="Color.Primary" Dense="true" Style="width:100%">
                                <strong>≥300 kg/l</strong> robbanásveszélyes (RV) osztályú anyagot tartalmazó helyiségekben és szabadtéren (korábban: A és B osztályú helyiségek)
                            </MudRadio>
                            <MudRadio Value="@("egyeb305")" Color="Color.Primary" Dense="true" Style="width:100%">
                                egyéb, itt nem szereplő esetekben:
                            </MudRadio>
                        </MudRadioGroup>

                        @* 3051 szövegmező – csak ha "egyeb305" van kiválasztva *@
                        @if (_adatok.KovetkezoFelulvizsgalatTipus == "egyeb305")
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-1 ml-6">
                                <MudTextField @bind-Value="_adatok.KovetkezoFelulvizsgalatEgyeb"
                                              Variant="Variant.Outlined"
                                              Style="max-width: 350px;" Margin="Margin.Dense"
                                              Placeholder="Egyéb eset leírása..." />
                            </MudStack>
                        }

                        @* 310 – automatikusan jelenik meg, ha 3 éves csoport van kiválasztva *@
                        @if (_adatok.KovetkezoFelulvizsgalatTipus is "50kW" or "32A" or "VMBSZ" or "RV300" or "egyeb305")
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                a kiadási dátumtól számított <strong>3 éven belül, legkésőbb: @GetSzamitottDatum(3)-ig</strong> kell elvégezni.
                            </MudAlert>
                        }

                        @* === 6 ÉVES CSOPORT (307-309) === *@
                        <MudRadioGroup T="string" Value="_adatok.HataridoTipus"
                                       ValueChanged="@((string v) => { _adatok.HataridoTipus = v; _adatok.KovetkezoFelulvizsgalatTipus = null; _adatok.KovetkezoFelulvizsgalatEgyeb = null; })"
                                       Class="d-flex flex-column gap-1 mt-3">
                            <MudRadio Value="@("307")" Color="Color.Primary" Dense="true" Style="width:100%">
                                a lakóépületek villamos berendezésén (kivéve: lakások, ha Ib ≤ 32 A és IΔn ≤ 30 mA)
                            </MudRadio>
                            <MudRadio Value="@("308")" Color="Color.Primary" Dense="true" Style="width:100%">
                                egyéb (robbanásveszélyes /RV/ osztályú anyagot NEM tartalmazó) helyiségekben és térségekben (korábban: C, D és E osztályú helyiségek)
                            </MudRadio>
                            <MudRadio Value="@("309")" Color="Color.Primary" Dense="true" Style="width:100%">
                                egyéb, itt nem szereplő esetekben:
                            </MudRadio>
                        </MudRadioGroup>

                        @* 3091 szövegmező – csak ha "309" van kiválasztva *@
                        @if (_adatok.HataridoTipus == "309")
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-1 ml-6">
                                <MudTextField @bind-Value="_adatok.HataridoEgyeb"
                                              Variant="Variant.Outlined"
                                              Style="max-width: 350px;" Margin="Margin.Dense"
                                              Placeholder="Egyéb eset leírása..." />
                            </MudStack>
                        }

                        @* 312 – automatikusan jelenik meg, ha 6 éves csoport van kiválasztva *@
                        @if (_adatok.HataridoTipus is "307" or "308" or "309")
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                a kiadási dátumtól számított <strong>6 éven belül, legkésőbb: @GetSzamitottDatum(6)-ig</strong> kell elvégezni.
                            </MudAlert>
                        }
                    </MudItem>
                    <MudTextField @bind-Value="_adatok.MinositoIratMegjegyzes"
                                  Label="Megjegyzés"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Class="mt-3"
                                  Placeholder="Megjegyzések a minősítő irathoz..." />
                }

                @* === KAPCSOLÓDÓ JOGSZABÁLYOK ÉS SZABVÁNYOK === *@
                @if (_adatok.KijeloltJogszabalyok.Any())
                {
                    var jogszabalyok = _adatok.KijeloltJogszabalyok
                        .Where(j => !j.IsSzabvany)
                        .OrderBy(j => j.Szam)
                        .ToList();
                    var szabvanyok = _adatok.KijeloltJogszabalyok
                        .Where(j => j.IsSzabvany)
                        .OrderBy(j => j.Szam)
                        .ToList();

                    <MudItem xs="12" Class="mt-4">
                        <MudDivider />
                    </MudItem>

                    @if (jogszabalyok.Any())
                    {
                        <MudItem xs="12" Class="mt-3">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
                                Kapcsolódó jogszabályok
                            </MudText>
                            <MudGrid Spacing="1">
                                @foreach (var j in jogszabalyok)
                                {
                                    <MudItem xs="12" md="4" Style="display:flex; align-items:flex-start;">
                                        <MudCheckBox @bind-Value="j.Kivalasztva" Color="Color.Primary" Dense="true">
                                            <span style="font-size:0.8rem; line-height:1.3;">
                                                <strong>@j.Szam</strong> – @j.Cim
                                            </span>
                                        </MudCheckBox>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudItem>
                    }

                    @if (szabvanyok.Any())
                    {
                        <MudItem xs="12" Class="mt-3">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Rule" Class="mr-2" />
                                Kapcsolódó szabványok
                            </MudText>
                            <MudGrid Spacing="1">
                                @foreach (var sz in szabvanyok)
                                {
                                    <MudItem xs="12" md="4" Style="display:flex; align-items:flex-start;">
                                        <MudCheckBox @bind-Value="sz.Kivalasztva" Color="Color.Primary" Dense="true">
                                            <span style="font-size:0.8rem; line-height:1.3;">
                                                <strong>@sz.Szam</strong> – @sz.Cim
                                            </span>
                                        </MudCheckBox>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudItem>
                    }
                }

                @* === KÖVETKEZŐ FELÜLVIZSGÁLAT DÁTUMA === *@
                @if (IsIdoszakosVBFTipus())
                {
                    <MudItem xs="12" Class="mt-4">
                        <MudDivider />
                    </MudItem>
                    <MudItem xs="12" Class="mt-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" />
                            Következő felülvizsgálat határideje
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex align-center">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="flex-grow-1">
                            <strong>Számított határidő:</strong>
                            @{
                                var evek = _adatok.HataridoTipus is "307" or "308" ? 6 : 3;
                            }
                            @GetSzamitottDatum(evek)
                        </MudAlert>
                    </MudItem>
                }

                @* === HIBÁK ÉS VÉGSŐ MINŐSÍTÉS – 3. oldalra folytatólagosan áthozva === *@
                @if (IsIdoszakosVBFTipus())
                {
                    <MudItem xs="12" Class="mt-4">
                        <MudDivider />
                    </MudItem>

                    <MudItem xs="12" Class="mt-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Talált hibák kategóriánként</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            Csak a talált hibákat töltsd ki. Ha egy kategóriában nincs hiba, hagyd üresen.
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Value="_adatok.HibakB"
                                      ValueChanged="@((string v) => OnHibaBKitoltve(v))"
                                      Label="B kategória – Életveszélyes hibák"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="pl. Hiányzó védőföldelés, sérült szigetelés érintésveszélyes részeken..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Warning"
                                      AdornmentColor="Color.Error" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Value="_adatok.HibakC"
                                      ValueChanged="@((string v) => OnHibaCKitoltve(v))"
                                      Label="C kategória – Súlyos hibák"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="pl. Túlterhelés, helytelen biztosíték méret..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Error"
                                      AdornmentColor="Color.Warning" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_adatok.HibakD"
                                      Label="D kategória – Karbantartást igénylő hibák"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="pl. Laza csatlakozások, szennyezett elosztó..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Build"
                                      AdornmentColor="Color.Info" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_adatok.HibakE"
                                      Label="E kategória – Felújítást igénylő hibák"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="pl. Elavult berendezés, lejárt élettartamú komponensek..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.HomeRepairService"
                                      AdornmentColor="Color.Secondary" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Mellékletek</MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_adatok.MellekletekSzama"
                                      Label="Mellékletek száma"
                                      Variant="Variant.Outlined"
                                      Placeholder="pl. 2 db" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_adatok.HibavedelmiJkv"
                                      Label="Hibavédelmi mérési jkv."
                                      Variant="Variant.Outlined"
                                      Placeholder="pl. 2024/HVM-001" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_adatok.AvkJegyzokonyv"
                                      Label="ÁVK mérési jkv."
                                      Variant="Variant.Outlined"
                                      Placeholder="pl. 2024/AVK-001" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Végső minősítés</MudText>
                        <MudToggleGroup T="string" Value="_adatok.VegsoMinosites"
                                        ValueChanged="OnVegsoMinositesValtozas"
                                        Color="Color.Primary" Rounded="true" CheckMark="true">
                            <MudToggleItem Value="@("MEGFELELT")" Text="Megfelelt" />
                            <MudToggleItem Value="@("NEM FELELT MEG")" Text="Nem felelt meg" />
                        </MudToggleGroup>
                    </MudItem>

                    @if (!string.IsNullOrWhiteSpace(_adatok.HibakB) || !string.IsNullOrWhiteSpace(_adatok.HibakC))
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                B vagy C kategóriás hiba esetén a végső minősítés általában <strong>NEM FELELT MEG</strong>!
                            </MudAlert>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_adatok.MinositoMegjegyzes"
                                      Label="Minősítő megjegyzés (opcionális)"
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      Placeholder="pl. A hibák kijavítása után a berendezés üzembe helyezhető." />
                    </MudItem>
                }

                <MudItem xs="12" Class="mt-4">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   OnClick="VisszaEggyetLepes"
                                   StartIcon="@Icons.Material.Filled.ArrowBack">
                            Vissza
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes4ValidalasEsTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább a 4. oldalra
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>

    @* === 4. LÉPÉS: VILLAMOS BERENDEZÉS ADATAI (csak Időszakos VBF) === *@
    <MudStep Title="4. oldal" Icon="@Icons.Material.Filled.ElectricBolt"
             Disabled="@(!IsIdoszakosVBFTipus())">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.ElectricBolt" Class="mr-2" />
                Villamos berendezés adatai (4. oldal)
            </MudText>

            <MudGrid>
                @* === I. NÉVLEGES FESZÜLTSÉG === *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">I. Névleges feszültség</MudText>
                    <MudRadioGroup T="string" @bind-Value="_adatok.NevlegesFeszultsegTipus" Class="d-flex flex-row gap-4">
                        <MudRadio Value="@("1fazis")" Color="Color.Primary">230 V (1 fázis)</MudRadio>
                        <MudRadio Value="@("3fazis")" Color="Color.Primary">3×230 V / 400 V (3 fázis)</MudRadio>
                    </MudRadioGroup>
                </MudItem>

                @* === II. FÖLDELÉSI TÍPUS === *@
                <MudItem xs="12" Class="mt-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">II. Földelési típus</MudText>
                    <MudRadioGroup T="string" @bind-Value="_adatok.FoldelesiTipusKod" Class="d-flex flex-column gap-1">
                        <MudRadio Value="@("szonda")" Color="Color.Primary">A – Szonda (függőleges)</MudRadio>
                        <MudRadio Value="@("vizszintes")" Color="Color.Primary">B – Vízszintes</MudRadio>
                        <MudRadio Value="@("mindketto")" Color="Color.Primary">A + B – Mindkettő</MudRadio>
                    </MudRadioGroup>
                </MudItem>

                @* === III. ÉRINTÉSVÉDELMI MÓD === *@
                <MudItem xs="12" Class="mt-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">III. Alapvető érintésvédelmi mód</MudText>
                    <MudTextField @bind-Value="_adatok.ErintesvedelmiMod"
                                  Label="Érintésvédelmi mód"
                                  Variant="Variant.Outlined"
                                  Placeholder="pl. TN-C-S" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                </MudItem>

                @* === ÁRAMÜTÉS-ELLENI VÉDELMI MÓDOK === *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Áramütés-elleni védelmi módok</MudText>
                    <MudStack Spacing="1">
                        <MudCheckBox @bind-Value="_adatok.Vedelem404" Color="Color.Primary" Dense="true">
                            A táplálás önműködő lekapcsolása (TN-/TT-/IT-rendszer)
                        </MudCheckBox>
                        <MudCheckBox @bind-Value="_adatok.Vedelem405" Color="Color.Primary" Dense="true">
                            Kettős vagy megerősített szigetelés
                        </MudCheckBox>
                        <MudCheckBox @bind-Value="_adatok.Vedelem406" Color="Color.Primary" Dense="true">
                            Villamos elválasztás
                        </MudCheckBox>
                        <MudCheckBox @bind-Value="_adatok.Vedelem407" Color="Color.Primary" Dense="true">
                            SELV/PELV törpefeszültség
                        </MudCheckBox>
                        <MudCheckBox @bind-Value="_adatok.Vedelem408" Color="Color.Primary" Dense="true">
                            Védő egyenpotenciálú összekötés, védővezetők, védőösszekötő-vezetők
                        </MudCheckBox>
                        <MudCheckBox @bind-Value="_adatok.Vedelem409" Color="Color.Primary" Dense="true">
                            Védelem földeletlen helyi egyenpotenciálú összekötéssel
                        </MudCheckBox>
                    </MudStack>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                </MudItem>

                @* === BETÁPLÁLÁS ÉS DOKUMENTÁCIÓ === *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Betáplálás és dokumentáció</MudText>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_adatok.Betaplalas" Label="Betáplálás" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Légvezeték")">Légvezeték</MudSelectItem>
                        <MudSelectItem Value="@("Földkábel")">Földkábel</MudSelectItem>
                        <MudSelectItem Value="@("Nem része a felülvizsgálatnak")">Nem része a felülvizsgálatnak</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_adatok.TartalekEnergia" Label="Tartalék energia" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Van")">Van</MudSelectItem>
                        <MudSelectItem Value="@("Nincs")">Nincs</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Class="mb-1">Legutolsó felújítás éve</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSelect T="string" Value="@GetFelujitasEv()"
                                   ValueChanged="@((string v) => OnFelujitasEvValtozas(v))"
                                   Variant="Variant.Outlined"
                                   Style="max-width: 130px; margin-top:0;">
                            <MudSelectItem Value="@("Ismeretlen")">Ismeretlen</MudSelectItem>
                            @for (int ev = DateTime.Now.Year; ev >= 1940; ev--)
                            {
                                var evStr = ev.ToString();
                                <MudSelectItem Value="@evStr">@evStr</MudSelectItem>
                            }
                        </MudSelect>
                        <MudCheckBox @bind-Value="_legutolsoFelujitasElott"
                                     Color="Color.Primary" Dense="true"
                                     Label="előtt"
                                     Disabled="@(_adatok.LegutolsoFelujitas == "Ismeretlen")"
                                     CheckedChanged="@((bool v) => OnFelujitasElottValtozas(v))" />
                        <MudText Typo="Typo.body2" Color="Color.Primary">
                            → <strong>@_adatok.LegutolsoFelujitas</strong>
                        </MudText>
                    </MudStack>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_adatok.Dokumentaciok"
                                  Label="Dokumentációk (max. 150 karakter)"
                                  Variant="Variant.Outlined"
                                  MaxLength="150"
                                  Counter="150"
                                  Placeholder="pl. Villamos tervdokumentáció, kapcsolási rajz..." />
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   OnClick="VisszaEggyetLepes"
                                   StartIcon="@Icons.Material.Filled.ArrowBack">
                            Vissza
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="Lepes4ValidalasEsTovabbAsync"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Tovább az összegzéshez
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>

        @* === 5. LÉPÉS: MSZ HD 60364-6 ELLENŐRZÉSEK === *@
    <MudStep Title="5. oldal" Icon="@Icons.Material.Filled.FactCheck"
             Disabled="@(!IsIdoszakosVBFTipus())">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
                MSZ HD 60364-6 ellenőrzések (5. oldal)
            </MudText>

            <MudGrid>
                @* === RÖGZÍTETT VILLAMOS BERENDEZÉS SZERKEZETEI === *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.ElectricalServices" Class="mr-2" />
                        A rögzített villamos berendezés szerkezetei
                    </MudText>
                </MudItem>

                @{
                    var szerkezetek = new[]
                    {
                        ("a", "megfelelnek a vonatkozó termékszabvány biztonsági követelményeinek (jelölések, tanúsítványok és gyártói információk alapján)", nameof(_adatok.Ellen5_Sz_A)),
                        ("b", "az MSZ HD 60364 szabványsorozat és a gyártó előírásai szerinti a kiválasztásuk és a szerelésük", nameof(_adatok.Ellen5_Sz_B)),
                        ("c", "épek és nincsen olyan látható sérülésük, amely csökkentené a biztonságot", nameof(_adatok.Ellen5_Sz_C)),
                    };
                }
