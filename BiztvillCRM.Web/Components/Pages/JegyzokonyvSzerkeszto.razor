        }
        finally
        {
            _feldolgozas = false;
        }
    }

    private int _aktualMeresId => MeresId ?? _ujonnanMentettMeresId ?? 0;
    private int? _ujonnanMentettMeresId;
    /// <summary>Igaz, ha a kiválasztott típus egy melléklet-specifikus workflow (AVK, HVM, stb.).</summary>

    private bool IsMellekletTipus()
    {
        return !string.IsNullOrEmpty(GetAktualisTipusKod());
    }

    /// <summary>Visszaadja a kiválasztott méréstípus MellekletTipusKod értékét (vagy null-t).</summary>
    private string? GetAktualisTipusKod()
    {
        return _osszesTipus.FirstOrDefault(t => t.Id == _kivalasztottTipusId)?.MellekletTipusKod;
    }

    /// <summary>Igaz, ha a műszer utolsó kalibrációja több mint 2 éves (vagy nincs megadva).</summary>
    private bool IsKalibracioLejart(MuszerSor? sor)
    {
        if (sor == null || string.IsNullOrWhiteSpace(sor.Tipus)) return false;
        if (string.IsNullOrWhiteSpace(sor.Kalibralas)) return true; // nincs kalibráció → figyelmeztetés

        // Formátumok: "yyyy.MM.dd" vagy "yyyy-MM-dd"
        if (DateTime.TryParseExact(sor.Kalibralas.Trim(),
                new[] { "yyyy.MM.dd", "yyyy-MM-dd", "yyyy. MM. dd." },
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var kalDatum))
        {
            return kalDatum < DateTime.Today.AddYears(-2);
        }

        return false; // nem tudtuk parse-olni → ne riasszunk
    }

    // Sablon tételek oldalanként
    private Dictionary<int, List<JegyzokonyvSablonTetel>> _sablonTetelek = new();

    private bool VanSablon(int oldalSzam) =>
        _sablonTetelek.TryGetValue(oldalSzam, out var lista) && lista.Count > 0;

    private string GetSablonErtek(int oldalSzam, int tetelId)
    {
        var kulcs = $"{oldalSzam}_{tetelId}";
        return _adatok.SablonErtekek.TryGetValue(kulcs, out var v) ? v : "";
    }

    private void SetSablonErtek(int oldalSzam, int tetelId, string ertek)
    {
        var kulcs = $"{oldalSzam}_{tetelId}";
        _adatok.SablonErtekek[kulcs] = ertek;
    }

    private string GetSablonMegjegyzes(int oldalSzam, int tetelId)
    {
        var kulcs = $"{oldalSzam}_{tetelId}_M";
        return _adatok.SablonMegjegyzések.TryGetValue(kulcs, out var v) ? v : "";
    }

    private void SetSablonMegjegyzes(int oldalSzam, int tetelId, string ertek)
    {
        var kulcs = $"{oldalSzam}_{tetelId}_M";
        _adatok.SablonMegjegyzések[kulcs] = ertek;
    }

    private async Task BetoltSablonTetelek(int meresTipusId)
    {
        _sablonTetelek.Clear();
        // Az 5–7. oldalak lehetséges sablon oldalak
        foreach (var oldal in new[] { 5, 6, 7 })
        {
            var tetelek = await JegyzokonyvSablonService.GetTetelek(meresTipusId, oldal);
            if (tetelek.Count > 0)
                _sablonTetelek[oldal] = tetelek;
        }
        // Alapértékek előtöltése (csak ha az adott kulcs még nincs kitöltve)
        foreach (var (oldal, tetelek) in _sablonTetelek)
        {
            foreach (var t in tetelek)
            {
                var kulcs = $"{oldal}_{t.Id}";
                if (!_adatok.SablonErtekek.ContainsKey(kulcs))
                    _adatok.SablonErtekek[kulcs] = t.AlapertelmezettErtek;
            }
        }
    }

    // Sablon változók
    private List<JegyzokonyvSablon> _sablonok = [];
    private string _kivalasztottSablonId = "VBF_KIF_MINTA";
    private List<VizsgalatiSablon> _vizsgalatiSablonok = [];
    private int? _kivalasztottVizsgalatiSablonId;

