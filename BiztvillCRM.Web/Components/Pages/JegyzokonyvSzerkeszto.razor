    private int? GetMuszerEszkozId(int index)
    {
        if (index >= _kivalasztottMuszerIds.Count) return null;
        return _kivalasztottMuszerIds[index];
    }

    // Kiválasztott műszer ID-k tárolása
    private List<int?> _kivalasztottMuszerIds = new() { null, null, null };

    private int GetLathatoMuszerekSzama()
    {
        int kitoltott = _adatok.Muszerek.Count(m => !string.IsNullOrEmpty(m.Tipus));
        return Math.Min(kitoltott + 1, 3);
    }

    private async Task OnMuszerValtozasAsync(int index, int? eszkozId)
    {
        while (_adatok.Muszerek.Count <= index)
            _adatok.Muszerek.Add(new MuszerSor());
        while (_kivalasztottMuszerIds.Count <= index)
            _kivalasztottMuszerIds.Add(null);

        _kivalasztottMuszerIds[index] = eszkozId;

        if (eszkozId.HasValue)
        {
            var muszer = _muszerek.FirstOrDefault(m => m.Id == eszkozId.Value);
            if (muszer != null)
            {
                var kalibraciok = await KalibracioService.GetByEszkozIdAsync(eszkozId.Value);
                var utolsoKalibracio = kalibraciok.FirstOrDefault();

                _adatok.Muszerek[index] = new MuszerSor
                {
                    Tipus = muszer.Nev ?? "",
                    GyariSzam = muszer.GyariSzam ?? "",
                    Kalibralas = utolsoKalibracio?.Datum.ToString("yyyy.MM.dd") ?? ""
                };
            }
        }
        else
        {
            _adatok.Muszerek[index] = new MuszerSor();
        }

        StateHasChanged();
    }

    private async Task KorabbiJegyzokonyvFeltoltesAsync(IBrowserFile? file)
    {
        if (file == null) return;

        _ocrFeldolgozas = true;
        _feltoltottFajlNev = null;

        try
        {
            var maxFileSize = 15 * 1024 * 1024;
            
            using var stream = file.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            // ✅ Mérés típus OCR model ID-jának lekérése
            var tipus = _tipusok.FirstOrDefault(t => t.Id == _kivalasztottTipusId);
            var ocrModelId = tipus?.OcrModelId; // null ha nincs megadva

            // OCR feldolgozás a megfelelő modellel
            var importAdatok = await OcrService.FeldolgozAsync(memoryStream, file.Name, ocrModelId);

            // Adatok egyesítése
            MergeImportaltAdatok(importAdatok);

            _feltoltottFajlNev = file.Name;
            _importaltEszkozokSzama = importAdatok.Eszkozok.Count;

            Snackbar.Add($"Jegyzőkönyv sikeresen importálva! {_importaltEszkozokSzama} eszköz betöltve.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a feldolgozás során: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ocrFeldolgozas = false;
        }
    }

    private void MergeImportaltAdatok(JegyzokonyvImportAdatok import)
    {
        // Csak nem üres mezők felülírása
        if (!string.IsNullOrWhiteSpace(import.DolgozoNeve))
            _adatok.DolgozoNeve = import.DolgozoNeve;

        if (!string.IsNullOrWhiteSpace(import.ForgalmiRendszam))
            _adatok.ForgalmiRendszam = import.ForgalmiRendszam;

        if (!string.IsNullOrWhiteSpace(import.Megrendelo))
            _adatok.Megrendelo = import.Megrendelo;

        if (!string.IsNullOrWhiteSpace(import.UzemiKisero))
            _adatok.UzemiKisero = import.UzemiKisero;

        if (!string.IsNullOrWhiteSpace(import.KapcsolatTarto))
            _adatok.KapcsolatTarto = import.KapcsolatTarto;

        if (!string.IsNullOrWhiteSpace(import.VizsgalatHelye))
            _adatok.VizsgalatHelye = import.VizsgalatHelye;

        // Eszközök hozzáadása
        if (import.Eszkozok.Any())
        {
            foreach (var impEszkoz in import.Eszkozok)
            {
                var ujEszkoz = new HordozhatoEszkozSor
                {
                    Sorsz = _adatok.Eszkozok.Count + 1,
                    Megnevezes = impEszkoz.Eszkoznev ?? "",
                    Tipus = impEszkoz.Tipus ?? "",
                    Azonosito = impEszkoz.GyariSzam ?? impEszkoz.Leltariszam ?? "",
                    VedelmiOsztaly = "I", // Alapértelmezett
                    Telj = impEszkoz.JellemzoTeljesitmeny ?? "230V",
                    Megtekint = impEszkoz.Megtekintes ?? "MF",
                    Folyt = impEszkoz.Folytonossag ?? "",
                    Szigell = impEszkoz.Szigeteles ?? "",
                    Szivargo = impEszkoz.SzivargoAram ?? "",
                    
                    // Hierarchikus mezők
                    CsoportNev = impEszkoz.CsoportNev,
                    CsoportSorrend = impEszkoz.CsoportSorrend
                };
                _adatok.Eszkozok.Add(ujEszkoz);
            }
    
            StateHasChanged();
        }
    }

