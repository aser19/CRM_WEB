@page "/jegyzokonyv/{MeresId:int?}"
@page "/jegyzokonyv/uj"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Services
@inject IMeresService MeresService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject IMeresTipusService MeresTipusService
@inject IJegyzokonyvWordService JegyzokonyvWordService
@inject IJegyzokonyvJogosultsagService JuegosultsagService
@inject IFelulvizsgaloService FelulvizsgaloService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ITenantService TenantService
@inject ICegService CegService
@inject IEszkozService EszkozService
@inject IKalibracioService KalibracioService
@inject IMunkaszamService MunkaszamService
@inject IMatricaValidatorService MatricaValidator

<PageTitle>Jegyzőkönyv szerkesztő</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
    Jegyzőkönyv szerkesztő
</MudText>

<MudStepper @ref="_stepper" Linear="false" Color="Color.Primary">
    
    @* === 1. LÉPÉS: KIVÁLASZTÁS === *@
    <MudStep Title="Kiválasztás" Icon="@Icons.Material.Filled.ListAlt">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Jegyzőkönyv típusa és ügyfél</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_kivalasztottTipusId" Label="Jegyzőkönyv típusa *"
                               ValueChanged="OnTipusValtozas"
                               Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               ToStringFunc="@(id => _tipusok.FirstOrDefault(t => t.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz típust --</MudSelectItem>
                        @foreach (var tipus in _tipusok)
                        {
                            <MudSelectItem Value="@tipus.Id">@tipus.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_kivalasztottUgyfelId" Label="Ügyfél *"
                               ValueChanged="OnUgyfelValtozas" Variant="Variant.Outlined"
                               ToStringFunc="@(id => _ugyfelek.FirstOrDefault(u => u.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz ügyfelet --</MudSelectItem>
                        @foreach (var ugyfel in _ugyfelek)
                        {
                            <MudSelectItem Value="@ugyfel.Id">@ugyfel.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_kivalasztottTelephelyId" Label="Telephely *"
                               Variant="Variant.Outlined" Disabled="@(_szurtTelephelyek.Count == 0)"
                               ToStringFunc="@(id => _szurtTelephelyek.FirstOrDefault(t => t.Id == id)?.Nev ?? "-- Válassz --")">
                        <MudSelectItem Value="0">-- Válassz telephelyet --</MudSelectItem>
                        @foreach (var telephely in _szurtTelephelyek)
                        {
                            <MudSelectItem Value="@telephely.Id">@telephely.Nev - @telephely.Cim</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_vizsgalatDatum" Label="Vizsgálat dátuma *"
                                   Variant="Variant.Outlined" DateFormat="yyyy.MM.dd" />
                </MudItem>
                
                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="ValidalasEsTovabblepesAsync"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Tovább az adatok megadásához
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>
    
    @* === 2. LÉPÉS: ADATOK KITÖLTÉSE === *@
    <MudStep Title="Adatok megadása" Icon="@Icons.Material.Filled.Edit">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Vizsgálat adatai</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.JegyzokonyvSzam" Label="Jegyzőkönyv száma"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.CegNev" Label="Vizsgáló cég neve"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.CegCim" Label="Vizsgáló cég címe"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.VizsgalatHelye" Label="Vizsgálat helye"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                @if (!IsHordozhatoTipus())
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgalatTargya" Label="Vizsgálat tárgya"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgaltBerendezes" Label="Vizsgált berendezés"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                }
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.Megrendelo" Label="Megrendelő neve"
                                  Variant="Variant.Outlined" />
                </MudItem>
                
                @if (!IsHordozhatoTipus())
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.VizsgalatIdotartama" Label="Vizsgálat időtartama"
                                      Variant="Variant.Outlined" Placeholder="pl. 2 óra" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_adatok.Megjegyzes" Label="Megjegyzések"
                                      Variant="Variant.Outlined" Lines="3" />
                    </MudItem>
                }
                
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Vizsgálat eredménye</MudText>
                    <MudToggleGroup T="string" Value="_adatok.Eredmeny"
                                    ValueChanged="OnEredmenyValtozas"
                                    Color="Color.Primary" Rounded="true" CheckMark="true">
                        <MudToggleItem Value="@("MEGFELELT")" Text="Megfelelt" />
                        <MudToggleItem Value="@("NEM FELELT MEG")" Text="Nem felelt meg" />
                    </MudToggleGroup>
                </MudItem>
                
                <MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.UzemiKisero" Label="Üzemi kísérő" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_adatok.KapcsolatTarto" Label="Kapcsolattartó" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Felülvizsgálók</MudText>
                    @if (_jogosultFelulvizsgalok.Count == 0 && _kivalasztottTipusId > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">
                            Nincs jogosult felülvizsgáló ehhez a jegyzőkönyv típushoz!
                        </MudAlert>
                    }
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?" Label="Felelős felülvizsgáló *"
                               Value="_kivalasztottFelulvizsgaloId"
                               ValueChanged="OnFelulvizsgaloValtozasAsync"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                        @foreach (var szemely in _jogosultFelulvizsgalok.Where(f => f.LehetFelelosFelulvizsgalo))
                        {
                            <MudSelectItem T="int?" Value="@szemely.Id">
                                @szemely.Nev (@szemely.Jogosultsag)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.FelulvizsgaloBizonyitvany" Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.FelulvizsgaloKepzes" Label="Továbbképzés(ek)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?" Label="Segítő-felülvizsgáló"
                               Value="_kivalasztottSegitoId"
                               ValueChanged="OnSegitoValtozasAsync"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                        @foreach (var szemely in _jogosultFelulvizsgalok)
                        {
                            <MudSelectItem T="int?" Value="@szemely.Id">@szemely.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.SegitoBizonyitvany" Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.SegitoKepzes" Label="Továbbképzés(ek)"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string"
                                     Label="Ellenőrizte"
                                     @bind-Value="_adatok.Ellenor"
                                     SearchFunc="EllenorKereses"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Placeholder="Válassz vagy írd be..."
                                     AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                     ResetValueOnEmptyText="false"
                                     Immediate="true"
                                     DebounceInterval="300" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_adatok.EllenorBizonyitvany"
                                  Label="Bizonyítvány(ok)"
                                  Variant="Variant.Outlined"
                                  Placeholder="pl. VF-12345/2024" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        <em>Tartalmi és formai ellenőrzés</em>
                    </MudAlert>
                </MudItem>
                @* === HORDOZHATÓ TÍPUSNÁL: JÁRMŰADATOK ÉS ESZKÖZLISTA === *@
                @if (IsHordozhatoTipus())
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.h6" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Class="mr-2" />
                            Járműadatok (opcionális)
                        </MudText>
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.DolgozoNeve" Label="Dolgozó neve"
                                      Variant="Variant.Outlined" Placeholder="pl. Kovács Péter" />
                    </MudItem>
                    
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_adatok.ForgalmiRendszam" Label="Forgalmi rendszám"
                                      Variant="Variant.Outlined" Placeholder="pl. ABC-123" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.ElectricalServices" Class="mr-2" />
                            Hordozható készülékek listája
                        </MudText>
                    </MudItem>
                    
                    <MudItem xs="12">
                        <HordozhatoEszkozLista 
        Eszkozok="_adatok.Eszkozok" 
        EszkozokChanged="OnEszkozokValtozas" />
                    </MudItem>
                }
                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="Lepes2ValidalasEsTovabbAsync"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Tovább a 3. oldal kitöltéséhez
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>

    @* === 3. LÉPÉS: 3. OLDAL - MINDKÉT TÍPUSNÁL === *@
    <MudStep Title="3. oldal" Icon="@Icons.Material.Filled.FactCheck"
             Disabled="@(_kivalasztottFelulvizsgaloId == null)">
        <MudPaper Class="pa-4">
            <MudGrid>
                @if (IsHordozhatoTipus())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.QrCode2" Class="mr-2" />
                            Felülvizsgálati matricák
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_cegMatricaElotag))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                A cég matrica előtagja: <b>@_cegMatricaElotag</b> - automatikusan hozzáfűzésre kerül
                            </MudText>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                Nincs beállítva matrica előtag a cégnél!
                            </MudAlert>
                        }
                    </MudItem>
                    
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_matricaSorszamTol"
                                         Label="Matrica sorszám -tól"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Placeholder="pl. 1234"
                                         Adornment="Adornment.Start"
                                         AdornmentText="@_cegMatricaElotag"
                                         Error="@_matricaValidaciosHiba"
                                         ErrorText="@_matricaHibaSzoveg"
                                         OnBlur="MatricaValidalas" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_matricaSorszamIg"
                                         Label="Matrica sorszám -ig"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Placeholder="pl. 1250"
                                         Adornment="Adornment.Start"
                                         AdornmentText="@_cegMatricaElotag"
                                         Error="@_matricaValidaciosHiba"
                                         ErrorText="@_matricaHibaSzoveg"
                                         OnBlur="MatricaValidalas" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        @if (_matricaValidaciosHiba)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="flex-grow-1">
                                @_matricaHibaSzoveg
                            </MudAlert>
                        }
                        else if (_matricakSzama.HasValue && _matricakSzama > 0)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="flex-grow-1">
                                <b>@_matricakSzama db</b> matrica
                            </MudAlert>
                        }
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
                            Minősítő irat (3. oldal)
                        </MudText>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Érvényességi feltételek:</MudText>
                        <MudStack Spacing="1">
                            <MudCheckBox @bind-Value="_adatok.ErvenyessegMegrendeles" Dense="true"
                                         Label="A vizsgálat kizárólag a megrendelésben részletezett villamos-szerkezetekre terjed ki."
                                         Color="Color.Primary" />
                            <MudCheckBox @bind-Value="_adatok.ErvenyessegBelsoSzabalyzat" Dense="true"
                                         Label="A felhasználói belső szabályzatban részletezett rendeltetésszerű használat."
                                         Color="Color.Primary" />
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                            <MudText>Jelen minősítő irat érvényes</MudText>
                            <MudDatePicker @bind-Date="_adatok.ErvenyessegDatum" Variant="Variant.Outlined"
                                           DateFormat="yyyy.MM.dd" Style="max-width: 180px;" Margin="Margin.Dense" />
                            <MudText>-ig, vagy a berendezésen történt első beavatkozásig!</MudText>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Az érvényességi feltételek betartása esetén a villamos berendezés következő időszakos felülvizsgálatát:
                        </MudText>
                        <MudRadioGroup T="string" @bind-Value="_adatok.KovetkezoFelulvizsgalatTipus">
                            <MudStack Spacing="1">
                                <MudRadio T="string" Value="@("50kW")" Color="Color.Primary" Dense="true">
                                    az épületnek nem minősülő műtárgy <strong>50 kW</strong>-ot meghaladó csatlakozási teljesítményű villamos berendezésén
                                </MudRadio>
                                <MudRadio T="string" Value="@("32A")" Color="Color.Primary" Dense="true">
                                    a fázisonként <strong>32 A</strong>-nél nagyobb névleges áramerősségű túráramvédelemmel korlátozott villamos berendezésén
                                </MudRadio>
                                <MudRadio T="string" Value="@("VMBSZ")" Color="Color.Primary" Dense="true">
                                    a <strong>VMBSZ</strong> szerint lakóépület, kommunális épület, valamint egyéb épület villamos berendezésén
                                </MudRadio>
                                <MudRadio T="string" Value="@("RV300")" Color="Color.Primary" Dense="true">
                                    <strong>≥300 kg/l</strong> robbanásveszélyes (RV) osztályú anyagot tartalmazó helyiségekben
                                </MudRadio>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudRadio T="string" Value="@("EGYEB1")" Color="Color.Primary" Dense="true">egyéb:</MudRadio>
                                    <MudTextField @bind-Value="_adatok.KovetkezoFelulvizsgalatEgyeb"
                                                  Variant="Variant.Outlined"
                                                  Disabled="@(_adatok.KovetkezoFelulvizsgalatTipus != "EGYEB1")"
                                                  Style="max-width: 350px;" Margin="Margin.Dense" />
                                </MudStack>
                            </MudStack>
                        </MudRadioGroup>
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">a kiadási dátumtól számított:</MudText>
                        <MudRadioGroup T="string" Value="_adatok.HataridoTipus" ValueChanged="OnHataridoTipusValtozas">
                            <MudStack Spacing="1">
                                <MudRadio T="string" Value="@("3EV")" Color="Color.Primary" Dense="true">
                                    <strong>3 éven</strong> belül, legkésőbb: <strong>@GetSzamitottDatum(3)</strong>-ig kell elvégezni.
                                </MudRadio>
                                <MudRadio T="string" Value="@("LAKAS")" Color="Color.Primary" Dense="true">
                                    lakóépületek villamos berendezésén - <strong>6 éven</strong> belül: <strong>@GetSzamitottDatum(6)</strong>-ig
                                </MudRadio>
                                <MudRadio T="string" Value="@("RV")" Color="Color.Primary" Dense="true">
                                    egyéb (RV osztályú anyagot NEM tartalmazó) helyiségekben
                                </MudRadio>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudRadio T="string" Value="@("EGYEB2")" Color="Color.Primary" Dense="true">egyéb:</MudRadio>
                                    <MudTextField @bind-Value="_adatok.HataridoEgyeb"
                                                  Variant="Variant.Outlined"
                                                  Disabled="@(_adatok.HataridoTipus != "EGYEB2")"
                                                  Style="max-width: 350px;" Margin="Margin.Dense" />
                                </MudStack>
                            </MudStack>
                        </MudRadioGroup>
                    </MudItem>

                    <MudItem xs="12" md="4" Class="mt-3">
                        <MudDatePicker @bind-Date="_adatok.KovetkezoFelulvizsgalatDatum"
                                       Label="Következő felülvizsgálat határideje"
                                       Variant="Variant.Outlined" DateFormat="yyyy.MM.dd"
                                       HelperText="Automatikusan számított, de módosítható" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudTextField @bind-Value="_adatok.MinositoMegjegyzes"
                                      Label="Megjegyzések, észrevételek, javaslatok"
                                      Variant="Variant.Outlined" Lines="3"
                                      Placeholder="pl. Jelen felülvizsgálat kizárólag az újonnan felszerelt kútoszlopra terjed ki." />
                    </MudItem>
                }

                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="Lepes3ValidalasEsTovabbAsync"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Tovább a letöltéshez
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>

    @* === 4. LÉPÉS: ELŐNÉZET ÉS LETÖLTÉS === *@
    <MudStep Title="Letöltés" Icon="@Icons.Material.Filled.Download">
        <MudPaper Class="pa-4">
            <MudSimpleTable Dense="true" Bordered="true" Class="mb-4">
                <tbody>
                    <tr><td><strong>Jegyzőkönyv száma</strong></td><td>@_adatok.JegyzokonyvSzam</td></tr>
                    <tr><td><strong>Ügyfél</strong></td><td>@_adatok.Megrendelo</td></tr>
                    <tr><td><strong>Helyszín</strong></td><td>@_adatok.VizsgalatHelye</td></tr>
                    <tr><td><strong>Felelős felülvizsgáló</strong></td><td>@_adatok.FelulvizsgaloNev</td></tr>
                    <tr><td><strong>Bizonyítványok</strong></td><td>@_adatok.FelulvizsgaloBizonyitvany</td></tr>
                    <tr>
                        <td><strong>Eredmény</strong></td>
                        <td><MudChip T="string" Color="@(_adatok.Eredmeny == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.Eredmeny</MudChip></td>
                    </tr>
                    <tr>
                        <td><strong>Végső minősítés</strong></td>
                        <td><MudChip T="string" Color="@(_adatok.VegsoMinosites == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.VegsoMinosites</MudChip></td>
                    </tr>
                    @if (IsHordozhatoTipus() && _matricakSzama.HasValue)
                    {
                        <tr><td><strong>Matricák</strong></td><td>@_matricakSzama db (@_adatok.MatricaSorszamTol - @_adatok.MatricaSorszamIg)</td></tr>
                    }
                    @if (VanKitoltottHiba())
                    {
                        <tr><td><strong>Rögzített hibák</strong></td><td>@GetHibakOsszegzes()</td></tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudStack Row="true" Spacing="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Download" OnClick="LetoltesAsync"
                           Disabled="_feldolgozas">
                    @(_feldolgozas ? "Generálás..." : "Letöltés (Word)")
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudStep>
</MudStepper>

@code {
    [Parameter] public int? MeresId { get; set; }

    private MudStepper _stepper = null!;
    private List<MeresTipus> _tipusok = [];
    private List<Ugyfel> _ugyfelek = [];
    private List<Telephely> _telephelyek = [];
    private List<Telephely> _szurtTelephelyek = [];

    private int _kivalasztottTipusId;
    private string? _kivalasztottTipusNev;
    private int _kivalasztottUgyfelId;
    private int _kivalasztottTelephelyId;
    private DateTime? _vizsgalatDatum = DateTime.Today;
    private bool _feldolgozas;

    private JegyzokonyvAdatok _adatok = new();

    private List<Felulvizsgalo> _osszFelulvizsgalo = [];
    private List<Felulvizsgalo> _jogosultFelulvizsgalok = [];

    private int? _kivalasztottFelulvizsgaloId;
    private int? _kivalasztottSegitoId;

    private int? _matricaSorszamTol;
    private int? _matricaSorszamIg;
    private bool _matricaValidaciosHiba;
    private string _matricaHibaSzoveg = "";
    private int? _matricakSzama;
    private List<Eszkoz> _muszerek = [];
    private string? _cegMatricaElotag;

    protected override async Task OnInitializedAsync()
    {
        _tipusok = await MeresTipusService.GetAllAsync();
        _ugyfelek = await UgyfelService.GetAllAsync();
        _telephelyek = await TelephelyService.GetAllAsync();
        _osszFelulvizsgalo = await FelulvizsgaloService.GetAllAsync();
        _muszerek = await EszkozService.GetAllAsync();

        await BetoltCegAdatokAsync();

        _adatok.Eredmeny = "MEGFELELT";
        _adatok.VegsoMinosites = "MEGFELELT";

        var cegId = TenantService.GetCurrentCegId();
        var munkaszam = await MunkaszamService.GeneralKovetkezoMunkaszamAsync(cegId);
        _adatok.Munkaszam = munkaszam;
        _adatok.JegyzokonyvSzam = munkaszam;

        var ceg = await CegService.GetByIdAsync(cegId);
        _cegMatricaElotag = ceg?.MatricaElotag;

        if (MeresId.HasValue)
            await BetoltMeresbolAsync(MeresId.Value);
    }

    private async Task OnTipusValtozas(int tipusId)
    {
        _kivalasztottTipusId = tipusId;
        var tipus = _tipusok.FirstOrDefault(t => t.Id == tipusId);
        _kivalasztottTipusNev = tipus?.Nev;

        if (tipusId > 0)
            _jogosultFelulvizsgalok = await JuegosultsagService.GetJogosultFelulvizsgalokAsync(tipusId);
        else
            _jogosultFelulvizsgalok = _osszFelulvizsgalo;
    }

    private void OnUgyfelValtozas(int ugyfelId)
    {
        _kivalasztottUgyfelId = ugyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == ugyfelId).ToList();
        _kivalasztottTelephelyId = _szurtTelephelyek.FirstOrDefault()?.Id ?? 0;

        var ugyfel = _ugyfelek.FirstOrDefault(u => u.Id == ugyfelId);
        if (ugyfel != null)
            _adatok.Megrendelo = ugyfel.Nev;
    }

    private async Task ValidalasEsTovabblepesAsync()
    {
        if (_kivalasztottTipusId == 0) { Snackbar.Add("Válassz jegyzőkönyv típust!", Severity.Warning); return; }
        if (_kivalasztottUgyfelId == 0) { Snackbar.Add("Válassz ügyfelet!", Severity.Warning); return; }
        if (_kivalasztottTelephelyId == 0) { Snackbar.Add("Válassz telephelyet!", Severity.Warning); return; }
        if (_vizsgalatDatum == null) { Snackbar.Add("Add meg a vizsgálat dátumát!", Severity.Warning); return; }

        var telephely = _telephelyek.FirstOrDefault(t => t.Id == _kivalasztottTelephelyId);
        if (telephely != null)
            _adatok.VizsgalatHelye = $"{telephely.Nev} - {telephely.Cim}";

        await _stepper.NextStepAsync();
    }

    private async Task Lepes2ValidalasEsTovabbAsync()
    {
        if (_kivalasztottFelulvizsgaloId == null) { Snackbar.Add("Válassz felelős felülvizsgálót!", Severity.Warning); return; }
        if (string.IsNullOrEmpty(_adatok.Eredmeny)) { Snackbar.Add("Add meg a vizsgálat eredményét!", Severity.Warning); return; }

        await _stepper.NextStepAsync();
    }

    private async Task Lepes3ValidalasEsTovabbAsync()
    {
        if (IsHordozhatoTipus())
        {
            MatricaValidalas();
            if (_matricaValidaciosHiba)
            {
                Snackbar.Add(_matricaHibaSzoveg, Severity.Warning);
                return;
            }
        }

        await _stepper.NextStepAsync();
    }

    private bool IsHordozhatoTipus()
    {
        if (string.IsNullOrEmpty(_kivalasztottTipusNev)) return false;
        return _kivalasztottTipusNev.Contains("Hordozható", StringComparison.OrdinalIgnoreCase) ||
               _kivalasztottTipusNev.Contains("E+G", StringComparison.OrdinalIgnoreCase);
    }

    private void OnEredmenyValtozas(string eredmeny)
    {
        _adatok.Eredmeny = eredmeny;
        _adatok.VegsoMinosites = eredmeny;
    }

    private Task OnFelulvizsgaloValtozasAsync(int? felulvizsgaloId)
    {
        _kivalasztottFelulvizsgaloId = felulvizsgaloId;

        if (felulvizsgaloId.HasValue)
        {
            var felulvizsgalo = _jogosultFelulvizsgalok.FirstOrDefault(f => f.Id == felulvizsgaloId.Value);
            if (felulvizsgalo != null)
            {
                _adatok.FelulvizsgaloNev = felulvizsgalo.Nev;
                _adatok.FelulvizsgaloBizonyitvany = string.Join(", ",
                    felulvizsgalo.Kepzesek.Where(k => !string.IsNullOrEmpty(k.BizonyitvanySzam)).Select(k => k.BizonyitvanySzam));
                _adatok.FelulvizsgaloKepzes = string.Join(", ",
                    felulvizsgalo.Kepzesek.Where(k => k.KepzesTipus != null).Select(k => k.KepzesTipus!.Nev));
            }
        }
        else
        {
            _adatok.FelulvizsgaloNev = "";
            _adatok.FelulvizsgaloBizonyitvany = "";
            _adatok.FelulvizsgaloKepzes = "";
        }
        return Task.CompletedTask;
    }

    private Task OnSegitoValtozasAsync(int? segitoId)
    {
        _kivalasztottSegitoId = segitoId;

        if (segitoId.HasValue)
        {
            var segito = _jogosultFelulvizsgalok.FirstOrDefault(f => f.Id == segitoId.Value);
            if (segito != null)
            {
                _adatok.SegitoFelulvizsgalo = segito.Nev;
                _adatok.SegitoBizonyitvany = string.Join(", ",
                    segito.Kepzesek.Where(k => !string.IsNullOrEmpty(k.BizonyitvanySzam)).Select(k => k.BizonyitvanySzam));
                _adatok.SegitoKepzes = string.Join(", ",
                    segito.Kepzesek.Where(k => k.KepzesTipus != null).Select(k => k.KepzesTipus!.Nev));
            }
        }
        else
        {
            _adatok.SegitoFelulvizsgalo = "";
            _adatok.SegitoBizonyitvany = "";
            _adatok.SegitoKepzes = "";
        }
        return Task.CompletedTask;
    }

    private Task<IEnumerable<string>> EllenorKereses(string value, CancellationToken token)
    {
        var nevek = _osszFelulvizsgalo.Where(f => f.LehetEllenor).Select(f => f.Nev).ToList();
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<string>>(nevek);
        return Task.FromResult<IEnumerable<string>>(nevek.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task LetoltesAsync()
    {
        try
        {
            _feldolgozas = true;
            StateHasChanged();

            var meresId = MeresId ?? 0;
            var tipus = _tipusok.FirstOrDefault(t => t.Id == _kivalasztottTipusId);
            var sablonId = tipus?.SablonId ?? "VBF_KIF_MINTA";

            var wordBytes = await JegyzokonyvWordService.GeneralasAsync(meresId, _adatok, sablonId);
            var fileName = $"{_adatok.JegyzokonyvSzam.Replace("/", "-")}.docx";

            using var streamRef = new DotNetStreamReference(new MemoryStream(wordBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Snackbar.Add("Jegyzőkönyv sikeresen legenerálva!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba történt: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

    private async Task BetoltCegAdatokAsync()
    {
        try
        {
            var cegId = TenantService.GetCurrentCegId();
            if (cegId > 0)
            {
                var ceg = await CegService.GetByIdAsync(cegId);
                if (ceg != null)
                {
                    _adatok.CegNev = ceg.Nev ?? "";
                    _adatok.CegCim = ceg.Cim ?? "";
                    _adatok.CegWeb = ceg.Weboldal ?? "";
                    _adatok.CegTelefon = ceg.Telefon ?? "";
                }
            }
        }
        catch
        {
            _adatok.CegNev = "";
            _adatok.CegCim = "";
        }
    }

    private async Task BetoltMeresbolAsync(int meresId)
    {
        var meres = await MeresService.GetByIdAsync(meresId);
        if (meres != null)
        {
            _kivalasztottTipusId = meres.MeresTipusId;
            _kivalasztottUgyfelId = meres.UgyfelId;
            _kivalasztottTelephelyId = meres.TelephelyId;
            _vizsgalatDatum = meres.Datum;

            await OnTipusValtozas(_kivalasztottTipusId);
            OnUgyfelValtozas(_kivalasztottUgyfelId);
        }
    }

    private void OnHataridoTipusValtozas(string tipus)
    {
        _adatok.HataridoTipus = tipus;
        _adatok.KovetkezoFelulvizsgalatDatum = tipus switch
        {
            "3EV" => _vizsgalatDatum?.AddYears(3),
            "LAKAS" => _vizsgalatDatum?.AddYears(6),
            _ => _adatok.KovetkezoFelulvizsgalatDatum
        };
    }

    private string GetSzamitottDatum(int evek) => _vizsgalatDatum?.AddYears(evek).ToString("yyyy.MM.dd") ?? "-";

    private bool VanKitoltottHiba() =>
        !string.IsNullOrWhiteSpace(_adatok.HibakB) ||
        !string.IsNullOrWhiteSpace(_adatok.HibakC) ||
        !string.IsNullOrWhiteSpace(_adatok.HibakD) ||
        !string.IsNullOrWhiteSpace(_adatok.HibakE);

    private string GetHibakOsszegzes()
    {
        var hibak = new List<string>();
        if (!string.IsNullOrWhiteSpace(_adatok.HibakB)) hibak.Add("B: Életveszélyes");
        if (!string.IsNullOrWhiteSpace(_adatok.HibakC)) hibak.Add("C: Súlyos");
        if (!string.IsNullOrWhiteSpace(_adatok.HibakD)) hibak.Add("D: Karbantartás");
        if (!string.IsNullOrWhiteSpace(_adatok.HibakE)) hibak.Add("E: Felújítás");
        return string.Join(", ", hibak);
    }

    private string GetTeljesMatricaSzam(int? sorszam)
    {
        if (!sorszam.HasValue || string.IsNullOrWhiteSpace(_cegMatricaElotag))
            return "";
        return $"{_cegMatricaElotag}{sorszam.Value:D7}";
    }

    private void MatricaValidalas()
    {
        if (!_matricaSorszamTol.HasValue && !_matricaSorszamIg.HasValue)
        {
            _matricaValidaciosHiba = false;
            _matricaHibaSzoveg = "";
            _matricakSzama = null;
            return;
        }

        if (!_matricaSorszamTol.HasValue || !_matricaSorszamIg.HasValue)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = "Mindkét matrica sorszámot meg kell adni!";
            _matricakSzama = null;
            return;
        }

        if (_matricaSorszamTol.Value > _matricaSorszamIg.Value)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = "A 'tól' érték nem lehet nagyobb mint az 'ig' érték!";
            _matricakSzama = null;
            return;
        }

        var matricakSzama = _matricaSorszamIg.Value - _matricaSorszamTol.Value + 1;

        // Javított validáció: ha van matrica de nincs eszköz, vagy több a matrica
        if (_adatok.Eszkozok.Count == 0)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = "Nincs eszköz megadva a matricákhoz!";
            _matricakSzama = matricakSzama;
            return;
        }

        if (matricakSzama > _adatok.Eszkozok.Count)
        {
            _matricaValidaciosHiba = true;
            _matricaHibaSzoveg = $"Több matrica ({matricakSzama} db) van megadva mint eszköz ({_adatok.Eszkozok.Count} db)!";
            _matricakSzama = matricakSzama;
            return;
        }

        _matricaValidaciosHiba = false;
        _matricaHibaSzoveg = "";
        _matricakSzama = matricakSzama;

        _adatok.MatricaSorszamTol = GetTeljesMatricaSzam(_matricaSorszamTol);
        _adatok.MatricaSorszamIg = GetTeljesMatricaSzam(_matricaSorszamIg);
    }

    private void OnEszkozokValtozas(List<HordozhatoEszkozSor> eszkozok)
    {
        _adatok.Eszkozok = eszkozok;
        MatricaValidalas();
    }
}
