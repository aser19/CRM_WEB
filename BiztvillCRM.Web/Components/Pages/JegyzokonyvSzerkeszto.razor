    private bool IsHordozhatoTipus()
    {
        if (string.IsNullOrEmpty(_kivalasztottTipusNev)) return false;
        return _kivalasztottTipusNev.Contains("Hordozható", StringComparison.OrdinalIgnoreCase) ||
               _kivalasztottTipusNev.Contains("E+G", StringComparison.OrdinalIgnoreCase);
    }

    private void OnEredmenyValtozas(string eredmeny)
    {
        _adatok.Eredmeny = eredmeny;
        _adatok.VegsoMinosites = eredmeny;
    }

    private Task OnFelulvizsgaloValtozasAsync(int? felulvizsgaloId)
    {
        _kivalasztottFelulvizsgaloId = felulvizsgaloId;

        if (felulvizsgaloId.HasValue)
        {
            var felulvizsgalo = _jogosultFelulvizsgalok.FirstOrDefault(f => f.Id == felulvizsgaloId.Value);
            if (felulvizsgalo != null)
            {
                _adatok.FelulvizsgaloNev = felulvizsgalo.Nev;
                _adatok.FelulvizsgaloBizonyitvany = string.Join(", ",
                    felulvizsgalo.Kepzesek
                        .Where(k => !string.IsNullOrEmpty(k.BizonyitvanySzam))
                        .Select(k => k.BizonyitvanySzam));
                _adatok.FelulvizsgaloKepzes = string.Join(", ",
                    felulvizsgalo.Kepzesek
                        .SelectMany(k => k.Tovabbkepzesek)
                        .Where(t => !string.IsNullOrEmpty(t.BizonyitvanySzam))
                        .Select(t => t.BizonyitvanySzam));
            }
        }
        else
        {
            _adatok.FelulvizsgaloNev = "";
            _adatok.FelulvizsgaloBizonyitvany = "";
            _adatok.FelulvizsgaloKepzes = "";
        }
        return Task.CompletedTask;
    }

    private Task OnSegitoValtozasAsync(int? segitoId)
    {
        _kivalasztottSegitoId = segitoId;

        if (segitoId.HasValue)
        {
            var segito = _jogosultFelulvizsgalok.FirstOrDefault(f => f.Id == segitoId.Value);
            if (segito != null)
            {
                _adatok.SegitoFelulvizsgalo = segito.Nev;
                _adatok.SegitoBizonyitvany = string.Join(", ",
                    segito.Kepzesek
                        .Where(k => !string.IsNullOrEmpty(k.BizonyitvanySzam))
                        .Select(k => k.BizonyitvanySzam));
                _adatok.SegitoKepzes = string.Join(", ",
                    segito.Kepzesek
                        .SelectMany(k => k.Tovabbkepzesek)
                        .Where(t => !string.IsNullOrEmpty(t.BizonyitvanySzam))
                        .Select(t => t.BizonyitvanySzam));
            }
        }
        else
        {
            _adatok.SegitoFelulvizsgalo = "";
            _adatok.SegitoBizonyitvany = "";
            _adatok.SegitoKepzes = "";
        }
        return Task.CompletedTask;
    }

    private Task<IEnumerable<string>> EllenorKereses(string value, CancellationToken token)
    {
        var nevek = _osszFelulvizsgalo.Where(f => f.LehetEllenor).Select(f => f.Nev).ToList();
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<string>>(nevek);
        return Task.FromResult<IEnumerable<string>>(nevek.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task LetoltesAsync()
    {
        try
        {
            _feldolgozas = true;
            StateHasChanged();

            var tipus = _tipusok.FirstOrDefault(t => t.Id == _kivalasztottTipusId);
            var sablonId = _kivalasztottSablonId;

            int meresId;
            if (!MeresId.HasValue || MeresId == 0)
            {
                if (_ujonnanMentettMeresId.HasValue)
                {
                    // Már el lett mentve korábban (pl. 2. letöltésnél)
                    meresId = _ujonnanMentettMeresId.Value;
                    await MeresService.MentesJegyzokonyvAdatokkalAsync(meresId, _adatok);
                }
                else
                {
                    // Első mentés
                    var ujMeres = new Meres
                    {
                        UgyfelId = _kivalasztottUgyfelId,
                        TelephelyId = _kivalasztottTelephelyId,
                        MeresTipusId = _kivalasztottTipusId,
                        Datum = _vizsgalatDatum ?? DateTime.Today,
                        MeresStatusz = MeresStatusz.Elvegezve,
                        JegyzokonyvAdatokJson = System.Text.Json.JsonSerializer.Serialize(_adatok)
                    };
                    ujMeres = await MeresService.CreateAsync(ujMeres);
                    meresId = ujMeres.Id;
                    _ujonnanMentettMeresId = meresId; // ← eltároljuk, nem navigálunk
                }
            }
            else
            {
                meresId = MeresId.Value;
                await MeresService.MentesJegyzokonyvAdatokkalAsync(meresId, _adatok);
            }

