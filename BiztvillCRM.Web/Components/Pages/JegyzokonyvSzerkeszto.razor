    private async Task MellekletMegnyitas(MellekletJegyzokonyv m)
    {
        // Jövőbeli típusok helye:
        // A meglévő MellekletMegnyitas metóduson belül, az AVK blokk UTÁN:
        if (m.Tipus == "HVM")
        {
            Navigation.NavigateTo($"/hvm-szerkeszto/{m.Id}");
            return;
        }

        // Alapértelmezett: ha van melléklet-mérés, a főwizardba navigálunk
        if (m.MellekletMeresId.HasValue)
        {
            Navigation.NavigateTo($"/jegyzokonyv/{m.MellekletMeresId.Value}");
            return;
        }

        // Nincs még mérés — névalapon keresünk típust
        var meresTipusNev = m.Tipus switch
        {
            "HVM" => "Hibavédelmi mérés (Hurok)",
            "SZI" => "Szigetelési ellenállás mérés",
            "VVN" => "Villámvédelem (norma szerinti)",
            "VVN-NEM" => "Villámvédelem (nem norma)",
            _ => ""
        };

        var meresTipus = _osszesTipus.FirstOrDefault(t =>
            t.Nev.Equals(meresTipusNev, StringComparison.OrdinalIgnoreCase));

        if (meresTipus is null)
        {
            Snackbar.Add(
                $"A '{meresTipusNev}' mérés típus nincs felvéve! " +
                $"Add hozzá az Admin → Méréstípusok menüben.",
                Severity.Warning);
            return;
        }

        _feldolgozas = true;
        StateHasChanged();
        
        try
        {
            var meresId = await MellekletService.MellekletMeresLetrehozAsync(
                m.Id, meresTipus.Id, _adatok);
            Navigation.NavigateTo($"/jegyzokonyv/{meresId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

