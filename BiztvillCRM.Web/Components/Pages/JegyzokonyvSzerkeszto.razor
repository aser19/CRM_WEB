                            <tr><td><strong>Ügyfél</strong></td><td>@_adatok.Megrendelo</td></tr>
                            <tr><td><strong>Helyszín</strong></td><td>@_adatok.VizsgalatHelye</td></tr>
                            <tr><td><strong>Felelős felülvizsgáló</strong></td><td>@_adatok.FelulvizsgaloNev</td></tr>
                            <tr><td><strong>Bizonyítványok</strong></td><td>@_adatok.FelulvizsgaloBizonyitvany</td></tr>
                            <tr>
                                <td><strong>Eredmény</strong></td>
                                <td><MudChip T="string" Color="@(_adatok.Eredmeny == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.Eredmeny</MudChip></td>
                            </tr>
                            <tr>
                                <td><strong>Végső minősítés</strong></td>
                                <td><MudChip T="string" Color="@(_adatok.VegsoMinosites == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.VegsoMinosites</MudChip></td>
                            </tr>
                            @if (IsHordozhatoTipus() && _matricakSzama.HasValue)
                            {
                                <tr><td><strong>Matricák</strong></td><td>@_matricakSzama db (@_adatok.MatricaSorszamTol - @_adatok.MatricaSorszamIg)</td></tr>
                            }
                            @if (VanKitoltottHiba())
                            {
                                <tr><td><strong>Rögzített hibák</strong></td><td>@GetHibakOsszegzes()</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="LetoltesAsync"
                               Disabled="_feldolgozas">
                        @(_feldolgozas ? "Generálás..." : "Letöltés (Word)")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStep>
</MudStepper>

@* ✅ JAVÍTÁS: Csak akkor jelenjen meg, ha van importált eszköz *@
@if (importAdatok.Eszkozok.Any())
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2" />
            Importált eszközök előnézete
        </MudText>
        
        <MudDataGrid Items="@importAdatok.Eszkozok" Groupable="true" GroupExpanded="true">
            <Columns>
                <TemplateColumn Title="Megnevezés">
                    <CellTemplate>
                        @if (context.Item.CsoportSorrend > 0)
                        {
                            <div style="padding-left: 30px;">
                                <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" />
