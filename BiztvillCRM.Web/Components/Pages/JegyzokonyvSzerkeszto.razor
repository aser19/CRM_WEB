    private async Task BetoltMeresbolAsync(int meresId)
    {
        var meres = await MeresService.GetByIdAsync(meresId);
        if (meres != null)
        {
            _kivalasztottTipusId = meres.MeresTipusId;
            _kivalasztottUgyfelId = meres.UgyfelId;
            _kivalasztottTelephelyId = meres.TelephelyId;
            _vizsgalatDatum = meres.Datum;

            await OnTipusValtozas(_kivalasztottTipusId);
            OnUgyfelValtozas(_kivalasztottUgyfelId);

            // ✅ JEGYZŐKÖNYV ADATOK BETÖLTÉSE
            if (!string.IsNullOrEmpty(meres.JegyzokonyvAdatokJson))
            {
                try
                {
                    var mentettAdatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
                        meres.JegyzokonyvAdatokJson,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );
                    
                    if (mentettAdatok != null)
                    {
                        _adatok = mentettAdatok;
                        
                        // Ha nincs MeresiPontok lista, inicializáljuk
                        _adatok.MeresiPontok ??= new List<MeresiPontSor>();
                        
                        // Felülvizsgálók újra-beállítása (ID alapján)
                        var felelosNev = _adatok.FelulvizsgaloNev;
                        var segitoNev = _adatok.SegitoFelulvizsgalo;
                        
                        _kivalasztottFelulvizsgaloId = _jogosultFelulvizsgalok
                            .FirstOrDefault(f => f.Nev == felelosNev)?.Id;
                        _kivalasztottSegitoId = _jogosultFelulvizsgalok
                            .FirstOrDefault(f => f.Nev == segitoNev)?.Id;

                        await OnFelulvizsgaloValtozasAsync(_kivalasztottFelulvizsgaloId);
                        await OnSegitoValtozasAsync(_kivalasztottSegitoId);

                        // Matricák visszatöltése
                        if (!string.IsNullOrEmpty(_adatok.MatricaSorszamTol))
                        {
                            var tolSzoveg = _adatok.MatricaSorszamTol.Replace(_cegMatricaElotag ?? "", "");
                            if (int.TryParse(tolSzoveg, out int tol))
                                _matricaSorszamTol = tol;
                        }
                        if (!string.IsNullOrEmpty(_adatok.MatricaSorszamIg))
                        {
                            var igSzoveg = _adatok.MatricaSorszamIg.Replace(_cegMatricaElotag ?? "", "");
                            if (int.TryParse(igSzoveg, out int ig))
                                _matricaSorszamIg = ig;
                        }
                        // Muszerek null-check
                        _adatok.Muszerek ??= new List<MuszerSor>();

                        // _kivalasztottMuszerIds visszatöltése a mentett EszkozId alapján
                        _kivalasztottMuszerIds = new List<int?> { null, null, null };
                        for (int i = 0; i < _adatok.Muszerek.Count && i < 3; i++)
                        {
                            _kivalasztottMuszerIds[i] = _adatok.Muszerek[i].EszkozId;
                        }
                        Snackbar.Add("Korábban mentett adatok betöltve!", Severity.Info);
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Hiba a jegyzőkönyv adatok betöltése során: {ex.Message}", Severity.Warning);
                }
            }
        }
    }

