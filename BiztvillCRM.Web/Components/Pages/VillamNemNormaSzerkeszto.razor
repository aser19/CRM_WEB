@page "/villam-nem-norma-szerkeszto"
@page "/villam-nem-norma-szerkeszto/{MeresId:int}"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject ITenantService TenantService
@inject ICegService CegService
@inject IFelulvizsgaloService FelulvizsgaloService
@inject IJogszabalyService JogszabalyService
@inject IMeresTipusService MeresTipusService
@inject IVillamNemNormaPdfService VillamNemNormaPdfService
@inject IFileStorageService FileStorageService
@inject IMeresService MeresService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Nem Norma szerinti Villámvédelmi Minősítő Irat</PageTitle>

@if (_betoltes)
{
    <MudProgressCircular Indeterminate="true" Class="mt-8" />
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Class="mr-2" />
            Nem Norma szerinti Villámvédelmi Minősítő Irat
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="VisszaMegerositessel">Vissza</MudButton>
    </MudStack>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Megrendelő / Megbízás adatai</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            A megrendelő és megbízás adatait már a jegyzőkönyv főlapján megadtad, azokat innen automatikusan átvesszük.
        </MudAlert>
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_adatok.MegrendeloNev" Label="Megbízó neve" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_adatok.MegrendeloCim" Label="Megbízó címe" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_adatok.MegbizasTargya" Label="A megbízás tárgya" Lines="2" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_adatok.MegrendeloKepviseloje" Label="Megbízó képviselője" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_meresIdeje" Label="Mérés ideje" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Felülvizsgálók</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            A felülvizsgálók adatait már a jegyzőkönyv főlapján megadtad, azokat innen automatikusan átvesszük.
        </MudAlert>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_adatok.FelulvizsgaloNev" Label="Felelős felülvizsgáló" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_adatok.SegitoFelulvizsgalo" Label="Segítő felülvizsgáló" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_adatok.Ellenor" Label="Ellenőr" ReadOnly="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">1. Bevezetés</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_adatok.KikeszitetteSzerep" Label="1.1 Kikészítette">
                    <MudSelectItem Value="@("Felelos")">Felelős felülvizsgáló</MudSelectItem>
                    <MudSelectItem Value="@("Segito")">Segítő felülvizsgáló</MudSelectItem>
                    <MudSelectItem Value="@("Ellenor")">Ellenőr</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.RendelkezesreBocsatottDokumentaciok" Label="1.2 A rendelkezésre bocsátott dokumentációk"
                              Lines="3" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mb-1 mt-4">1.3 A vizsgálatnál figyelembe vett rendeletek és szabványok</MudText>
        @if (!_villamJogszabalyok.Any())
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Ehhez a méréstípushoz még nincsenek rendeletek/szabványok hozzárendelve. Vedd fel őket az Admin &gt; Mérés típusok oldalon, ennél a méréstípusnál.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="1">
                @foreach (var j in _adatok.KijeloltJogszabalyok.OrderBy(x => x.IsSzabvany).ThenBy(x => x.Szam))
                {
                    <MudItem xs="12" md="6" Style="display:flex;align-items:flex-start;">
                        <MudCheckBox @bind-Value="j.Kivalasztva" Color="Color.Primary" Dense="true">
                            <span style="font-size:0.8rem;line-height:1.3;"><strong>@j.Szam</strong> – @j.Cim</span>
                        </MudCheckBox>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudItem xs="12" Class="mt-3">
            <MudCheckBox @bind-Value="_adatok.NincsEredetiTervdokumentacio" Color="Color.Primary">
                A létesítmény eredeti műszaki kiírással nem rendelkezik
            </MudCheckBox>
        </MudItem>
        @if (_adatok.NincsEredetiTervdokumentacio)
        {
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_adatok.LetesitmenyEpitesEve" Label="A létesítmény építésének éve" />
            </MudItem>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">2. A vizsgálat módszerei</MudText>
        <MudText Typo="Typo.subtitle2" Class="mb-2">2.1 Villámvédelmi besorolás meghatározása</MudText>

        <MudSimpleTable Dense="true">
            <thead>
                <tr>
                    <th>Megnevezés</th>
                    <th>Besorolás</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sor in _adatok.VillamBesorolasSorok)
                {
                    <tr>
                        <td>
                            @sor.Megnevezes
                            @if (sor.SzempontKod == "Magassag")
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info"
                                               OnClick="MagassagiBesorolasMegjelenitese" />
                            }
                            @if (sor.SzempontKod == "TetoAnyaga")
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info"
                                               OnClick="TetoAnyagBesorolasMegjelenitese" />
                            }
                            @if (sor.SzempontKod == "MasodlagosHatas")
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info"
                                               OnClick="MasodlagosHatasBesorolasMegjelenitese" />
                            }
                        </td>
                        <td style="min-width:260px;">
                            <MudSelect T="string" Value="@sor.Besorolas" ValueChanged="@((string v) => BesorolasSorValtozott(sor, v))" Dense="true">
                                @foreach (var kv in VillamBesorolasKodok.GetKodok(sor.SzempontKod))
                                {
                                    <MudSelectItem Value="@kv.Key">
                                        <MudTooltip Text="@kv.Value" Placement="Placement.Right">
                                            <span><strong>@kv.Key</strong> – @kv.Value</span>
                                        </MudTooltip>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">2.2 Szemrevételezés</MudText>
        <MudTextField @bind-Value="_adatok.SzemrevetelezesLeiras" Label="Szemrevételezés leírása" Variant="Variant.Outlined"
                      Lines="2" AutoGrow="true" Class="mb-3" />

        <MudText Typo="Typo.body2" Class="mb-2">Szemrevételezéssel vizsgálva lett ezen kívül:</MudText>
        <MudGrid Spacing="1">
            @foreach (var t in _adatok.SzemrevetelezesTetelek)
            {
                <MudItem xs="12" md="6" Style="display:flex;align-items:flex-start;">
                    <MudCheckBox @bind-Value="t.Kivalasztva" Color="Color.Primary" Dense="true">
                        @t.Megnevezes
                    </MudCheckBox>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">2.3 Műszeres mérések</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            A használt műszerek adatait már a jegyzőkönyv főlapján megadtad, azokat innen automatikusan átvesszük.
        </MudAlert>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_adatok.Idojaras" Label="A mérés idején az időjárás" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.MeresKorulmenyeinekLeirasa" Label="A mérés körülményeinek rövid leírása"
                              Lines="4" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.MertErtekSzabvanySzerint" Label="Milyen szabvány szerint mi a mért érték"
                              Lines="2" Variant="Variant.Outlined" />

            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_adatok.MertErtek" Label="A mért érték" Variant="Variant.Outlined"
                              Adornment="Adornment.End" AdornmentText="Ω" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_adatok.MeresEredmenyeAllapot" Label="A felülvizsgálat eredménye" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("megfelelő")">megfelelő</MudSelectItem>
                    <MudSelectItem Value="@("nem megfelelő")">nem megfelelő</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">3.1 Az építmény vizsgálata</MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.OsszehasonlitasSzabvanySzerint" Label="Milyen szabvány szerint történt az összehasonlítás"
                              Lines="2" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_adatok.TuzveszelyessegiOsztaly" Label="Tűzveszélyességi osztályba sorolás" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_adatok.VillamvedelmiBesorolasEredmenye" Label="Villámvédelmi besorolás eredménye"
                              Variant="Variant.Outlined" ReadOnly="true"
                              HelperText="@(_osszesBesorolasKitoltve ? "Automatikusan frissül a 2.1 besorolás alapján" : "Töltsd ki a 2.1 pont összes besorolását a számításhoz")" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Az építmény elemenkénti besorolása</MudText>
        @{
            var elvartFelfogoFokozat = GetElvartFelfogoFokozat();
        }
        @if (!string.IsNullOrWhiteSpace(elvartFelfogoFokozat))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                A 2.1 pontban megadott besorolás (rendeltetés / magasság / tető anyaga) alapján az NNV-2020 4. táblázata szerint
                elvárt minimális felfogó fokozat: <strong>@elvartFelfogoFokozat</strong>. Csak a helyszínen talált fokozatot
                kell beírni, a megfelelőséget a rendszer automatikusan megállapítja.
            </MudAlert>
        }
        @{
            var levezetoAlternativak = GetLevezetoFoldelesAlternativak();
        }
        @if (levezetoAlternativak.Any())
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                A 2.1 pontban megadott besorolás (rendeltetés / magasság / körítő falak anyaga) alapján az NNV-2020
                táblázata szerint az alábbi levezető / földelés fokozat-kombinációk bármelyike elfogadható (a körítő
                falak anyaga szerinti oszlop - K1/K2/K3 - közül a helyszínen talált kialakításnak megfelelőt kell figyelembe venni;
                a földelés fokozatánál az "x" = nincs ellenállás-követelmény, az "r" = méréssel igazolandó szigorúbb követelmény):
                <ul class="mb-0">
                    @foreach (var alt in levezetoAlternativak)
                    {
                        <li>@alt</li>
                    }
                </ul>
            </MudAlert>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                Figyelembe veendő kiegészítő szabályok:
                <ul class="mb-0">
                    @foreach (var megjegyzes in LevezetoFoldelesFokozatTablazat.Megjegyzesek)
                    {
                        <li>@megjegyzes</li>
                    }
                </ul>
            </MudAlert>
        }
        <MudSimpleTable Dense="true">
            <thead>
                <tr>
                    <th>Megnevezés</th>
                    <th>Fokozat</th>
                    <th>Állapot</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sor in _adatok.ElemBesorolasSorok)
                {
                    <tr>
                        <td>@sor.Megnevezes</td>
                        <td style="min-width:160px;">
                            @if (sor.Megnevezes == "A meglévő felfogó állapota")
                            {
                                <MudSelect T="string" Value="@sor.Fokozat" ValueChanged="@((string v) => OnFelfogoFokozatValtozas(sor, v))" Dense="true"
                                           Placeholder="pl. V2a">
                                    @foreach (var kod in VillamBesorolasKodok.FelfogoFokozatok)
                                    {
                                        <MudSelectItem Value="@kod">@kod</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (sor.Megnevezes == "A meglévő levezető állapota")
                            {
                                <MudSelect T="string" Value="@sor.Fokozat" ValueChanged="@((string v) => OnLevezetoFokozatValtozas(sor, v))" Dense="true"
                                           Placeholder="pl. L2b">
                                    @foreach (var kod in VillamBesorolasKodok.LevezetoFokozatok)
                                    {
                                        <MudSelectItem Value="@kod">@kod</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (sor.Megnevezes == "A meglévő földelő állapota")
                            {
                                <MudSelect T="string" @bind-Value="sor.Fokozat" Dense="true">
                                    @foreach (var kod in VillamBesorolasKodok.FoldelesFokozatok)
                                    {
                                        <MudSelectItem Value="@kod">@kod</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (sor.Megnevezes == "A belső villámvédelem fokozata")
                            {
                                <MudSelect T="string" @bind-Value="sor.Fokozat" Dense="true">
                                    @foreach (var kod in VillamBesorolasKodok.BelsoVedelemFokozatok)
                                    {
                                        <MudSelectItem Value="@kod">@kod</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (sor.Megnevezes == "A felfogó, levezető és a földelés föld feletti részeinek szükséges méretfokozata")
                            {
                                <MudSelect T="string" @bind-Value="sor.Fokozat" Dense="true">
                                    <MudSelectItem Value="@("o")">o</MudSelectItem>
                                    <MudSelectItem Value="@("r")">r</MudSelectItem>
                                </MudSelect>
                            }
                            else if (sor.Megnevezes != "A belső villámvédelem kialakítása" && sor.Megnevezes != "A méretfokozat betartása")
                            {
                                <MudTextField @bind-Value="sor.Fokozat" Dense="true" />
                            }
                        </td>
                        <td style="min-width:180px;">
                            <MudSelect T="string" @bind-Value="sor.Allapot" Dense="true">
                                <MudSelectItem Value="@("megfelelő")">megfelelő</MudSelectItem>
                                <MudSelectItem Value="@("nem megfelelő")">nem megfelelő</MudSelectItem>
                                <MudSelectItem Value="@("ismeretlen")">ismeretlen</MudSelectItem>
                            </MudSelect>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudGrid Class="mt-3">
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_adatok.FelulvizsgalatErtekelese" Label="A felülvizsgálat értékelése" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("megfelelő")">megfelelő</MudSelectItem>
                    <MudSelectItem Value="@("nem megfelelő")">nem megfelelő</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.HibakHianyossagok" Label="3.2 A vizsgálat során tapasztalt hibák, hiányosságok"
                              Lines="3" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.EszrevetelekMegjegyzesek" Label="3.3 A felülvizsgálattal kapcsolatos észrevételek, megjegyzések"
                              Lines="3" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">3.4 Belső villámvédelem</MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudCheckBox @bind-Value="_adatok.BelsoVillamvedelemTartalmazza" Color="Color.Primary">
                    A megrendelés tartalmazza a belső villámvédelem vizsgálatát
                </MudCheckBox>
            </MudItem>
            @if (_adatok.BelsoVillamvedelemTartalmazza)
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="_adatok.BelsoVillamvedelemLeirasa" Label="Belső villámvédelem leírása"
                                  Lines="3" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_adatok.BelsoVillamvedelemAllapot" Label="Belső villámvédelem állapota" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("megfelelő")">megfelelő</MudSelectItem>
                        <MudSelectItem Value="@("nem megfelelő")">nem megfelelő</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">4. A villámvédelem általános minősítése</MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_adatok.AltalanosMinositesSzovege" Label="Az általános minősítés szövege"
                              Lines="3" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_adatok.AltalanosMinositesAllapot" Label="Az általános minősítés eredménye" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("megfelelő")">megfelelő</MudSelectItem>
                    <MudSelectItem Value="@("nem megfelelő")">nem megfelelő</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_kovetkezoFelulvizsgalat" Label="A következő villámvédelmi felülvizsgálat időpontja" DateFormat="yyyy.MM.dd" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">1. melléklet - Fényképek / skiccek (max. 5 db)</MudText>
        <MudGrid>
            @for (var i = 0; i < _adatok.FenykepPaths.Count; i++)
            {
                var index = i;
                var path = _adatok.FenykepPaths[index];
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-2" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@Path.GetFileName(path)</MudText>
                            </MudStack>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => FenykepTorlese(index))" Title="Törlés" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        @if (_adatok.FenykepPaths.Count < 5)
        {
            <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png" MaximumFileCount="1"
                           FilesChanged="FenykepFeltoltese" Class="mt-3">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload">
                        Fénykép feltöltése (@(_adatok.FenykepPaths.Count)/5)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Elérte a maximális 5 db fényképet.</MudText>
        }
    </MudPaper>

