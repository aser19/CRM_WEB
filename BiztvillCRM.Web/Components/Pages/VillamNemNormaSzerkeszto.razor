    {
        _feldolgozas = true;
        try
        {
            _adatok.MeresIdeje = _meresIdeje;
            _adatok.KovetkezoFelulvizsgalatIdopontja = _kovetkezoFelulvizsgalat;
            if (_adatok.MikorKeszult is null)
                _adatok.MikorKeszult = DateTime.Today;
            FrissitVillamvedelmiBesorolasEredmenye();

            if (MeresId.HasValue && MeresId.Value > 0)
            {
                var meres = await MeresService.GetByIdAsync(MeresId.Value);
                if (meres != null)
                {
                    meres.VillamNemNormaAdatokJson = System.Text.Json.JsonSerializer.Serialize(_adatok);
                    await MeresService.UpdateAsync(meres);
                    _marMentveVolt = true;
                }
            }

            byte[]? cegBelyegzoKep = null;
            var cegId = _adatok.CegId > 0 ? _adatok.CegId : TenantService.GetCurrentCegId();
            var ceg = await CegService.GetByIdAsync(cegId);
            if (!string.IsNullOrWhiteSpace(ceg?.BelyegzoPath))
            {
                cegBelyegzoKep = await FileStorageService.GetFileBytesAsync(ceg.BelyegzoPath);
            }

            byte[]? alairoAlairasKep = null;
            var alairoFelulvizsgalo = _felulvizsgalok.FirstOrDefault(f => f.Nev == _adatok.FelulvizsgaloNev);
            if (alairoFelulvizsgalo != null && !string.IsNullOrWhiteSpace(alairoFelulvizsgalo.AlairasPath))
            {
                alairoAlairasKep = await FileStorageService.GetFileBytesAsync(alairoFelulvizsgalo.AlairasPath);
            }

            // 1. melléklet - fényképek
            var fenykepek = new List<byte[]>();
            foreach (var path in _adatok.FenykepPaths)
            {
                var kep = await FileStorageService.GetFileBytesAsync(path);
                if (kep != null)
                    fenykepek.Add(kep);
            }

            // 2. melléklet - felülvizsgálói bizonyítványok (Felelős kötelező, Segítő/Ellenőr opcionális)
            var kepBizonyitvanyok = new List<(string Cimke, byte[] Kep)>();
            var pdfBizonyitvanyok = new List<byte[]>();

            var segitoFelulvizsgalo = _felulvizsgalok.FirstOrDefault(f => f.Nev == _adatok.SegitoFelulvizsgalo);
            var ellenorFelulvizsgalo = _felulvizsgalok.FirstOrDefault(f => f.Nev == _adatok.Ellenor);

            var bizonyitvanyForrasok = new[]
            {
                ("Felelős felülvizsgáló: " + (alairoFelulvizsgalo?.Nev ?? _adatok.FelulvizsgaloNev), VvnNemBizonyitvanyPath(alairoFelulvizsgalo)),
                ("Segítő felülvizsgáló: " + (segitoFelulvizsgalo?.Nev ?? _adatok.SegitoFelulvizsgalo), VvnNemBizonyitvanyPath(segitoFelulvizsgalo)),
                ("Ellenőr: " + (ellenorFelulvizsgalo?.Nev ?? _adatok.Ellenor), VvnNemBizonyitvanyPath(ellenorFelulvizsgalo)),
            };

            if (string.IsNullOrWhiteSpace(VvnNemBizonyitvanyPath(alairoFelulvizsgalo)))
            {
                Snackbar.Add("A felelős felülvizsgálónak nincs feltöltve \"Nem norma szerinti villámvédelmi felülvizsgálói bizonyítvány\"!", Severity.Warning);
            }

            foreach (var (cimke, path) in bizonyitvanyForrasok)
            {
                if (string.IsNullOrWhiteSpace(path))
                    continue;

                var extension = Path.GetExtension(path).ToLowerInvariant();
                var fajl = await FileStorageService.GetFileBytesAsync(path);
                if (fajl is null)
                    continue;

                if (extension is ".jpg" or ".jpeg" or ".png")
                {
                    kepBizonyitvanyok.Add((cimke, fajl));
                }
                else if (extension == ".pdf")
                {
                    pdfBizonyitvanyok.Add(fajl);
                }
            }

            var pdfBytes = VillamNemNormaPdfService.Generalas(
                _adatok, cegBelyegzoKep, alairoAlairasKep,
                fenykepek, kepBizonyitvanyok, pdfBizonyitvanyok);
            var fajlNev = $"Villamvedelmi-Nem-Norma-{DateTime.Now:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fajlNev, "application/pdf", pdfBytes);
            _marMentveVolt = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a PDF generálása közben: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

    /// <summary>A "Vissza" gomb: ha még nincs mentett adat, megerősítés nélkül eldobjuk és visszalépünk;
    /// ha már volt korábbi mentés, megerősítés után navigálunk vissza mentés nélkül (a legutóbbi mentés óta
    /// végzett változtatások elveszhetnek).</summary>
    private async Task VisszaMegerositessel()
    {
        if (!_marMentveVolt)
        {
            Vissza();
            return;
        }

        var eredmeny = await DialogService.ShowMessageBox(
            "Vissza",
            "Biztosan kilépsz mentés nélkül? A legutóbbi mentés óta végzett változtatások elveszhetnek.",
            yesText: "Igen, kilépek",
            cancelText: "Mégse");

        if (eredmeny == true)
        {
            Vissza();
        }
    }

    private void Vissza()
    {
        if (MeresId.HasValue && MeresId.Value > 0)
            Navigation.NavigateTo($"/jegyzokonyv/{MeresId.Value}");
        else
            Navigation.NavigateTo("/meresek");
    }

