    /// <summary>
    /// Betölti az adott mérés típusához (MeresTipusJogszabaly) hozzárendelt rendeleteket/szabványokat,
    /// és szinkronizálja a jegyzőkönyvben már kiválasztott elemekkel, hogy az újonnan felvett
    /// hozzárendelések is megjelenjenek a listában (az AlapertelmezettKivalasztva szerint előjelölve).
    /// </summary>
    private async Task BetoltVillamJogszabalyokAsync()
    {
        try
        {
            var hozzarendeltek = _meresTipusId > 0
                ? await MeresTipusService.GetJogszabalyokByTipusIdAsync(_meresTipusId)
                : new List<MeresTipusJogszabaly>();

            _villamJogszabalyok = hozzarendeltek
                .Where(h => h.Jogszabaly != null)
                .Select(h => h.Jogszabaly!)
                .OrderBy(j => j.Tipus)
                .ThenBy(j => j.Szam)
                .ToList();

            var hozzarendeltIdk = hozzarendeltek.Select(x => x.JogszabalyId).ToHashSet();

            _adatok.KijeloltJogszabalyok ??= new List<KijeloltJogszabaly>();
            // Eltávolítjuk azokat a korábban mentett kijelöléseket, amelyek már nincsenek hozzárendelve a típushoz
            _adatok.KijeloltJogszabalyok.RemoveAll(k => !hozzarendeltIdk.Contains(k.JogszabalyId));

            foreach (var h in hozzarendeltek)
            {
                if (!_adatok.KijeloltJogszabalyok.Any(k => k.JogszabalyId == h.JogszabalyId))
                {
                    _adatok.KijeloltJogszabalyok.Add(new KijeloltJogszabaly
                    {
                        JogszabalyId = h.JogszabalyId,
                        Szam = h.Jogszabaly?.Szam ?? "",
                        Cim = h.Jogszabaly?.Cim ?? "",
                        Kivalasztva = h.AlapertelmezettKivalasztva,
                        IsSzabvany = h.Jogszabaly?.Tipus == JogszabalyTipus.Szabvany
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a rendeletek/szabványok betöltésekor: {ex.Message}", Severity.Warning);
        }
    }

