    private async Task PdfGeneralasAsync()
    {
        _feldolgozas = true;
        try
        {
            _adatok.MeresIdeje = _meresIdeje;
            _adatok.FelulvizsgalatErvenyessegeIg = _ervenyessegIg;
            _adatok.KovetkezoFelulvizsgalatIdopontja = _kovetkezoFelulvizsgalat;
            if (_adatok.MikorKeszult is null)
                _adatok.MikorKeszult = DateTime.Today;

            if (MeresId.HasValue && MeresId.Value > 0)
            {
                var meres = await MeresService.GetByIdAsync(MeresId.Value);
                if (meres != null)
                {
                    meres.JegyzokonyvAdatokJson = System.Text.Json.JsonSerializer.Serialize(_adatok);
                    await MeresService.UpdateAsync(meres);
                }
            }

            byte[]? cegBelyegzoKep = null;
            var cegId = _adatok.CegId > 0 ? _adatok.CegId : TenantService.GetCurrentCegId();
            var ceg = await CegService.GetByIdAsync(cegId);
            if (!string.IsNullOrWhiteSpace(ceg?.BelyegzoPath))
            {
                cegBelyegzoKep = await FileStorageService.GetFileBytesAsync(ceg.BelyegzoPath);
            }

            byte[]? alairoAlairasKep = null;
            var alairoFelulvizsgalo = _felulvizsgalok.FirstOrDefault(f => f.Nev == _adatok.FelulvizsgaloNev);
            if (alairoFelulvizsgalo != null && !string.IsNullOrWhiteSpace(alairoFelulvizsgalo.AlairasPath))
            {
                alairoAlairasKep = await FileStorageService.GetFileBytesAsync(alairoFelulvizsgalo.AlairasPath);
            }

            var pdfBytes = VillamNemNormaPdfService.Generalas(_adatok, cegBelyegzoKep, alairoAlairasKep);
            var fajlNev = $"Villamvedelmi-Nem-Norma-{DateTime.Now:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fajlNev, "application/pdf", pdfBytes);
            _marMentveVolt = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a PDF generálása közben: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

    /// <summary>A "Vissza" gomb: ha még nincs mentett adat, megerősítés nélkül eldobjuk és visszalépünk;
    /// ha már volt korábbi mentés, megerősítés után navigálunk vissza mentés nélkül (a legutóbbi mentés óta
    /// végzett változtatások elveszhetnek).</summary>
    private async Task VisszaMegerositessel()
    {
        if (!_marMentveVolt)
        {
            Vissza();
            return;
        }

        var eredmeny = await DialogService.ShowMessageBox(
            "Vissza",
            "Biztosan kilépsz mentés nélkül? A legutóbbi mentés óta végzett változtatások elveszhetnek.",
            yesText: "Igen, kilépek",
            cancelText: "Mégse");

        if (eredmeny == true)
        {
            Vissza();
        }
    }

    private void Vissza()
    {
        if (MeresId.HasValue && MeresId.Value > 0)
            Navigation.NavigateTo($"/jegyzokonyv/{MeresId.Value}");
        else
            Navigation.NavigateTo("/meresek");
    }
