    /// <summary>
    /// Visszaadja a 2.1 pontban megadott R (Rendeltetés) / M (Magasság) / T (Tető anyaga) besorolás alapján
    /// az NNV-2020 4. táblázata szerint elvárt minimális felfogó fokozatot, vagy null-t, ha a 2.1 besorolás
    /// még nincs (teljesen) megadva.
    /// </summary>
    private string? GetElvartFelfogoFokozat()
    {
        var r = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "Rendeltetes")?.Besorolas;
        var m = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "Magassag")?.Besorolas;
        var t = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "TetoAnyaga")?.Besorolas;

        if (string.IsNullOrWhiteSpace(r) || string.IsNullOrWhiteSpace(m) || string.IsNullOrWhiteSpace(t))
            return null;

        return FelfogoFokozatTablazat.ElvartFokozat(r, m, t);
    }

    /// <summary>
    /// Visszaadja a 2.1 pontban megadott R (Rendeltetés) / M (Magasság) besorolás alapján az NNV-2020 táblázata
    /// szerinti, az adott R/M csoporthoz tartozó összes lehetséges levezető/földelés fokozat-kombinációt,
    /// tájékoztató szöveges formában (K1/K2/K3 oszloponként), vagy üres listát, ha a 2.1 besorolás hiányos.
    /// </summary>
    private List<string> GetLevezetoFoldelesAlternativak()
    {
        var r = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "Rendeltetes")?.Besorolas;
        var m = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "Magassag")?.Besorolas;

        if (string.IsNullOrWhiteSpace(r) || string.IsNullOrWhiteSpace(m))
            return new List<string>();

        return LevezetoFoldelesFokozatTablazat.GetAlternativak(r, m)
            .Select(alt =>
            {
                var kReszek = new List<string>();
                if (!string.IsNullOrWhiteSpace(alt.K1)) kReszek.Add($"K1: {alt.K1}");
                if (!string.IsNullOrWhiteSpace(alt.K2)) kReszek.Add($"K2: {alt.K2}");
                if (!string.IsNullOrWhiteSpace(alt.K3)) kReszek.Add($"K3: {alt.K3}");

                var foldelesReszek = new[] { alt.Foldeles1, alt.Foldeles2 }
                    .Where(f => !string.IsNullOrWhiteSpace(f))
                    .ToList();

                return $"{string.Join(", ", kReszek)} – Földelés: {string.Join(" vagy ", foldelesReszek)}";
            })
            .ToList();
    }

    /// <summary>
    /// A helyszínen talált felfogó fokozat megadásakor automatikusan megállapítja a megfelelőséget
    /// a 2.1 pontban megadott besorolás alapján elvárt minimumhoz képest.
    /// </summary>
    private void OnFelfogoFokozatValtozas(VillamElemBesorolasSor sor, string? ujErtek)
    {
        sor.Fokozat = ujErtek ?? "";

        var elvart = GetElvartFelfogoFokozat();
        var eredmeny = FelfogoFokozatTablazat.Megfelel(elvart, sor.Fokozat);
        sor.Allapot = eredmeny.HasValue ? (eredmeny.Value ? "megfelelő" : "nem megfelelő") : "ismeretlen";
    }

    /// <summary>
    /// A helyszínen talált levezető fokozat megadásakor automatikusan megállapítja a megfelelőséget
    /// a 2.1 pontban megadott R/M besorolás alapján elvárt (bármelyik K1/K2/K3 alternatívának megfelelő) minimumhoz képest.
    /// </summary>
    private void OnLevezetoFokozatValtozas(VillamElemBesorolasSor sor, string? ujErtek)
    {
        sor.Fokozat = ujErtek ?? "";

        var r = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "Rendeltetes")?.Besorolas;
        var m = _adatok.VillamBesorolasSorok.FirstOrDefault(s => s.SzempontKod == "Magassag")?.Besorolas;

        var eredmeny = LevezetoFoldelesFokozatTablazat.Megfelel(r, m, sor.Fokozat);
        sor.Allapot = eredmeny.HasValue ? (eredmeny.Value ? "megfelelő" : "nem megfelelő") : "ismeretlen";
    }

    /// <summary>A KepzesTipus neve, ami alapján a 2. mellékletbe kerülő bizonyítványt keressük.</summary>
    private const string VvnNemBizonyitvanyTipusNev = "Nem norma szerinti villámvédelmi felülvizsgálói bizonyítvány";

    /// <summary>
    /// Megkeresi a felülvizsgáló "Nem norma szerinti villámvédelmi felülvizsgálói bizonyítvány" típusú,
    /// feltöltött bizonyítvány fájljának elérési útját (a legfrissebb bizonyítvány kelte szerint, ha több is van).
    /// </summary>
    private static string? VvnNemBizonyitvanyPath(Felulvizsgalo? felulvizsgalo)
    {
        if (felulvizsgalo is null)
            return null;

        return felulvizsgalo.Kepzesek
            .Where(k => k.Aktiv
                        && !string.IsNullOrWhiteSpace(k.BizonyitvanyPath)
                        && k.KepzesTipus != null
                        && string.Equals(k.KepzesTipus.Nev, VvnNemBizonyitvanyTipusNev, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(k => k.BizonyitvanyKelte)
            .Select(k => k.BizonyitvanyPath)
            .FirstOrDefault();
    }

