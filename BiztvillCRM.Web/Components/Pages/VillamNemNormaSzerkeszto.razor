    /// <summary>Kinyeri a várost egy "1234 Város; utca házszám" vagy "1234 Város, utca házszám" formátumú címből.</summary>
    private static string VarosKinyerese(string? cim)
    {
        if (string.IsNullOrWhiteSpace(cim)) return "";

        var resz = cim.Trim();
        // Irányítószám levágása (4 egymást követő számjegy az elején)
        var match = System.Text.RegularExpressions.Regex.Match(resz, @"^\d{4}\s*(.+)$");
        if (match.Success)
            resz = match.Groups[1].Value.Trim();

        // Az első elválasztó (; vagy ,) előtti rész a település neve
        var elvalasztoIndex = resz.IndexOfAny(new[] { ';', ',' });
        if (elvalasztoIndex > 0)
            resz = resz[..elvalasztoIndex];

        return resz.Trim();
    }

