    private async Task OnModszerChanged(MeresiPontSor pont, string ujModszer)
    {
        pont.Modszer = ujModszer;

        var modOsztaly = _modOsztalyok.FirstOrDefault(m => m.Nev == ujModszer);
        if (modOsztaly != null)
        {
            if (!modOsztaly.VanAvk)
                pont.AVKCsatolva = false;
            if (!modOsztaly.VanPeFolyt)
                pont.PEFolytMegfelelt = false;
        }

        await OnChange.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnPeFolytChanged(MeresiPontSor pont, bool ujErtek, bool peTiltott)
    {
        pont.PEFolytMegfelelt = ujErtek;

        // Ha tiltott módnál mégis be van pipálva → automatikus NEM FELELT MEG
        if (peTiltott && ujErtek)
        {
            pont.Minosites = "NEM FELELT MEG";
            Snackbar.Add(
                $"⚠️ '{pont.Modszer}' módhoz PE folytonosság nem lehetséges – minősítés: NEM FELELT MEG",
                Severity.Warning);
        }
        else
        {
            // Normál esetben újraszámoljuk a minősítést
            await SzamolMinositest(pont);
            return;
        }

        await OnChange.InvokeAsync();
        StateHasChanged();
    }
