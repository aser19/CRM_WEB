@page "/sugo"
@attribute [Authorize]
@rendermode InteractiveServer
@layout SugoLayout
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Web.Helpers
@inject IJSRuntime JSRuntime
@inject ISugoService SugoService

<PageTitle>Súgó</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Súgó</MudText>

@if (!string.IsNullOrWhiteSpace(Kategoria))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.Info">
        A(z) <b>@Kategoria</b> témakör automatikusan kiemelve. A teljes súgó tartalom görgetéssel vagy kereséssel érhető el.
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudTextField T="string" Value="@_keresoSzoveg" ValueChanged="@OnKeresesValtozott"
                  Label="Keresés a súgóban..." Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Clearable="true" />
</MudPaper>

@if (!_betoltve)
{
    <MudProgressCircular Indeterminate="true" Class="my-4" />
}
else if (!SzurtKategoriak.Any())
{
    <MudAlert Severity="Severity.Info">Nincs találat a keresett kifejezésre.</MudAlert>
}
else
{
    <MudExpansionPanels>
        @foreach (var kategoria in SzurtKategoriak)
        {
            <div id="@SugoAnchorId(kategoria.Nev)">
                <MudExpansionPanel Text="@kategoria.Nev" Icon="@SugoIkonTerkep.Feloldas(kategoria.Icon)"
                                   Expanded="@(kategoria.Nev == Kategoria || !string.IsNullOrWhiteSpace(_keresoSzoveg))">
                @foreach (var tema in kategoria.Temak)
                {
                    <MudPaper Class="pa-3 mb-3" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-1">@tema.Cim</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2" Style="white-space: pre-line;">@tema.Leiras</MudText>
                        @if (!string.IsNullOrWhiteSpace(tema.VideoUrl))
                        {
                            <div class="mud-width-full" style="max-width: 560px;">
                                <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;">
                                    <iframe src="@tema.VideoUrl" title="@tema.Cim"
                                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen>
                                    </iframe>
                                </div>
                            </div>
                        }
                    </MudPaper>
                }
                </MudExpansionPanel>
            </div>
        }
    </MudExpansionPanels>
}

@code {
    [SupplyParameterFromQuery]
    [Parameter]
    public string? Kategoria { get; set; }

    private bool _gorgetesMegtortent;
    private bool _betoltve;
    private List<BiztvillCRM.Shared.Models.SugoKategoria> _kategoriak = new();
    private string _keresoSzoveg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _kategoriak = await SugoService.GetAllWithTemakAsync();
        _betoltve = true;
    }

    private static string SugoAnchorId(string kategoriaNev) =>
        "sugo-" + kategoriaNev
            .Replace(" ", "-")
            .Replace("ó", "o").Replace("ő", "o").Replace("ö", "o")
            .Replace("é", "e").Replace("á", "a").Replace("ú", "u")
            .Replace("ü", "u").Replace("ű", "u").Replace("í", "i")
            .ToLowerInvariant();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_gorgetesMegtortent && !string.IsNullOrWhiteSpace(Kategoria) &&
            _kategoriak.Any(k => k.Nev == Kategoria))
        {
            _gorgetesMegtortent = true;
            await JSRuntime.InvokeVoidAsync("eval",
                $"document.getElementById('{SugoAnchorId(Kategoria)}')?.scrollIntoView({{ behavior: 'smooth', block: 'start' }});");
        }
    }

    private List<BiztvillCRM.Shared.Models.SugoKategoria> SzurtKategoriak
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_keresoSzoveg))
            {
                return _kategoriak;
            }

            var kereses = _keresoSzoveg.Trim();

            return _kategoriak
                .Select(k => new BiztvillCRM.Shared.Models.SugoKategoria
                {
                    Id = k.Id,
                    Nev = k.Nev,
                    Icon = k.Icon,
                    Sorrend = k.Sorrend,
                    Temak = k.Temak
                        .Where(t => Tartalmazza(t.Cim, kereses) || Tartalmazza(t.Leiras, kereses) || Tartalmazza(k.Nev, kereses))
                        .ToList()
                })
                .Where(k => k.Temak.Any())
                .ToList();
        }
    }

    private static bool Tartalmazza(string szoveg, string kereses) =>
        szoveg.Contains(kereses, StringComparison.OrdinalIgnoreCase);

    private void OnKeresesValtozott(string ertek)
    {
        _keresoSzoveg = ertek;
    }
}
