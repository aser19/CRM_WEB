@page "/elfelejtett-jelszo"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject UserManager<Felhasznalo> UserManager
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IEmailKuldoService EmailKuldoService

<PageTitle>Elfelejtett jelszó - Biztovill CRM</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Class="pa-8" Elevation="4" Style="width: 100%; max-width: 450px;">
        <MudStack AlignItems="AlignItems.Center" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">Elfelejtett jelszó</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                Adja meg az email címét, és küldünk egy jelszó-visszaállító linket.
            </MudText>
        </MudStack>

        @if (_elkuldve)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Ha a megadott email cím létezik a rendszerben, küldtünk egy jelszó-visszaállító emailt.
            </MudAlert>
            <MudButton Variant="Variant.Outlined" FullWidth="true"
                       OnClick="@(() => NavigationManager.NavigateTo("/bejelentkezes"))">
                Vissza a bejelentkezéshez
            </MudButton>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="KuldesAsync" FormName="forgot-password">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Email"
                              Label="Email cím"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4"
                              Required="true" />

                <ValidationMessage For="@(() => _model.Email)" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_betoltes">
                    @if (_betoltes)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    <span>Link küldése</span>
                </MudButton>
            </EditForm>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.Center">
                <MudLink Href="/bejelentkezes" Color="Color.Primary">Vissza a bejelentkezéshez</MudLink>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    private EmailModel _model = new();
    private bool _betoltes;
    private bool _elkuldve;

    private async Task KuldesAsync()
    {
        _betoltes = true;
        try
        {
            var user = await UserManager.FindByEmailAsync(_model.Email);
            if (user is not null && user.Aktiv)
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                var callbackUrl = NavigationManager.ToAbsoluteUri(
                    $"/jelszo-visszaallitas?email={Uri.EscapeDataString(user.Email!)}" +
                    $"&token={Uri.EscapeDataString(token)}");

                var szoveg = $"""
                    <html><body style="font-family:Arial,sans-serif;color:#333;max-width:600px;margin:0 auto;">
                    <h2 style="color:#1565C0;border-bottom:3px solid #1565C0;padding-bottom:8px;">
                        🔐 Jelszó visszaállítás
                    </h2>
                    <p>Kedves <strong>{user.Nev}</strong>!</p>
                    <p>Jelszó-visszaállítási kérelmet kaptunk ehhez az email fiókhoz.</p>
                    <p>A jelszó visszaállításához kattintson az alábbi gombra:</p>
                    <p style="text-align:center;margin:32px 0;">
                        <a href="{callbackUrl}"
                           style="background:#1565C0;color:#fff;padding:12px 28px;border-radius:6px;
                                  text-decoration:none;font-weight:bold;font-size:16px;">
                            Jelszó visszaállítása
                        </a>
                    </p>
                    <p style="color:#555;">Ha a gomb nem működik, másolja be ezt a linket a böngészőbe:</p>
                    <p style="word-break:break-all;color:#1565C0;font-size:13px;">{callbackUrl}</p>
                    <p style="color:#888;font-size:12px;margin-top:16px;">
                        Ha nem Ön kérte a jelszó visszaállítását, hagyja figyelmen kívül ezt az emailt.
                        A link <strong>24 óráig</strong> érvényes.
                    </p>
                    <hr style="border:none;border-top:1px solid #ccc;margin:24px 0;"/>
                    <p style="color:#aaa;font-size:11px;">
                        Ez az értesítés automatikusan lett küldve a BiztvillCRM rendszerből.
                    </p>
                    </body></html>
                    """;

                await EmailKuldoService.KuldAsync(
                    user.Email!,
                    "BiztvillCRM – Jelszó visszaállítás",
                    szoveg);
            }

            // Mindig sikert mutatunk – biztonsági okokból nem jelezzük, hogy az email létezik-e
            _elkuldve = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba történt az email küldésekor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _betoltes = false;
        }
    }

    public class EmailModel
    {
        [Required(ErrorMessage = "Az email cím megadása kötelező")]
        [EmailAddress(ErrorMessage = "Érvénytelen email cím formátum")]
        public string Email { get; set; } = string.Empty;
    }
}