@page "/karbantartasok"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Services.Interfaces
@inject IKarbantartasService KarbantartasService
@inject IKarbantartasTipusService KarbantartasTipusService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantService TenantService
@inject ICegService CegService

<PageTitle>Karbantartások</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Karbantartások</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField @bind-Value="_kereses" Label="Keresés (ügyfél, telephely, típus)" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Style="max-width:400px;" />
        <MudSelect T="string" @bind-Value="_datumSzuro" Label="Dátumszűrő" Clearable="true"
                   Style="max-width:220px;" AdornmentIcon="@Icons.Material.Filled.DateRange" Adornment="Adornment.Start"
                   Dense="true">
            <MudSelectItem Value="@("k30")">Következő 30 nap</MudSelectItem>
            <MudSelectItem Value="@("k90")">Következő 90 nap</MudSelectItem>
            <MudSelectItem Value="@("k180")">Következő 180 nap</MudSelectItem>
            <MudSelectItem Value="@("kiden")">Következő – Idén</MudSelectItem>
            <MudSelectItem Value="@("pm30")">± 30 nap</MudSelectItem>
            <MudSelectItem Value="@("pm90")">± 90 nap</MudSelectItem>
            <MudSelectItem Value="@("pm180")">± 180 nap</MudSelectItem>
            <MudSelectItem Value="@("iden")">Idén (egész év)</MudSelectItem>
        </MudSelect>
        <MudSpacer />
        <MudTooltip Text="@(_csoportositott ? "Lista nézet" : "Csoportosítás ügyfél szerint")">
            <MudIconButton Icon="@(_csoportositott ? Icons.Material.Filled.TableRows : Icons.Material.Filled.GroupWork)"
                           Color="@(_csoportositott ? Color.Primary : Color.Default)"
                           Variant="@(_csoportositott ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => _csoportositott = !_csoportositott)" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Archive" OnClick="InaktivakMegnyitasa">Inaktív karbantartások</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="UjMegnyitasa">Új karbantartás</MudButton>
    </MudStack>

    @if (!_csoportositott)
    {
        <MudDataGrid T="Karbantartas" Items="_szurtLista" Filterable="false" SortMode="SortMode.Multiple" Hover="true" Striped="true" Loading="_betoltes">
        <Columns>
            <TemplateColumn Title="Ügyfél" Sortable="true" SortBy="@(k => k.Ugyfel?.Nev ?? "")">
                <CellTemplate>
                    <div>
                        <div>@(context.Item.Ugyfel?.Nev ?? "-")</div>
                        @if (_elerhetoCegek.Count > 1 && context.Item.Ugyfel != null)
                        {
                            var cegId = context.Item.Ugyfel.CegId;
                            var szin = GetCegSzin(cegId);
                            var rovidites = GetCegRovidites(cegId);
                            var cegNev = GetCegNev(cegId);
                            <MudTooltip Text="@cegNev" Placement="Placement.Right">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px; margin-top:2px;")"
                                         Label="true">
                                    @rovidites
                                </MudChip>
                            </MudTooltip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="k => k.Telephely!.Nev" Title="Telephely" />
            <PropertyColumn Property="k => k.KarbantartasTipus!.Nev" Title="Típus" />
            <PropertyColumn Property="k => k.Datum" Title="Dátum" Format="yyyy.MM.dd" />
            <TemplateColumn Title="Következő" Sortable="true" SortBy="@(k => k.KovetkezoDatum ?? DateTime.MaxValue)"
                            InitialDirection="SortDirection.Ascending">
                <CellTemplate>
                    @if (context.Item.KovetkezoDatum.HasValue)
                    {
                        <MudText>@context.Item.KovetkezoDatum.Value.ToString("yyyy.MM.dd")</MudText>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Eseti</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="k => k.Elvegzo" Title="Elvégző" />
            <TemplateColumn Title="Státusz">
                <CellTemplate>
                    @{
                        var (szin, szoveg) = context.Item.Statusz switch
                        {
                            KarbantartasStatusz.Tervezett => (Color.Default, "Tervezett"),
                            KarbantartasStatusz.Folyamatban => (Color.Info, "Folyamatban"),
                            KarbantartasStatusz.Elvegezve => (Color.Success, "Elvégezve"),
                            KarbantartasStatusz.Elhalasztva => (Color.Warning, "Elhalasztva"),
                            _ => (Color.Default, "Ismeretlen")
                        };
                    }
                    <MudChip T="string" Size="Size.Small" Color="@szin">@szoveg</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Műveletek" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true">
                        <MudTooltip Text="Másolás – új karbantartás az adatok alapján">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="() => MasolasMegnyitasa(context.Item)" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => SzerkesztesMegnyitasa(context.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => TorlesMegerosites(context.Item)" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText>Nincs megjeleníthető karbantartás.</MudText></NoRecordsContent>
    </MudDataGrid>
    }
    else
    {
        @if (_betoltes)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
        else if (!_szurtLista.Any())
        {
            <MudText Class="pa-4 ml-2">Nincs megjeleníthető karbantartás.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Class="mt-1">
                @foreach (var csoport in _szurtLista.GroupBy(k => k.UgyfelId).OrderBy(g => g.FirstOrDefault()?.Ugyfel?.Nev ?? ""))
                {
                    var ugyfelNev = csoport.FirstOrDefault()?.Ugyfel?.Nev ?? "-";
                    var cegId = csoport.FirstOrDefault()?.Ugyfel?.CegId ?? 0;
                    var karbantartasok = csoport.OrderBy(k => k.KovetkezoDatum ?? DateTime.MaxValue).ToList();

                    <MudExpansionPanel IsInitiallyExpanded="true">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1"><b>@ugyfelNev</b></MudText>
                                @if (_elerhetoCegek.Count > 1)
                                {
                                    var szin = GetCegSzin(cegId);
                                    var rovidites = GetCegRovidites(cegId);
                                    var cegNev = GetCegNev(cegId);
                                    <MudTooltip Text="@cegNev">
                                        <MudChip T="string" Size="Size.Small" Label="true"
                                                 Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px;")">
                                            @rovidites
                                        </MudChip>
                                    </MudTooltip>
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @karbantartasok.Count karbantartás
                                </MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudTable T="Karbantartas" Items="@karbantartasok" Hover="true" Dense="true" Striped="true"
                                      Breakpoint="Breakpoint.Sm" Class="mb-2">
                                <HeaderContent>
                                    <MudTh>Telephely</MudTh>
                                    <MudTh>Típus</MudTh>
                                    <MudTh>Dátum</MudTh>
                                    <MudTh>Következő</MudTh>
                                    <MudTh>Elvégző</MudTh>
                                    <MudTh>Státusz</MudTh>
                                    <MudTh>Műveletek</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Telephely">@(context.Telephely?.Nev ?? "-")</MudTd>
                                    <MudTd DataLabel="Típus">@(context.KarbantartasTipus?.Nev ?? "-")</MudTd>
                                    <MudTd DataLabel="Dátum">@context.Datum.ToString("yyyy.MM.dd")</MudTd>
                                    <MudTd DataLabel="Következő">
                                        @if (context.KovetkezoDatum.HasValue)
                                        {
                                            <MudText>@context.KovetkezoDatum.Value.ToString("yyyy.MM.dd")</MudText>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Eseti</MudChip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Elvégző">@(context.Elvegzo ?? "-")</MudTd>
                                    <MudTd DataLabel="Státusz">
                                        @{
                                            var (szin, szoveg) = context.Statusz switch
                                            {
                                                KarbantartasStatusz.Tervezett => (Color.Default, "Tervezett"),
                                                KarbantartasStatusz.Folyamatban => (Color.Info, "Folyamatban"),
                                                KarbantartasStatusz.Elvegezve => (Color.Success, "Elvégezve"),
                                                KarbantartasStatusz.Elhalasztva => (Color.Warning, "Elhalasztva"),
                                                _ => (Color.Default, "Ismeretlen")
                                            };
                                        }
                                        <MudChip T="string" Size="Size.Small" Color="@szin">@szoveg</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Műveletek">
                                        <MudStack Row="true" Spacing="1">
                                            <MudTooltip Text="Másolás – új karbantartás az adatok alapján">
                                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                               Color="Color.Secondary"
                                                               Size="Size.Small"
                                                               OnClick="() => MasolasMegnyitasa(context)" />
                                            </MudTooltip>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => SzerkesztesMegnyitasa(context)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => TorlesMegerosites(context)" />
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
</MudPaper>

<MudDialog @bind-Visible="_inaktivDialogNyitva" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Inaktív karbantartások</MudText></TitleContent>
    <DialogContent>
        @if (_inaktivBetoltes)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (!_inaktivLista.Any())
        {
            <MudAlert Severity="Severity.Info">Nincs inaktív karbantartás.</MudAlert>
        }
        else
        {
            <MudDataGrid T="Karbantartas" Items="_inaktivLista" Filterable="false" Hover="true" Striped="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="k => k.Ugyfel!.Nev" Title="Ügyfél" />
                    <PropertyColumn Property="k => k.Telephely!.Nev" Title="Telephely" />
                    <PropertyColumn Property="k => k.KarbantartasTipus!.Nev" Title="Típus" />
                    <TemplateColumn Title="Dátum">
                        <CellTemplate>@context.Item.Datum.ToString("yyyy.MM.dd")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Következő">
                        <CellTemplate>@(context.Item.KovetkezoDatum?.ToString("yyyy.MM.dd") ?? "Eseti")</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="k => k.Elvegzo" Title="Elvégző" />
                    <TemplateColumn Title="" Sortable="false">
                        <CellTemplate>
                            <MudTooltip Text="Másolás">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" 
                                               Color="Color.Secondary" 
                                               Size="Size.Small" 
                                               OnClick="() => { _inaktivDialogNyitva = false; MasolasMegnyitasa(context.Item); }" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _inaktivDialogNyitva = false" Color="Color.Primary">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_dialogNyitva" Options="_dialogOptions">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:8px;">
            @if (_masolasbol)
            {
                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary" Class="mr-1" />
            }
            <MudText Typo="Typo.h6">
                @(_masolasbol ? "Másolat létrehozása" 
                  : _szerkesztesAlatt?.Id > 0 ? "Karbantartás szerkesztése" 
                  : "Új karbantartás")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_szerkesztesAlatt is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSelect T="int" Value="_kivalasztottUgyfelId" Label="Ügyfél *" 
                                   ValueChanged="@((int id) => UgyfelValtozottAsync(id))"
                                   ToStringFunc="@(id => _ugyfelek.FirstOrDefault(u => u.Id == id)?.Nev ?? "")"
                                   Style="flex:1;">
                            @foreach (var u in _ugyfelek)
                            {
                                <MudSelectItem Value="@u.Id">@u.Nev</MudSelectItem>
                            }
                        </MudSelect>
                        @if (_kivalasztottUgyfelId == 0)
                        {
                            <MudTooltip Text="Új ügyfél felvétele">
                                <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" 
                                               Color="Color.Success" 
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               OnClick="UjUgyfelMegnyitasa" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSelect T="int" @bind-Value="_szerkesztesAlatt.TelephelyId" Label="Telephely *"
                                   Disabled="@(_szurtTelephelyek.Count == 0)"
                                   ToStringFunc="@(id => _szurtTelephelyek.FirstOrDefault(t => t.Id == id)?.Nev ?? "")"
                                   Style="flex:1;">
                            @foreach (var t in _szurtTelephelyek)
                            {
                                <MudSelectItem Value="@t.Id">@t.Nev (@t.Cim)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (_kivalasztottUgyfelId > 0)
                        {
                            <MudTooltip Text="Új telephely felvétele">
                                <MudIconButton Icon="@Icons.Material.Filled.AddLocation" 
                                               Color="Color.Success" 
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               OnClick="UjTelephelyMegnyitasa" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_szerkesztesAlatt.KarbantartasTipusId" Label="Típus *"
                               ValueChanged="@((int id) => TipusValtozottAsync(id))"
                               ToStringFunc="@(id => _tipusok.FirstOrDefault(t => t.Id == id)?.Nev ?? "")">
                        @foreach (var t in _tipusok)
                        {
                            <MudSelectItem Value="@t.Id">
                                @t.Nev @(t.Eseti ? "(eseti)" : $"({t.IsmetlodesHonap} hónap)")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="_datum" Label="Dátum *" DateChanged="DatumValtozottAsync" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="_kovetkezoDatum" 
                                   DateChanged="KovetkezoDatumValtozottAsync" 
                                   Label="Következő dátum" 
                                   Disabled="@_esetiTipus" />
                    @if (_esetiTipus)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Eseti karbantartásnál nincs következő dátum</MudText>
                    }
                    else if (_manualisKovetkezoDatum)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info">Kézileg módosított dátum</MudText>
                    }
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_szerkesztesAlatt.Elvegzo" Label="Elvégző" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="KarbantartasStatusz" @bind-Value="_szerkesztesAlatt.Statusz" Label="Státusz *">
                        <MudSelectItem Value="KarbantartasStatusz.Tervezett">Tervezett</MudSelectItem>
                        <MudSelectItem Value="KarbantartasStatusz.Folyamatban">Folyamatban</MudSelectItem>
                        <MudSelectItem Value="KarbantartasStatusz.Elvegezve">Elvégezve</MudSelectItem>
                        <MudSelectItem Value="KarbantartasStatusz.Elhalasztva">Elhalasztva</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_szerkesztesAlatt.Leiras" Label="Leírás" Lines="3" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="DialogBezarasa">Mégse</MudButton>
        <MudButton OnClick="MentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_mentes">@(_mentes ? "Mentés..." : "Mentés")</MudButton>
    </DialogActions>
</MudDialog>

<!-- Új ügyfél dialógus -->
<MudDialog @bind-Visible="_ujUgyfelDialogNyitva" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Új ügyfél hozzáadása</MudText>
    </TitleContent>
    <DialogContent>
        @if (_ujUgyfel is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujUgyfel.Nev" Label="Név *" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="UgyfelTipus" @bind-Value="_ujUgyfel.UgyfelTipus" Label="Típus">
                        @foreach (UgyfelTipus t in Enum.GetValues(typeof(UgyfelTipus)))
                        {
                            <MudSelectItem Value="@t">@t.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujUgyfel.Adoszam" Label="Adószám" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujUgyfel.Email" Label="Email" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujUgyfel.Telefon" Label="Telefon" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujUgyfel.Cim" Label="Cím" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _ujUgyfelDialogNyitva = false">Mégse</MudButton>
        <MudButton OnClick="UjUgyfelMentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_ujUgyfelMentes">
            @(_ujUgyfelMentes ? "Mentés..." : "Mentés")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Új telephely dialógus -->
<MudDialog @bind-Visible="_ujTelephelyDialogNyitva" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Új telephely hozzáadása</MudText>
    </TitleContent>
    <DialogContent>
        @if (_ujTelephely is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujTelephely.Nev" Label="Telephely neve *" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujTelephely.Cim" Label="Cím" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujTelephely.Kapcsolattarto" Label="Kapcsolattartó" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujTelephely.Telefon" Label="Telefon" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_ujTelephely.Email" Label="Email" InputType="InputType.Email" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _ujTelephelyDialogNyitva = false">Mégse</MudButton>
        <MudButton OnClick="UjTelephelyMentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_ujTelephelyMentes">
            @(_ujTelephelyMentes ? "Mentés..." : "Mentés")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Karbantartas> _lista = new();
    private List<Ugyfel> _ugyfelek = new();
    private List<Telephely> _telephelyek = new();
    private List<Telephely> _szurtTelephelyek = new();
    private List<KarbantartasTipus> _tipusok = new();
    private string _kereses = string.Empty;
    private bool _betoltes = true, _dialogNyitva = false, _mentes = false, _esetiTipus = false, _masolasbol = false;
    private bool _manualisKovetkezoDatum = false; // Flag a manuális következő dátum jelzésére
    private bool _csoportositott = true; // Csoportosított nézet kapcsoló

    // Új ügyfél/telephely dialógok
    private bool _ujUgyfelDialogNyitva = false;
    private bool _ujTelephelyDialogNyitva = false;
    private bool _ujUgyfelMentes = false;
    private bool _ujTelephelyMentes = false;
    private Ugyfel? _ujUgyfel;
    private Telephely? _ujTelephely;

    private Karbantartas? _szerkesztesAlatt;
    private int _kivalasztottUgyfelId;
    private DateTime? _datum, _kovetkezoDatum;
    private readonly DialogOptions _dialogOptions = new() 
    { 
        MaxWidth = MaxWidth.Medium, 
        FullWidth = true, 
        CloseButton = true,
        CloseOnEscapeKey = true  // ESC gomb kezelése
    };

    private string? _datumSzuro;

    // Inaktív karbantartások
    private bool _inaktivDialogNyitva = false;
    private List<Karbantartas> _inaktivLista = new();
    private bool _inaktivBetoltes = false;

    private List<Ceg> _elerhetoCegek = new();

    private static readonly string[] _cegSzinek = new[]
    {
        "#1976D2", // kék   – főcég
        "#F57C00", // narancs
        "#388E3C", // zöld
        "#7B1FA2", // lila
        "#C62828", // sötétpiros
        "#00838F", // cián
    };

    private string GetCegSzin(int cegId)
    {
        if (_elerhetoCegek.Count <= 1) return "";
        var index = _elerhetoCegek.FindIndex(c => c.Id == cegId);
        return _cegSzinek[Math.Max(0, index) % _cegSzinek.Length];
    }

    private string GetCegRovidites(int cegId)
    {
        var ceg = _elerhetoCegek.FirstOrDefault(c => c.Id == cegId);
        if (ceg == null) return "?";
        return ceg.MatricaElotag
            ?? new string(ceg.Nev.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpper();
    }

    private string GetCegNev(int cegId)
        => _elerhetoCegek.FirstOrDefault(c => c.Id == cegId)?.Nev ?? "";

    private IEnumerable<Karbantartas> _szurtLista
    {
        get
        {
            var ma = DateTime.Today;
            IEnumerable<Karbantartas> lista = _lista;

            // Dátumintervallum szűrő
            lista = _datumSzuro switch
            {
                "k30"   => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma && k.KovetkezoDatum.Value <= ma.AddDays(30)),
                "k90"   => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma && k.KovetkezoDatum.Value <= ma.AddDays(90)),
                "k180"  => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma && k.KovetkezoDatum.Value <= ma.AddDays(180)),
                "kiden" => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma && k.KovetkezoDatum.Value.Year == ma.Year),
                "pm30"  => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma.AddDays(-30) && k.KovetkezoDatum.Value <= ma.AddDays(30)),
                "pm90"  => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma.AddDays(-90) && k.KovetkezoDatum.Value <= ma.AddDays(90)),
                "pm180" => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value >= ma.AddDays(-180) && k.KovetkezoDatum.Value <= ma.AddDays(180)),
                "iden"  => lista.Where(k => k.KovetkezoDatum.HasValue && k.KovetkezoDatum.Value.Year == ma.Year),
                _       => lista
            };

            // Szöveges keresés
            if (!string.IsNullOrWhiteSpace(_kereses))
                lista = lista.Where(k =>
                    (k.Ugyfel?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (k.Telephely?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (k.KarbantartasTipus?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false));

            return lista;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await BetoltesAsync();
            _ugyfelek = await UgyfelService.GetAllAsync();
            _telephelyek = await TelephelyService.GetAllAsync();
            _tipusok = await KarbantartasTipusService.GetActiveAsync();

            // Multi-tenant cég badge betöltés
            var elerhhetoCegIds = await TenantService.GetElerhhetoCegIdsAsync();
            if (elerhhetoCegIds.Count > 1)
            {
                var cegId = TenantService.GetCurrentCegId();
                var osszesCeg = await CegService.GetAllAsync(csakAktiv: false);
                _elerhetoCegek = osszesCeg
                    .Where(c => elerhhetoCegIds.Contains(c.Id))
                    .OrderBy(c => c.Id == cegId ? 0 : 1)
                    .ThenBy(c => c.Nev)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hiba a Karbantartasok oldal betöltése során: {ex.Message}");
            Snackbar.Add($"Hiba történt az adatok betöltése során: {ex.Message}", Severity.Error);
            _betoltes = false;
        }
    }

    private async Task BetoltesAsync() 
    { 
        _betoltes = true; 
        try
        {
            _lista = await KarbantartasService.GetAllAsync(); 
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hiba a karbantartások betöltése során: {ex.Message}");
            Snackbar.Add("Nem sikerült betölteni a karbantartásokat. Lehet, hogy az adatbázis migráció még nem futott le.", Severity.Error);
            _lista = new List<Karbantartas>();
        }
        finally
        {
            _betoltes = false;
        }
    }

    private void UjMegnyitasa() 
    { 
        _szerkesztesAlatt = new Karbantartas(); 
        _datum = DateTime.Today; 
        _kovetkezoDatum = null; 
        _kivalasztottUgyfelId = 0;
        _szurtTelephelyek = new();
        _esetiTipus = false;
        _masolasbol = false; // ← Új karbantartás, NEM másolat
        _manualisKovetkezoDatum = false; // ← Automatikus számítás engedélyezése
        _dialogNyitva = true; 
    }

    private void SzerkesztesMegnyitasa(Karbantartas item) 
    { 
        _szerkesztesAlatt = new Karbantartas 
        { 
            Id = item.Id, 
            UgyfelId = item.UgyfelId,
            TelephelyId = item.TelephelyId, 
            KarbantartasTipusId = item.KarbantartasTipusId, 
            Leiras = item.Leiras,
            Elvegzo = item.Elvegzo,
            Statusz = item.Statusz
        }; 
        _kivalasztottUgyfelId = item.UgyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == _kivalasztottUgyfelId).ToList();
        _datum = item.Datum; 
        _kovetkezoDatum = item.KovetkezoDatum;

        var tipus = _tipusok.FirstOrDefault(t => t.Id == item.KarbantartasTipusId);
        _esetiTipus = tipus?.Eseti ?? false;

        _masolasbol = false; // ← Szerkesztés, NEM másolat
        _manualisKovetkezoDatum = false; // ← Meglévő dátum megtartása
        _dialogNyitva = true; 
    }

    private void MasolasMegnyitasa(Karbantartas item)
    {
        _szerkesztesAlatt = new Karbantartas
        {
            Id = 0,                                         // ← ÚJ rekord
            UgyfelId = item.UgyfelId,
            TelephelyId = item.TelephelyId,
            KarbantartasTipusId = item.KarbantartasTipusId,
            Leiras = item.Leiras,
            Elvegzo = item.Elvegzo,
            Statusz = KarbantartasStatusz.Tervezett        // ← új karbantartás, Tervezett státusz
        };
        _kivalasztottUgyfelId = item.UgyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == _kivalasztottUgyfelId).ToList();
        _datum = DateTime.Today;                            // ← mai dátum

        var tipus = _tipusok.FirstOrDefault(t => t.Id == item.KarbantartasTipusId);
        _esetiTipus = tipus?.Eseti ?? false;

        // Következő dátum számítása az új dátum alapján
        if (!_esetiTipus && tipus is not null)
        {
            _kovetkezoDatum = _datum.Value.AddMonths(tipus.IsmetlodesHonap);
        }
        else
        {
            _kovetkezoDatum = null;
        }

        _masolasbol = true;
        _manualisKovetkezoDatum = false; // ← Automatikus számítás engedélyezése
        _dialogNyitva = true;
    }

    private Task UgyfelValtozottAsync(int ugyfelId)
    {
        _kivalasztottUgyfelId = ugyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == ugyfelId).ToList();
        if (_szerkesztesAlatt is not null)
        {
            _szerkesztesAlatt.UgyfelId = ugyfelId;
            _szerkesztesAlatt.TelephelyId = _szurtTelephelyek.FirstOrDefault()?.Id ?? 0;
        }
        return Task.CompletedTask;
    }

    private Task TipusValtozottAsync(int tipusId)
    {
        if (_szerkesztesAlatt is null) return Task.CompletedTask;

        _szerkesztesAlatt.KarbantartasTipusId = tipusId;
        var tipus = _tipusok.FirstOrDefault(t => t.Id == tipusId);
        _esetiTipus = tipus?.Eseti ?? false;

        // Következő dátum automatikus számítása csak ha nincs manuális felülírás
        if (_esetiTipus)
        {
            _kovetkezoDatum = null;
            _manualisKovetkezoDatum = false;
        }
        else if (!_manualisKovetkezoDatum && _datum.HasValue && tipus is not null)
        {
            _kovetkezoDatum = _datum.Value.AddMonths(tipus.IsmetlodesHonap);
        }

        return Task.CompletedTask;
    }

    private Task DatumValtozottAsync(DateTime? ujDatum)
    {
        _datum = ujDatum;

        // Következő dátum újraszámítása ha nem eseti ÉS nincs manuális felülírás
        if (!_esetiTipus && !_manualisKovetkezoDatum && _datum.HasValue && _szerkesztesAlatt is not null)
        {
            var tipus = _tipusok.FirstOrDefault(t => t.Id == _szerkesztesAlatt.KarbantartasTipusId);
            if (tipus is not null)
            {
                _kovetkezoDatum = _datum.Value.AddMonths(tipus.IsmetlodesHonap);
            }
        }

        return Task.CompletedTask;
    }

    private Task KovetkezoDatumValtozottAsync(DateTime? ujDatum)
    {
        // Felhasználó manuálisan módosította a következő dátumot
        _kovetkezoDatum = ujDatum;
        _manualisKovetkezoDatum = true; // Jelöljük, hogy manuális módosítás történt

        return Task.CompletedTask;
    }

    private void DialogBezarasa() 
    { 
        _dialogNyitva = false; 
        _szerkesztesAlatt = null; 
        _masolasbol = false;   // ← visszaállítás
        _manualisKovetkezoDatum = false; // ← visszaállítás
    }

    // === ÚJ ÜGYFÉL GYORSHOZZÁADÁS ===
    private void UjUgyfelMegnyitasa()
    {
        var cegId = _elerhetoCegek.FirstOrDefault()?.Id ?? 0;

        _ujUgyfel = new Ugyfel
        {
            CegId = cegId,
            Aktiv = true,
            UgyfelTipus = UgyfelTipus.Kft,
            Tevekenyseg = TevekenysegTipus.VillanosMeres
        };
        _ujUgyfelDialogNyitva = true;
    }

    private async Task UjUgyfelMentesAsync()
    {
        if (_ujUgyfel is null || string.IsNullOrWhiteSpace(_ujUgyfel.Nev))
        {
            Snackbar.Add("Az ügyfél neve kötelező!", Severity.Warning);
            return;
        }

        _ujUgyfelMentes = true;
        try
        {
            await UgyfelService.CreateAsync(_ujUgyfel);

            // Frissítjük az ügyfelek listáját
            _ugyfelek = await UgyfelService.GetAllAsync();

            // Kiválasztjuk az új ügyfelet
            _kivalasztottUgyfelId = _ujUgyfel.Id;
            if (_szerkesztesAlatt is not null)
            {
                _szerkesztesAlatt.UgyfelId = _ujUgyfel.Id;
            }

            // Telephelyek frissítése (üres lesz az új ügyfélhez)
            _szurtTelephelyek = new List<Telephely>();

            Snackbar.Add($"Új ügyfél ({_ujUgyfel.Nev}) sikeresen létrehozva!", Severity.Success);
            _ujUgyfelDialogNyitva = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba az ügyfél mentésekor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ujUgyfelMentes = false;
        }
    }

    // === ÚJ TELEPHELY GYORSHOZZÁADÁS ===
    private void UjTelephelyMegnyitasa()
    {
        if (_kivalasztottUgyfelId == 0)
        {
            Snackbar.Add("Először válassz ügyfelet!", Severity.Warning);
            return;
        }

        _ujTelephely = new Telephely
        {
            UgyfelId = _kivalasztottUgyfelId,
            Aktiv = true
        };
        _ujTelephelyDialogNyitva = true;
    }

    private async Task UjTelephelyMentesAsync()
    {
        if (_ujTelephely is null || string.IsNullOrWhiteSpace(_ujTelephely.Nev))
        {
            Snackbar.Add("A telephely neve kötelező!", Severity.Warning);
            return;
        }

        _ujTelephelyMentes = true;
        try
        {
            await TelephelyService.CreateAsync(_ujTelephely);

            // Frissítjük a telephelyek listáját
            _telephelyek = await TelephelyService.GetAllAsync();
            _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == _kivalasztottUgyfelId).ToList();

            // Kiválasztjuk az új telephelyet
            if (_szerkesztesAlatt is not null)
            {
                _szerkesztesAlatt.TelephelyId = _ujTelephely.Id;
            }

            Snackbar.Add($"Új telephely ({_ujTelephely.Nev}) sikeresen létrehozva!", Severity.Success);
            _ujTelephelyDialogNyitva = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a telephely mentésekor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ujTelephelyMentes = false;
        }
    }

    private async Task MentesAsync()
    {
        if (_szerkesztesAlatt is null || _datum is null) { Snackbar.Add("A dátum megadása kötelező!", Severity.Warning); return; }
        if (_szerkesztesAlatt.UgyfelId == 0) { Snackbar.Add("Az ügyfél kiválasztása kötelező!", Severity.Warning); return; }
        if (_szerkesztesAlatt.TelephelyId == 0) { Snackbar.Add("A telephely kiválasztása kötelező!", Severity.Warning); return; }
        if (_szerkesztesAlatt.KarbantartasTipusId == 0) { Snackbar.Add("A típus kiválasztása kötelező!", Severity.Warning); return; }

        _szerkesztesAlatt.Datum = _datum.Value;
        _szerkesztesAlatt.KovetkezoDatum = _esetiTipus ? null : _kovetkezoDatum;

        // Duplikáció ellenőrzése csak új karbantartás esetén (nem szerkesztésnél)
        if (_szerkesztesAlatt.Id == 0)
        {
            var duplikalt = await KarbantartasService.EllenorizDuplikaciot(
                _szerkesztesAlatt.UgyfelId,
                _szerkesztesAlatt.TelephelyId,
                _szerkesztesAlatt.KarbantartasTipusId,
                _szerkesztesAlatt.Datum
            );

            if (duplikalt != null)
            {
                var valasz = await ShowKarbantartasDuplikacioDialog(duplikalt);
                if (valasz == "Mégsem")
                {
                    return; // Nem mentjük az új karbantartást
                }
                else if (valasz == "Igen")
                {
                    // Régi inaktívvá, új aktívként mentés
                    await KarbantartasService.InaktivvaTesz(duplikalt.Id);
                }
                // "Nem" esetén: régi változatlan marad, új mentésre kerül aktívként (alapértelmezett)
            }
        }

        _mentes = true;
        try
        {
            if (_szerkesztesAlatt.Id == 0) await KarbantartasService.CreateAsync(_szerkesztesAlatt);
            else await KarbantartasService.UpdateAsync(_szerkesztesAlatt);
            Snackbar.Add("Sikeres mentés!", Severity.Success); DialogBezarasa(); await BetoltesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        finally { _mentes = false; }
    }

    private async Task TorlesMegerosites(Karbantartas item)
    {
        if (await DialogService.ShowMessageBox("Törlés megerősítése", $"Biztosan törli ezt a karbantartást?", yesText: "Törlés", cancelText: "Mégse") == true)
        {
            try { await KarbantartasService.DeleteAsync(item.Id); Snackbar.Add("Törölve.", Severity.Success); await BetoltesAsync(); }
            catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        }
    }

    private async Task InaktivakMegnyitasa()
    {
        _inaktivBetoltes = true;
        _inaktivDialogNyitva = true;
        try
        {
            _inaktivLista = await KarbantartasService.GetInaktivakAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba az inaktív karbantartások betöltésekor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _inaktivBetoltes = false;
        }
    }

    private async Task<string> ShowKarbantartasDuplikacioDialog(Karbantartas regi)
    {
        var ugyfel = _ugyfelek.FirstOrDefault(u => u.Id == regi.UgyfelId)?.Nev ?? "?";
        var telephely = _telephelyek.FirstOrDefault(t => t.Id == regi.TelephelyId)?.Nev ?? "?";
        var tipus = _tipusok.FirstOrDefault(t => t.Id == regi.KarbantartasTipusId)?.Nev ?? "?";
        var regiDatumStr = regi.Datum.ToString("yyyy.MM.dd");
        var lejaratStr = regi.KovetkezoDatum?.ToString("yyyy.MM.dd") ?? "nincs megadva";

        var napKulonbseg = Math.Abs((_datum!.Value - regi.Datum).Days);

        var parameters = new DialogParameters
        {
            ["Uzenet"] = $"⚠️ Duplikáció észlelve!\n\n" +
                         $"Ugyanezen az ügyfélen, telephelyen és típussal már létezik karbantartás {napKulonbseg} napon belül:\n\n" +
                         $"📍 Ügyfél: {ugyfel}\n" +
                         $"📍 Telephely: {telephely}\n" +
                         $"📍 Típus: {tipus}\n" +
                         $"📅 Meglévő elvégzési dátum: {regiDatumStr}\n" +
                         $"📅 Következő karbantartás: {lejaratStr}\n\n" +
                         $"Szeretnéd a régit inaktívvá tenni?\n\n" +
                         $"• Igen → Régi inaktív lesz, új aktív állapottal mentésre kerül\n" +
                         $"• Nem → Régi változatlan marad, új is aktív állapottal kerül mentésre\n" +
                         $"• Mégsem → Régi változatlan marad, új nem kerül mentésre"
        };

        var dialog = await DialogService.ShowAsync<KarbantartasDuplikacioDialog>("Duplikált karbantartás", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            CloseButton = false
        });

        var result = await dialog.Result;
        if (result.Canceled) return "Mégsem";
        return result.Data?.ToString() ?? "Mégsem";
    }
