@page "/meresek"
@attribute [Authorize(Policy = "RequireMeresek")]
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Services.Interfaces
@inject IMeresService MeresService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject IMeresTipusService MeresTipusService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJegyzokonyvPdfService JegyzokonyvPdfService
@inject IJegyzokonyvWordService JegyzokonyvWordService
@inject IJSRuntime JS
@inject IEmailKuldoService EmailKuldoService
@inject ITenantService TenantService
@inject NavigationManager Navigation
@inject IMellekletJegyzokonyvService MellekletService
@inject ICegService CegService
@inject ILejaroOsszefoglaloService LejaroOsszefoglaloService

<PageTitle>Mérések</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Mérések</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField @bind-Value="_kereses" Label="Keresés (ügyfél, telephely, eredmény)" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Style="max-width:400px;" />
        <MudSelect T="string" @bind-Value="_datumSzuro" Label="Dátumszűrő" Clearable="true"
                   Style="max-width:220px;" AdornmentIcon="@Icons.Material.Filled.DateRange" Adornment="Adornment.Start"
                   Dense="true">
            <MudSelectItem Value="@("k30")">Következő 30 nap</MudSelectItem>
            <MudSelectItem Value="@("k90")">Következő 90 nap</MudSelectItem>
            <MudSelectItem Value="@("k180")">Következő 180 nap</MudSelectItem>
            <MudSelectItem Value="@("kiden")">Következő – Idén</MudSelectItem>
            <MudSelectItem Value="@("pm30")">± 30 nap</MudSelectItem>
            <MudSelectItem Value="@("pm90")">± 90 nap</MudSelectItem>
            <MudSelectItem Value="@("pm180")">± 180 nap</MudSelectItem>
            <MudSelectItem Value="@("iden")">Idén (egész év)</MudSelectItem>
        </MudSelect>
        <MudSpacer />
        <MudTooltip Text="@(_csoportositott ? "Lista nézet" : "Csoportosítás ügyfél szerint")">
            <MudIconButton Icon="@(_csoportositott ? Icons.Material.Filled.TableRows : Icons.Material.Filled.GroupWork)"
                           Color="@(_csoportositott ? Color.Primary : Color.Default)"
                           Variant="@(_csoportositott ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => _csoportositott = !_csoportositott)" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="UjMegnyitasa">Új mérés</MudButton>
    </MudStack>

    @if (!_csoportositott)
    {
        <MudDataGrid T="Meres" Items="_szurtLista" Filterable="false" SortMode="SortMode.Multiple" Hover="true" Striped="true" Loading="_betoltes">
            <Columns>
                <TemplateColumn Title="Ügyfél" Sortable="true" SortBy="@(m => m.Ugyfel?.Nev ?? "")">
                    <CellTemplate>
                        <div>
                            <div>@(context.Item.Ugyfel?.Nev ?? "-")</div>
                            @if (_elerhetoCegek.Count > 1 && context.Item.Ugyfel != null)
                            {
                                var szin = GetCegSzin(context.Item.Ugyfel.CegId);
                                var rovidites = GetCegRovidites(context.Item.Ugyfel.CegId);
                                var cegNev = GetCegNev(context.Item.Ugyfel.CegId);
                                <MudTooltip Text="@cegNev" Placement="Placement.Right">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px; margin-top:2px;")"
                                             Label="true">
                                        @rovidites
                                    </MudChip>
                                </MudTooltip>
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Telephely" Sortable="true" SortBy="@(m => m.Telephely?.Nev ?? "")">
                    <CellTemplate>
                        @{
                            var jSzam      = GetJegyzokonyvSzam(context.Item.Id);
                            var chipSzoveg = string.IsNullOrEmpty(jSzam) ? $"#{context.Item.Id}" : jSzam;
                            var tooltip    = string.IsNullOrEmpty(jSzam)
                                ? $"Mérés azonosítója: #{context.Item.Id}"
                                : $"#{context.Item.Id} · {jSzam}";
                        }
                        <div>
                            <div>@(context.Item.Telephely?.Nev ?? "-")</div>
                            <MudTooltip Text="@tooltip" Placement="Placement.Right">
                                <MudChip T="string" Size="Size.Small" Label="true"
                                         Variant="Variant.Outlined"
                                         Color="@(string.IsNullOrEmpty(jSzam) ? Color.Default : Color.Primary)"
                                         Style="font-size:10px; height:18px; margin-top:2px;">
                                    @chipSzoveg
                                </MudChip>
                            </MudTooltip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="m => m.MeresTipus!.Nev" Title="Típus" />
                <PropertyColumn Property="m => m.Datum" Title="Dátum" Format="yyyy.MM.dd" />
                <PropertyColumn Property="m => m.KovetkezoDatum" Title="Következő" Format="yyyy.MM.dd" />
                <PropertyColumn Property="m => m.Eredmeny" Title="Eredmény" />
                <PropertyColumn Property="m => m.MeresStatusz" Title="Státusz" />
                <TemplateColumn Title="" Sortable="false" HeaderStyle="width:40px">
                    <CellTemplate>
                        @{
                            var tipusKod = _tipusok.FirstOrDefault(t => t.Id == context.Item.MeresTipusId)?.MellekletTipusKod;
                            var vanMelleklet = _meresIdsWithMelleklet.Contains(context.Item.Id) && tipusKod != "AVK";
                        }
                        @if (vanMelleklet)
                        {
                            <MudTooltip Text="Van melléklet">
                                <MudIconButton Icon="@Icons.Material.Filled.Attachment"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               OnClick="@(async () => await SzerkesztesMegnyitasa(context.Item))" />
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Műveletek" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudTooltip Text="Word jegyzőkönyv">
                                <MudIconButton Icon="@Icons.Material.Filled.Description"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="() => WordLetoltesAsync(context.Item)" />
                            </MudTooltip>
                            <MudTooltip Text="Email küldése">
                                <MudIconButton Icon="@Icons.Material.Filled.Email"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               OnClick="() => EmailKuldesDialogusMegnyitasa(context.Item)" />
                            </MudTooltip>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="() => SzerkesztesMegnyitasa(context.Item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => TorlesMegerosites(context.Item)" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent><MudText>Nincs megjeleníthető mérés.</MudText></NoRecordsContent>
        </MudDataGrid>
    }
    else
    {
        @if (_betoltes)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
        else if (!_szurtLista.Any())
        {
            <MudText Class="pa-4 ml-2">Nincs megjeleníthető mérés.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Class="mt-1">
                @foreach (var csoport in _szurtLista.GroupBy(m => m.UgyfelId).OrderBy(g => g.FirstOrDefault()?.Ugyfel?.Nev ?? ""))
                {
                    var ugyfelNev = csoport.FirstOrDefault()?.Ugyfel?.Nev ?? "-";
                    var cegId    = csoport.FirstOrDefault()?.Ugyfel?.CegId ?? 0;
                    var meresek  = csoport.OrderBy(m => m.KovetkezoDatum).ToList();

                    <MudExpansionPanel IsInitiallyExpanded="true">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1"><b>@ugyfelNev</b></MudText>
                                @if (_elerhetoCegek.Count > 1)
                                {
                                    var szin      = GetCegSzin(cegId);
                                    var rovidites = GetCegRovidites(cegId);
                                    var cegNev    = GetCegNev(cegId);
                                    <MudTooltip Text="@cegNev">
                                        <MudChip T="string" Size="Size.Small" Label="true"
                                                 Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px;")">
                                            @rovidites
                                        </MudChip>
                                    </MudTooltip>
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @meresek.Count mérés
                                </MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudTable T="Meres" Items="@meresek" Hover="true" Dense="true" Striped="true"
                                      Breakpoint="Breakpoint.Sm" Class="mb-2">
                                <HeaderContent>
                                    <MudTh>Telephely</MudTh>
                                    <MudTh>Típus</MudTh>
                                    <MudTh>Dátum</MudTh>
                                    <MudTh>Következő</MudTh>
                                    <MudTh>Eredmény</MudTh>
                                    <MudTh>Státusz</MudTh>
                                    <MudTh Style="width:40px;"></MudTh>
                                    <MudTh>Műveletek</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    @{
                                        var tk = _tipusok.FirstOrDefault(t => t.Id == context.MeresTipusId)?.MellekletTipusKod;
                                        var vm = _meresIdsWithMelleklet.Contains(context.Id) && tk != "AVK";
                                    }
                                    <MudTd DataLabel="Telephely">
                                        @{
                                            var jSzam      = GetJegyzokonyvSzam(context.Id);
                                            var chipSzoveg = string.IsNullOrEmpty(jSzam) ? $"#{context.Id}" : jSzam;
                                            var tooltip    = string.IsNullOrEmpty(jSzam)
                                                ? $"Mérés azonosítója: #{context.Id}"
                                                : $"#{context.Id} · {jSzam}";
                                        }
                                        <div>
                                            <div>@(context.Telephely?.Nev ?? "-")</div>
                                            <MudTooltip Text="@tooltip" Placement="Placement.Right">
                                                <MudChip T="string" Size="Size.Small" Label="true"
                                                         Variant="Variant.Outlined"
                                                         Color="@(string.IsNullOrEmpty(jSzam) ? Color.Default : Color.Primary)"
                                                         Style="font-size:10px; height:18px; margin-top:2px;">
                                                    @chipSzoveg
                                                </MudChip>
                                            </MudTooltip>
                                        </div>
                                    </MudTd>
                                    <MudTd DataLabel="Típus">@(context.MeresTipus?.Nev ?? "-")</MudTd>
                                    <MudTd DataLabel="Dátum">@context.Datum.ToString("yyyy.MM.dd")</MudTd>
                                    <MudTd DataLabel="Következő">@(context.KovetkezoDatum?.ToString("yyyy.MM.dd") ?? "-")</MudTd>
                                    <MudTd DataLabel="Eredmény">@(context.Eredmeny ?? "-")</MudTd>
                                    <MudTd DataLabel="Státusz">@context.MeresStatusz</MudTd>
                                    <MudTd>
                                        @if (vm)
                                        {
                                            <MudTooltip Text="Van melléklet">
                                                <MudIconButton Icon="@Icons.Material.Filled.Attachment"
                                                               Color="Color.Warning" Size="Size.Small"
                                                               OnClick="@(async () => await SzerkesztesMegnyitasa(context))" />
                                            </MudTooltip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Műveletek">
                                        <MudStack Row="true" Spacing="1">
                                            <MudTooltip Text="Word jegyzőkönyv">
                                                <MudIconButton Icon="@Icons.Material.Filled.Description"
                                                               Color="Color.Info" Size="Size.Small"
                                                               OnClick="() => WordLetoltesAsync(context)" />
                                            </MudTooltip>
                                            <MudTooltip Text="Email küldése">
                                                <MudIconButton Icon="@Icons.Material.Filled.Email"
                                                               Color="Color.Secondary" Size="Size.Small"
                                                               OnClick="() => EmailKuldesDialogusMegnyitasa(context)" />
                                            </MudTooltip>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary" Size="Size.Small"
                                                           OnClick="() => SzerkesztesMegnyitasa(context)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error" Size="Size.Small"
                                                           OnClick="() => TorlesMegerosites(context)" />
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
</MudPaper>

<!-- Email küldés dialógus -->
<MudDialog @bind-Visible="_emailDialogNyitva"
           Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" />
            Email értesítés küldése
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_emailMeres is not null)
        {
            <MudToggleGroup T="bool" @bind-Value="_osszefoglaloMod"
                            Color="Color.Primary" CheckMark="true" Rounded="true" Class="mb-4" Exclusive="true">
                <MudToggleItem Value="false" Text="Adott mérés értesítés" />
                <MudToggleItem Value="true"  Text="@($"Összefoglaló – következő 30 nap")" />
            </MudToggleGroup>

            @if (!_osszefoglaloMod)
            {
                <!-- Eredeti – egy mérésre -->
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                    <b>@_emailMeres.Ugyfel?.Nev</b> – @_emailMeres.MeresTipus?.Nev<br/>
                    Következő: @_emailMeres.KovetkezoDatum?.ToString("yyyy.MM.dd")
                </MudAlert>

                <MudSelect T="EmailErtesitesTipus" @bind-Value="_kivalasztottEmailTipus"
                           Label="Értesítés típusa *" Required="true" Class="mb-3">
                    <MudSelectItem Value="EmailErtesitesTipus.MeresLejarat90Nap">Mérés lejárat – 90 nap</MudSelectItem>
                    <MudSelectItem Value="EmailErtesitesTipus.MeresLejarat30Nap">Mérés lejárat – 30 nap</MudSelectItem>
                </MudSelect>
            }
            else
            {
                <!-- Összefoglaló mód – előnézet betöltése -->
                @if (_osszefoglaloToltes)
                {
                    <MudProgressLinear Indeterminate="true" Class="mb-3" />
                }
                else if (_emailOsszefoglalo is not null)
                {
                    @if (!_emailOsszefoglalo.VanTetel)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3">
                            Nincs lejáró tétel a következő 30 napban ennél az ügyfélnél.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                            <b>@_emailOsszefoglalo.UgyfelNev</b> – összesen
                            <b>@_emailOsszefoglalo.OsszesSzam tétel</b> jár le a következő 30 napban.
                        </MudAlert>
                        <MudSimpleTable Dense="true" Hover="true" Class="mb-3" Style="font-size:13px;">
                            <thead>
                                <tr>
                                    <th>Kategória</th>
                                    <th style="text-align:center;">Db</th>
                                    <th>Legközelebbi lejárat</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_emailOsszefoglalo.Meresek.Any())
                                {
                                    <tr>
                                        <td>⚡ Mérések</td>
                                        <td style="text-align:center;">@_emailOsszefoglalo.Meresek.Count</td>
                                        <td style="color:#C62828;font-weight:600;">
                                            @_emailOsszefoglalo.Meresek.Min(m => m.KovetkezoDatum)?.ToString("yyyy.MM.dd")
                                        </td>
                                    </tr>
                                }
                                @if (_emailOsszefoglalo.Hitelesitesek.Any())
                                {
                                    <tr>
                                        <td>🔬 Hitelesítések</td>
                                        <td style="text-align:center;">@_emailOsszefoglalo.Hitelesitesek.Count</td>
                                        <td style="color:#C62828;font-weight:600;">
                                            @_emailOsszefoglalo.Hitelesitesek.Min(h => h.LejaratDatum)?.ToString("yyyy.MM.dd")
                                        </td>
                                    </tr>
                                }
                                @if (_emailOsszefoglalo.Karbantartasok.Any())
                                {
                                    <tr>
                                        <td>🔧 Karbantartások</td>
                                        <td style="text-align:center;">@_emailOsszefoglalo.Karbantartasok.Count</td>
                                        <td style="color:#C62828;font-weight:600;">
                                            @_emailOsszefoglalo.Karbantartasok.Min(k => k.KovetkezoDatum)?.ToString("yyyy.MM.dd")
                                        </td>
                                    </tr>
                                }
                                @if (_emailOsszefoglalo.Kockazatok.Any())
                                {
                                    <tr>
                                        <td>📋 Kockázatértékelések</td>
                                        <td style="text-align:center;">@_emailOsszefoglalo.Kockazatok.Count</td>
                                        <td style="color:#C62828;font-weight:600;">
                                            @_emailOsszefoglalo.Kockazatok.Min(k => k.KovetkezoFelulvizsgalat)?.ToString("yyyy.MM.dd")
                                        </td>
                                    </tr>
                                }
                                @if (_emailOsszefoglalo.Zonaterkepek.Any())
                                {
                                    <tr>
                                        <td>🗺️ Zónatérképek</td>
                                        <td style="text-align:center;">@_emailOsszefoglalo.Zonaterkepek.Count</td>
                                        <td style="color:#C62828;font-weight:600;">
                                            @_emailOsszefoglalo.Zonaterkepek.Min(z => z.ErvenyessegVege)?.ToString("yyyy.MM.dd")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            }

            <MudTextField @bind-Value="_emailCimzett" Label="Címzett email cím *" Required="true"
                          InputType="InputType.Email" HelperText="Az ügyfél vagy telephely email címe" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _emailDialogNyitva = false">Mégse</MudButton>
        <MudButton OnClick="EmailKuldesAsync" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_emailKuldes || (_osszefoglaloMod && _emailOsszefoglalo is { VanTetel: false }))"
                   StartIcon="@Icons.Material.Filled.Send">
            @(_emailKuldes ? "Küldés..." : "Küldés")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_dialogNyitva" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(_szerkesztesAlatt?.Id > 0 ? "Mérés szerkesztése" : "Új mérés")</MudText></TitleContent>
    <DialogContent>
        @if (_szerkesztesAlatt is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_szerkesztesAlatt.UgyfelId" Label="Ügyfél *" 
                               ValueChanged="@((int id) => UgyfelValtozottAsync(id))"
                               ToStringFunc="@(id => _ugyfelek.FirstOrDefault(u => u.Id == id)?.Nev ?? "")">
                        @foreach (var u in _ugyfelek)
                        {
                            <MudSelectItem Value="@u.Id">@u.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_szerkesztesAlatt.TelephelyId" Label="Telephely *"
                               Disabled="@(_szurtTelephelyek.Count == 0)"
                               ToStringFunc="@(id => _szurtTelephelyek.FirstOrDefault(t => t.Id == id)?.Nev ?? "")">
                        @foreach (var t in _szurtTelephelyek)
                        {
                            <MudSelectItem Value="@t.Id">@t.Nev (@t.Cim)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_szerkesztesAlatt.MeresTipusId" 
                               ValueChanged="OnMeresTipusValtozas"
                               Label="Típus *"
                               ToStringFunc="@(id => _tipusok.FirstOrDefault(t => t.Id == id)?.Nev ?? "")">
                        @foreach (var t in _tipusok)
                        {
                            <MudSelectItem Value="@t.Id">@t.Nev @(t.ErvenyessegHonap.HasValue && t.ErvenyessegHonap > 0 ? $"({t.ErvenyessegHonap} hónap)" : "")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6"><MudDatePicker Date="_datum" DateChanged="OnDatumValtozas" Label="Dátum *" DateFormat="yyyy.MM.dd" /></MudItem>
                <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_kovetkezoDatum" Label="Következő dátum (auto)" DateFormat="yyyy.MM.dd" /></MudItem>                                        
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Class="mb-1">Eredmény</MudText>
                    <MudToggleGroup T="string" @bind-Value="_szerkesztesAlatt.Eredmeny" 
                                    Color="Color.Primary" 
                                    Rounded="true" 
                                    CheckMark="true">
                        <MudToggleItem Value="@("MEGFELELT")" Text="Megfelelt" />
                        <MudToggleItem Value="@("NEM MEGFELELT")" Text="Nem megfelelt" />
                    </MudToggleGroup>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="MeresStatusz" @bind-Value="_szerkesztesAlatt.MeresStatusz" Label="Státusz">
                        @foreach (MeresStatusz s in Enum.GetValues(typeof(MeresStatusz)))
                        {
                            <MudSelectItem Value="@s">@s</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_szerkesztesAlatt.Megjegyzes" Label="Megjegyzés" Lines="2" /></MudItem>

                @* === FŐJEGYZŐKÖNYV / SZERKESZTÉS GOMB === *@
                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                </MudItem>
                <MudItem xs="12">
                    @if (IsOnalloAvk)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ElectricalServices"
                                   FullWidth="true"
                                   OnClick="@(() => { _dialogNyitva = false; Navigation.NavigateTo($"/avk-szerkeszto/meres/{_szerkesztesAlatt!.Id}"); })">
                            ÁVK mérési adatok szerkesztése
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.EditNote"
                                   FullWidth="true"
                                   OnClick="@(() => { _dialogNyitva = false; Navigation.NavigateTo($"/jegyzokonyv/{_szerkesztesAlatt!.Id}"); })">
                            Főjegyőkönyv megnyitása / szerkesztése
                        </MudButton>
                    }
                </MudItem>

                @* === MELLÉKLET JEGYZŐKÖNYVEK – csak nem-önálló AVK esetén === *@
                @if (!IsOnalloAvk && _szerkesztettMellekletek.Count > 0)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="mr-1" />
                            Melléklet jegyzőkönyvek
                        </MudText>
                    </MudItem>
                    @foreach (var m in _szerkesztettMellekletek)
                    {
                        <MudItem xs="12">
                            <MudPaper Outlined="true" Class="pa-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <div>
                                        <MudText Typo="Typo.body2"><b>@MellekletJegyzokonyv.TipusNev(m.Tipus)</b></MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@m.Szam</MudText>
                                    </div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudChip T="string"
                                                 Color="@(m.KeszeE ? Color.Success : Color.Warning)"
                                                 Size="Size.Small"
                                                 OnClick="@(async () => await MellekletStatuszValtas(m))"
                                                 Style="cursor:pointer;"
                                                 Icon="@(m.KeszeE ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)">
                                            @(m.KeszeE ? "Kész" : "Folyamatban")
                                        </MudChip>
                                        @if (m.KeszeE && m.MellekletMeresId.HasValue)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                           Color="Color.Success"
                                                           Size="Size.Small"
                                                           Title="Word letöltése"
                                                           OnClick="@(async () => await MellekletWordLetoltes(m))" />
                                        }
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@(m.MellekletMeresId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)"
                                                   OnClick="@(async () => await MellekletSzerkesztes(m))">
                                            @(m.MellekletMeresId.HasValue ? "Szerkesztés" : "Megnyitás")
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="DialogBezarasa">Mégse</MudButton>
        <MudButton OnClick="MentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_mentes">@(_mentes ? "Mentés..." : "Mentés")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Meres> _lista = new();
    private List<Ugyfel> _ugyfelek = new();
    private List<Telephely> _telephelyek = new();
    private List<Telephely> _szurtTelephelyek = new();
    private List<MeresTipus> _tipusok = new();
    private List<MellekletJegyzokonyv> _szerkesztettMellekletek = [];
    private string _kereses = string.Empty;
    private bool _betoltes = true, _dialogNyitva = false, _mentes = false;
    private Meres? _szerkesztesAlatt;
    private bool _csoportositott = true;

    // HIÁNYZÓ DEKLARÁCIÓK:
    private int _cegId;
    private int _kivalasztottUgyfelId;
    private DateTime? _datum;
    private DateTime? _kovetkezoDatum;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    
    // Email küldés
    private bool _emailDialogNyitva = false;
    private bool _emailKuldes = false;
    private Meres? _emailMeres;
    private EmailErtesitesTipus _kivalasztottEmailTipus = EmailErtesitesTipus.MeresLejarat90Nap;
    private string _emailCimzett = "";

    // Összefoglaló email
    private bool _osszefoglaloMod = false;
    private bool _osszefoglaloToltes = false;
    private LejaroOsszefoglalo? _emailOsszefoglalo;

    // A meglévő _emailCimzett után (263. sor környékére) ADD HOZZÁ:
    private HashSet<int> _mellekletMeresIds = new();
    private HashSet<int> _meresIdsWithMelleklet = new();
    private Dictionary<int, string> _jegyzokonyvSzamok = new();

    private string GetJegyzokonyvSzam(int meresId)
        => _jegyzokonyvSzamok.TryGetValue(meresId, out var szam) ? szam : string.Empty;

    private string? _datumSzuro;

    private IEnumerable<Meres> _szurtLista
    {
        get
        {
            var ma = DateTime.Today;
            var hatarNap = ma.AddDays(60);

            IEnumerable<Meres> lista = _lista.Where(m => !_mellekletMeresIds.Contains(m.Id));

            if (_szuroParam == "lejaro")
                lista = lista.Where(m => m.KovetkezoDatum.HasValue
                    && m.KovetkezoDatum.Value > ma
                    && m.KovetkezoDatum.Value <= hatarNap);
            else if (_szuroParam == "lejart")
                lista = lista.Where(m => m.KovetkezoDatum.HasValue
                    && m.KovetkezoDatum.Value < ma);

            // Dátumintervallum szűrő
            lista = _datumSzuro switch
            {
                "k30" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma && m.KovetkezoDatum.Value <= ma.AddDays(30)),
                "k90" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma && m.KovetkezoDatum.Value <= ma.AddDays(90)),
                "k180" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma && m.KovetkezoDatum.Value <= ma.AddDays(180)),
                "kiden" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma && m.KovetkezoDatum.Value.Year == ma.Year),
                "pm30" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma.AddDays(-30) && m.KovetkezoDatum.Value <= ma.AddDays(30)),
                "pm90" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma.AddDays(-90) && m.KovetkezoDatum.Value <= ma.AddDays(90)),
                "pm180" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value >= ma.AddDays(-180) && m.KovetkezoDatum.Value <= ma.AddDays(180)),
                "iden" => lista.Where(m => m.KovetkezoDatum.HasValue && m.KovetkezoDatum.Value.Year == ma.Year),
                _ => lista
            };

            if (!string.IsNullOrWhiteSpace(_kereses))
                lista = lista.Where(m =>
                    (m.Ugyfel?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Telephely?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Eredmeny?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false));

            return lista;
        }
    }

    [SupplyParameterFromQuery(Name = "szuro")]
    private string? _szuroParam { get; set; }

    // OnInitializedAsync-ban, BetoltesAsync után:
    protected override async Task OnInitializedAsync()
    {
        _cegId = TenantService.GetCurrentCegId();
        _ugyfelek = await UgyfelService.GetAllAsync();
        _telephelyek = await TelephelyService.GetAllAsync();
        _tipusok = await MeresTipusService.GetAllAsync();
        
        // Multi-tenant cég badge betöltés
        var elerhhetoCegIds = await TenantService.GetElerhhetoCegIdsAsync();
        if (elerhhetoCegIds.Count > 1)
        {
            var osszesCeg = await CegService.GetAllAsync(csakAktiv: false);
            _elerhetoCegek = osszesCeg
                .Where(c => elerhhetoCegIds.Contains(c.Id))
                .OrderBy(c => c.Id == _cegId ? 0 : 1)
                .ThenBy(c => c.Nev)
                .ToList();
        }
        
        await BetoltesAsync();
    }

    private async Task BetoltesAsync()
    {
        _betoltes = true;
        _lista = await MeresService.GetAllAsync();
        _mellekletMeresIds = await MellekletService.GetMellekletMeresIdsAsync();
        _meresIdsWithMelleklet = await MellekletService.GetMeresIdsWithMellekletAsync();

        // Jkv. számok kinyerése a JSON-ból – egyszeri parse, betöltéskor
        _jegyzokonyvSzamok = _lista
            .Where(m => !string.IsNullOrEmpty(m.JegyzokonyvAdatokJson))
            .Select(m =>
            {
                try
                {
                    var adatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
                        m.JegyzokonyvAdatokJson!,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    return (m.Id, Szam: adatok?.JegyzokonyvSzam ?? "");
                }
                catch { return (m.Id, Szam: ""); }
            })
            .Where(x => !string.IsNullOrEmpty(x.Szam))
            .ToDictionary(x => x.Id, x => x.Szam);

        _betoltes = false;
    }

    private void UjMegnyitasa() 
    { 
        var elsoTipus = _tipusok.FirstOrDefault();
        
        _szerkesztesAlatt = new Meres 
        { 
            MeresTipusId = elsoTipus?.Id ?? 0
        }; 
        _datum = DateTime.Today; 
        _kovetkezoDatum = null; 
        _kivalasztottUgyfelId = 0;
        _szurtTelephelyek = new();
        
        // Következő dátum számolása rögtön
        SzamolKovetkezoDatum();
        
        _dialogNyitva = true; 
    }

    private async Task SzerkesztesMegnyitasa(Meres item)
    {
        _szerkesztesAlatt = new Meres
        {
            Id = item.Id,
            UgyfelId = item.UgyfelId,
            TelephelyId = item.TelephelyId,
            MeresTipusId = item.MeresTipusId,
            Eredmeny = item.Eredmeny,
            MeresStatusz = item.MeresStatusz,
            Megjegyzes = item.Megjegyzes
        };
        _kivalasztottUgyfelId = item.UgyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == _kivalasztottUgyfelId).ToList();
        _datum = item.Datum;
        _kovetkezoDatum = item.KovetkezoDatum;

        // Ha nincs elmentett következő dátum, számoljuk ki automatikusan
        if (_kovetkezoDatum == null)
            SzamolKovetkezoDatum();

        // Mellékletek betöltése
        _szerkesztettMellekletek = await MellekletService.GetByMeresIdAsync(item.Id);

        _dialogNyitva = true;
        StateHasChanged();
    }

    private Task UgyfelValtozottAsync(int ugyfelId)
    {
        _kivalasztottUgyfelId = ugyfelId;
        _szurtTelephelyek = _telephelyek.Where(t => t.UgyfelId == ugyfelId).ToList();
        if (_szerkesztesAlatt is not null)
        {
            _szerkesztesAlatt.UgyfelId = ugyfelId;
            _szerkesztesAlatt.TelephelyId = _szurtTelephelyek.FirstOrDefault()?.Id ?? 0;
        }
        return Task.CompletedTask;
    }

    private void OnMeresTipusValtozas(int ujTipusId)
    {
        if (_szerkesztesAlatt != null)
        {
            _szerkesztesAlatt.MeresTipusId = ujTipusId;
            SzamolKovetkezoDatum();
        }
    }

    private void OnDatumValtozas(DateTime? ujDatum)
    {
        _datum = ujDatum;
        SzamolKovetkezoDatum();
    }

    /// <summary>Automatikusan kiszámolja a következő mérés dátumát a típus érvényességi ideje alapján.</summary>
    private void SzamolKovetkezoDatum()
    {
        if (_szerkesztesAlatt == null || _datum == null || _szerkesztesAlatt.MeresTipusId == 0) 
            return;

        var tipus = _tipusok.FirstOrDefault(t => t.Id == _szerkesztesAlatt.MeresTipusId);
        if (tipus != null && tipus.ErvenyessegHonap.HasValue && tipus.ErvenyessegHonap > 0)
        {
            _kovetkezoDatum = _datum.Value.AddMonths(tipus.ErvenyessegHonap.Value);
            StateHasChanged();
        }
    }

    private void DialogBezarasa() { _dialogNyitva = false; _szerkesztesAlatt = null; }

    private async Task MentesAsync()
    {
        if (_szerkesztesAlatt is null || _datum is null) { Snackbar.Add("A dátum megadása kötelező!", Severity.Warning); return; }
        if (_szerkesztesAlatt.UgyfelId == 0) { Snackbar.Add("Az ügyfél kiválasztása kötelező!", Severity.Warning); return; }
        if (_szerkesztesAlatt.TelephelyId == 0) { Snackbar.Add("A telephely kiválasztása kötelező!", Severity.Warning); return; }
        if (_szerkesztesAlatt.MeresTipusId == 0) { Snackbar.Add("A típus kiválasztása kötelező!", Severity.Warning); return; }

        // Ha a következő dátum még nincs kiszámolva (pl. új mérés), számoljuk ki mentés előtt
        if (_kovetkezoDatum == null)
            SzamolKovetkezoDatum();

        _szerkesztesAlatt.Datum = _datum.Value;
        _szerkesztesAlatt.KovetkezoDatum = _kovetkezoDatum;
        _mentes = true;
        try
        {
            if (_szerkesztesAlatt.Id == 0) await MeresService.CreateAsync(_szerkesztesAlatt);
            else await MeresService.UpdateAsync(_szerkesztesAlatt);
            Snackbar.Add("Sikeres mentés!", Severity.Success); DialogBezarasa(); await BetoltesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        finally { _mentes = false; }
    }

    private async Task TorlesMegerosites(Meres item)
    {
        if (await DialogService.ShowMessageBox("Törlés megerősítése", $"Biztosan törli ezt a mérést?", yesText: "Törlés", cancelText: "Mégse") == true)
        {
            try { await MeresService.DeleteAsync(item.Id); Snackbar.Add("Törölve.", Severity.Success); await BetoltesAsync(); }
            catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        }
    }

    private async Task JegyzokonyvLetoltesAsync(Meres meres)
    {
        try
        {
            var pdfBytes = await JegyzokonyvPdfService.GeneralasAsync(meres.Id);
            var fileName = $"jegyzokonyv_{meres.Id}_{DateTime.Now:yyyyMMdd}.pdf";
            
            // Letöltés böngészőben
            using var streamRef = new DotNetStreamReference(new MemoryStream(pdfBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            
            Snackbar.Add("Jegyzőkönyv letöltve!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
    }

    private async Task WordLetoltesAsync(Meres meres)
    {
        try
        {
            var wordBytes = await JegyzokonyvWordService.GeneralasAsync(meres.Id);
            var fileName = $"jegyzokonyv_{meres.Id:D6}_{DateTime.Now:yyyyMMdd}.docx";
            
            using var streamRef = new DotNetStreamReference(new MemoryStream(wordBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            
            Snackbar.Add("Word jegyzőkönyv letöltve!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
    }

    private async Task EmailKuldesDialogusMegnyitasa(Meres meres)
    {
        _emailMeres = meres;
        _kivalasztottEmailTipus = EmailErtesitesTipus.MeresLejarat30Nap;
        _emailCimzett = meres.Telephely?.Email ?? meres.Ugyfel?.Email ?? "";
        _osszefoglaloMod = false;
        _emailOsszefoglalo = null;
        _emailDialogNyitva = true;

        // Előre betöltjük az összefoglalót a háttérben
        _ = Task.Run(async () =>
        {
            _osszefoglaloToltes = true;
            await InvokeAsync(StateHasChanged);
            _emailOsszefoglalo = await LejaroOsszefoglaloService.GetOsszefoglaloAsync(meres.UgyfelId, 30);
            _osszefoglaloToltes = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task EmailKuldesAsync()
    {
        if (_emailMeres is null || string.IsNullOrWhiteSpace(_emailCimzett))
        {
            Snackbar.Add("Kérjük adja meg a címzett email címét!", Severity.Warning);
            return;
        }

        _emailKuldes = true;
        try
        {
            bool siker;

            if (_osszefoglaloMod)
            {
                siker = await LejaroOsszefoglaloService.KuldOsszefoglaloEmailtAsync(
                    _emailMeres.UgyfelId, _emailCimzett, 30, _cegId);
            }
            else
            {
                var placeholderek = new Dictionary<string, string>
                {
                    { "UgyfelNev",      _emailMeres.Ugyfel?.Nev ?? "" },
                    { "TelephelyNev",   _emailMeres.Telephely?.Nev ?? "" },
                    { "MeresTipus",     _emailMeres.MeresTipus?.Nev ?? "" },
                    { "LejaratDatum",   _emailMeres.KovetkezoDatum?.ToString("yyyy.MM.dd") ?? "" },
                    { "EszkozTipus",    "" },
                    { "CegNev",         "" }
                };
                siker = await EmailKuldoService.KuldSablonbolAsync(
                    _kivalasztottEmailTipus, _emailCimzett, placeholderek, _cegId, meresId: _emailMeres.Id);
            }

            if (siker)
            {
                Snackbar.Add($"Email sikeresen elküldve: {_emailCimzett}", Severity.Success);
                _emailDialogNyitva = false;
            }
            else
            {
                Snackbar.Add("Email küldése sikertelen! Ellenőrizd az SMTP beállításokat.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
        finally
        {
            _emailKuldes = false;
        }
    }

    private void JegyzokonyvSzerkesztes(Meres meres)
    {
        Navigation.NavigateTo($"/jegyzokonyv/{meres.Id}");
    }

    private async Task MellekletSzerkesztes(MellekletJegyzokonyv m)
    {
        _dialogNyitva = false;

        if (m.Tipus == "AVK")
        {
            Navigation.NavigateTo($"/avk-szerkeszto/{m.Id}");
            return;
        }

        if (m.Tipus == "HVM")
        {
            Navigation.NavigateTo($"/hvm-szerkeszto/{m.Id}");
            return;
        }

        if (m.MellekletMeresId.HasValue)
        {
            Navigation.NavigateTo($"/jegyzokonyv/{m.MellekletMeresId.Value}");
            return;
        }

        var mellekletTipus = _tipusok.FirstOrDefault(t =>
            !string.IsNullOrEmpty(t.MellekletTipusKod) &&
            t.MellekletTipusKod == m.Tipus);

        if (mellekletTipus == null)
        {
            Snackbar.Add(
                $"Nem található méréstípus a(z) '{m.Tipus}' melléklet kódhoz. " +
                "Az Admin → Méréstípusok felületen add meg a Melléklet típus kódot!",
                Severity.Warning);
            return;
        }

        try
        {
            var ujMeresId = await MellekletService.MellekletMeresLetrehozAsync(
                m.Id, mellekletTipus.Id, new BiztvillCRM.Shared.Models.JegyzokonyvAdatok());
            Navigation.NavigateTo($"/jegyzokonyv/{ujMeresId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a melléklet mérés létrehozásakor: {ex.Message}", Severity.Error);
        }
    }

    private async Task MellekletStatuszValtas(MellekletJegyzokonyv melleklet)
    {
        var ujStatusz = melleklet.KeszeE
            ? MellekletStatusz.Folyamatban
            : MellekletStatusz.Kesz;

        var megerosites = await DialogService.ShowMessageBox(
            melleklet.KeszeE ? "Visszaállítás" : "Megjelölés késznek",
            melleklet.KeszeE
                ? $"Biztosan visszaállítod '{melleklet.Szam}' státuszát?"
                : $"Megjelölöd készként: '{melleklet.Szam}'?",
            yesText: "Igen", cancelText: "Mégsem");

        if (megerosites != true) return;

        await MellekletService.StatuszFrissitesAsync(melleklet.Id, ujStatusz);
        melleklet.Statusz = ujStatusz; // lokális frissítés
        Snackbar.Add($"{melleklet.Szam} → {(ujStatusz == MellekletStatusz.Kesz ? "Kész ✓" : "Folyamatban")}", Severity.Success);
        StateHasChanged();
    }
    private async Task MellekletWordLetoltes(MellekletJegyzokonyv melleklet)
    {
        // HVM: saját szerkesztőbe navigálás
        if (melleklet.Tipus == "HVM")
        {
            _dialogNyitva = false;
            Navigation.NavigateTo($"/hvm-szerkeszto/{melleklet.Id}");
            return;
        }

        // Ha nincs még MellekletMeresId: a szerkesztőt kell előbb megnyitni (MEGNYITÁS gomb)
        if (!melleklet.MellekletMeresId.HasValue)
        {
            Snackbar.Add("A Word letöltéshez először nyissa meg a melléklet szerkesztőjét (MEGNYITÁS gomb) és mentse el az adatokat!", Severity.Warning);
            return;
        }

        try
        {
            var mellekletTipus = _tipusok.FirstOrDefault(t => t.MellekletTipusKod == melleklet.Tipus);
            var sablonId = mellekletTipus?.SablonId;
            if (string.IsNullOrEmpty(sablonId))
            {
                Snackbar.Add($"Nincs Word sablon a '{melleklet.Tipus}' típushoz!", Severity.Warning);
                return;
            }

            var avkMeres = await MeresService.GetByIdAsync(melleklet.MellekletMeresId.Value);
            if (avkMeres == null) { Snackbar.Add("Mérés nem található!", Severity.Error); return; }

            JegyzokonyvAdatok adatok = new();
            if (!string.IsNullOrEmpty(avkMeres.JegyzokonyvAdatokJson))
                adatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
                    avkMeres.JegyzokonyvAdatokJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

            var wordBytes = await JegyzokonyvWordService.GeneralasAsync(
                melleklet.MellekletMeresId.Value, adatok, sablonId);

            if (wordBytes is { Length: > 0 })
            {
                var fajlNev = $"{melleklet.Szam.Replace("/", "-")}.docx";
                await JS.InvokeVoidAsync("downloadFileFromBytes", fajlNev,
                    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                    wordBytes);
            }
            else
                Snackbar.Add("Word dokumentum nem generálható (sablon hiányzik?).", Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add($"Word letöltés hiba: {ex.Message}", Severity.Error); }
    }

    private bool IsOnalloAvk => _szerkesztesAlatt != null && _tipusok.FirstOrDefault(t => t.Id == _szerkesztesAlatt.MeresTipusId)?.MellekletTipusKod == "AVK";

    private List<Ceg> _elerhetoCegek = new();

    private static readonly string[] _cegSzinek =
    [
        "#1976D2", "#F57C00", "#388E3C", "#7B1FA2", "#C62828", "#00838F",
    ];

    private string GetCegSzin(int cegId)
    {
        if (_elerhetoCegek.Count <= 1) return "";
        var index = _elerhetoCegek.FindIndex(c => c.Id == cegId);
        return _cegSzinek[Math.Max(0, index) % _cegSzinek.Length];
    }

    private string GetCegRovidites(int cegId)
    {
        var ceg = _elerhetoCegek.FirstOrDefault(c => c.Id == cegId);
        if (ceg == null) return "?";
        return ceg.MatricaElotag
            ?? new string(ceg.Nev.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpper();
    }

    private string GetCegNev(int cegId)
        => _elerhetoCegek.FirstOrDefault(c => c.Id == cegId)?.Nev ?? "";
}