    // ========== DUPLIKÁCIÓ DIALOG ==========
    private async Task<string> ShowDuplikacioDialog(string uzenet)
    {
        var parameters = new DialogParameters
        {
            { "Uzenet", uzenet }
        };
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<DuplikacioDialog>("Duplikáció észlelve", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled) return "Mégsem";
        return result.Data?.ToString() ?? "Mégsem";
    }

