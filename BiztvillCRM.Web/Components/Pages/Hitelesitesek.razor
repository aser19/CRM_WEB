        _emailKuldes = true;
        try
        {
            var placeholderek = new Dictionary<string, string>
            {
                { "UgyfelNev", _emailHitelesites.Ugyfel?.Nev ?? "" },
                { "TelephelyNev", _emailHitelesites.Telephely?.Nev ?? "" },
                { "EszkozTipus", _emailHitelesites.EszkozTipus?.Nev ?? "" },
                { "LejaratDatum", _emailHitelesites.LejaratDatum?.ToString("yyyy.MM.dd") ?? "" },
                { "MeresTipus", "" },
                { "CegNev", "" }
            };

            var siker = await EmailKuldoService.KuldSablonbolAsync(
                _kivalasztottEmailTipus,
                _emailCimzett,
                placeholderek,
                _cegId,
                hitelesitesId: _emailHitelesites.Id
            );

            if (siker)
            {
                Snackbar.Add($"Email sikeresen elküldve: {_emailCimzett}", Severity.Success);
                _emailDialogNyitva = false;
            }
            else
            {
                Snackbar.Add("Email küldése sikertelen! Ellenőrizd az SMTP beállításokat.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
        finally
        {
            _emailKuldes = false;
        }
    }

