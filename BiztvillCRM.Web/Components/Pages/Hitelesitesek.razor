        _hatosagok = await HatosagService.GetAllAsync();
        _ugyfelek = await UgyfelService.GetAllAsync();
        _telephelyek = await TelephelyService.GetAllAsync();
        _csoportok = await HitelesitesCsoportService.GetAllAsync();
    }

    private async Task BetoltesAsync() 
    { 
        _betoltes = true; 
        _lista = await HitelesitesService.GetAllAsync(); 
        _betoltes = false; 
    }

    private void UjMegnyitasa()
    {
        var elsoTipus = _eszkozTipusok.FirstOrDefault();
        
        _szerkesztesAlatt = new Hitelesites
        {
            Darabszam = 1,
            EszkozTipusId = elsoTipus?.Id ?? 0
            // EszkozAzonosito itt üres marad – új rekordnál nincs mit másolni
        };
        _kivalasztottUgyfelId = null;
        _datum = DateTime.Today;
        _lejaratDatum = null;
        _aktualisEgyediLejaratok = new List<HitelesitesReszlet>();
        
        SzamoljLejaratot();
        FrissitsCsoportTagSorokat();
        _dialogNyitva = true;
    }

    private void SzerkesztesMegnyitasa(Hitelesites item) 
    { 
        _szerkesztesAlatt = new Hitelesites
        {
            Id = item.Id,
            UgyfelId = item.UgyfelId,
            TelephelyId = item.TelephelyId,
            EszkozTipusId = item.EszkozTipusId,
            HatosagId = item.HatosagId,
            Darabszam = item.Darabszam,
            HitelesitesStatusz = item.HitelesitesStatusz,
            Megjegyzes = item.Megjegyzes,
            EgyediLejaratok = item.EgyediLejaratok,
            CsoportTagLejaratok = item.CsoportTagLejaratok,
            EszkozAzonosito = item.EszkozAzonosito  // ← itt helyes
        };
        _kivalasztottUgyfelId = item.UgyfelId;
        _datum = item.Datum; 
        _lejaratDatum = item.LejaratDatum;
        
        // ÚJ: Egyedi lejáratok betöltése
        _aktualisEgyediLejaratok = item.EgyediLejaratokLista.ToList();
        FrissitsCsoportTagSorokat();
        _dialogNyitva = true; 
    }

    private void OnUgyfelValtozas(int? ujUgyfelId)
    {
        _kivalasztottUgyfelId = ujUgyfelId;
        if (_szerkesztesAlatt != null)
        {
            _szerkesztesAlatt.UgyfelId = ujUgyfelId;
            var elsoTelephely = _szurtTelephelyek.FirstOrDefault();
            _szerkesztesAlatt.TelephelyId = elsoTelephely?.Id;
        }
    }

    private void OnEszkozTipusValtozas(int ujEszkozTipusId)
    {
        if (_szerkesztesAlatt != null)
        {
            _szerkesztesAlatt.EszkozTipusId = ujEszkozTipusId;
            SzamoljLejaratot();
            FrissitsCsoportTagSorokat();
        }
    }

    private void FrissitsCsoportTagSorokat()
    {
        if (_szerkesztesAlatt is null) return;

        _aktivCsoport = _csoportok.FirstOrDefault(c =>
            c.FoEszkozTipusId == _szerkesztesAlatt.EszkozTipusId ||
            c.Tagok.Any(t => t.EszkozTipusId == _szerkesztesAlatt.EszkozTipusId));

        if (_aktivCsoport is null)
        {
            _csoportTagSorok = new();
            return;
        }

        // Meglévő egyedi dátumok betöltése (szerkesztés esetén)
        var mentettDatumok = _szerkesztesAlatt.CsoportTagLejaratokLista;

        _csoportTagSorok = _aktivCsoport.Tagok
            .OrderBy(t => t.Sorrend)
            .Select(tag =>
            {
                var eszkozTipus = _eszkozTipusok.FirstOrDefault(e => e.Id == tag.EszkozTipusId);
                var autoLejarat = _datum.HasValue && eszkozTipus != null
                    ? _datum.Value.AddMonths(eszkozTipus.HitelesitesiIdotartamHonap)
                    : (DateTime?)null;

                var mentett = mentettDatumok.FirstOrDefault(m => m.EszkozTipusId == tag.EszkozTipusId);

                return new CsoportTagSor
                {
                    Tag = tag,
                    EszkozTipusNev = eszkozTipus?.Nev ?? "–",
                    EszkozTipusHonap = eszkozTipus?.HitelesitesiIdotartamHonap ?? 0,
                    AutoLejaratDatum = autoLejarat,
                    EgyediDatumHasznalata = mentett != null,
                    EgyediLejaratDatum = mentett?.LejaratDatum ?? autoLejarat
                };
            })
            .ToList();
    }

    private void OnDatumValtozas(DateTime? ujDatum)
    {
        _datum = ujDatum;
        SzamoljLejaratot();
    }

    private void SzamoljLejaratot()
    {
        if (_szerkesztesAlatt == null || _datum == null || _szerkesztesAlatt.EszkozTipusId == 0)
            return;

        var tipus = _eszkozTipusok.FirstOrDefault(t => t.Id == _szerkesztesAlatt.EszkozTipusId);
        if (tipus != null && tipus.HitelesitesiIdotartamHonap > 0)
        {
            _lejaratDatum = _datum.Value.AddMonths(tipus.HitelesitesiIdotartamHonap);
            StateHasChanged();
        }
    }

    // ========== EGYEDI LEJÁRATOK KEZELÉSE ==========
    
    private void UjEgyediLejaratHozzaadas()
    {
        _aktualisEgyediLejaratok.Add(new HitelesitesReszlet 
        { 
            EszkozNev = "",
            LejaratDatum = _lejaratDatum ?? DateTime.Today.AddYears(1),
            Megjegyzes = ""
        });
    }
    
    private void EgyediLejaratTorlese(HitelesitesReszlet reszlet)
    {
        _aktualisEgyediLejaratok.Remove(reszlet);
    }

    private void DialogBezarasa() 
    { 
        _dialogNyitva = false; 
        _szerkesztesAlatt = null; 
        _kivalasztottUgyfelId = null;
        _aktualisEgyediLejaratok.Clear(); // ÚJ
        _aktivCsoport = null;
        _csoportTagSorok.Clear();
    }

    private async Task MentesAsync()
    {
        if (_szerkesztesAlatt is null || _datum is null) 
        { 
            Snackbar.Add("A dátum megadása kötelező!", Severity.Warning); 
            return; 
        }
        if (_szerkesztesAlatt.UgyfelId == null) 
        { 
            Snackbar.Add("Az ügyfél kiválasztása kötelező!", Severity.Warning); 
            return; 
        }
        if (_szerkesztesAlatt.TelephelyId == null) 
        { 
            Snackbar.Add("A telephely kiválasztása kötelező!", Severity.Warning); 
            return; 
        }
        if (_szerkesztesAlatt.EszkozTipusId == 0) 
        { 
            Snackbar.Add("Az eszköztípus kiválasztása kötelező!", Severity.Warning); 
            return; 
        }
        
        // ÚJ: Egyedi lejáratok validálása
        if (_aktualisEgyediLejaratok.Any(r => string.IsNullOrWhiteSpace(r.EszkozNev)))
        {
            Snackbar.Add("Minden egyedi eszköz nevének megadása kötelező!", Severity.Warning);
            return;
        }
        
        _szerkesztesAlatt.Datum = _datum.Value;
        _szerkesztesAlatt.LejaratDatum = _lejaratDatum;
        
        // ÚJ: Egyedi lejáratok mentése
        _szerkesztesAlatt.EgyediLejaratokLista = _aktualisEgyediLejaratok;
        
        // Csoporttag lejáratok mentése (csak az egyedi dátummal rendelkezőkét)
        _szerkesztesAlatt.CsoportTagLejaratokLista = _csoportTagSorok
            .Where(s => s.EgyediDatumHasznalata && s.EgyediLejaratDatum.HasValue)
            .Select(s => new CsoportTagLejaratReszlet
            {
                EszkozTipusId = s.Tag.EszkozTipusId,
                EszkozTipusNev = s.EszkozTipusNev,
                LejaratDatum = s.EgyediLejaratDatum
            })
            .ToList();
        
        // Automatikus lejárt státusz
        if (_lejaratDatum.HasValue && _lejaratDatum.Value.Date < DateTime.Today && 
            _szerkesztesAlatt.HitelesitesStatusz == HitelesitesStatusz.Sikeres)
        {
            _szerkesztesAlatt.HitelesitesStatusz = HitelesitesStatusz.Lejart;
        }
        
        _mentes = true;
        try
        {
            if (_szerkesztesAlatt.Id == 0) 
                await HitelesitesService.CreateAsync(_szerkesztesAlatt);
            else 
                await HitelesitesService.UpdateAsync(_szerkesztesAlatt);
            
            Snackbar.Add("Sikeres mentés!", Severity.Success); 
            DialogBezarasa(); 
            await BetoltesAsync();
        }
        catch (Exception ex) 
        { 
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); 
        }
        finally 
        { 
            _mentes = false; 
        }
    }

    private async Task TorlesMegerosites(Hitelesites item)
    {
        if (await DialogService.ShowMessageBox("Törlés megerősítése", "Biztosan törli?", yesText: "Törlés", cancelText: "Mégse") == true)
        {
            try { await HitelesitesService.DeleteAsync(item.Id); Snackbar.Add("Törölve.", Severity.Success); await BetoltesAsync(); }
            catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        }
    }

