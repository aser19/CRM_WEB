    private async Task MunkalapFeltoltese(IBrowserFile? file)
    {
        if (file is null || _szerkesztesAlatt is null || _szerkesztesAlatt.UgyfelId is null) return;

        try
        {
            var ugyfel = _ugyfelek.FirstOrDefault(u => u.Id == _szerkesztesAlatt.UgyfelId.Value);
            if (ugyfel is null)
            {
                Snackbar.Add("Ügyfél nem található!", Severity.Error);
                return;
            }

            var ceg = _elerhetoCegek.FirstOrDefault(c => c.Id == ugyfel.CegId);
            var cegNev = ceg?.Nev ?? "Ismeretlen";

            // Régi fájl törlése, ha volt
            if (!string.IsNullOrWhiteSpace(_szerkesztesAlatt.MunkalapPath))
            {
                await FileStorageService.DeleteFileAsync(_szerkesztesAlatt.MunkalapPath);
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB
            var relativePath = await FileStorageService.SaveHitelesitesFileAsync(
                stream,
                file.Name,
                cegNev,
                ugyfel.Nev ?? "Ismeretlen",
                "munkalapok",
                new[] { ".jpg", ".jpeg", ".png", ".pdf" },
                10
            );

            if (relativePath is not null)
            {
                _szerkesztesAlatt.MunkalapPath = relativePath;
                Console.WriteLine($"Munkalap feltöltve: {relativePath}, Hitelesítés Id: {_szerkesztesAlatt.Id}");

                // Ha meglévő rekordot szerkesztünk, automatikusan mentjük
                if (_szerkesztesAlatt.Id > 0)
                {
                    await HitelesitesService.UpdateAsync(_szerkesztesAlatt);
                    Snackbar.Add("Munkalap feltöltve és mentve!", Severity.Success);
                    await BetoltesAsync(); // Frissítjük a listát
                }
                else
                {
                    Snackbar.Add("Munkalap feltöltve! Ne felejtsd el menteni a hitelesítést.", Severity.Info);
                }
            }
            else
            {
                Snackbar.Add("Fájl feltöltése sikertelen!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
    }

