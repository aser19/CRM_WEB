<!-- Inaktív hitelesítések dialógus -->
<MudDialog @bind-Visible="_inaktivDialogNyitva" Options="new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Archive" Class="mr-2" />
            Inaktív hitelesítések
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_inaktivBetoltes)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
        else if (!_inaktivLista.Any())
        {
            <MudText Class="pa-4 ml-2">Nincs inaktív hitelesítés.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Class="mt-1">
                @foreach (var csoport in _inaktivLista
                    .GroupBy(h => h.UgyfelId)
                    .OrderBy(g => g.FirstOrDefault()?.Ugyfel?.Nev ?? ""))
                {
                    var ugyfelNev    = csoport.FirstOrDefault()?.Ugyfel?.Nev ?? "-";
                    var cegId        = csoport.FirstOrDefault()?.Ugyfel?.CegId ?? 0;
                    var hitelesitesek = csoport
                        .OrderBy(h => h.Telephely?.Nev ?? "")
                        .ThenBy(h => h.EszkozTipus?.Nev ?? "")
                        .ToList();

                    <MudExpansionPanel IsInitiallyExpanded="true">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Warning" />
                                <MudText Typo="Typo.subtitle1"><b>@ugyfelNev</b></MudText>
                                @if (_elerhetoCegek.Count > 1)
                                {
                                    var szin      = GetCegSzin(cegId);
                                    var rovidites = GetCegRovidites(cegId);
                                    var cegNev    = GetCegNev(cegId);
                                    <MudTooltip Text="@cegNev">
                                        <MudChip T="string" Size="Size.Small" Label="true"
                                                 Style="@($"background-color:{szin};color:white;font-weight:600;font-size:10px;height:18px;")">
                                            @rovidites
                                        </MudChip>
                                    </MudTooltip>
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Archive">
                                    @hitelesitesek.Count inaktív
                                </MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudTable T="Hitelesites" Items="@hitelesitesek"
                                      Hover="true" Dense="true" Striped="true"
                                      Breakpoint="Breakpoint.Sm" Class="mb-2">
                                <HeaderContent>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.Telephely?.Nev ?? string.Empty)"
                                                           InitialDirection="SortDirection.Ascending">
                                            Telephely
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.EszkozTipus?.Nev ?? string.Empty)">
                                            Eszköztípus
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.EszkozAzonosito ?? string.Empty)">
                                            Azonosító
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.Darabszam)">
                                            Db
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.Datum)">
                                            Dátum
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.LejaratDatum ?? DateTime.MaxValue)">
                                            Lejárat
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => (int)h.HitelesitesStatusz)">
                                            Státusz
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>Állapot</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Telephely">@(context.Telephely?.Nev ?? "-")</MudTd>
                                    <MudTd DataLabel="Eszköztípus">@(context.EszkozTipus?.Nev ?? "-")</MudTd>
                                    <MudTd DataLabel="Azonosító">
                                        @if (!string.IsNullOrEmpty(context.EszkozAzonosito))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                     Icon="@Icons.Material.Filled.Label">
                                                @context.EszkozAzonosito
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Db">@context.Darabszam</MudTd>
                                    <MudTd DataLabel="Dátum">@context.Datum.ToString("yyyy.MM.dd")</MudTd>
                                    <MudTd DataLabel="Lejárat">
                                        @if (context.LejaratDatum.HasValue)
                                        {
                                            <span>@context.LejaratDatum.Value.ToString("yyyy.MM.dd")</span>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Státusz">
                                        @switch (context.HitelesitesStatusz)
                                        {
                                            case HitelesitesStatusz.Sikeres:
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Sikeres</MudChip>
                                                break;
                                            case HitelesitesStatusz.Sikertelen:
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Sikertelen</MudChip>
                                                break;
                                            case HitelesitesStatusz.Lejart:
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Lejárt</MudChip>
                                                break;
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Állapot">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Archive">Inaktív</MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _inaktivDialogNyitva = false" Color="Color.Primary">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Hitelesites> _lista = new();
    private List<EszkozTipus> _eszkozTipusok = new();
    private List<Hatosag> _hatosagok = new();
    private List<Ugyfel> _ugyfelek = new();
    private List<Telephely> _telephelyek = new();
    private string _kereses = string.Empty;
    private bool _betoltes = true, _dialogNyitva = false, _mentes = false;
    private bool _isAdmin;
    private int _cegId;
    private Hitelesites? _szerkesztesAlatt;
    private DateTime? _datum, _lejaratDatum;
    private int? _kivalasztottUgyfelId;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
    // A meglévő mezők után (~510. sor után) add hozzá:
    private List<Ceg> _elerhetoCegek = new();
    private bool _masolasbol = false;
    private bool _csoportositott = true;

    private static readonly string[] _cegSzinek = new[]
    {
        "#1976D2", // kék   – főcég (1. pozíció)
        "#F57C00", // narancs
        "#388E3C", // zöld
        "#7B1FA2", // lila
        "#C62828", // sötétpiros
        "#00838F", // cián
    };

    private string GetCegSzin(int cegId)
    {
        if (_elerhetoCegek.Count <= 1) return "";
        var index = _elerhetoCegek.FindIndex(c => c.Id == cegId);
        return _cegSzinek[Math.Max(0, index) % _cegSzinek.Length];
    }

    private string GetCegRovidites(int cegId)
    {
        var ceg = _elerhetoCegek.FirstOrDefault(c => c.Id == cegId);
        if (ceg == null) return "?";
        return ceg.MatricaElotag
            ?? new string(ceg.Nev.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpper();
    }

    private string GetCegNev(int cegId)
        => _elerhetoCegek.FirstOrDefault(c => c.Id == cegId)?.Nev ?? "";

    // ÚJ: Egyedi lejáratok kezeléséhez
    private List<HitelesitesReszlet> _aktualisEgyediLejaratok = new();

    // Eszköztípus kezelés dialógushoz
    private bool _eszkozTipusDialogNyitva = false;
    private string _ujEszkozTipusNev = string.Empty;
    private int _ujEszkozTipusHonap = 12;
    private int? _szerkesztettEszkozTipusId = null;
    private string _szerkesztettEszkozTipusNev = string.Empty;
    private int _szerkesztettEszkozTipusHonap = 12;

    // Email küldés
    private bool _emailDialogNyitva = false;
    private bool _emailKuldes = false;
    private Hitelesites? _emailHitelesites;
    private EmailErtesitesTipus _kivalasztottEmailTipus = EmailErtesitesTipus.HitelesitesLejarat90Nap;
    private string _emailCimzett = "";

    // Inaktív hitelesítések
    private bool _inaktivDialogNyitva = false;
    private List<Hitelesites> _inaktivLista = new();
    private bool _inaktivBetoltes = false;

    private IEnumerable<Telephely> _szurtTelephelyek => _kivalasztottUgyfelId.HasValue 
        ? _telephelyek.Where(t => t.UgyfelId == _kivalasztottUgyfelId.Value) 
        : Enumerable.Empty<Telephely>();

        private string? _datumSzuro;

    private IEnumerable<Hitelesites> _szurtLista
    {
        get
        {
            var ma = DateTime.Today;
            var hatarNap = ma.AddDays(_lejaroDays);

            IEnumerable<Hitelesites> lista = _lista;

            // URL szűrő
            if (_szuroParam == "lejaro")
                lista = lista.Where(h => h.LejaratDatum.HasValue
                    && h.LejaratDatum.Value > ma
                    && h.LejaratDatum.Value <= hatarNap);
            else if (_szuroParam == "lejart")
                lista = lista.Where(h => h.LejaratDatum.HasValue
                    && h.LejaratDatum.Value < ma);

            // Dátumintervallum szűrő
            lista = _datumSzuro switch
            {
                "k30"   => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma && h.LejaratDatum.Value <= ma.AddDays(30)),
                "k90"   => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma && h.LejaratDatum.Value <= ma.AddDays(90)),
                "k180"  => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma && h.LejaratDatum.Value <= ma.AddDays(180)),
                "kiden" => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma && h.LejaratDatum.Value.Year == ma.Year),
                "pm30"  => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma.AddDays(-30) && h.LejaratDatum.Value <= ma.AddDays(30)),
                "pm90"  => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma.AddDays(-90) && h.LejaratDatum.Value <= ma.AddDays(90)),
                "pm180" => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value >= ma.AddDays(-180) && h.LejaratDatum.Value <= ma.AddDays(180)),
                "iden"  => lista.Where(h => h.LejaratDatum.HasValue && h.LejaratDatum.Value.Year == ma.Year),
                _       => lista
            };

            // Szöveges keresés
            if (!string.IsNullOrWhiteSpace(_kereses))
                lista = lista.Where(h =>
                    (h.Ugyfel?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (h.Telephely?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (h.EszkozTipus?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false));

            return lista;
        }
    }

    // Hitelesítési csoport
    private List<HitelesitesCsoport> _csoportok = new();
    private HitelesitesCsoport? _aktivCsoport;
    // Megmutatja-e az azonosító mezőt (ha van csoport hozzárendelve az eszköztípushoz)
    private bool _eszkozTipusokVanCsoport =>
        _szerkesztesAlatt != null &&
        _csoportok.Any(c =>
            c.FoEszkozTipusId == _szerkesztesAlatt.EszkozTipusId ||
            c.Tagok.Any(t => t.EszkozTipusId == _szerkesztesAlatt.EszkozTipusId));
    private List<CsoportTagSor> _csoportTagSorok = new();

    /// <summary>
/// True ha új rekordnál (másolásnál) ugyanolyan
/// (ügyfél + telephely + eszköztípus + azonosító) kombináció már létezik.
/// </summary>
private bool _eszkozAzonositoDuplikalva =>
    _szerkesztesAlatt is not null &&
    _szerkesztesAlatt.Id == 0 &&
    _lista.Any(h =>
        h.UgyfelId == _szerkesztesAlatt.UgyfelId &&
        h.TelephelyId == _szerkesztesAlatt.TelephelyId &&
        h.EszkozTipusId == _szerkesztesAlatt.EszkozTipusId &&
        string.Equals(
            h.EszkozAzonosito?.Trim(),
            _szerkesztesAlatt.EszkozAzonosito?.Trim(),
            StringComparison.OrdinalIgnoreCase));

    [SupplyParameterFromQuery(Name = "szuro")]
    private string? _szuroParam { get; set; }

    private static readonly int _lejaroDays = 60;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = TenantService.IsInRole(FelhasznaloSzerepkor.Admin);
        _cegId = TenantService.GetCurrentCegId();
        await BetoltesAsync();
        _eszkozTipusok = await EszkozTipusService.GetAllAsync();
        _hatosagok = await HatosagService.GetAllAsync();
        _ugyfelek = await UgyfelService.GetAllAsync();
        _telephelyek = await TelephelyService.GetAllAsync();
        _csoportok = await HitelesitesCsoportService.GetAllAsync();

        // Multi-tenant cég badge betöltés
        var elerhhetoCegIds = await TenantService.GetElerhhetoCegIdsAsync();
        if (elerhhetoCegIds.Count > 1)
        {
            var osszesCeg = await CegService.GetAllAsync(csakAktiv: false);
            _elerhetoCegek = osszesCeg
                .Where(c => elerhhetoCegIds.Contains(c.Id))
                .OrderBy(c => c.Id == _cegId ? 0 : 1)
                .ThenBy(c => c.Nev)
                .ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sticky scroll inicializálása
            await JS.InvokeVoidAsync("eval", @"
                import('/js/sticky-scroll.js').then(module => {
                    setTimeout(() => {
                        module.initializeStickyScroll('.sticky-horizontal-scroll-wrapper');
                    }, 500);
                });
            ");
        }
        else
        {
            // Táblázat frissítése után is újra inicializáljuk
            await JS.InvokeVoidAsync("eval", @"
                if (window.initializeStickyScroll) {
                    setTimeout(() => {
                        window.initializeStickyScroll('.sticky-horizontal-scroll-wrapper');
                    }, 300);
                }
            ");
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Cleanup sticky scroll
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if (window.cleanupStickyScroll) {
                    window.cleanupStickyScroll('.sticky-horizontal-scroll-wrapper');
                }
            ");
        }
        catch { /* Ignore errors during cleanup */ }
    }

    private async Task BetoltesAsync() 
    { 
        _betoltes = true; 
        _lista = await HitelesitesService.GetAllAsync(); 
        _betoltes = false; 
    }

    private async Task InaktivakMegnyitasa()
    {
        _inaktivBetoltes = true;
        _inaktivLista = await HitelesitesService.GetInaktivakAsync();
        _inaktivBetoltes = false;
        _inaktivDialogNyitva = true;
    }

    private async Task ExportExcel()
    {
        try
        {
            _betoltes = true;
            var bytes = await ExportService.ExportHitelesitesekExcelAsync(_szurtLista.ToList());
            var fileName = $"Hitelesitesek_{DateTime.Now:yyyy-MM-dd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromByteArray", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
            Snackbar.Add("Excel exportálás sikeres!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba az Excel exportálás során: {ex.Message}", Severity.Error);
        }
        finally
        {
            _betoltes = false;
        }
    }

    private async Task ExportPdf()
    {
        try
        {
            _betoltes = true;
            var bytes = await ExportService.ExportHitelesitesekPdfAsync(_szurtLista.ToList());
            var fileName = $"Hitelesitesek_{DateTime.Now:yyyy-MM-dd_HHmm}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromByteArray", fileName, "application/pdf", bytes);
            Snackbar.Add("PDF exportálás sikeres!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a PDF exportálás során: {ex.Message}", Severity.Error);
        }
        finally
        {
            _betoltes = false;
        }
    }

    private void UjMegnyitasa()
    {
        var elsoTipus = _eszkozTipusok.FirstOrDefault();

        _szerkesztesAlatt = new Hitelesites
        {
            Darabszam = 1,
            EszkozTipusId = elsoTipus?.Id ?? 0
            // EszkozAzonosito itt üres marad – új rekordnál nincs mit másolni
        };
        _kivalasztottUgyfelId = null;
        _datum = DateTime.Today;
        _lejaratDatum = null;
        _aktualisEgyediLejaratok = new List<HitelesitesReszlet>();

        SzamoljLejaratot();
        FrissitsCsoportTagSorokat();
        _dialogNyitva = true;
        _manualisLejaratDatum = false;
        _masolasbol = false; // ← Új hitelesítés, NEM másolat
    }

    private void SzerkesztesMegnyitasa(Hitelesites item) 
    { 
        _szerkesztesAlatt = new Hitelesites
        {
            Id = item.Id,
            UgyfelId = item.UgyfelId,
            TelephelyId = item.TelephelyId,
            EszkozTipusId = item.EszkozTipusId,
            HatosagId = item.HatosagId,
            Darabszam = item.Darabszam,
            HitelesitesStatusz = item.HitelesitesStatusz,
            Megjegyzes = item.Megjegyzes,
            EgyediLejaratok = item.EgyediLejaratok,
            CsoportTagLejaratok = item.CsoportTagLejaratok,
            EszkozAzonosito = item.EszkozAzonosito,
            MunkalapPath = item.MunkalapPath,           // ← FONTOS: fájl útvonalak
            BizonyitvanyPath = item.BizonyitvanyPath    // ← másolása
        };
        _kivalasztottUgyfelId = item.UgyfelId;
        _datum = item.Datum;
        _lejaratDatum = item.LejaratDatum;
        _manualisLejaratDatum = item.LejaratDatum.HasValue; // ← ha volt mentett dátum, manuális

        // ÚJ: Egyedi lejáratok betöltése
        _aktualisEgyediLejaratok = item.EgyediLejaratokLista.ToList();
        FrissitsCsoportTagSorokat();
        _dialogNyitva = true;
        _masolasbol = false; // ← Szerkesztés, NEM másolat
    }

    private void MasolasMegnyitasa(Hitelesites item)
    {
        _szerkesztesAlatt = new Hitelesites
        {
            Id = 0,                                         // ← ÚJ rekord
            UgyfelId = item.UgyfelId,
            TelephelyId = item.TelephelyId,
            EszkozTipusId = item.EszkozTipusId,
            HatosagId = item.HatosagId,
            Darabszam = item.Darabszam,
            HitelesitesStatusz = HitelesitesStatusz.Sikeres, // ← friss hitelesítés = Sikeres
            Megjegyzes = item.Megjegyzes,
            EgyediLejaratok = item.EgyediLejaratok,
            CsoportTagLejaratok = item.CsoportTagLejaratok,
