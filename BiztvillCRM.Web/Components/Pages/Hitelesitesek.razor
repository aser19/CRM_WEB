@page "/hitelesitesek"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.IO
@inject IHitelesitesService HitelesitesService
@inject IEszkozTipusService EszkozTipusService
@inject IHatosagService HatosagService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject ITenantService TenantService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IEmailKuldoService EmailKuldoService
@inject IExportService ExportService
@inject IHitelesitesCsoportService HitelesitesCsoportService
@inject IHitelesitesCsoportService HitelesitesCsoportService
@inject ICegService CegService
@inject IFileStorageService FileStorageService
@inject IJSRuntime JS

<PageTitle>Hitelesítések</PageTitle>

<style>
    .sticky-horizontal-scroll-wrapper {
        position: relative;
        overflow-x: auto;
        max-width: 100%;
    }

    .sticky-horizontal-scroll-wrapper::-webkit-scrollbar {
        position: sticky;
        bottom: 0;
        height: 12px;
    }

    .sticky-horizontal-scroll-wrapper {
        scrollbar-width: thin;
    }

    /* A táblázat min-width beállítása hogy kikényszerítse a vízszintes scrollt ha szükséges */
    .sticky-horizontal-scroll-wrapper > * {
        min-width: max-content;
    }

    /* Sticky scrollbar wrapper rögzítése az ablak aljához */
    .table-container-sticky {
        position: relative;
        padding-bottom: 20px;
    }
</style>

<MudText Typo="Typo.h4" Class="mb-4">Hitelesítések</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField @bind-Value="_kereses" Label="Keresés (ügyfél, telephely, típus)" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Style="max-width:400px;" />
        <MudSelect T="string" @bind-Value="_datumSzuro" Label="Dátumszűrő" Clearable="true"
                   Style="max-width:220px;" AdornmentIcon="@Icons.Material.Filled.DateRange" Adornment="Adornment.Start"
                   Dense="true">
            <MudSelectItem Value="@("k30")">Következő 30 nap</MudSelectItem>
            <MudSelectItem Value="@("k90")">Következő 90 nap</MudSelectItem>
            <MudSelectItem Value="@("k180")">Következő 180 nap</MudSelectItem>
            <MudSelectItem Value="@("kiden")">Következő – Idén</MudSelectItem>
            <MudSelectItem Value="@("pm30")">± 30 nap</MudSelectItem>
            <MudSelectItem Value="@("pm90")">± 90 nap</MudSelectItem>
            <MudSelectItem Value="@("pm180")">± 180 nap</MudSelectItem>
            <MudSelectItem Value="@("iden")">Idén (egész év)</MudSelectItem>
        </MudSelect>
        <MudSpacer />
        <MudSpacer />
        <MudTooltip Text="@(_csoportositott ? "Lista nézet" : "Csoportosítás ügyfél szerint")">
            <MudIconButton Icon="@(_csoportositott ? Icons.Material.Filled.TableRows : Icons.Material.Filled.GroupWork)"
                           Color="@(_csoportositott ? Color.Primary : Color.Default)"
                           Variant="@(_csoportositott ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => _csoportositott = !_csoportositott)" />
        </MudTooltip>
        @if (_isAdmin)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Settings" 
                       OnClick="EszkozTipusokMegnyitasa" Class="mr-2">Eszköztípusok</MudButton>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Archive" 
                   OnClick="InaktivakMegnyitasa" Class="mr-2">Inaktív hitelesítések</MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportExcel" Class="mr-2" Disabled="_betoltes">Excel export</MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   OnClick="ExportPdf" Class="mr-2" Disabled="_betoltes">PDF export</MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="UjMegnyitasa">Új hitelesítés</MudButton>
    </MudStack>

    @if (!_csoportositott)
    {
        <div class="table-container-sticky">
            <div class="sticky-horizontal-scroll-wrapper">
                <MudDataGrid T="Hitelesites" Items="_szurtLista" Filterable="false" SortMode="SortMode.Multiple" Hover="true" Striped="true" Loading="_betoltes">
                    <Columns>
                        <TemplateColumn Title="Ügyfél" Sortable="true" SortBy="@(h => h.Ugyfel?.Nev ?? "")">
                            <CellTemplate>
                                <div>
                                    <div>@(context.Item.Ugyfel?.Nev ?? "-")</div>
                                    @if (_elerhetoCegek.Count > 1 && context.Item.Ugyfel != null)
                                    {
                                        var cegId = context.Item.Ugyfel.CegId;
                                        var szin = GetCegSzin(cegId);
                                        var rovidites = GetCegRovidites(cegId);
                                        var cegNev = GetCegNev(cegId);
                                        <MudTooltip Text="@cegNev" Placement="Placement.Right">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px; margin-top:2px;")"
                                                     Label="true">
                                                @rovidites
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Telephely" Sortable="true" SortBy="@(h => h.Telephely?.Nev ?? "")">
                            <CellTemplate>@(context.Item.Telephely?.Nev ?? "-")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Eszköztípus" Sortable="true" SortBy="@(h => h.EszkozTipus?.Nev ?? "")">
                            <CellTemplate>@(context.Item.EszkozTipus?.Nev ?? "-")</CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="h => h.Darabszam" Title="Darab" Sortable="true" />
                        <PropertyColumn Property="h => h.Datum" Title="Dátum" Format="yyyy.MM.dd" Sortable="true" />
                        <TemplateColumn Title="Lejárat" Sortable="true" SortBy="@(h => h.LejaratDatum ?? DateTime.MaxValue)">
                            <CellTemplate>
                                <div>
                                    @if (context.Item.LejaratDatum.HasValue)
                                    {
                                        <div>@context.Item.LejaratDatum.Value.ToString("yyyy.MM.dd")</div>
                                    }
                                    @if (context.Item.EgyediLejaratokLista.Any())
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Info" Class="mt-1">
                                            @context.Item.EgyediLejaratokLista.Count egyedi
                                    </MudChip>
                                    }
                                    @{
                                        var egyediKozbenso = context.Item.CsoportTagLejaratokLista
                                            .Where(t => !t.NemAlkalmazhato && t.LejaratDatum.HasValue)
                                            .ToList();
                                    }
                                    @if (egyediKozbenso.Any())
                                    {
                                        <MudTooltip>
                                            <TooltipContent>
                                                @foreach (var tag in egyediKozbenso)
                                                {
                                                    <div>@tag.EszkozTipusNev: @tag.LejaratDatum!.Value.ToString("yyyy.MM.dd")</div>
                                                }
                                            </TooltipContent>
                                            <ChildContent>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.CalendarMonth" Class="mt-1">
                                                    @egyediKozbenso.Count közbenső eltér
                                                </MudChip>
                                            </ChildContent>
                                        </MudTooltip>
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Dokumentumok" Sortable="false">
                            <CellTemplate>
                                @{
                                    var item = context.Item;
                                    var vanFoMunkalap = !string.IsNullOrWhiteSpace(item.MunkalapPath) || item.MunkalapPathsLista.Any();
                                    var vanFoBizonyitvany = !string.IsNullOrWhiteSpace(item.BizonyitvanyPath) || item.BizonyitvanyPathsLista.Any();
                                    var kozbensoTagok = item.CsoportTagLejaratokLista.Where(t => !t.NemAlkalmazhato).ToList();
                                    var feltoltottKozbenso = kozbensoTagok.Count(t => t.MunkalapPathsLista.Any() || t.BizonyitvanyPathsLista.Any());
                                    var osszesKozbenso = kozbensoTagok.Count;
                                }

                                @if (vanFoMunkalap || vanFoBizonyitvany)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Class="mb-1">
                                        @(vanFoMunkalap && vanFoBizonyitvany ? "M+B" : vanFoMunkalap ? "M" : "B")
                                    </MudChip>
                                }

                                @if (osszesKozbenso > 0)
                                {
                                    var kozbensoSzin = feltoltottKozbenso == osszesKozbenso ? Color.Success :
                                                      feltoltottKozbenso == 0 ? Color.Error :
                                                      Color.Warning;
                                    var kozbensoIkon = feltoltottKozbenso == osszesKozbenso ? Icons.Material.Filled.CheckCircle :
                                                      feltoltottKozbenso == 0 ? Icons.Material.Filled.Cancel :
                                                      Icons.Material.Filled.Warning;

                                    <MudTooltip>
                                        <TooltipContent>
                                            @foreach (var tag in kozbensoTagok)
                                            {
                                                var vanDok = tag.MunkalapPathsLista.Any() || tag.BizonyitvanyPathsLista.Any();
                                                <div>
                                                    @(vanDok ? "✓" : "✗") @tag.EszkozTipusNev
                                                    @if (vanDok)
                                                    {
                                                        <text> (@(tag.MunkalapPathsLista.Count)M / @(tag.BizonyitvanyPathsLista.Count)B)</text>
                                                    }
                                                </div>
                                            }
                                        </TooltipContent>
                                        <ChildContent>
                                            <MudChip T="string" Size="Size.Small" Color="@kozbensoSzin" Icon="@kozbensoIkon">
                                                @feltoltottKozbenso/@osszesKozbenso részfeladat
                                            </MudChip>
                                        </ChildContent>
                                    </MudTooltip>
                                }

                                @if (!vanFoMunkalap && !vanFoBizonyitvany && osszesKozbenso == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Nincs feltöltve</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Státusz" Sortable="true" SortBy="@(h => (int)h.HitelesitesStatusz)">
                            <CellTemplate>
                                @switch (context.Item.HitelesitesStatusz)
                                {
                                    case HitelesitesStatusz.Sikeres:
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Sikeres</MudChip>
                                        break;
                                    case HitelesitesStatusz.Sikertelen:
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Sikertelen</MudChip>
                                        break;
                                    case HitelesitesStatusz.Lejart:
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Lejárt</MudChip>
                                        break;
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Műveletek" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudTooltip Text="Email küldése">
                                        <MudIconButton Icon="@Icons.Material.Filled.Email"
                                                       Color="Color.Info" Size="Size.Small"
                                                       OnClick="() => EmailKuldesDialogusMegnyitasa(context.Item)" />
                                    </MudTooltip>
                                    <MudTooltip Text="Másolás – új hitelesítés az adatok alapján">
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                       Color="Color.Secondary" Size="Size.Small"
                                                       OnClick="() => MasolasMegnyitasa(context.Item)" />
                                    </MudTooltip>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => SzerkesztesMegnyitasa(context.Item)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => TorlesMegerosites(context.Item)" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Eszközazonosító" Sortable="true" SortBy="@(h => h.EszkozAzonosito ?? "")">
                            <CellTemplate>
                                @if (!string.IsNullOrEmpty(context.Item.EszkozAzonosito))
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="Color.Secondary"
                                             Icon="@Icons.Material.Filled.Label">
                                        @context.Item.EszkozAzonosito
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent><MudText>Nincs megjeleníthető hitelesítés.</MudText></NoRecordsContent>
                </MudDataGrid>
            </div>
        </div>
    }
    else
    {
        @if (_betoltes)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
        else if (!_szurtLista.Any())
        {
            <MudText Class="pa-4 ml-2">Nincs megjeleníthető hitelesítés.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Class="mt-1">
                @foreach (var csoport in _szurtLista
                    .GroupBy(h => h.UgyfelId)
                    .OrderBy(g => g.FirstOrDefault()?.Ugyfel?.Nev ?? ""))
                {
                    var ugyfelNev    = csoport.FirstOrDefault()?.Ugyfel?.Nev ?? "-";
                    var cegId        = csoport.FirstOrDefault()?.Ugyfel?.CegId ?? 0;
                    var hitelesitesek = csoport
                        .OrderBy(h => h.Telephely?.Nev ?? "")
                        .ThenBy(h => h.EszkozTipus?.Nev ?? "")
                        .ToList();

                    <MudExpansionPanel IsInitiallyExpanded="true">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1"><b>@ugyfelNev</b></MudText>
                                @if (_elerhetoCegek.Count > 1)
                                {
                                    var szin      = GetCegSzin(cegId);
                                    var rovidites = GetCegRovidites(cegId);
                                    var cegNev    = GetCegNev(cegId);
                                    <MudTooltip Text="@cegNev">
                                        <MudChip T="string" Size="Size.Small" Label="true"
                                                 Style="@($"background-color:{szin};color:white;font-weight:600;font-size:10px;height:18px;")">
                                            @rovidites
                                        </MudChip>
                                    </MudTooltip>
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @hitelesitesek.Count hitelesítés
                                </MudChip>
                                @{
                                    var legkozelebb = hitelesitesek
                                        .Where(h => h.LejaratDatum.HasValue && h.LejaratDatum > DateTime.Today)
                                        .OrderBy(h => h.LejaratDatum)
                                        .FirstOrDefault();
                                    var lejart = hitelesitesek
                                        .Count(h => h.LejaratDatum.HasValue && h.LejaratDatum < DateTime.Today);
                                }
                                @if (lejart > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Warning">
                                        @lejart lejárt
                                    </MudChip>
                                }
                                @if (legkozelebb is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule">
                                        Köv.: @legkozelebb.LejaratDatum!.Value.ToString("yyyy.MM.dd")
                                    </MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <div class="sticky-horizontal-scroll-wrapper">
                                <MudTable T="Hitelesites" Items="@hitelesitesek"
                                          Hover="true" Dense="true" Striped="true"
                                          Breakpoint="Breakpoint.Sm" Class="mb-2">
                                    <HeaderContent>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.Telephely?.Nev ?? string.Empty)"
                                                               InitialDirection="SortDirection.Ascending">
                                                Telephely
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.EszkozTipus?.Nev ?? string.Empty)">
                                                Eszköztípus
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.EszkozAzonosito ?? string.Empty)">
                                                Azonosító
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.Darabszam)">
                                                Db
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.Datum)">
                                                Dátum
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => h.LejaratDatum ?? DateTime.MaxValue)">
                                                Lejárat
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<Hitelesites, object>(h => (int)h.HitelesitesStatusz)">
                                                Státusz
                                            </MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>Műveletek</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Telephely">@(context.Telephely?.Nev ?? "-")</MudTd>
                                        <MudTd DataLabel="Eszköztípus">@(context.EszkozTipus?.Nev ?? "-")</MudTd>
                                        <MudTd DataLabel="Azonosító">
                                            @if (!string.IsNullOrEmpty(context.EszkozAzonosito))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                         Icon="@Icons.Material.Filled.Label">
                                                    @context.EszkozAzonosito
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Db">@context.Darabszam</MudTd>
                                        <MudTd DataLabel="Dátum">@context.Datum.ToString("yyyy.MM.dd")</MudTd>
                                        <MudTd DataLabel="Lejárat">
                                            @if (context.LejaratDatum.HasValue)
                                            {
                                                var szin = context.LejaratDatum < DateTime.Today
                                                    ? "color:#C62828;font-weight:600;"
                                                    : context.LejaratDatum < DateTime.Today.AddDays(60)
                                                        ? "color:#E65100;font-weight:600;"
                                                        : "";
                                                <span style="@szin">@context.LejaratDatum.Value.ToString("yyyy.MM.dd")</span>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Státusz">
                                            @switch (context.HitelesitesStatusz)
                                            {
                                                case HitelesitesStatusz.Sikeres:
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Sikeres</MudChip>
                                                    break;
                                                case HitelesitesStatusz.Sikertelen:
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Sikertelen</MudChip>
                                                    break;
                                                case HitelesitesStatusz.Lejart:
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Lejárt</MudChip>
                                                    break;
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Műveletek">
                                            <MudStack Row="true" Spacing="1">
                                                <MudTooltip Text="Email küldése">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Email"
                                                                   Color="Color.Info" Size="Size.Small"
                                                                   OnClick="() => EmailKuldesDialogusMegnyitasa(context)" />
                                                </MudTooltip>
                                                <MudTooltip Text="Másolás">
                                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                                   Color="Color.Secondary" Size="Size.Small"
                                                                   OnClick="() => MasolasMegnyitasa(context)" />
                                                </MudTooltip>
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Color="Color.Primary" Size="Size.Small"
                                                               OnClick="() => SzerkesztesMegnyitasa(context)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error" Size="Size.Small"
                                                               OnClick="() => TorlesMegerosites(context)" />
                                            </MudStack>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
</MudPaper>

<!-- Hitelesítés dialógus -->
<MudDialog @bind-Visible="_dialogNyitva" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        @if (_masolasbol)
        {
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary" Class="mr-1" />
        }
        <MudText Typo="Typo.h6">
            @(_masolasbol ? "Másolat létrehozása" 
              : _szerkesztesAlatt?.Id > 0 ? "Hitelesítés szerkesztése" 
              : "Új hitelesítés")
        </MudText>
    </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_szerkesztesAlatt is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" Value="_kivalasztottUgyfelId" ValueChanged="OnUgyfelValtozas" Label="Ügyfél *" Required="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Válasszon --</MudSelectItem>
                        @foreach (var u in _ugyfelek)
                        {
                            <MudSelectItem T="int?" Value="@((int?)u.Id)">@u.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" @bind-Value="_szerkesztesAlatt.TelephelyId" Label="Telephely *" Required="true" 
                               Disabled="@(_kivalasztottUgyfelId == null)"
                               ToStringFunc="@(id => id.HasValue ? (_szurtTelephelyek.FirstOrDefault(t => t.Id == id.Value)?.Nev ?? "") : "")">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Válasszon --</MudSelectItem>
                        @foreach (var t in _szurtTelephelyek)
                        {
                            <MudSelectItem T="int?" Value="@((int?)t.Id)">@t.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_szerkesztesAlatt.EszkozTipusId" ValueChanged="OnEszkozTipusValtozas" Label="Eszköztípus *" Required="true">
                        @foreach (var t in _eszkozTipusok)
                        {
                            <MudSelectItem Value="@t.Id">@t.Nev (@(t.HitelesitesiIdotartamHonap / 12) év)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* === Közbenső vizsgálatok – a MudSelect-en KÍVÜL! === *@
                @if (_aktivCsoport is not null)
                {
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-3 mt-1" Style="border-color: var(--mud-palette-info);">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                    Color="Color.Info" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Info">
                                        @_aktivCsoport.Nev – közbenső vizsgálatok
                                    </MudText>
                                </MudStack>
                                @{
                                    var osszesTag = _csoportTagSorok.Count(s => !s.NemAlkalmazhato);
                                    var feltoltottTag = _csoportTagSorok.Count(s => !s.NemAlkalmazhato && (s.MunkalapPaths.Any() || s.BizonyitvanyPaths.Any()));
                                    var statuszSzoveg = osszesTag == 0 ? "Nincs alkalmazható részfeladat" :
                                                       feltoltottTag == osszesTag ? "Minden feltöltve" :
                                                       feltoltottTag == 0 ? "Nincs feltöltve" :
                                                       $"{feltoltottTag}/{osszesTag} részfeladat feltöltve";
                                    var statuszSzin = osszesTag == 0 ? Color.Default :
                                                     feltoltottTag == osszesTag ? Color.Success :
                                                     feltoltottTag == 0 ? Color.Error :
                                                     Color.Warning;
                                }
                                <MudChip T="string" Size="Size.Small" Color="@statuszSzin" Variant="Variant.Text">
                                    @statuszSzoveg
                                </MudChip>
                            </MudStack>

                            @foreach (var sor in _csoportTagSorok)
                            {
                                <MudPaper Outlined="true" Class="pa-2 mb-2"
                                Style="@(sor.NemAlkalmazhato ? "opacity:0.5; background: var(--mud-palette-background-grey)" : "")">
                                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                        <!-- Vizsgálat neve -->
                                        <MudItem xs="12" md="4">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@(sor.Tag.Kotelezo ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                                Size="Size.Small"
                                                Color="@(sor.NemAlkalmazhato ? Color.Default : sor.Tag.Kotelezo ? Color.Warning : Color.Default)" />
                                                <div>
                                                    <MudText Typo="Typo.body2"
                                                    Style="@(sor.NemAlkalmazhato ? "text-decoration:line-through; color:gray" : null)">
                                                        <b>@sor.EszkozTipusNev</b>
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @sor.EszkozTipusHonap hónap
                                                        @if (sor.Tag.Kotelezo && !sor.NemAlkalmazhato)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">Kötelező</MudChip>
                                                        }
                                                        @if (sor.NemAlkalmazhato)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-1">Nem alkalmazható</MudChip>
                                                        }
                                                    </MudText>
                                                </div>
                                            </MudStack>
                                        </MudItem>

                                        <!-- Auto lejárat -->
                                        <MudItem xs="12" md="2">
                                            @if (!sor.NemAlkalmazhato)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Auto lejárat</MudText>
                                                <MudText Typo="Typo.body2">@(sor.AutoLejaratDatum?.ToString("yyyy.MM.dd") ?? "–")</MudText>
                                            }
                                        </MudItem>

                                        <!-- Eltérő dátum -->
                                        <MudItem xs="12" md="4">
                                            @if (!sor.NemAlkalmazhato)
                                            {
                                                <MudSwitch @bind-Value="sor.EgyediDatumHasznalata"
                                                Color="Color.Primary"
                                                Label="Eltérő dátum"
                                                Size="Size.Small" />
                                                @if (sor.EgyediDatumHasznalata)
                                                {
                                                    <MudTextField T="string"
                                                    Value="@(sor.EgyediLejaratDatum?.ToString("yyyy-MM-dd") ?? "")"
                                                    ValueChanged="@((string v) => {
                                                                      sor.EgyediLejaratDatum = DateTime.TryParse(v, out var d) ? d : sor.EgyediLejaratDatum;
                                                                  })"
                                                    Label="Egyedi lejárat"
                                                    InputType="InputType.Date"
                                                    Margin="Margin.Dense"
                                                    Style="max-width:175px;" />
                                                }
                                            }
                                        </MudItem>

                                        <!-- Nem alkalmazható toggle -->
                                        <MudItem xs="12" md="2">
                                            <MudTooltip Text="Ennél az eszköznél ez a vizsgálat nem alkalmazható (pl. nincs lyukadásjelző)">
                                                <MudSwitch @bind-Value="sor.NemAlkalmazhato"
                                                Color="Color.Error"
                                                Label="N/A"
                                                Size="Size.Small"
                                                ThumbIcon="@Icons.Material.Filled.Block" />
                                            </MudTooltip>
                                        </MudItem>

                                        <!-- Dokumentumok -->
                                        @if (!sor.NemAlkalmazhato)
                                        {
                                            <MudItem xs="12">
                                                <MudDivider Class="my-1" />
                                                <MudGrid Spacing="1">
                                                    <!-- Munkalap -->
                                                    <MudItem xs="12" sm="6">
                                                        <MudText Typo="Typo.caption" Class="mb-1">Munkalap</MudText>
                                                        @if (sor.MunkalapPaths.Any())
                                                        {
                                                            @foreach (var munkalapPath in sor.MunkalapPaths)
                                                            {
                                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                                    <MudText Typo="Typo.caption">@Path.GetFileName(munkalapPath)</MudText>
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Primary"
                                                                                   OnClick="@(() => KozbensoMunkalapLetoltese(munkalapPath))" Title="Letöltés" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                                   OnClick="@(() => KozbensoMunkalapTorlese(sor, munkalapPath))" Title="Törlés" />
                                                                </MudStack>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Nincs feltöltve</MudText>
                                                        }
                                                        <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.pdf" MaximumFileCount="1"
                                                                       FilesChanged="@(async (file) => await KozbensoMunkalapFeltoltese(file, sor))">
                                                            <ActivatorContent>
                                                                <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small"
                                                                           StartIcon="@Icons.Material.Filled.Upload">
                                                                    @(sor.MunkalapPaths.Any() ? "Újabb hozzáadása" : "Feltöltés")
                                                                </MudButton>
                                                            </ActivatorContent>
                                                        </MudFileUpload>
                                                    </MudItem>

                                                    <!-- Bizonyítvány -->
                                                    <MudItem xs="12" sm="6">
                                                        <MudText Typo="Typo.caption" Class="mb-1">Bizonyítvány</MudText>
                                                        @if (sor.BizonyitvanyPaths.Any())
                                                        {
                                                            @foreach (var bizonyitvanyPath in sor.BizonyitvanyPaths)
                                                            {
                                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                                    <MudText Typo="Typo.caption">@Path.GetFileName(bizonyitvanyPath)</MudText>
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Primary"
                                                                                   OnClick="@(() => KozbensoBizonyitvanyLetoltese(bizonyitvanyPath))" Title="Letöltés" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                                   OnClick="@(() => KozbensoBizonyitvanyTorlese(sor, bizonyitvanyPath))" Title="Törlés" />
                                                                </MudStack>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Nincs feltöltve</MudText>
                                                        }
                                                        <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.pdf" MaximumFileCount="1"
                                                                       FilesChanged="@(async (file) => await KozbensoBizonyitvanyFeltoltese(file, sor))">
                                                            <ActivatorContent>
                                                                <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small"
                                                                           StartIcon="@Icons.Material.Filled.Upload">
                                                                    @(sor.BizonyitvanyPaths.Any() ? "Újabb hozzáadása" : "Feltöltés")
                                                                </MudButton>
                                                            </ActivatorContent>
                                                        </MudFileUpload>
                                                                      </MudItem>
                                                                 </MudGrid>
                                                             </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            }

                            @if (!string.IsNullOrEmpty(_aktivCsoport.Leiras))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    @_aktivCsoport.Leiras
                                </MudText>
                            }
                        </MudPaper>
                        @if (_aktivCsoport is not null || _eszkozTipusokVanCsoport || _masolasbol)
                        {
                            <MudItem xs="12">
                                @if (_masolasbol && _eszkozAzonositoDuplikalva)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" Icon="@Icons.Material.Filled.Warning">
                                        Ez az eszközazonosító már létezik ennél az ügyfélnél / telephelyen.
                                        <b>Mentés előtt kötelező megváltoztatni!</b>
                                    </MudAlert>
                                }
                                <MudTextField @bind-Value="_szerkesztesAlatt!.EszkozAzonosito"
                                Label="@(_eszkozAzonositoDuplikalva ? "Eszköz azonosítója * (kötelező megváltoztatni!)" : "Eszköz azonosítója (opcionális)")"
                                Placeholder="Pl. Tartály #1 · 50m³ · Északi tároló"
                                HelperText="Ha a telephelyen több azonos típusú eszköz van, add meg az egyedi azonosítót."
                                Error="@_eszkozAzonositoDuplikalva"
                                ErrorText="@(_eszkozAzonositoDuplikalva ? "Már létezik ilyen azonosítójú hitelesítés!" : null)"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Label"
                                Clearable="true" />
                            </MudItem>
                        }
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudNumericField T="int" @bind-Value="_szerkesztesAlatt.Darabszam" Label="Darabszám" Min="1" Max="999" />
                </MudItem>
                @if (_aktivCsoport is not null || _eszkozTipusokVanCsoport)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_szerkesztesAlatt.EszkozAzonosito"
                                      Label="Eszköz azonosítója (opcionális)"
                                      Placeholder="Pl. Tartály #1 · 50m³ · Északi tároló"
                                      HelperText="Ha a telephelyen több azonos típusú eszköz van, add meg az egyedi azonosítót."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Label"
                                      Clearable="true" />
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="_datum"
                                   DateChanged="OnDatumValtozas"
                                   Label="Hitelesítés dátuma *"
                                   Editable="true"
                                   DateFormat="yyyy.MM.dd"
                                   Required="true"
                                   RequiredError="A hitelesítés dátuma kötelező!"
                                   HelperText="A lejárat automatikusan számítódik" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudStack Spacing="0">
                        <MudDatePicker Date="_lejaratDatum"
                                       DateChanged="OnLejaratDatumValtozas"
                                       Label="@(_manualisLejaratDatum ? "Lejárat (manuális) *" : "Általános lejárat (auto)")"
                                       Editable="true"
                                       DateFormat="yyyy.MM.dd" />
                        @if (_manualisLejaratDatum)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Autorenew"
                                       OnClick="AutoLejaratVisszaallitas">
                                Visszaállítás auto módba
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>
                
                <!-- Eredmény -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Class="mb-1">Eredmény</MudText>
                    <MudToggleGroup T="HitelesitesStatusz" @bind-Value="_szerkesztesAlatt.HitelesitesStatusz" 
                                    Color="Color.Primary" 
                                    Rounded="true" 
                                    CheckMark="true">
                        <MudToggleItem Value="HitelesitesStatusz.Sikeres" Text="Sikeres" />
                        <MudToggleItem Value="HitelesitesStatusz.Sikertelen" Text="Sikertelen" />
                    </MudToggleGroup>
                </MudItem>

                <!-- ========== EGYEDI LEJÁRATOK SZAKASZ ========== -->
                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mr-1" />
                        Eltérő lejáratú pisztolyok/eszközök
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mb-3 mud-text-secondary">
                        Ha egy pisztoly/eszköz javítás miatt máskor jár le, itt adhatja meg.
                    </MudText>
                    
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="UjEgyediLejaratHozzaadas" 
                               Class="mb-3">
                        Egyedi lejárat hozzáadása
                    </MudButton>

                    @if (_aktualisEgyediLejaratok.Any())
                    {
                        <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                            @foreach (var reszlet in _aktualisEgyediLejaratok)
                            {
                                <MudPaper Class="pa-3 mb-2" Elevation="1">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="reszlet.EszkozNev" 
                                                          Label="Eszköz neve *" 
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="pl.: 2-es benzin pisztoly" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudDatePicker @bind-Date="@reszlet.LejaratDatumNullable" 
                                                           Label="Lejárati dátum *" 
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           DateFormat="yyyy.MM.dd" 
                                                           Editable="true" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="reszlet.Megjegyzes" 
                                                          Label="Megjegyzés" 
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="pl.: javítás után" />
                                        </MudItem>
                                        <MudItem xs="12" md="1" Class="d-flex align-center justify-center">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                           Color="Color.Error" 
                                                           Size="Size.Small"
                                                           OnClick="() => EgyediLejaratTorlese(reszlet)" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            Nincs egyedi lejárat megadva. Minden eszköz az általános lejárati dátummal rendelkezik.
                        </MudAlert>
                    }
                </MudItem>
                <!-- ========== EGYEDI LEJÁRATOK VÉGE ========== -->

                <!-- ========== FÁJLFELTÖLTÉSEK ========== -->
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="mr-1" />
                        Dokumentumok
                    </MudText>
                </MudItem>

                <!-- Munkalap feltöltés -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Class="mb-1">Munkalap (PDF, képfájl)</MudText>
                    @if (!string.IsNullOrWhiteSpace(_szerkesztesAlatt.MunkalapPath))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@Path.GetFileName(_szerkesztesAlatt.MunkalapPath)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => MunkalapLetoltese())" Title="Letöltés" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => MunkalapTorlese())" Title="Törlés" />
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Nincs feltöltve</MudText>
                    }
                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.pdf" MaximumFileCount="1"
                                   FilesChanged="@(async (file) => await MunkalapFeltoltese(file))">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Upload">
                                @(string.IsNullOrWhiteSpace(_szerkesztesAlatt.MunkalapPath) ? "Munkalap feltöltése" : "Csere")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudItem>

                <!-- Hitelesítési bizonyítvány feltöltés -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Class="mb-1">Hitelesítési bizonyítvány (PDF, képfájl)</MudText>
                    @if (!string.IsNullOrWhiteSpace(_szerkesztesAlatt.BizonyitvanyPath))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@Path.GetFileName(_szerkesztesAlatt.BizonyitvanyPath)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => BizonyitvanyLetoltese())" Title="Letöltés" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => BizonyitvanyTorlese())" Title="Törlés" />
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Nincs feltöltve</MudText>
                    }
                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.pdf" MaximumFileCount="1"
                                   FilesChanged="@(async (file) => await BizonyitvanyFeltoltese(file))">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Upload">
                                @(string.IsNullOrWhiteSpace(_szerkesztesAlatt.BizonyitvanyPath) ? "Bizonyítvány feltöltése" : "Csere")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudItem>
                <!-- ========== FÁJLFELTÖLTÉSEK VÉGE ========== -->

                <MudItem xs="12">
                    <MudTextField @bind-Value="_szerkesztesAlatt.Megjegyzes" Label="Általános megjegyzés" Lines="2" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="DialogBezarasa">Mégse</MudButton>
        <MudButton OnClick="MentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_mentes">
            @(_mentes ? "Mentés..." : "Mentés")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Eszköztípusok kezelése dialógus -->
<MudDialog @bind-Visible="_eszkozTipusDialogNyitva" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />Eszköztípusok kezelése</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.End">
            <MudTextField @bind-Value="_ujEszkozTipusNev" Label="Új típus neve" Style="flex:1" />
            <MudNumericField @bind-Value="_ujEszkozTipusHonap" Label="Hónap" Min="1" Max="180" Style="width:100px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UjEszkozTipusHozzaadasaAsync" 
                       Disabled="@string.IsNullOrWhiteSpace(_ujEszkozTipusNev)">Hozzáadás</MudButton>
        </MudStack>
        
        <MudDivider Class="my-3" />
        
        <MudList T="EszkozTipus" Dense="true">
            @foreach (var tipus in _eszkozTipusok)
            {
                <MudListItem T="EszkozTipus">
                    <div class="d-flex align-center justify-space-between" style="width:100%">
                        @if (_szerkesztettEszkozTipusId == tipus.Id)
                        {
                            <!-- Szerkesztési mód -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="flex:1" Class="mr-2">
                                <MudTextField @bind-Value="_szerkesztettEszkozTipusNev" 
                                              Label="Név" 
                                              Style="flex:1" 
                                              Margin="Margin.Dense" />
                                <MudNumericField @bind-Value="_szerkesztettEszkozTipusHonap" 
                                                 Label="Hónap" 
                                                 Min="1" Max="180" 
                                                 Style="width:80px" 
                                                 Margin="Margin.Dense" />
                            </MudStack>
                            <MudStack Row="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" 
                                               OnClick="EszkozTipusMentese" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" 
                                               OnClick="EszkozTipusSzerkesztesMegse" />
                            </MudStack>
                        }
                        else
                        {
                            <!-- Megjelenítési mód - KATTINTHATÓ -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" 
                                      Style="flex:1; cursor:pointer" 
                                      @onclick="() => EszkozTipusSzerkesztes(tipus)">
                                <MudText Style="user-select:none">@tipus.Nev</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="cursor:pointer">
