    }

    private async Task MentesAsync()
    {
        if (_szerkesztesAlatt is null || _datum is null) 
        { 
            Snackbar.Add("A dátum megadása kötelező!", Severity.Warning); 
            return; 
        }
        if (_szerkesztesAlatt.UgyfelId == null) 
        { 
            Snackbar.Add("Az ügyfél kiválasztása kötelező!", Severity.Warning); 
            return; 
        }
        if (_szerkesztesAlatt.TelephelyId == null) 
        { 
            Snackbar.Add("A telephely kiválasztása kötelező!", Severity.Warning); 
            return; 
        }
        if (_szerkesztesAlatt.EszkozTipusId == 0) 
        { 
            Snackbar.Add("Az eszköztípus kiválasztása kötelező!", Severity.Warning); 
            return; 
        }

        // ÚJ: Egyedi lejáratok validálása
        if (_aktualisEgyediLejaratok.Any(r => string.IsNullOrWhiteSpace(r.EszkozNev)))
        {
            Snackbar.Add("Minden egyedi eszköz nevének megadása kötelező!", Severity.Warning);
            return;
        }

        // Duplikált eszközazonosító blokkolása ÚJ hitelesítésnél (de másolásnál NEM!)
        if (_szerkesztesAlatt.Id == 0 && !_masolasbol && _eszkozAzonositoDuplikalva)
        {
            var azonositoSzoveg = string.IsNullOrWhiteSpace(_szerkesztesAlatt.EszkozAzonosito)
                ? "üres eszközazonosítóval"
                : $"\"{_szerkesztesAlatt.EszkozAzonosito}\" azonosítóval";
            Snackbar.Add(
                $"Már létezik hitelesítés {azonositoSzoveg} ennél az ügyfélnél / telephelyen / eszköztípusnál! " +
                "Adjon meg egyedi eszközazonosítót a mentéshez.",
                Severity.Warning);
            return;
        }

        // ÚJ: Duplikáció ellenőrzés (új hitelesítésnél ÉS másolásnál is!)
        if (_szerkesztesAlatt.Id == 0)
        {
            var regiHitelesites = await HitelesitesService.EllenorizDuplikaciot(
                _szerkesztesAlatt.UgyfelId.Value,
                _szerkesztesAlatt.TelephelyId.Value,
                _szerkesztesAlatt.EszkozTipusId,
                _szerkesztesAlatt.EszkozAzonosito,
                _datum.Value
            );

            if (regiHitelesites != null)
            {
                var eszkozInfo = string.IsNullOrWhiteSpace(_szerkesztesAlatt.EszkozAzonosito)
                    ? ""
                    : $" (Eszköz: {_szerkesztesAlatt.EszkozAzonosito})";
                var lejaratInfo = regiHitelesites.LejaratDatum.HasValue
                    ? $", lejárat: {regiHitelesites.LejaratDatum.Value:yyyy.MM.dd}"
                    : "";
                var uzenet = $"Már létezik hasonló hitelesítés: {regiHitelesites.Ugyfel?.Nev} / {regiHitelesites.Telephely?.Nev} / {regiHitelesites.EszkozTipus?.Nev}{eszkozInfo}, dátum: {regiHitelesites.Datum:yyyy.MM.dd}{lejaratInfo}. Mit szeretne tenni?";

                var valasz = await ShowDuplikacioDialog(uzenet);
                if (valasz == "Mégsem")
                {
                    return; // Nem mentünk semmit, régi változatlan marad
                }
                else if (valasz == "Igen")
                {
                    // Régi inaktív, új aktív
                    await HitelesitesService.InaktivvaTesz(regiHitelesites.Id);
                    _szerkesztesAlatt.Aktiv = true;
                }
                else // "Nem"
                {
                    // Régi változatlan marad, új aktív állapottal mentésre kerül
                    _szerkesztesAlatt.Aktiv = true;
                }
            }
        }

        _szerkesztesAlatt.Datum = _datum.Value;
        _szerkesztesAlatt.LejaratDatum = _lejaratDatum;

        // ÚJ: Egyedi lejáratok mentése
        _szerkesztesAlatt.EgyediLejaratokLista = _aktualisEgyediLejaratok;

        // Csoporttag lejáratok mentése (csak az egyedi dátummal rendelkezőkét)
        _szerkesztesAlatt.CsoportTagLejaratokLista = _csoportTagSorok
            .Where(s => s.EgyediDatumHasznalata || s.NemAlkalmazhato || s.MunkalapPaths.Any() || s.BizonyitvanyPaths.Any())  // ← mentjük a N/A-t és dokumentumokat is
            .Select(s => new CsoportTagLejaratReszlet
            {
                EszkozTipusId = s.Tag.EszkozTipusId,
                EszkozTipusNev = s.EszkozTipusNev,
                LejaratDatum = s.NemAlkalmazhato ? null : s.EgyediLejaratDatum,
                NemAlkalmazhato = s.NemAlkalmazhato,
                MunkalapPath = s.MunkalapPath,
                BizonyitvanyPath = s.BizonyitvanyPath,
                MunkalapPathsLista = s.MunkalapPaths,
                BizonyitvanyPathsLista = s.BizonyitvanyPaths
            })
            .ToList();

        // Automatikus lejárt státusz
        if (_lejaratDatum.HasValue && _lejaratDatum.Value.Date < DateTime.Today && 
            _szerkesztesAlatt.HitelesitesStatusz == HitelesitesStatusz.Sikeres)
        {
            _szerkesztesAlatt.HitelesitesStatusz = HitelesitesStatusz.Lejart;
        }

        _mentes = true;
        try
        {
            // Debug: ellenőrizzük, hogy vannak-e fájlútvonalak
            var debugMsg = $"Mentés előtt - Munkalap: {(_szerkesztesAlatt.MunkalapPath ?? "NINCS")}, Bizonyítvány: {(_szerkesztesAlatt.BizonyitvanyPath ?? "NINCS")}";
            Console.WriteLine(debugMsg);

            if (_szerkesztesAlatt.Id == 0) 
                await HitelesitesService.CreateAsync(_szerkesztesAlatt);
            else 
                await HitelesitesService.UpdateAsync(_szerkesztesAlatt);

            Snackbar.Add("Sikeres mentés!", Severity.Success); 
            DialogBezarasa(); 
            await BetoltesAsync();
        }
        catch (Exception ex) 
        { 
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); 
        }
        finally 
        { 
            _mentes = false; 
        }
    }

