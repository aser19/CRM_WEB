    private void OnEszkozTipusValtozas(int ujEszkozTipusId)
    {
        if (_szerkesztesAlatt != null)
        {
            _szerkesztesAlatt.EszkozTipusId = ujEszkozTipusId;
            _manualisLejaratDatum = false; // típus váltásakor visszaáll auto módba
            SzamoljLejaratot();
            FrissitsCsoportTagSorokat();
        }
    }

    private void FrissitsCsoportTagSorokat()
    {
        if (_szerkesztesAlatt is null) return;

        _aktivCsoport = _csoportok.FirstOrDefault(c =>
            c.FoEszkozTipusId == _szerkesztesAlatt.EszkozTipusId ||
            c.Tagok.Any(t => t.EszkozTipusId == _szerkesztesAlatt.EszkozTipusId));

        if (_aktivCsoport is null)
        {
            _csoportTagSorok = new();
            return;
        }

        // Meglévő egyedi dátumok betöltése (szerkesztés esetén)
        var mentettDatumok = _szerkesztesAlatt.CsoportTagLejaratokLista;

        _csoportTagSorok = _aktivCsoport.Tagok
            .OrderBy(t => t.Sorrend)
            .Select(tag =>
            {
                var eszkozTipus = _eszkozTipusok.FirstOrDefault(e => e.Id == tag.EszkozTipusId);
                var autoLejarat = _datum.HasValue && eszkozTipus != null
                    ? _datum.Value.AddMonths(eszkozTipus.HitelesitesiIdotartamHonap)
                    : (DateTime?)null;

                var mentett = mentettDatumok.FirstOrDefault(m => m.EszkozTipusId == tag.EszkozTipusId);

                return new CsoportTagSor
                {
                    Tag = tag,
                    EszkozTipusNev = eszkozTipus?.Nev ?? "–",
                    EszkozTipusHonap = eszkozTipus?.HitelesitesiIdotartamHonap ?? 0,
                    AutoLejaratDatum = autoLejarat,
                    EgyediDatumHasznalata = mentett != null && !mentett.NemAlkalmazhato,
                    EgyediLejaratDatum = mentett?.LejaratDatum ?? autoLejarat,
                    NemAlkalmazhato = mentett?.NemAlkalmazhato ?? false,  // ← ÚJ
                    MunkalapPath = mentett?.MunkalapPath,
                    BizonyitvanyPath = mentett?.BizonyitvanyPath,
                    MunkalapPaths = mentett?.MunkalapPathsLista ?? new List<string>(),
                    BizonyitvanyPaths = mentett?.BizonyitvanyPathsLista ?? new List<string>()
                };
            })
            .ToList();
    }

    private void OnDatumValtozas(DateTime? ujDatum)
    {
        _datum = ujDatum;
        if (!_manualisLejaratDatum)
            SzamoljLejaratot();
    }

    private void SzamoljLejaratot()
    {
        if (_manualisLejaratDatum) return; // ← manuális esetén nem nyúl hozzá
        if (_szerkesztesAlatt == null || _datum == null || _szerkesztesAlatt.EszkozTipusId == 0)
            return;

        var tipus = _eszkozTipusok.FirstOrDefault(t => t.Id == _szerkesztesAlatt.EszkozTipusId);
        if (tipus != null && tipus.HitelesitesiIdotartamHonap > 0)
        {
            _lejaratDatum = _datum.Value.AddMonths(tipus.HitelesitesiIdotartamHonap);
            StateHasChanged();
        }
    }

