    {
        public HitelesitesCsoportTag Tag { get; set; } = null!;
        public string EszkozTipusNev { get; set; } = "";
        public int EszkozTipusHonap { get; set; }
        public DateTime? AutoLejaratDatum { get; set; }
        public bool EgyediDatumHasznalata { get; set; }
        public DateTime? EgyediLejaratDatum { get; set; }
    }
