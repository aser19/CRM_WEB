    private async Task KozbensoMunkalapFeltoltese(IBrowserFile? file, CsoportTagSor sor)
    {
        if (file is null || _szerkesztesAlatt is null || _szerkesztesAlatt.UgyfelId is null) return;

        try
        {
            var ugyfel = _ugyfelek.FirstOrDefault(u => u.Id == _szerkesztesAlatt.UgyfelId.Value);
            if (ugyfel is null)
            {
                Snackbar.Add("Ügyfél nem található!", Severity.Error);
                return;
            }

            var ceg = _elerhetoCegek.FirstOrDefault(c => c.Id == ugyfel.CegId);
            var cegNev = ceg?.Nev ?? "Ismeretlen";

            // Kategória: közbenső vizsgálat neve
            var kategoria = $"Kozbenso_{sor.EszkozTipusNev.Replace(" ", "_")}";

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var path = await FileStorageService.SaveHitelesitesFileAsync(
                stream,
                file.Name,
                cegNev,
                ugyfel.Nev ?? "Ismeretlen",
                kategoria,
                new[] { ".pdf", ".jpg", ".jpeg", ".png" },
                10
            );

            sor.MunkalapPath = path;

            // ÚJ: hozzáadjuk a fájlt a listához is
            if (!sor.MunkalapPaths.Contains(path))
                sor.MunkalapPaths.Add(path);

            // Frissítjük a felületet
            StateHasChanged();

            // Ha a hitelesítés már el van mentve, automatikusan frissítjük az adatbázisban is
            if (_szerkesztesAlatt.Id > 0)
            {
                // Frissítjük a CsoportTagLejaratokLista-t
                _szerkesztesAlatt.CsoportTagLejaratokLista = _csoportTagSorok
                    .Where(s => s.EgyediDatumHasznalata || s.NemAlkalmazhato || s.MunkalapPaths.Any() || s.BizonyitvanyPaths.Any())
                    .Select(s => new CsoportTagLejaratReszlet
                    {
                        EszkozTipusId = s.Tag.EszkozTipusId,
                        EszkozTipusNev = s.EszkozTipusNev,
                        LejaratDatum = s.NemAlkalmazhato ? null : s.EgyediLejaratDatum,
                        NemAlkalmazhato = s.NemAlkalmazhato,
                        MunkalapPath = s.MunkalapPath,
                        BizonyitvanyPath = s.BizonyitvanyPath,
                        MunkalapPathsLista = s.MunkalapPaths,
                        BizonyitvanyPathsLista = s.BizonyitvanyPaths
                    })
                    .ToList();

                await HitelesitesService.UpdateAsync(_szerkesztesAlatt);
                Snackbar.Add("Munkalap feltöltve és mentve!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Munkalap feltöltve! Mentsd el a hitelesítést a véglegesítéshez.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
    }

