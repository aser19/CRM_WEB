@page "/hitelesitesek"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Services.Interfaces
@inject IHitelesitesService HitelesitesService
@inject IEszkozTipusService EszkozTipusService
@inject IHatosagService HatosagService
@inject IUgyfelService UgyfelService
@inject ITelephelyService TelephelyService
@inject ITenantService TenantService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IEmailKuldoService EmailKuldoService
@inject IHitelesitesCsoportService HitelesitesCsoportService
@inject IHitelesitesCsoportService HitelesitesCsoportService

<PageTitle>Hitelesítések</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Hitelesítések</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_kereses" Label="Keresés (ügyfél, telephely, típus)" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Style="max-width:400px;" />
        <MudSpacer />
        @if (_isAdmin)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Settings" 
                       OnClick="EszkozTipusokMegnyitasa" Class="mr-2">Eszköztípusok</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="UjMegnyitasa">Új hitelesítés</MudButton>
    </MudStack>

    <MudDataGrid T="Hitelesites" Items="_szurtLista" Filterable="false" SortMode="SortMode.Multiple" Hover="true" Striped="true" Loading="_betoltes">
        <Columns>
            <TemplateColumn Title="Ügyfél">
                <CellTemplate>@(context.Item.Ugyfel?.Nev ?? "-")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Telephely">
                <CellTemplate>@(context.Item.Telephely?.Nev ?? "-")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Eszköztípus">
                <CellTemplate>@(context.Item.EszkozTipus?.Nev ?? "-")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="h => h.Darabszam" Title="Darab" />
            <PropertyColumn Property="h => h.Datum" Title="Dátum" Format="yyyy.MM.dd" />
            <TemplateColumn Title="Lejárat">
                <CellTemplate>
                    <div>
                        @if (context.Item.LejaratDatum.HasValue)
                        {
                            <div>@context.Item.LejaratDatum.Value.ToString("yyyy.MM.dd")</div>
                        }
                        @if (context.Item.EgyediLejaratokLista.Any())
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Info" Class="mt-1">
                                @context.Item.EgyediLejaratokLista.Count egyedi
                            </MudChip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Státusz">
                <CellTemplate>
                    @switch (context.Item.HitelesitesStatusz)
                    {
                        case HitelesitesStatusz.Sikeres:
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Sikeres</MudChip>
                            break;
                        case HitelesitesStatusz.Sikertelen:
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Sikertelen</MudChip>
                            break;
                        case HitelesitesStatusz.Lejart:
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Lejárt</MudChip>
                            break;
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Műveletek" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="Email küldése">
                            <MudIconButton Icon="@Icons.Material.Filled.Email" 
                                           Color="Color.Info" 
                                           Size="Size.Small" 
                                           OnClick="() => EmailKuldesDialogusMegnyitasa(context.Item)" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => SzerkesztesMegnyitasa(context.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => TorlesMegerosites(context.Item)" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Eszközazonosító" Sortable="true">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.EszkozAzonosito))
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="Color.Secondary"
                                 Icon="@Icons.Material.Filled.Label">
                            @context.Item.EszkozAzonosito
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText>Nincs megjeleníthető hitelesítés.</MudText></NoRecordsContent>
    </MudDataGrid>
</MudPaper>

<!-- Hitelesítés dialógus -->
<MudDialog @bind-Visible="_dialogNyitva" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(_szerkesztesAlatt?.Id > 0 ? "Hitelesítés szerkesztése" : "Új hitelesítés")</MudText></TitleContent>
    <DialogContent>
        @if (_szerkesztesAlatt is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" Value="_kivalasztottUgyfelId" ValueChanged="OnUgyfelValtozas" Label="Ügyfél *" Required="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Válasszon --</MudSelectItem>
                        @foreach (var u in _ugyfelek)
                        {
                            <MudSelectItem T="int?" Value="@((int?)u.Id)">@u.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" @bind-Value="_szerkesztesAlatt.TelephelyId" Label="Telephely *" Required="true" 
                               Disabled="@(_kivalasztottUgyfelId == null)"
                               ToStringFunc="@(id => id.HasValue ? (_szurtTelephelyek.FirstOrDefault(t => t.Id == id.Value)?.Nev ?? "") : "")">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Válasszon --</MudSelectItem>
                        @foreach (var t in _szurtTelephelyek)
                        {
                            <MudSelectItem T="int?" Value="@((int?)t.Id)">@t.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Value="_szerkesztesAlatt.EszkozTipusId" ValueChanged="OnEszkozTipusValtozas" Label="Eszköztípus *" Required="true">
                        @if (_aktivCsoport is not null)
                        {
                            <MudItem xs="12">
                                <MudPaper Outlined="true" Class="pa-3 mt-1" Style="border-color: var(--mud-palette-info);">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                                 Color="Color.Info" Size="Size.Small" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Info">
                                            @_aktivCsoport.Nev – közbenső vizsgálatok
                                        </MudText>
                                    </MudStack>

                                    @foreach (var sor in _csoportTagSorok)
                                    {
                                        <MudPaper Outlined="true" Class="pa-2 mb-2">
                                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                                <!-- Vizsgálat neve -->
                                                <MudItem xs="12" md="4">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudIcon Icon="@(sor.Tag.Kotelezo ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                                                 Size="Size.Small"
                                                                 Color="@(sor.Tag.Kotelezo ? Color.Warning : Color.Default)" />
                                                        <div>
                                                            <MudText Typo="Typo.body2"><b>@sor.EszkozTipusNev</b></MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @sor.EszkozTipusHonap hónap
                                                                @if (sor.Tag.Kotelezo)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small"
                                                                             Color="Color.Warning" Class="ml-1">Kötelező</MudChip>
                                                                }
                                                            </MudText>
                                                        </div>
                                                    </MudStack>
                                                </MudItem>

                                                <!-- Auto lejárat -->
                                                <MudItem xs="12" md="3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Auto lejárat</MudText>
                                                    <MudText Typo="Typo.body2">
                                                        @(sor.AutoLejaratDatum?.ToString("yyyy.MM.dd") ?? "–")
                                                    </MudText>
                                                </MudItem>

                                                <!-- Egyedi dátum toggle + picker -->
                                                <MudItem xs="12" md="5">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudSwitch @bind-Value="sor.EgyediDatumHasznalata"
                                                                   Color="Color.Primary"
                                                                   Label="Eltérő dátum"
                                                                   Size="Size.Small" />
                                                        @if (sor.EgyediDatumHasznalata)
                                                        {
                                                            <MudDatePicker @bind-Date="sor.EgyediLejaratDatum"
                                                                           Label="Egyedi lejárat"
                                                                           DateFormat="yyyy.MM.dd"
                                                                           Editable="true"
                                                                           Margin="Margin.Dense"
                                                                           Style="max-width:160px;" />
                                                        }
                                                    </MudStack>
                                                    @if (!string.IsNullOrEmpty(sor.Tag.Megjegyzes))
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @sor.Tag.Megjegyzes
                                                        </MudText>
                                                    }
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }

                                    @if (!string.IsNullOrEmpty(_aktivCsoport.Leiras))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                            @_aktivCsoport.Leiras
                                        </MudText>
                                    }
                                </MudPaper>
                            </MudItem>
                        }
                        @foreach (var t in _eszkozTipusok)
                        {
                            <MudSelectItem Value="@t.Id">@t.Nev (@(t.HitelesitesiIdotartamHonap / 12) év)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int" @bind-Value="_szerkesztesAlatt.Darabszam" Label="Darabszám" Min="1" Max="999" />
                </MudItem>
                @if (_aktivCsoport is not null || _eszkozTipusokVanCsoport)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_szerkesztesAlatt.EszkozAzonosito"
                                      Label="Eszköz azonosítója (opcionális)"
                                      Placeholder="Pl. Tartály #1 · 50m³ · Északi tároló"
                                      HelperText="Ha a telephelyen több azonos típusú eszköz van, add meg az egyedi azonosítót."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Label"
                                      Clearable="true" />
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="_datum" DateChanged="OnDatumValtozas" Label="Dátum *" Editable="true" DateFormat="yyyy.MM.dd" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_lejaratDatum" Label="Általános lejárat" Editable="true" DateFormat="yyyy.MM.dd" />
                </MudItem>
                
                <!-- Eredmény -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Class="mb-1">Eredmény</MudText>
                    <MudToggleGroup T="HitelesitesStatusz" @bind-Value="_szerkesztesAlatt.HitelesitesStatusz" 
                                    Color="Color.Primary" 
                                    Rounded="true" 
                                    CheckMark="true">
                        <MudToggleItem Value="HitelesitesStatusz.Sikeres" Text="Sikeres" />
                        <MudToggleItem Value="HitelesitesStatusz.Sikertelen" Text="Sikertelen" />
                    </MudToggleGroup>
                </MudItem>

                <!-- ========== EGYEDI LEJÁRATOK SZAKASZ ========== -->
                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mr-1" />
                        Eltérő lejáratú pisztolyok/eszközök
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mb-3 mud-text-secondary">
                        Ha egy pisztoly/eszköz javítás miatt máskor jár le, itt adhatja meg.
                    </MudText>
                    
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="UjEgyediLejaratHozzaadas" 
                               Class="mb-3">
                        Egyedi lejárat hozzáadása
                    </MudButton>

                    @if (_aktualisEgyediLejaratok.Any())
                    {
                        <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                            @foreach (var reszlet in _aktualisEgyediLejaratok)
                            {
                                <MudPaper Class="pa-3 mb-2" Elevation="1">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="reszlet.EszkozNev" 
                                                          Label="Eszköz neve *" 
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="pl.: 2-es benzin pisztoly" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudDatePicker @bind-Date="@reszlet.LejaratDatumNullable" 
                                                           Label="Lejárati dátum *" 
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           DateFormat="yyyy.MM.dd" 
                                                           Editable="true" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="reszlet.Megjegyzes" 
                                                          Label="Megjegyzés" 
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Placeholder="pl.: javítás után" />
                                        </MudItem>
                                        <MudItem xs="12" md="1" Class="d-flex align-center justify-center">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                           Color="Color.Error" 
                                                           Size="Size.Small"
                                                           OnClick="() => EgyediLejaratTorlese(reszlet)" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            Nincs egyedi lejárat megadva. Minden eszköz az általános lejárati dátummal rendelkezik.
                        </MudAlert>
                    }
                </MudItem>
                <!-- ========== EGYEDI LEJÁRATOK VÉGE ========== -->
                
                <MudItem xs="12">
                    <MudTextField @bind-Value="_szerkesztesAlatt.Megjegyzes" Label="Általános megjegyzés" Lines="2" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="DialogBezarasa">Mégse</MudButton>
        <MudButton OnClick="MentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_mentes">
            @(_mentes ? "Mentés..." : "Mentés")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Eszköztípusok kezelése dialógus -->
<MudDialog @bind-Visible="_eszkozTipusDialogNyitva" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />Eszköztípusok kezelése</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.End">
            <MudTextField @bind-Value="_ujEszkozTipusNev" Label="Új típus neve" Style="flex:1" />
            <MudNumericField @bind-Value="_ujEszkozTipusHonap" Label="Hónap" Min="1" Max="180" Style="width:100px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UjEszkozTipusHozzaadasaAsync" 
                       Disabled="@string.IsNullOrWhiteSpace(_ujEszkozTipusNev)">Hozzáadás</MudButton>
        </MudStack>
        
        <MudDivider Class="my-3" />
        
        <MudList T="EszkozTipus" Dense="true">
            @foreach (var tipus in _eszkozTipusok)
            {
                <MudListItem T="EszkozTipus">
                    <div class="d-flex align-center justify-space-between" style="width:100%">
                        @if (_szerkesztettEszkozTipusId == tipus.Id)
                        {
                            <!-- Szerkesztési mód -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="flex:1" Class="mr-2">
                                <MudTextField @bind-Value="_szerkesztettEszkozTipusNev" 
                                              Label="Név" 
                                              Style="flex:1" 
                                              Margin="Margin.Dense" />
                                <MudNumericField @bind-Value="_szerkesztettEszkozTipusHonap" 
                                                 Label="Hónap" 
                                                 Min="1" Max="180" 
                                                 Style="width:80px" 
                                                 Margin="Margin.Dense" />
                            </MudStack>
                            <MudStack Row="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" 
                                               OnClick="EszkozTipusMentese" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" 
                                               OnClick="EszkozTipusSzerkesztesMegse" />
                            </MudStack>
                        }
                        else
                        {
                            <!-- Megjelenítési mód - KATTINTHATÓ -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" 
                                      Style="flex:1; cursor:pointer" 
                                      @onclick="() => EszkozTipusSzerkesztes(tipus)">
                                <MudText Style="user-select:none">@tipus.Nev</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="cursor:pointer">
                                    @tipus.HitelesitesiIdotartamHonap hónap
                                </MudChip>
                            </MudStack>
                            <MudStack Row="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                               OnClick="() => EszkozTipusSzerkesztes(tipus)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                               OnClick="() => EszkozTipusTorlese(tipus)" />
                            </MudStack>
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => { _eszkozTipusDialogNyitva = false; _szerkesztettEszkozTipusId = null; }">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

<!-- Email küldés dialógus -->
<MudDialog @bind-Visible="_emailDialogNyitva" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" />
            Email értesítés küldése
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_emailHitelesites is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                <b>@_emailHitelesites.Ugyfel?.Nev</b> - @_emailHitelesites.EszkozTipus?.Nev<br/>
                Lejárat: @_emailHitelesites.LejaratDatum?.ToString("yyyy.MM.dd")
            </MudAlert>

            <MudSelect T="EmailErtesitesTipus" @bind-Value="_kivalasztottEmailTipus" Label="Értesítés típusa *" Required="true" Class="mb-3">
                <MudSelectItem Value="EmailErtesitesTipus.HitelesitesLejarat90Nap">Hitelesítés lejárat - 90 nap</MudSelectItem>
                <MudSelectItem Value="EmailErtesitesTipus.HitelesitesLejarat30Nap">Hitelesítés lejárat - 30 nap</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_emailCimzett" Label="Címzett email cím *" Required="true" 
                          InputType="InputType.Email" HelperText="Az ügyfél vagy telephely email címe" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _emailDialogNyitva = false">Mégse</MudButton>
        <MudButton OnClick="EmailKuldesAsync" Color="Color.Primary" Variant="Variant.Filled" 
                   Disabled="_emailKuldes" StartIcon="@Icons.Material.Filled.Send">
            @(_emailKuldes ? "Küldés..." : "Küldés")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Hitelesites> _lista = new();
    private List<EszkozTipus> _eszkozTipusok = new();
    private List<Hatosag> _hatosagok = new();
    private List<Ugyfel> _ugyfelek = new();
    private List<Telephely> _telephelyek = new();
    private string _kereses = string.Empty;
    private bool _betoltes = true, _dialogNyitva = false, _mentes = false;
    private bool _isAdmin;
    private int _cegId;
    private Hitelesites? _szerkesztesAlatt;
    private DateTime? _datum, _lejaratDatum;
    private int? _kivalasztottUgyfelId;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };

    // ÚJ: Egyedi lejáratok kezeléséhez
    private List<HitelesitesReszlet> _aktualisEgyediLejaratok = new();

    // Eszköztípus kezelés dialógushoz
    private bool _eszkozTipusDialogNyitva = false;
    private string _ujEszkozTipusNev = string.Empty;
    private int _ujEszkozTipusHonap = 12;
    private int? _szerkesztettEszkozTipusId = null;
    private string _szerkesztettEszkozTipusNev = string.Empty;
    private int _szerkesztettEszkozTipusHonap = 12;

    // Email küldés
    private bool _emailDialogNyitva = false;
    private bool _emailKuldes = false;
    private Hitelesites? _emailHitelesites;
    private EmailErtesitesTipus _kivalasztottEmailTipus = EmailErtesitesTipus.HitelesitesLejarat90Nap;
    private string _emailCimzett = "";

    private IEnumerable<Telephely> _szurtTelephelyek => _kivalasztottUgyfelId.HasValue 
        ? _telephelyek.Where(t => t.UgyfelId == _kivalasztottUgyfelId.Value) 
        : Enumerable.Empty<Telephely>();

    private IEnumerable<Hitelesites> _szurtLista => string.IsNullOrWhiteSpace(_kereses) ? _lista
        : _lista.Where(h => 
            (h.Ugyfel?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (h.Telephely?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (h.EszkozTipus?.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false));

    // Hitelesítési csoport
    private List<HitelesitesCsoport> _csoportok = new();
    private HitelesitesCsoport? _aktivCsoport;
    // Megmutatja-e az azonosító mezőt (ha van csoport hozzárendelve az eszköztípushoz)
    private bool _eszkozTipusokVanCsoport =>
        _szerkesztesAlatt != null &&
        _csoportok.Any(c =>
            c.FoEszkozTipusId == _szerkesztesAlatt.EszkozTipusId ||
            c.Tagok.Any(t => t.EszkozTipusId == _szerkesztesAlatt.EszkozTipusId));
    private List<CsoportTagSor> _csoportTagSorok = new();

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = TenantService.IsInRole(FelhasznaloSzerepkor.Admin);
