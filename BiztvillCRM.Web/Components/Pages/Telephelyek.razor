@page "/telephelyek"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@inject ITelephelyService TelephelyService
@inject IUgyfelService UgyfelService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantService TenantService
@inject ICegService CegService

<PageTitle>Telephelyek</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Telephelyek</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_kereses" Label="Keresés (név, cím)" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" Style="max-width:400px;" />
        <MudSpacer />
        <MudTooltip Text="@(_csoportositott ? "Lista nézet" : "Csoportosítás ügyfél szerint")">
            <MudIconButton Icon="@(_csoportositott ? Icons.Material.Filled.TableRows : Icons.Material.Filled.GroupWork)"
                           Color="@(_csoportositott ? Color.Primary : Color.Default)"
                           Variant="@(_csoportositott ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => _csoportositott = !_csoportositott)" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="UjMegnyitasa">Új telephely</MudButton>
    </MudStack>

    @if (!_csoportositott)
    {
        <MudDataGrid T="Telephely" Items="_szurtLista" Filterable="false" SortMode="SortMode.Multiple" Hover="true" Striped="true" Loading="_betoltes">
        <Columns>
            <PropertyColumn Property="t => t.Nev" Title="Név" />
            <TemplateColumn Title="Ügyfél" Sortable="true" SortBy="@(t => t.Ugyfel?.Nev ?? "")">
                <CellTemplate>
                    <div>
                        <div>@(context.Item.Ugyfel?.Nev ?? "-")</div>
                        @if (_elerhetoCegek.Count > 1 && context.Item.Ugyfel != null)
                        {
                            var szin = GetCegSzin(context.Item.Ugyfel.CegId);
                            var rovidites = GetCegRovidites(context.Item.Ugyfel.CegId);
                            var cegNev = GetCegNev(context.Item.Ugyfel.CegId);
                            <MudTooltip Text="@cegNev" Placement="Placement.Right">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px; margin-top:2px;")"
                                         Label="true">
                                    @rovidites
                                </MudChip>
                            </MudTooltip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="t => t.Cim" Title="Cím" />
            <PropertyColumn Property="t => t.Kapcsolattarto" Title="Kapcsolattartó" />
            <PropertyColumn Property="t => t.Telefon" Title="Telefon" />
            <TemplateColumn Title="Aktív">
                <CellTemplate>
                    <MudIcon Icon="@(context.Item.Aktiv? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(context.Item.Aktiv ? Color.Success : Color.Error)" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Műveletek" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => SzerkesztesMegnyitasa(context.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => TorlesMegerosites(context.Item)" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText>Nincs megjeleníthető telephely.</MudText></NoRecordsContent>
    </MudDataGrid>
    }
    else
    {
        @if (_betoltes)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
        else if (!_szurtLista.Any())
        {
            <MudText Class="pa-4 ml-2">Nincs megjeleníthető telephely.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Class="mt-1">
                @foreach (var csoport in _szurtLista.GroupBy(t => t.UgyfelId).OrderBy(g => g.FirstOrDefault()?.Ugyfel?.Nev ?? ""))
                {
                    var ugyfelNev = csoport.FirstOrDefault()?.Ugyfel?.Nev ?? "-";
                    var cegId = csoport.FirstOrDefault()?.Ugyfel?.CegId ?? 0;
                    var telephelyek = csoport.OrderBy(t => t.Nev).ToList();

                    <MudExpansionPanel IsInitiallyExpanded="true">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1"><b>@ugyfelNev</b></MudText>
                                @if (_elerhetoCegek.Count > 1)
                                {
                                    var szin = GetCegSzin(cegId);
                                    var rovidites = GetCegRovidites(cegId);
                                    var cegNev = GetCegNev(cegId);
                                    <MudTooltip Text="@cegNev">
                                        <MudChip T="string" Size="Size.Small" Label="true"
                                                 Style="@($"background-color:{szin}; color:white; font-weight:600; font-size:10px; height:18px;")">
                                            @rovidites
                                        </MudChip>
                                    </MudTooltip>
                                }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @telephelyek.Count telephely
                                </MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudTable T="Telephely" Items="@telephelyek" Hover="true" Dense="true" Striped="true"
                                      Breakpoint="Breakpoint.Sm" Class="mb-2">
                                <HeaderContent>
                                    <MudTh>Név</MudTh>
                                    <MudTh>Cím</MudTh>
                                    <MudTh>Kapcsolattartó</MudTh>
                                    <MudTh>Telefon</MudTh>
                                    <MudTh>Aktív</MudTh>
                                    <MudTh>Műveletek</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Név">@(context.Nev ?? "-")</MudTd>
                                    <MudTd DataLabel="Cím">@(context.Cim ?? "-")</MudTd>
                                    <MudTd DataLabel="Kapcsolattartó">@(context.Kapcsolattarto ?? "-")</MudTd>
                                    <MudTd DataLabel="Telefon">@(context.Telefon ?? "-")</MudTd>
                                    <MudTd DataLabel="Aktív">
                                        <MudIcon Icon="@(context.Aktiv ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                 Color="@(context.Aktiv ? Color.Success : Color.Error)" />
                                    </MudTd>
                                    <MudTd DataLabel="Műveletek">
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => SzerkesztesMegnyitasa(context)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => TorlesMegerosites(context)" />
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
</MudPaper>

<MudDialog @bind-Visible="_dialogNyitva" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(_szerkesztesAlatt?.Id > 0 ? "Telephely szerkesztése" : "Új telephely")</MudText></TitleContent>
    <DialogContent>
        @if (_szerkesztesAlatt is not null)
        {
            <MudGrid>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_szerkesztesAlatt.Nev" Label="Név *" Required="true" /></MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_szerkesztesAlatt.UgyfelId" Label="Ügyfél *">
                        @foreach (var u in _ugyfelek)
                        {
                            <MudSelectItem Value="@u.Id">@u.Nev</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_szerkesztesAlatt.Cim" Label="Cím" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_szerkesztesAlatt.Kapcsolattarto" Label="Kapcsolattartó" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_szerkesztesAlatt.Telefon" Label="Telefon" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_szerkesztesAlatt.Email" Label="Email" /></MudItem>
                <MudItem xs="12"><MudSwitch @bind-Value="_szerkesztesAlatt.Aktiv" Label="Aktív" Color="Color.Primary" /></MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="DialogBezarasa">Mégse</MudButton>
        <MudButton OnClick="MentesAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_mentes">@(_mentes ? "Mentés..." : "Mentés")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Telephely> _lista = new();
    private List<Ugyfel> _ugyfelek = new();
    private string _kereses = string.Empty;
    private bool _betoltes = true, _dialogNyitva = false, _mentes = false;
    private bool _csoportositott = true; // Csoportosított nézet kapcsoló
    private Telephely? _szerkesztesAlatt;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private IEnumerable<Telephely> _szurtLista => string.IsNullOrWhiteSpace(_kereses) ? _lista
        : _lista.Where(t => (t.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (t.Cim?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<Ceg> _elerhetoCegek = new();

    private static readonly string[] _cegSzinek =
    [
        "#1976D2", "#F57C00", "#388E3C", "#7B1FA2", "#C62828", "#00838F",
    ];

    private string GetCegSzin(int cegId)
    {
        if (_elerhetoCegek.Count <= 1) return "";
        var index = _elerhetoCegek.FindIndex(c => c.Id == cegId);
        return _cegSzinek[Math.Max(0, index) % _cegSzinek.Length];
    }

    private string GetCegRovidites(int cegId)
    {
        var ceg = _elerhetoCegek.FirstOrDefault(c => c.Id == cegId);
        if (ceg == null) return "?";
        return ceg.MatricaElotag
            ?? new string(ceg.Nev.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpper();
    }

    private string GetCegNev(int cegId)
        => _elerhetoCegek.FirstOrDefault(c => c.Id == cegId)?.Nev ?? "";

    protected override async Task OnInitializedAsync()
    {
        await BetoltesAsync();
        _ugyfelek = await UgyfelService.GetAllAsync();

        // Multi-tenant cég badge betöltés
        var elerhhetoCegIds = await TenantService.GetElerhhetoCegIdsAsync();
        if (elerhhetoCegIds.Count > 1)
        {
            var osszesCeg = await CegService.GetAllAsync(csakAktiv: false);
            _elerhetoCegek = osszesCeg
                .Where(c => elerhhetoCegIds.Contains(c.Id))
                .OrderBy(c => c.Id == TenantService.GetCurrentCegId() ? 0 : 1)
                .ThenBy(c => c.Nev)
                .ToList();
        }
    }

    private async Task BetoltesAsync() { _betoltes = true; _lista = await TelephelyService.GetAllAsync(); _betoltes = false; }

    private void UjMegnyitasa() { _szerkesztesAlatt = new Telephely { Aktiv = true }; _dialogNyitva = true; }
    private void SzerkesztesMegnyitasa(Telephely item) { _szerkesztesAlatt = new Telephely { Id = item.Id, Nev = item.Nev, Cim = item.Cim, UgyfelId = item.UgyfelId, Kapcsolattarto = item.Kapcsolattarto, Telefon = item.Telefon, Email = item.Email, Aktiv = item.Aktiv }; _dialogNyitva = true; }
    private void DialogBezarasa() { _dialogNyitva = false; _szerkesztesAlatt = null; }

    private async Task MentesAsync()
    {
        if (_szerkesztesAlatt is null || string.IsNullOrWhiteSpace(_szerkesztesAlatt.Nev)) { Snackbar.Add("A név megadása kötelező!", Severity.Warning); return; }
        _mentes = true;
        try
        {
            if (_szerkesztesAlatt.Id == 0) await TelephelyService.CreateAsync(_szerkesztesAlatt);
            else await TelephelyService.UpdateAsync(_szerkesztesAlatt);
            Snackbar.Add("Sikeres mentés!", Severity.Success); DialogBezarasa(); await BetoltesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        finally { _mentes = false; }
    }

    private async Task TorlesMegerosites(Telephely item)
    {
        if (await DialogService.ShowMessageBox("Törlés megerősítése", $"Biztosan törli: \"{item.Nev}\"?", yesText: "Törlés", cancelText: "Mégse") == true)
        {
            try { await TelephelyService.DeleteAsync(item.Id); Snackbar.Add("Törölve.", Severity.Success); await BetoltesAsync(); }
            catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
        }
    }
}