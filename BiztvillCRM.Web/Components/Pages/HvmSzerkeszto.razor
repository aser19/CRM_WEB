@page "/hvm-szerkeszto/{MellekletId:int}"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Services
@inject IMellekletJegyzokonyvService MellekletService
@inject IMeresService MeresService
@inject IEszkozService EszkozService
@inject IKalibracioService KalibracioService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHvmPdfService HvmPdfService
@inject IFelulvizsgaloService FelulvizsgaloService

<PageTitle>Hibavédelmi mérési jegyzőkönyv</PageTitle>

@if (_betoltes)
{
    <MudProgressCircular Indeterminate="true" Class="mt-8" />
}
else if (_melleklet == null)
{
    <MudAlert Severity="Severity.Error">A melléklet nem található.</MudAlert>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.ElectricBolt" Class="mr-2" />
        Hibavédelmi mérési jegyzőkönyv —
        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="ml-1">
            @_melleklet.Szam
        </MudChip>
    </MudText>

    @* === 1. OLDAL: FEJLAP === *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" Class="mr-1" />
            1. oldal – Fejlap (melléklet)
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_adatok.JelentesTipus"
                           Label="Jelentés típusa"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Használatba vételt megelőző")">Használatba vételt megelőző</MudSelectItem>
                    <MudSelectItem Value="@("Időszakos felülvizsgálat")">Időszakos felülvizsgálat</MudSelectItem>
                    <MudSelectItem Value="@("Rendkívüli felülvizsgálat")">Rendkívüli felülvizsgálat</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_adatok.Munkaszam"
                              Label="Munkaszám"
                              Variant="Variant.Outlined"
                              HelperText="pl. BVP-MNB-0210" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_meresIdeje"
                               Label="Mérés ideje"
                               Variant="Variant.Outlined"
                               DateFormat="yyyy.MM.dd" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_keszitesDatum"
                               Label="Készítés dátuma"
                               Variant="Variant.Outlined"
                               DateFormat="yyyy.MM.dd" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_adatok.KapcsolatTarto"
                              Label="Kapcsolattartó"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_adatok.UzemiKisero"
                              Label="Belső azonosító szám"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int?"
                           Value="_kivalasztottFelulvizsgaloId"
                           ValueChanged="OnFelulvizsgaloValtozasAsync"
                           Label="Felülvizsgáló"
                           Variant="Variant.Outlined">
                    <MudSelectItem T="int?" Value="null">-- Válassz --</MudSelectItem>
                    @foreach (var f in _felulvizsgalok)
                    {
                        <MudSelectItem T="int?" Value="@f.Id">@f.Nev</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Value="@_foAdatok.VizsgalatHelye"
                              Label="A mérés helye"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Lock" />
            </MudItem>

            @* Műszer adatok *@
            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.subtitle2">Műszer adatok</MudText>
                    @if (!_adatok.Muszerek.Any(m => !string.IsNullOrEmpty(m.Tipus)))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">kötelező</MudChip>
                    }
                </MudStack>
            </MudItem>

            @for (int i = 0; i < GetLathatoMuszerekSzama(); i++)
            {
                var index = i;
                var aktualis = index < _adatok.Muszerek.Count ? _adatok.Muszerek[index] : null;

                <MudItem xs="12" md="4">
                    <MudSelect T="int?"
                               Value="@GetMuszerEszkozId(index)"
                               ValueChanged="@(async (int? id) => await OnMuszerValtozasAsync(index, id))"
                               Label="@($"Műszer {index + 1}")"
                               Variant="Variant.Outlined"
                               Clearable="true">
                        <MudSelectItem T="int?" Value="null">-- Válassz műszert --</MudSelectItem>
                        @foreach (var m in _muszerek)
                        {
                            <MudSelectItem T="int?" Value="@m.Id">
                                @m.Nev @(string.IsNullOrEmpty(m.Tipus) ? "" : $"({m.Tipus})")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@(aktualis?.Tipus ?? "")"
                                  ValueChanged="@((string v) => SetMuszerTipus(index, v))"
                                  Label="Típus / Gyári szám"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@(aktualis?.Kalibralas ?? "")"
                                  ValueChanged="@((string v) => SetMuszerKalibralas(index, v))"
                                  Label="Kalibrálva"
                                  Variant="Variant.Outlined"
                                  Placeholder="yyyy.MM.dd" />
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    @* === 2–N. OLDAL: MÉRÉSI ADATOK === *@
    <MeresiPontLista MeresiPontok="_adatok.MeresiPontok"
                     RendszerTipus="@(_foAdatok.MeresiRendszerTipus ?? "TN")"
                     OnChange="StateHasChanged"
                     EgyszeruMod="true" />

    @* === GOMBOK === *@
    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mb-4">
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="Vissza">Vissza</MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="LetoltesAsync"
                   Disabled="_feldolgozas">
            @(_feldolgozas ? "Generálás..." : "Letöltés (PDF)")
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="MentesEsBezarAsync"
                   Disabled="_feldolgozas">
            @(_feldolgozas ? "Mentés..." : "Mentés és bezár")
        </MudButton>
    </MudStack>
}

@code {
    [Parameter] public int MellekletId { get; set; }

    private MellekletJegyzokonyv? _melleklet;
    private HvmAdatok _adatok = new();
    private JegyzokonyvAdatok _foAdatok = new();   // ← főjgyk-ból betöltött, csak olvasható
    private bool _betoltes = true;
    private bool _feldolgozas = false;

    private DateTime? _meresIdeje
    {
        get => _adatok.MeresIdeje;
        set => _adatok.MeresIdeje = value ?? DateTime.Today;
    }
    private DateTime? _muszerKalibralas
    {
        get => _adatok.MuszerKalibralasDatum;
        set => _adatok.MuszerKalibralasDatum = value;
    }
    private DateTime? _keszitesDatum
    {
        get => _adatok.KeszitesDatum;
        set => _adatok.KeszitesDatum = value ?? DateTime.Today;
    }

    private List<Eszkoz> _muszerek = new();
    private List<int?> _kivalasztottMuszerIds = new() { null, null, null };
    private List<Felulvizsgalo> _felulvizsgalok = new();
    private int? _kivalasztottFelulvizsgaloId;

    private async Task OnFelulvizsgaloValtozasAsync(int? felulvizsgaloId)
    {
        _kivalasztottFelulvizsgaloId = felulvizsgaloId;
        var felulvizsgalo = felulvizsgaloId.HasValue
            ? _felulvizsgalok.FirstOrDefault(f => f.Id == felulvizsgaloId.Value)
            : null;
        _adatok.FelulvizsgaloNev = felulvizsgalo?.Nev ?? "";
        await Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        // Műszerek betöltése
        var osszes = await EszkozService.GetAllAsync();
        _muszerek = osszes.Where(e => e.Kategoria?.Contains("műszer", StringComparison.OrdinalIgnoreCase) == true
                                   || e.Kategoria?.Contains("mérő", StringComparison.OrdinalIgnoreCase) == true).ToList();
        if (!_muszerek.Any()) _muszerek = osszes; // ha nincs szűrés, mutasson mindent

        _felulvizsgalok = await FelulvizsgaloService.GetAllAsync();

        _melleklet = await MellekletService.GetByIdAsync(MellekletId);
        if (_melleklet != null)
        {
            var foMeres = await MeresService.GetByIdAsync(_melleklet.MeresId);
            if (foMeres != null && !string.IsNullOrWhiteSpace(foMeres.JegyzokonyvAdatokJson))
            {
                _foAdatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
                    foMeres.JegyzokonyvAdatokJson) ?? new JegyzokonyvAdatok();
            }

            if (!string.IsNullOrWhiteSpace(_melleklet.AdatokJson))
            {
                _adatok = System.Text.Json.JsonSerializer.Deserialize<HvmAdatok>(_melleklet.AdatokJson) ?? new HvmAdatok();
                _adatok.Muszerek ??= new List<MuszerSor>();
                _kivalasztottMuszerIds = _adatok.Muszerek.Select(m => m.EszkozId).ToList();
                if (foMeres != null && _adatok.MeresIdeje == DateTime.Today)
                    _adatok.MeresIdeje = foMeres.Datum;

                // Ha az egyes fejléc mezők még üresek (régebbi mentés), pótoljuk a főjegyzőkönyvből.
                if (string.IsNullOrWhiteSpace(_adatok.CegNev)) _adatok.CegNev = _foAdatok.CegNev;
                if (string.IsNullOrWhiteSpace(_adatok.CegCim)) _adatok.CegCim = _foAdatok.CegCim;
                if (string.IsNullOrWhiteSpace(_adatok.KapcsolatTarto)) _adatok.KapcsolatTarto = _foAdatok.KapcsolatTarto;
                if (string.IsNullOrWhiteSpace(_adatok.UzemiKisero)) _adatok.UzemiKisero = _foAdatok.UzemiKisero;
                if (string.IsNullOrWhiteSpace(_adatok.MeresiRendszerTipus)) _adatok.MeresiRendszerTipus = _foAdatok.MeresiRendszerTipus ?? "TN";
                if (string.IsNullOrWhiteSpace(_adatok.FelulvizsgaloNev)) _adatok.FelulvizsgaloNev = _foAdatok.FelulvizsgaloNev;
                if (string.IsNullOrWhiteSpace(_adatok.MeresHelye)) _adatok.MeresHelye = _foAdatok.VizsgalatHelye;
            }
            else
            {
                _adatok.Munkaszam = _melleklet.Szam;
                _adatok.CegNev = _foAdatok.CegNev;
                _adatok.CegCim = _foAdatok.CegCim;
                _adatok.KapcsolatTarto = _foAdatok.KapcsolatTarto;
                _adatok.UzemiKisero = _foAdatok.UzemiKisero;
                _adatok.MeresiRendszerTipus = _foAdatok.MeresiRendszerTipus ?? "TN";
                _adatok.FelulvizsgaloNev = _foAdatok.FelulvizsgaloNev;
                _adatok.MeresHelye = _foAdatok.VizsgalatHelye;
                if (foMeres != null)
                {
                    _adatok.MeresIdeje = foMeres.Datum;
                    _adatok.KeszitesDatum = foMeres.Datum;

                    // Főjgyk műszereinek előtöltése
                    if (_foAdatok.Muszerek?.Any() == true)
                    {
                        _adatok.Muszerek = _foAdatok.Muszerek
                            .Take(3)
                            .Select(m => new MuszerSor
                            {
                                EszkozId = m.EszkozId,
                                Tipus = $"{m.Tipus} {m.GyariSzam}".Trim(),
                                Kalibralas = m.Kalibralas
                            }).ToList();
                        _kivalasztottMuszerIds = _adatok.Muszerek
                            .Select(m => m.EszkozId)
                            .ToList();
                    }
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(_adatok.FelulvizsgaloNev))
        {
            _kivalasztottFelulvizsgaloId = _felulvizsgalok
                .FirstOrDefault(f => f.Nev == _adatok.FelulvizsgaloNev)?.Id;
        }

        _betoltes = false;
    }

    private async Task MentesEsBezarAsync()
    {
        _feldolgozas = true;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_adatok);

            // 1. Adatok mentése + "Kész" státusz beállítása
            await MellekletService.MentAdatokAsync(MellekletId, json, kesz: true);

            // 2. Linked Meres létrehozása, ha még nincs (download gomb feltétele)
            _melleklet = await MellekletService.GetByIdAsync(MellekletId);
            if (_melleklet != null && !_melleklet.MellekletMeresId.HasValue)
            {
                var foMeres = await MeresService.GetByIdAsync(_melleklet.MeresId);
                if (foMeres != null)
                {
                    await MellekletService.MellekletMeresLetrehozAsync(
                        MellekletId,
                        foMeres.MeresTipusId,
                        new BiztvillCRM.Shared.Models.JegyzokonyvAdatok
                        {
                            JegyzokonyvSzam = _melleklet.Szam
                        });
                }
            }

            Snackbar.Add("Mentve!", Severity.Success);
            Vissza();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

    private async Task LetoltesAsync()
    {
        _feldolgozas = true;
        try
        {
            // 1. Mentés JSON-be
            var json = System.Text.Json.JsonSerializer.Serialize(_adatok);
            await MellekletService.MentAdatokAsync(MellekletId, json, kesz: true);

            // 2. Linked mérés létrehozása/frissítése, ha még nincs
            _melleklet = await MellekletService.GetByIdAsync(MellekletId);
            int meresId;

            if (_melleklet != null && !_melleklet.MellekletMeresId.HasValue)
            {
                var foMeres = await MeresService.GetByIdAsync(_melleklet.MeresId);
                if (foMeres != null)
                {
                    meresId = await MellekletService.MellekletMeresLetrehozAsync(
                        MellekletId,
                        foMeres.MeresTipusId,
                        new BiztvillCRM.Shared.Models.JegyzokonyvAdatok
                        {
                            JegyzokonyvSzam = _melleklet.Szam
                        });
                }
                else
                {
                    Snackbar.Add("Hiba: Főmérés nem található!", Severity.Error);
                    return;
                }
            }
            else
            {
                meresId = _melleklet?.MellekletMeresId ?? 0;
            }

            if (meresId == 0)
            {
                Snackbar.Add("Hiba: Mérés ID nem található!", Severity.Error);
                return;
            }

            // 3. PDF dokumentum generálása
            var pdfBytes = await HvmPdfService.GeneralasAsync(meresId, _adatok);

            // 4. Letöltés JavaScript segítségével
            await JS.InvokeVoidAsync("downloadFile", 
                $"HVM_{_melleklet?.Szam ?? "jegyzokonyv"}.pdf", 
                Convert.ToBase64String(pdfBytes));

            Snackbar.Add("Letöltés indult!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba a letöltés során: {ex.Message}", Severity.Error);
        }
        finally
        {
            _feldolgozas = false;
        }
    }

    private void Vissza()
    {
        if (_melleklet != null)
            Navigation.NavigateTo($"/jegyzokonyv/{_melleklet.MeresId}");
        else
            Navigation.NavigateTo("/meresek");
    }

    private int GetLathatoMuszerekSzama()
    {
        int kitoltott = _adatok.Muszerek.Count(m => !string.IsNullOrEmpty(m.Tipus));
        return Math.Min(kitoltott + 1, 3);
    }

    private int? GetMuszerEszkozId(int index) =>
        index < _kivalasztottMuszerIds.Count ? _kivalasztottMuszerIds[index] : null;

    private void SetMuszerTipus(int index, string ertek)
    {
        while (_adatok.Muszerek.Count <= index) _adatok.Muszerek.Add(new MuszerSor());
        _adatok.Muszerek[index].Tipus = ertek;
    }

    private void SetMuszerKalibralas(int index, string ertek)
    {
        while (_adatok.Muszerek.Count <= index) _adatok.Muszerek.Add(new MuszerSor());
        _adatok.Muszerek[index].Kalibralas = ertek;
    }

    private async Task OnMuszerValtozasAsync(int index, int? eszkozId)
    {
        while (_adatok.Muszerek.Count <= index) _adatok.Muszerek.Add(new MuszerSor());
        while (_kivalasztottMuszerIds.Count <= index) _kivalasztottMuszerIds.Add(null);

        _kivalasztottMuszerIds[index] = eszkozId;
        _adatok.Muszerek[index].EszkozId = eszkozId;

        if (eszkozId.HasValue)
        {
            var muszer = _muszerek.FirstOrDefault(m => m.Id == eszkozId.Value);
            if (muszer != null)
            {
                var kalibraciok = await KalibracioService.GetByEszkozIdAsync(eszkozId.Value);
                var utolso = kalibraciok.FirstOrDefault();
                _adatok.Muszerek[index].Tipus = $"{muszer.Nev} {muszer.GyariSzam}".Trim();
                _adatok.Muszerek[index].Kalibralas = utolso?.Datum.ToString("yyyy.MM.dd") ?? "";
            }
        }
        else
        {
            _adatok.Muszerek[index] = new MuszerSor();
        }
    }
}