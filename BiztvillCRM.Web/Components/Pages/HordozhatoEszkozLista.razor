@namespace BiztvillCRM.Web.Components.Pages
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Web.Components.Dialog
@using BiztvillCRM.Services.Interfaces
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IEszkozSablonService EszkozSablonService

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Devices" Class="mr-2" />
            Vizsgált eszközök (@Eszkozok.Count db)
        </MudText>
        
        @* ✅ ÚJ: Szerkesztési mód kapcsoló *@
        @if (Eszkozok.Count > 0)
        {
            <MudSwitch @bind-Value="_szerkesztesMod" 
                       Color="Color.Primary" 
                       UnCheckedColor="Color.Default"
                       Label="@(_szerkesztesMod ? "Szerkesztési mód BE" : "Szerkesztési mód KI")"
                       ThumbIcon="@(_szerkesztesMod ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)" />
        }
    </MudStack>

    @* Helyiség választó - AUTOCOMPLETE a kézi bevitelhez *@
    <MudGrid Class="mb-3">
        <MudItem xs="12" md="4">
            <MudAutocomplete T="string"
                         @bind-Value="_aktualisHelyisegNev"
                         Label="Aktív helyiség"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         SearchFunc="@HelyisegKereses"
                         CoerceText="false"
                         CoerceValue="false"
                         Clearable="true"
                         Placeholder="Válassz vagy írd be..."
                         ResetValueOnEmptyText="false"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Room"
                         DebounceInterval="300"
                         ShowProgressIndicator="true" />
        </MudItem>
        <MudItem xs="12" md="8" Class="d-flex align-center">
            @if (!string.IsNullOrEmpty(_aktualisHelyisegNev))
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.Room">
                    Új eszközök ide kerülnek: <b>@_aktualisHelyisegNev</b>
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                    Nincs helyiség kiválasztva!
                </MudChip>
            }
        </MudItem>
    </MudGrid>

    @* Gyors helyiség váltó gombok - ha már van eszköz *@
    @if (Eszkozok.Count > 0)
    {
        var hasznaltHelyisegek = Eszkozok
            .Where(e => !string.IsNullOrWhiteSpace(e.HelyisegNev))
            .Select(e => e.HelyisegNev)
            .Distinct()
            .ToList();
        
        @if (hasznaltHelyisegek.Any())
        {
            <MudStack Row="true" Spacing="1" Class="mb-3 flex-wrap">
                <MudText Typo="Typo.caption" Class="mr-2 align-self-center">Gyors váltás:</MudText>
                @foreach (var hely in hasznaltHelyisegek)
                {
                    <MudButton Size="Size.Small" 
                               Variant="@(_aktualisHelyisegNev == hely ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               OnClick="@(() => GyorsHelyisegValtas(hely))">
                        @hely (@Eszkozok.Count(e => e.HelyisegNev == hely) db)
                    </MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => _aktualisHelyisegNev = "")">
                    Új helyiség
                </MudButton>
            </MudStack>
        }
    }

    @* ✅ ÚJ: Figyelmeztetés a sablon használathoz *@
    @if (_sablonokBetoltve && _sablonok.Any())
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" />
                <MudText Typo="Typo.body2">
                    <strong>@_sablonok.Count db eszköz sablon</strong> elérhető. Ha a megnevezés egyezik, automatikusan hozzáadódnak az alkatrészek!
                </MudText>
                <MudButton Size="Size.Small" 
                           Variant="Variant.Text" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="SablonokMegtekintese">
                    Sablonok megtekintése
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @* Eszköz hozzáadás gyorsform *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="2">
            <MudTextField @bind-Value="_ujEszkoz.Megnevezes" 
                          Label="Megnevezés *" 
                          Variant="Variant.Outlined" 
                          Size="Size.Small"
                          OnBlur="EllenorizSablont" />
        </MudItem>
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Tipus" Label="Típus" 
                          Variant="Variant.Outlined" Size="Size.Small" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudTextField @bind-Value="_ujEszkoz.Azonosito" Label="Gyártási szám" 
                          Variant="Variant.Outlined" Size="Size.Small" />
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudSelect T="string" @bind-Value="_ujEszkoz.VedelmiOsztaly" Label="Osztály *" 
                       Variant="Variant.Outlined" Size="Size.Small">
                <MudSelectItem T="string" Value="@("I")">I.</MudSelectItem>
                <MudSelectItem T="string" Value="@("II")">II.</MudSelectItem>
                <MudSelectItem T="string" Value="@("III")">III.</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudSelect T="string" @bind-Value="_ujEszkoz.Telj" Label="Feszültség" 
                       Variant="Variant.Outlined" Size="Size.Small">
                <MudSelectItem T="string" Value="@("230V")">230V</MudSelectItem>
                <MudSelectItem T="string" Value="@("400V")">400V</MudSelectItem>
                <MudSelectItem T="string" Value="@("12V")">12V</MudSelectItem>
                <MudSelectItem T="string" Value="@("24V")">24V</MudSelectItem>
                <MudSelectItem T="string" Value="@("48V")">48V</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudSelect T="string" @bind-Value="_ujEszkoz.Megtekint" Label="Szemrevét." 
                       Variant="Variant.Outlined" Size="Size.Small">
                <MudSelectItem T="string" Value="@("MF")">MF</MudSelectItem>
                <MudSelectItem T="string" Value="@("NMF")">NMF</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Folyt" Label="Folyt." 
                          Variant="Variant.Outlined" Size="Size.Small" Placeholder="Ω"
                          Disabled="@(!_ujEszkoz.KellFolyt)" />
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Szigell" Label="Szig." 
                          Variant="Variant.Outlined" Size="Size.Small" Placeholder="MΩ" />
        </MudItem>
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Szivargo" Label="Sziv." 
                          Variant="Variant.Outlined" Size="Size.Small" Placeholder="mA" />
        </MudItem>
        <MudItem xs="12" md="1" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       OnClick="EszkozHozzaadas" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add">
                Hozzáad
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (Eszkozok.Count > 0)
    {
        <!-- A táblázat része változatlan, csak a kód részben változik -->
        <MudDataGrid Items="@Eszkozok" Groupable="false" Filterable="false" SortMode="SortMode.None">
            <Columns>
                <TemplateColumn Title="Ssz." CellStyle="width: 60px;">
                    <CellTemplate>
                        @if (context.Item.CsoportSorrend == 0)
                        {
                            <strong>@context.Item.Sorsz</strong>
                        }
                        else
                        {
                            <span style="padding-left: 20px;">—</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Megnevezés *@
                <TemplateColumn Title="Megnevezés">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.Megnevezes" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @if (context.Item.CsoportSorrend > 0)
                            {
                                <div style="padding-left: 30px;">
                                    <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" />
                                    @context.Item.Megnevezes
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(context.Item.CsoportNev))
                            {
                                <strong>
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" />
                                    @context.Item.Megnevezes
                                </strong>
                            }
                            else
                            {
                                @context.Item.Megnevezes
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Típus *@
                <TemplateColumn Title="Típus">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.Tipus" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @context.Item.Tipus
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Gyári szám *@
                <TemplateColumn Title="Gyári szám">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.Azonosito" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @context.Item.Azonosito
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Védelmi osztály *@
                <TemplateColumn Title="Oszt.">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudSelect T="string" @bind-Value="context.Item.VedelmiOsztaly" 
                                       Variant="Variant.Text" 
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       OnValueChanged="@(() => OnCellChanged())">
                                <MudSelectItem T="string" Value="@("I")">I.</MudSelectItem>
                                <MudSelectItem T="string" Value="@("II")">II.</MudSelectItem>
                                <MudSelectItem T="string" Value="@("III")">III.</MudSelectItem>
                            </MudSelect>
                        }
                        else
                        {
                            @context.Item.VedelmiOsztaly
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Feszültség *@
                <TemplateColumn Title="Fesz.">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudSelect T="string" @bind-Value="context.Item.Telj" 
                                       Variant="Variant.Text" 
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       OnValueChanged="@(() => OnCellChanged())">
                                <MudSelectItem T="string" Value="@("230V")">230V</MudSelectItem>
                                <MudSelectItem T="string" Value="@("400V")">400V</MudSelectItem>
                                <MudSelectItem T="string" Value="@("12V")">12V</MudSelectItem>
                                <MudSelectItem T="string" Value="@("24V")">24V</MudSelectItem>
                                <MudSelectItem T="string" Value="@("48V")">48V</MudSelectItem>
                            </MudSelect>
                        }
                        else
                        {
                            @context.Item.Telj
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Szemrevétel *@
                <TemplateColumn Title="Szemre">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudSelect T="string" @bind-Value="context.Item.Megtekint" 
                                       Variant="Variant.Text" 
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       OnValueChanged="@(() => OnCellChanged())">
                                <MudSelectItem T="string" Value="@("MF")">MF</MudSelectItem>
                                <MudSelectItem T="string" Value="@("NMF")">NMF</MudSelectItem>
                            </MudSelect>
                        }
                        else
                        {
                            @context.Item.Megtekint
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Folytonosság *@
                <TemplateColumn Title="Folyt.">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.Folyt" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Disabled="@(!context.Item.KellFolyt)"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @context.Item.Folyt
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Szigetelés *@
                <TemplateColumn Title="Szig.">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.Szigell" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @context.Item.Szigell
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Szivárgó áram *@
                <TemplateColumn Title="Sziv.">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.Szivargo" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @context.Item.Szivargo
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* ✅ SZERKESZTHETŐ: Helyiség *@
                <TemplateColumn Title="Helyiség">
                    <CellTemplate>
                        @if (_szerkesztesMod)
                        {
                            <MudTextField @bind-Value="context.Item.HelyisegNev" 
                                          Variant="Variant.Text" 
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          OnBlur="@(() => OnCellChanged())" />
                        }
                        else
                        {
                            @context.Item.HelyisegNev
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                @* Műveletek oszlop - CSAK nem szerkesztési módban *@
                @if (!_szerkesztesMod)
                {
                    <TemplateColumn Title="Műveletek" Sortable="false">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                @if (context.Item.CsoportSorrend > 0)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Size="Size.Small" 
                                                   Color="Color.Error"
                                                   Title="Alkatrész törlése"
                                                   OnClick="@(() => AlkatreszTorlese(context.Item))" />
                                }
                                else if (!string.IsNullOrEmpty(context.Item.CsoportNev))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Settings" 
                                                   Size="Size.Small" 
                                                   Color="Color.Primary"
                                                   Title="Alkatrészek szerkesztése"
                                                   OnClick="@(() => AlkatreszekSzerkesztese(context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Size="Size.Small" 
                                                   Color="Color.Error"
                                                   Title="Eszköz + alkatrészek törlése"
                                                   OnClick="@(() => FoEszkozTorlese(context.Item))" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                   Size="Size.Small" 
                                                   Color="Color.Primary"
                                                   Title="Szerkesztés"
                                                   OnClick="@(() => EszkozSzerkesztese(context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Size="Size.Small" 
                                                   Color="Color.Error"
                                                   Title="Törlés"
                                                   OnClick="@(() => EszkozTorlese(context.Item))" />
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
        </MudDataGrid>

        <MudDivider Class="my-3" />
        
        <MudStack Row="true" Spacing="4" Class="flex-wrap">
            <MudChip T="string" Color="Color.Primary">Összes: @Eszkozok.Count db</MudChip>
            <MudChip T="string" Color="Color.Success">MF: @Eszkozok.Count(e => e.Megtekint == "MF") db</MudChip>
            <MudChip T="string" Color="Color.Error">NMF: @Eszkozok.Count(e => e.Megtekint == "NMF") db</MudChip>
            <MudChip T="string" Color="Color.Info">I. oszt.: @Eszkozok.Count(e => e.VedelmiOsztaly == "I") db</MudChip>
            <MudChip T="string" Color="Color.Warning">II. oszt.: @Eszkozok.Count(e => e.VedelmiOsztaly == "II") db</MudChip>
            <MudChip T="string" Color="Color.Secondary">III. oszt.: @Eszkozok.Count(e => e.VedelmiOsztaly == "III") db</MudChip>
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            Még nincs eszköz hozzáadva. Adj hozzá eszközöket a fenti űrlapon vagy importálj korábbi jegyzőkönyvet!
        </MudAlert>
    }

    @* Helyiségek sorrendje - a jegyzőkönyvben ez lesz *@
    @if (Eszkozok.Count > 0 && _helyisegSorrend.Count > 1)
    {
        <MudPaper Class="pa-2 mb-3" Elevation="0" Style="background-color: var(--mud-palette-background-grey)">
            <MudText Typo="Typo.caption" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Sort" Size="Size.Small" Class="mr-1" />
                Helyiségek sorrendje (húzd át a rendezéshez):
            </MudText>
            <MudDropContainer T="HelyisegSorrendItem" 
                              Items="@_helyisegSorrend"
                              ItemsSelector="@((item, zone) => true)"
                              ItemDropped="OnHelyisegSorrendValtozas"
                              Class="d-flex flex-wrap gap-2">
                <ChildContent>
                    <MudDropZone T="HelyisegSorrendItem" Identifier="zone" 
                                 Class="d-flex flex-wrap gap-1" 
                                 Style="min-height: 40px;">
                    </MudDropZone>
                </ChildContent>
                <ItemRenderer>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" 
                             Style="cursor: grab;"
                             Icon="@Icons.Material.Filled.DragIndicator">
                        @context.Sorszam. @context.Nev (@context.EszkozokSzama db)
                    </MudChip>
                </ItemRenderer>
            </MudDropContainer>
        </MudPaper>
    }
</MudPaper>

@* ✅ ÚJ: Sablonok megtekintése dialógus *@
<MudDialog @bind-Visible="_sablonokDialogNyitva" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Extension" Class="mr-2" />
            Elérhető eszköz sablonok
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_sablonok.Any())
        {
            <MudList T="EszkozSablon" Dense="true">
                @foreach (var sablon in _sablonok)
                {
                    var alkatreszekSzama = sablon.Alkatreszek.Count;
                    <MudListItem T="EszkozSablon">
                        <MudPaper Class="pa-2 mb-2" Elevation="1">
                            <MudStack Spacing="1">
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle1"><strong>@sablon.Megnevezes</strong></MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                        @alkatreszekSzama alkatrész
                                    </MudChip>
                                </MudStack>
                                @if (!string.IsNullOrEmpty(sablon.Tipus))
                                {
                                    <MudText Typo="Typo.body2">Típus: @sablon.Tipus</MudText>
                                }
                                @if (alkatreszekSzama > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mt-1">
                                        Alkatrészek: @string.Join(", ", sablon.Alkatreszek.Select(a => a.Megnevezes))
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                Még nincs eszköz sablon létrehozva. Hozz létre sablonokat az "Alkatrész kezelés" menüpontban!
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _sablonokDialogNyitva = false)">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public List<HordozhatoEszkozSor> Eszkozok { get; set; } = new();
    [Parameter] public EventCallback<List<HordozhatoEszkozSor>> EszkozokChanged { get; set; }

    private HordozhatoEszkozSor _ujEszkoz = new() { VedelmiOsztaly = "I", Telj = "230V", Megtekint = "MF" };
    private string _aktualisHelyisegNev = "";
    private List<HelyisegSorrendItem> _helyisegSorrend = new();
    private bool _szerkesztesMod = false;
    
    // ✅ MÓDOSÍTOTT: Sablon rendszer adatbázis alapú
    private List<BiztvillCRM.Shared.Models.EszkozSablon> _sablonok = new();
    private bool _sablonokBetoltve = false;
    private bool _sablonokDialogNyitva = false; // ✅ HIÁNYZÓ VÁLTOZÓ

    private class HelyisegSorrendItem
    {
        public string Identifier { get; set; } = Guid.NewGuid().ToString();
        public int Sorszam { get; set; }
        public string Nev { get; set; } = "";
        public int EszkozokSzama { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("localStorageInterop.get", "lastHelyisegNev");
                if (!string.IsNullOrEmpty(saved))
                {
                    _aktualisHelyisegNev = saved;
                }

                // ✅ MÓDOSÍTOTT: Sablonok betöltése adatbázisból
                await SablonokBetoltese();
                StateHasChanged();
            }
            catch { }
        }
    }

    // ✅ ÚJ: Eszközök változásakor frissítjük a helyiség sorrendet
