@namespace BiztvillCRM.Web.Components.Pages
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Web.Components.Dialog
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Devices" Class="mr-2" />
        Vizsgált eszközök (@Eszkozok.Count db)
    </MudText>

    @* Helyiség választó - AUTOCOMPLETE a kézi bevitelhez *@
    <MudGrid Class="mb-3">
        <MudItem xs="12" md="4">
            <MudAutocomplete T="string"
                         @bind-Value="_aktualisHelyisegNev"
                         Label="Aktív helyiség"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         SearchFunc="@HelyisegKereses"
                         CoerceText="false"
                         CoerceValue="false"
                         Clearable="true"
                         Placeholder="Válassz vagy írd be..."
                         ResetValueOnEmptyText="false"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Room"
                         DebounceInterval="300"
                         ShowProgressIndicator="true" />
        </MudItem>
        <MudItem xs="12" md="8" Class="d-flex align-center">
            @if (!string.IsNullOrEmpty(_aktualisHelyisegNev))
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.Room">
                    Új eszközök ide kerülnek: <b>@_aktualisHelyisegNev</b>
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                    Nincs helyiség kiválasztva!
                </MudChip>
            }
        </MudItem>
    </MudGrid>

    @* Gyors helyiség váltó gombok - ha már van eszköz *@
    @if (Eszkozok.Count > 0)
    {
        var hasznaltHelyisegek = Eszkozok
            .Where(e => !string.IsNullOrWhiteSpace(e.HelyisegNev))
            .Select(e => e.HelyisegNev)
            .Distinct()
            .ToList();
        
        @if (hasznaltHelyisegek.Any())
        {
            <MudStack Row="true" Spacing="1" Class="mb-3 flex-wrap">
                <MudText Typo="Typo.caption" Class="mr-2 align-self-center">Gyors váltás:</MudText>
                @foreach (var hely in hasznaltHelyisegek)
                {
                    <MudButton Size="Size.Small" 
                               Variant="@(_aktualisHelyisegNev == hely ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               OnClick="@(() => GyorsHelyisegValtas(hely))">
                        @hely (@Eszkozok.Count(e => e.HelyisegNev == hely) db)
                    </MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => _aktualisHelyisegNev = "")">
                    Új helyiség
                </MudButton>
            </MudStack>
        }
    }

    @* Eszköz hozzáadás gyorsform *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="2">
            <MudTextField @bind-Value="_ujEszkoz.Megnevezes" Label="Megnevezés *" 
                          Variant="Variant.Outlined" Size="Size.Small" />
        </MudItem>
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Tipus" Label="Típus" 
                          Variant="Variant.Outlined" Size="Size.Small" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudTextField @bind-Value="_ujEszkoz.Azonosito" Label="Gyártási szám" 
                          Variant="Variant.Outlined" Size="Size.Small" />
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudSelect T="string" @bind-Value="_ujEszkoz.VedelmiOsztaly" Label="Osztály *" 
                       Variant="Variant.Outlined" Size="Size.Small">
                <MudSelectItem T="string" Value="@("I")">I.</MudSelectItem>
                <MudSelectItem T="string" Value="@("II")">II.</MudSelectItem>
                <MudSelectItem T="string" Value="@("III")">III.</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudSelect T="string" @bind-Value="_ujEszkoz.Telj" Label="Feszültség" 
                       Variant="Variant.Outlined" Size="Size.Small">
                <MudSelectItem T="string" Value="@("230V")">230V</MudSelectItem>
                <MudSelectItem T="string" Value="@("400V")">400V</MudSelectItem>
                <MudSelectItem T="string" Value="@("12V")">12V</MudSelectItem>
                <MudSelectItem T="string" Value="@("24V")">24V</MudSelectItem>
                <MudSelectItem T="string" Value="@("48V")">48V</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudSelect T="string" @bind-Value="_ujEszkoz.Megtekint" Label="Szemrevét." 
                       Variant="Variant.Outlined" Size="Size.Small">
                <MudSelectItem T="string" Value="@("MF")">MF</MudSelectItem>
                <MudSelectItem T="string" Value="@("NMF")">NMF</MudSelectItem>
            </MudSelect>
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Folyt" Label="Folyt." 
                          Variant="Variant.Outlined" Size="Size.Small" Placeholder="Ω"
                          Disabled="@(!_ujEszkoz.KellFolyt)" />
        </MudItem>
        
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Szigell" Label="Szig." 
                          Variant="Variant.Outlined" Size="Size.Small" Placeholder="MΩ" />
        </MudItem>
        <MudItem xs="12" md="1">
            <MudTextField @bind-Value="_ujEszkoz.Szivargo" Label="Sziv." 
                          Variant="Variant.Outlined" Size="Size.Small" Placeholder="mA" />
        </MudItem>
        <MudItem xs="12" md="1" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       OnClick="EszkozHozzaadas" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add">
                Hozzáad
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (Eszkozok.Count > 0)
    {
        <MudDataGrid Items="@Eszkozok" Groupable="true" GroupExpanded="true">
            <Columns>
                <TemplateColumn Title="Ssz." CellStyle="width: 60px;">
                    <CellTemplate>
                        @if (context.Item.CsoportSorrend == 0)
                        {
                            <strong>@context.Item.Sorsz</strong>
                        }
                        else
                        {
                            <span style="padding-left: 20px;">—</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                <TemplateColumn Title="Megnevezés">
                    <CellTemplate>
                        @if (context.Item.CsoportSorrend > 0)
                        {
                            <div style="padding-left: 30px;">
                                <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" />
                                @context.Item.Megnevezes
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(context.Item.CsoportNev))
                        {
                            <strong>
                                <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" />
                                @context.Item.Megnevezes
                            </strong>
                        }
                        else
                        {
                            @context.Item.Megnevezes
                        }
                    </CellTemplate>
                </TemplateColumn>
                
                <PropertyColumn Property="e => e.Tipus" Title="Típus" />
                <PropertyColumn Property="e => e.Azonosito" Title="Gyári szám" />
                <PropertyColumn Property="e => e.VedelmiOsztaly" Title="Oszt." />
                <PropertyColumn Property="e => e.Telj" Title="Fesz." />
                <PropertyColumn Property="e => e.Megtekint" Title="Szemre" />
                <PropertyColumn Property="e => e.Folyt" Title="Folyt." />
                <PropertyColumn Property="e => e.Szigell" Title="Szig." />
                <PropertyColumn Property="e => e.Szivargo" Title="Sziv." />
                <PropertyColumn Property="e => e.HelyisegNev" Title="Helyiség" />
                
                <TemplateColumn Title="Műveletek" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            @if (context.Item.CsoportSorrend > 0)
                            {
                                @* Alkatrész törlése *@
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Size="Size.Small" 
                                               Color="Color.Error"
                                               Title="Alkatrész törlése"
                                               OnClick="@(() => AlkatreszTorlese(context.Item))" />
                            }
                            else if (!string.IsNullOrEmpty(context.Item.CsoportNev))
                            {
                                @* Főeszköz alkatrészekkel - Szerkesztés *@
                                <MudIconButton Icon="@Icons.Material.Filled.Settings" 
                                               Size="Size.Small" 
                                               Color="Color.Primary"
                                               Title="Alkatrészek szerkesztése"
                                               OnClick="@(() => AlkatreszekSzerkesztese(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Size="Size.Small" 
                                               Color="Color.Error"
                                               Title="Eszköz + alkatrészek törlése"
                                               OnClick="@(() => FoEszkozTorlese(context.Item))" />
                            }
                            else
                            {
                                @* ✅ Normál eszköz - Szerkesztés és törlés *@
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                               Size="Size.Small" 
                                               Color="Color.Primary"
                                               Title="Szerkesztés"
                                               OnClick="@(() => EszkozSzerkesztese(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Size="Size.Small" 
                                               Color="Color.Error"
                                               Title="Törlés"
                                               OnClick="@(() => EszkozTorlese(context.Item))" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>

        <MudDivider Class="my-3" />
        
        <MudStack Row="true" Spacing="4" Class="flex-wrap">
            <MudChip T="string" Color="Color.Primary">Összes: @Eszkozok.Count db</MudChip>
            <MudChip T="string" Color="Color.Success">MF: @Eszkozok.Count(e => e.Megtekint == "MF") db</MudChip>
            <MudChip T="string" Color="Color.Error">NMF: @Eszkozok.Count(e => e.Megtekint == "NMF") db</MudChip>
            <MudChip T="string" Color="Color.Info">I. oszt.: @Eszkozok.Count(e => e.VedelmiOsztaly == "I") db</MudChip>
            <MudChip T="string" Color="Color.Warning">II. oszt.: @Eszkozok.Count(e => e.VedelmiOsztaly == "II") db</MudChip>
            <MudChip T="string" Color="Color.Secondary">III. oszt.: @Eszkozok.Count(e => e.VedelmiOsztaly == "III") db</MudChip>
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            Még nincs eszköz hozzáadva. Adj hozzá eszközöket a fenti űrlapon vagy importálj korábbi jegyzőkönyvet!
        </MudAlert>
    }

    @* Helyiségek sorrendje - a jegyzőkönyvben ez lesz *@
    @if (Eszkozok.Count > 0 && _helyisegSorrend.Count > 1)
    {
        <MudPaper Class="pa-2 mb-3" Elevation="0" Style="background-color: var(--mud-palette-background-grey)">
            <MudText Typo="Typo.caption" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Sort" Size="Size.Small" Class="mr-1" />
                Helyiségek sorrendje (húzd át a rendezéshez):
            </MudText>
            <MudDropContainer T="HelyisegSorrendItem" 
                              Items="@_helyisegSorrend"
                              ItemsSelector="@((item, zone) => true)"
                              ItemDropped="OnHelyisegSorrendValtozas"
                              Class="d-flex flex-wrap gap-2">
                <ChildContent>
                    <MudDropZone T="HelyisegSorrendItem" Identifier="zone" 
                                 Class="d-flex flex-wrap gap-1" 
                                 Style="min-height: 40px;">
                    </MudDropZone>
                </ChildContent>
                <ItemRenderer>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" 
                             Style="cursor: grab;"
                             Icon="@Icons.Material.Filled.DragIndicator">
                        @context.Sorszam. @context.Nev (@context.EszkozokSzama db)
                    </MudChip>
                </ItemRenderer>
            </MudDropContainer>
        </MudPaper>
    }
</MudPaper>

@code {
    [Parameter] public List<HordozhatoEszkozSor> Eszkozok { get; set; } = new();
    [Parameter] public EventCallback<List<HordozhatoEszkozSor>> EszkozokChanged { get; set; }

    private HordozhatoEszkozSor _ujEszkoz = new() { VedelmiOsztaly = "I", Telj = "230V", Megtekint = "MF" };
    private string _aktualisHelyisegNev = "";
    
    // ✅ HIÁNYZÓ DEKLARÁCIÓK
    private List<HelyisegSorrendItem> _helyisegSorrend = new();

    // ✅ ÚJ: Nested class a helyiség sorrendhez
    private class HelyisegSorrendItem
    {
        public string Identifier { get; set; } = Guid.NewGuid().ToString();
        public int Sorszam { get; set; }
        public string Nev { get; set; } = "";
        public int EszkozokSzama { get; set; }
    }

    // ✅ ÚJ: OnAfterRenderAsync - helyiség név visszatöltése localStorage-ból
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("localStorageInterop.get", "lastHelyisegNev");
                if (!string.IsNullOrEmpty(saved))
                {
                    _aktualisHelyisegNev = saved;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    // ✅ ÚJ: Eszközök változásakor frissítjük a helyiség sorrendet
    protected override void OnParametersSet()
    {
        FrissitHelyisegSorrend();
    }

    // ✅ Normál eszköz szerkesztése
    private async Task EszkozSzerkesztese(HordozhatoEszkozSor eszkoz)
    {
        var parameters = new DialogParameters
        {
            ["Eszkoz"] = new HordozhatoEszkozSor
            {
                Sorsz = eszkoz.Sorsz,
                Megnevezes = eszkoz.Megnevezes,
                Tipus = eszkoz.Tipus,
                Azonosito = eszkoz.Azonosito,
                VedelmiOsztaly = eszkoz.VedelmiOsztaly,
                Telj = eszkoz.Telj,
                Megtekint = eszkoz.Megtekint,
                Folyt = eszkoz.Folyt,
                Szigell = eszkoz.Szigell,
                Szivargo = eszkoz.Szivargo,
                HelyisegNev = eszkoz.HelyisegNev
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EszkozSzerkesztesDialog>("Eszköz szerkesztése", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is HordozhatoEszkozSor modositott)
        {
            eszkoz.Megnevezes = modositott.Megnevezes;
            eszkoz.Tipus = modositott.Tipus;
            eszkoz.Azonosito = modositott.Azonosito;
            eszkoz.VedelmiOsztaly = modositott.VedelmiOsztaly;
            eszkoz.Telj = modositott.Telj;
            eszkoz.Megtekint = modositott.Megtekint;
            eszkoz.Folyt = modositott.Folyt;
            eszkoz.Szigell = modositott.Szigell;
            eszkoz.Szivargo = modositott.Szivargo;
            eszkoz.HelyisegNev = modositott.HelyisegNev;

            await EszkozokChanged.InvokeAsync(Eszkozok);
            StateHasChanged();
        }
    }

    // ✅ Normál eszköz törlése
    private async Task EszkozTorlese(HordozhatoEszkozSor eszkoz)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törölni szeretnéd: {eszkoz.Megnevezes}?",
            yesText: "Törlés",
            cancelText: "Mégse");

        if (confirm == true)
        {
            Eszkozok.Remove(eszkoz);
            UjraSzamozas();
            await EszkozokChanged.InvokeAsync(Eszkozok);
            StateHasChanged();
        }
    }

    // ✅ Főeszköz + alkatrészek törlése
    private async Task FoEszkozTorlese(HordozhatoEszkozSor foEszkoz)
    {
        var alkatreszekSzama = Eszkozok.Count(e => e.CsoportNev == foEszkoz.CsoportNev && e.CsoportSorrend > 0);
        
        bool? confirm = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törölni szeretnéd: {foEszkoz.Megnevezes} + {alkatreszekSzama} alkatrész?",
            yesText: "Törlés",
            cancelText: "Mégse");

        if (confirm == true)
        {
            Eszkozok.RemoveAll(e => e.CsoportNev == foEszkoz.CsoportNev);
            UjraSzamozas();
            await EszkozokChanged.InvokeAsync(Eszkozok);
            StateHasChanged();
        }
    }

    // Alkatrész törlése
    private async Task AlkatreszTorlese(HordozhatoEszkozSor alkatresz)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törölni szeretnéd: {alkatresz.Megnevezes}?",
            yesText: "Törlés",
            cancelText: "Mégse");

        if (confirm == true)
        {
            Eszkozok.Remove(alkatresz);
            await EszkozokChanged.InvokeAsync(Eszkozok);
            StateHasChanged();
        }
    }

    // Alkatrészek szerkesztése (placeholder)
    private void AlkatreszekSzerkesztese(HordozhatoEszkozSor foEszkoz)
    {
        // TODO: Implementáld később
    }

    // ✅ Sorszámok újraszámozása
    private void UjraSzamozas()
    {
        int sorszam = 1;
        foreach (var eszkoz in Eszkozok.Where(e => string.IsNullOrEmpty(e.CsoportNev) || e.CsoportSorrend == 0))
        {
            eszkoz.Sorsz = sorszam++;
        }
    }

    private void GyorsHelyisegValtas(string helyiseg)
    {
        _aktualisHelyisegNev = helyiseg;
    }

    // ✅ Helyiség sorrend frissítése
    private void FrissitHelyisegSorrend()
    {
        var aktualisHelyisegek = Eszkozok
            .Where(e => !string.IsNullOrWhiteSpace(e.HelyisegNev))
            .Select(e => e.HelyisegNev!)
            .Distinct()
            .ToList();

        // Töröljük azokat, amik már nincsenek használva
        _helyisegSorrend.RemoveAll(h => !aktualisHelyisegek.Contains(h.Nev));

        // Hozzáadjuk az újakat
        foreach (var helyisegNev in aktualisHelyisegek)
        {
            if (!_helyisegSorrend.Any(h => h.Nev == helyisegNev))
            {
                _helyisegSorrend.Add(new HelyisegSorrendItem 
                { 
                    Nev = helyisegNev,
                    Identifier = Guid.NewGuid().ToString()
                });
            }
        }

        // Sorszámok és eszközök számának frissítése
        for (int i = 0; i < _helyisegSorrend.Count; i++)
        {
            _helyisegSorrend[i].Sorszam = i + 1;
            _helyisegSorrend[i].EszkozokSzama = Eszkozok.Count(e => e.HelyisegNev == _helyisegSorrend[i].Nev);
        }
    }

    // ✅ Helyiség sorrend változtatása drag&drop-pal
    private void OnHelyisegSorrendValtozas(MudItemDropInfo<HelyisegSorrendItem> info)
    {
        if (info.Item == null) return;

        var item = info.Item;
        var oldIndex = _helyisegSorrend.IndexOf(item);
        if (oldIndex < 0) return;

        _helyisegSorrend.RemoveAt(oldIndex);
        var newIndex = Math.Min(Math.Max(0, info.IndexInZone), _helyisegSorrend.Count);
        _helyisegSorrend.Insert(newIndex, item);

        // Sorszámok újraszámozása
        for (int i = 0; i < _helyisegSorrend.Count; i++)
            _helyisegSorrend[i].Sorszam = i + 1;

        StateHasChanged();
    }

    private async Task EszkozHozzaadas()
    {
        if (string.IsNullOrWhiteSpace(_ujEszkoz.Megnevezes)) return;

        if (!_ujEszkoz.KellFolyt) _ujEszkoz.Folyt = "";

        if (!string.IsNullOrEmpty(_aktualisHelyisegNev))
        {
            try { await JS.InvokeVoidAsync("localStorageInterop.set", "lastHelyisegNev", _aktualisHelyisegNev); }
            catch { }
        }

        _ujEszkoz.HelyisegNev = _aktualisHelyisegNev;
        _ujEszkoz.Sorsz = Eszkozok.Count + 1;
        
        Eszkozok.Add(_ujEszkoz);
        
        _ujEszkoz = new HordozhatoEszkozSor
        {
            VedelmiOsztaly = "I",
            Telj = "230V",
            Megtekint = "MF",
            HelyisegNev = _aktualisHelyisegNev
        };

        FrissitHelyisegSorrend();
        await EszkozokChanged.InvokeAsync(Eszkozok);
    }

    private Task<IEnumerable<string>> HelyisegKereses(string keresettErtek, CancellationToken token)
    {
        // Korábban használt helyiségek
        var hasznaltNevek = Eszkozok
            .Where(e => !string.IsNullOrWhiteSpace(e.HelyisegNev))
            .Select(e => e.HelyisegNev!)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        if (string.IsNullOrWhiteSpace(keresettErtek))
            return Task.FromResult(hasznaltNevek.AsEnumerable());

        var talalatok = hasznaltNevek
            .Where(n => n.Contains(keresettErtek, StringComparison.OrdinalIgnoreCase))
            .ToList();

        // Ha nincs találat, add hozzá a beírt értéket
        if (!talalatok.Any() && !string.IsNullOrWhiteSpace(keresettErtek))
            talalatok.Add(keresettErtek);

        return Task.FromResult(talalatok.AsEnumerable());
    }

    // ✅ Eszközök lekérése helyiség sorrend szerint (jegyzőkönyvhöz)
    public List<HordozhatoEszkozSor> GetRendezettEszkozok()
    {
        var sorrend = _helyisegSorrend
            .Select((h, i) => new { h.Nev, Index = i })
            .ToDictionary(x => x.Nev, x => x.Index);
        
        return Eszkozok
            .OrderBy(e => string.IsNullOrWhiteSpace(e.HelyisegNev) ? int.MaxValue : 
                          sorrend.TryGetValue(e.HelyisegNev!, out var idx) ? idx : int.MaxValue - 1)
            .ThenBy(e => e.Sorsz)
            .ToList();
    }
}