    // ✅ MÓDOSÍTOTT: Sablon ellenőrzés megnevezés alapján - most adatbázisból
    private async Task EllenorizSablont()
    {
        if (string.IsNullOrWhiteSpace(_ujEszkoz.Megnevezes)) return;

        var talalat = await EszkozSablonService.GetByMegnevezesAsync(_ujEszkoz.Megnevezes);

        if (talalat != null && talalat.Alkatreszek.Any())
        {
            var result = await DialogService.ShowMessageBox(
                "Eszköz sablon található!",
                $"Találtam egy sablont '{talalat.Megnevezes}' néven {talalat.Alkatreszek.Count} alkatrésszel. Automatikusan hozzáadjam őket?",
                yesText: "Igen, add hozzá",
                cancelText: "Nem, csak az eszközt adom hozzá");

            if (result == true)
            {
                // ✅ JAVÍTVA: Null-coalescing operatorok
                _ujEszkoz.Tipus = talalat.Tipus ?? "";                     // 642. sor
                _ujEszkoz.Azonosito = talalat.Azonosito ?? "";             // 643. sor
                _ujEszkoz.VedelmiOsztaly = talalat.VedelmiOsztaly ?? "I";
                _ujEszkoz.Telj = talalat.Telj ?? "230V";
                _ujEszkoz.Megtekint = talalat.Megtekint ?? "MF";
                Snackbar.Add($"Sablon adatok betöltve: {talalat.Alkatreszek.Count} alkatrész lesz hozzáadva!", Severity.Info);
            }
        }
    }

    // ✅ MÓDOSÍTOTT: Eszköz hozzáadás automatikus alkatrész hozzáadással - adatbázisból
    private async Task EszkozHozzaadas()
    {
        if (string.IsNullOrWhiteSpace(_ujEszkoz.Megnevezes)) return;

        if (!_ujEszkoz.KellFolyt) _ujEszkoz.Folyt = "";

        if (!string.IsNullOrEmpty(_aktualisHelyisegNev))
        {
            try { await JS.InvokeVoidAsync("localStorageInterop.set", "lastHelyisegNev", _aktualisHelyisegNev); }
            catch { }
        }

        _ujEszkoz.HelyisegNev = _aktualisHelyisegNev;
        _ujEszkoz.Sorsz = Eszkozok.Count + 1;

        // ✅ MÓDOSÍTOTT: Ellenőrizzük, van-e sablon az adatbázisban
        var sablon = await EszkozSablonService.GetByMegnevezesAsync(_ujEszkoz.Megnevezes);

        if (sablon != null && sablon.Alkatreszek.Any())
        {
            var csoportNev = $"Csoport_{Guid.NewGuid().ToString().Substring(0, 8)}";
            _ujEszkoz.CsoportNev = csoportNev;
            _ujEszkoz.CsoportSorrend = 0;
            
            Eszkozok.Add(_ujEszkoz);

            // ✅ JAVÍTVA: Null-coalescing operatorokkal
            foreach (var sablonAlkatresz in sablon.Alkatreszek.OrderBy(a => a.Sorrend))
            {
                var ujAlkatresz = new HordozhatoEszkozSor
                {
                    CsoportNev = csoportNev,
                    CsoportSorrend = sablonAlkatresz.Sorrend,
                    Megnevezes = sablonAlkatresz.Megnevezes,
                    Tipus = sablonAlkatresz.Tipus ?? "",                    // ✅ JAVÍTVA
                    Azonosito = sablonAlkatresz.Azonosito ?? "",            // ✅ JAVÍTVA
                
                    // ✅ JAVÍTVA: Alkatrész SAJÁT értékei a sablonból
                    VedelmiOsztaly = sablonAlkatresz.VedelmiOsztaly ?? "I", // ✅ JAVÍTVA
                    Telj = sablonAlkatresz.Telj ?? "230V",                  // ✅ JAVÍTVA
                    Megtekint = sablonAlkatresz.Megtekint ?? "MF",          // ✅ JAVÍTVA
                
                    HelyisegNev = _ujEszkoz.HelyisegNev ?? "",              // ✅ JAVÍTVA
                    Folyt = "",
                    Szigell = "",
                    Szivargo = ""
                };
                Eszkozok.Add(ujAlkatresz);
            }

            Snackbar.Add($"Eszköz és {sablon.Alkatreszek.Count} alkatrész hozzáadva sablonból!", Severity.Success);
        }
        else
        {
            // Normál eszköz hozzáadás (nincs sablon)
            Eszkozok.Add(_ujEszkoz);
        }
        
        _ujEszkoz = new HordozhatoEszkozSor
        {
            VedelmiOsztaly = "I",
            Telj = "230V",
            Megtekint = "MF",
            HelyisegNev = _aktualisHelyisegNev ?? ""  // ✅ JAVÍTVA
        };

        FrissitHelyisegSorrend();
        await EszkozokChanged.InvokeAsync(Eszkozok);
    }

