    // Normál eszköz törlése
    private async Task EszkozTorlese(HordozhatoEszkozSor eszkoz)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törölni szeretnéd: {eszkoz.Megnevezes}?",
            yesText: "Törlés",
            cancelText: "Mégse");

        if (confirm == true)
        {
            Eszkozok.Remove(eszkoz);
            UjraSzamozas();
            await EszkozokChanged.InvokeAsync(Eszkozok);
            StateHasChanged();
        }
    }

    // Főeszköz + alkatrészek törlése
    private async Task FoEszkozTorlese(HordozhatoEszkozSor foEszkoz)
    {
        var alkatreszekSzama = Eszkozok.Count(e => e.CsoportNev == foEszkoz.CsoportNev && e.CsoportSorrend > 0);
        
        bool? confirm = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törölni szeretnéd: {foEszkoz.Megnevezes} + {alkatreszekSzama} alkatrész?",
            yesText: "Törlés",
            cancelText: "Mégse");

        if (confirm == true)
        {
            Eszkozok.RemoveAll(e => e.CsoportNev == foEszkoz.CsoportNev);
            UjraSzamozas();
            await EszkozokChanged.InvokeAsync(Eszkozok);
            StateHasChanged();
        }
    }

