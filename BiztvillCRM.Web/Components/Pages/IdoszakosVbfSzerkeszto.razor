					<MudTextField @bind-Value="_adatok.Ellen7_Elektrosztatikus" Label="Elektrosztatikus feltöltődés elleni védelem" Variant="Variant.Outlined" Lines="4" />
				</MudItem>
				<MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
				<MudItem xs="12"><MudTextField @bind-Value="_adatok.Ellen7_Megjegyzes" Label="Megjegyzések, észrevételek" Variant="Variant.Outlined" Lines="4" /></MudItem>
				<MudItem xs="12"><MudTextField @bind-Value="_adatok.Ellen7_AtfogoErtekeles" Label="A védelmek átfogó, rendszerszintű értékelése" Variant="Variant.Outlined" Lines="5" /></MudItem>
				<MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
				<MudItem xs="12"><MudTextField @bind-Value="_adatok.Ellen7_AltalánosEszrevételek" Label="Általános észrevételek" Variant="Variant.Outlined" Lines="4" /></MudItem>

				@* Áramkörök *@
				<MudItem xs="12" Class="mt-2">
					<MudText Typo="Typo.subtitle1" Class="mb-2">
						<MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-2" />Áramkörök leírása helyiségenként
					</MudText>
				</MudItem>
				<MudItem xs="12">
					<MudSimpleTable Dense="true" Bordered="true">
						<thead>
							<tr>
								<th style="width:35%">Helyiség neve</th>
								<th>Áramkörök leírása</th>
								<th style="width:50px;"></th>
							</tr>
						</thead>
						<tbody>
							@foreach (var (sor, idx) in _adatok.Aramkorok.Select((s, i) => (s, i)))
							{
								<tr>
									<td>
										<MudTextField T="string" Value="sor.HelyisegNev"
													  ValueChanged="@((string v) => { sor.HelyisegNev = v; OnAramkorMezoValtozas(); })"
													  Variant="Variant.Text" Margin="Margin.Dense" Placeholder="pl. Iroda..." />
									</td>
									<td>
										<MudTextField T="string" Value="sor.Leiras"
													  ValueChanged="@((string v) => { sor.Leiras = v; OnAramkorMezoValtozas(); })"
													  Variant="Variant.Text" Margin="Margin.Dense" Placeholder="pl. világítási áramkör..." />
									</td>
									<td>
										<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
													   Size="Size.Small" OnClick="@(() => AramkorTorles(idx))" />
									</td>
								</tr>
							}
						</tbody>
					</MudSimpleTable>
				</MudItem>
				<MudItem xs="12">
					<MudButton Variant="Variant.Outlined" Color="Color.Primary"
							   StartIcon="@Icons.Material.Filled.Add" OnClick="AramkorHozzaad">
						Sor hozzáadása
					</MudButton>
				</MudItem>
				<MudItem xs="12">
					<MudTextField @bind-Value="_adatok.Ellen7_MegjegyzesekEszrevételek" Label="Megjegyzések, észrevételek"
								  Variant="Variant.Outlined" Lines="4" />
				</MudItem>
			</MudGrid>
		</MudTabPanel>

		@* ===== ÖSSZEGZÉS + LETÖLTÉS ===== *@
		<MudTabPanel Text="Összegzés" Icon="@Icons.Material.Filled.Summarize">
			<MudGrid>
				<MudItem xs="12">
					<MudSimpleTable Dense="true" Bordered="true" Class="mb-4">
						<tbody>
							<tr><td><strong>Jegyzőkönyv száma</strong></td><td>@_adatok.JegyzokonyvSzam</td></tr>
							<tr><td><strong>Ügyfél</strong></td><td>@_adatok.Megrendelo</td></tr>
							<tr><td><strong>Helyszín</strong></td><td>@_adatok.VizsgalatHelye</td></tr>
							<tr><td><strong>Felelős felülvizsgáló</strong></td><td>@_adatok.FelulvizsgaloNev</td></tr>
							<tr><td><strong>Bizonyítványok</strong></td><td>@_adatok.FelulvizsgaloBizonyitvany</td></tr>
							<tr>
								<td><strong>Eredmény</strong></td>
								<td><MudChip T="string" Color="@(_adatok.Eredmeny == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.Eredmeny</MudChip></td>
							</tr>
							<tr>
								<td><strong>Végső minősítés</strong></td>
								<td><MudChip T="string" Color="@(_adatok.VegsoMinosites == "MEGFELELT" ? Color.Success : Color.Error)" Size="Size.Small">@_adatok.VegsoMinosites</MudChip></td>
							</tr>
						</tbody>
					</MudSimpleTable>
				</MudItem>

				@if (_mellekletek.Count > 0)
				{
					<MudPaper Class="pa-4 mt-4" Elevation="3">
						<MudText Typo="Typo.h6" Class="mb-3">
							<MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" />Melléklet jegyzőkönyvek
						</MudText>
						<MudGrid>
							@foreach (var m in _mellekletek)
							{
								<MudItem xs="12" sm="6" md="4">
									<MudCard Outlined="true">
										<MudCardContent Class="pa-3">
											<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
												<div>
													<MudText Typo="Typo.subtitle2">@MellekletJegyzokonyv.TipusNev(m.Tipus)</MudText>
													<MudText Typo="Typo.caption" Color="Color.Secondary">@m.Szam</MudText>
												</div>
												<MudChip T="string" Color="@(m.KeszeE ? Color.Success : Color.Warning)" Size="Size.Small">
													@(m.KeszeE ? "Kész" : "Folyamatban")
												</MudChip>
											</MudStack>
										</MudCardContent>
										<MudCardActions Class="pa-2">
											<MudButton Variant="Variant.Filled"
													   Color="@(m.KeszeE ? Color.Default : Color.Primary)"
													   Size="Size.Small" FullWidth="true"
													   StartIcon="@(m.KeszeE ? Icons.Material.Filled.Visibility : Icons.Material.Filled.Edit)"
													   OnClick="@(() => MellekletMegnyitas(m))">
												@(m.KeszeE ? "Megtekintés" : "Folytatás / Szerkesztés")
											</MudButton>
										</MudCardActions>
									</MudCard>
								</MudItem>
							}
						</MudGrid>
					</MudPaper>
				}
			</MudGrid>
		</MudTabPanel>
	</MudTabs>

	@* Navigációs gombok *@
	<MudStack Row="true" Class="mt-4">
		<MudButton Variant="Variant.Outlined" Color="Color.Default"
				   StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Vissza">
			Vissza az elejére
		</MudButton>

		@if (_aktívTab > 0)
		{
			<MudButton Variant="Variant.Outlined" Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.ChevronLeft"
					   OnClick="@(async () => { _aktívTab--; await JS.InvokeVoidAsync("window.scrollTo", 0, 0); })">
				Előző oldal
			</MudButton>
		}

		@if (_aktívTab < 5)
		{
			<MudButton Variant="Variant.Filled" Color="Color.Primary"
					   EndIcon="@Icons.Material.Filled.ArrowForward"
					   OnClick="KovetkezoOldalAsync">
				Következő oldal
			</MudButton>
		}
		@* Sablon mód — utolsó oldal gombjai *@
		@if (_sablonMod)
		{
			@if (SablonId is > 0)
			{
				@* Szerkesztés: dialog a névmódosítással *@
				<MudButton Variant="Variant.Filled" Color="Color.Warning"
						   StartIcon="@Icons.Material.Filled.Save"
						   Disabled="_feldolgozas"
						   OnClick="@(() => _sablonNevDialogNyitva = true)">
					@(_feldolgozas ? "Mentés..." : "💾 Sablon mentése")
				</MudButton>
			}
			else
			{
				@* Új sablon: névadó dialog *@
				<MudButton Variant="Variant.Outlined" Color="Color.Warning"
						   StartIcon="@Icons.Material.Filled.Save"
						   OnClick="@(() => _sablonNevDialogNyitva = true)">
					💾 Mentés névvel...
				</MudButton>
			}
		}
		else
		{
			<MudButton Variant="Variant.Filled" Color="Color.Success"
					   StartIcon="@Icons.Material.Filled.Save"
					   OnClick="MentesEsLetoltésAsync" Disabled="_feldolgozas">
				@(_feldolgozas ? "Mentés..." : "Mentés és letöltés (Word)")
			</MudButton>
		} @* ← ez zárja az else { @if (_sablonMod) ... } blokkot *@
		</MudStack>
	}

	@* Sablon névadó dialog — gyökérszinten *@
	<MudDialog @bind-Visible="_sablonNevDialogNyitva"
			   Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
		<TitleContent>
			<MudText Typo="Typo.h6">Sablon mentése</MudText>
		</TitleContent>
		<DialogContent>
			<MudTextField @bind-Value="_sablonNev" Label="Sablon neve"
						  Placeholder='pl. "Családi ház", "Iroda 3 éves"'
						  Required="true" Variant="Variant.Outlined" />
			<MudTextField @bind-Value="_sablonLeiras" Label="Leírás (opcionális)"
						  Class="mt-3" Variant="Variant.Outlined" />
		</DialogContent>
		<DialogActions>
			<MudButton OnClick="@(() => _sablonNevDialogNyitva = false)">Mégse</MudButton>
		<MudButton Variant="Variant.Filled" Color="Color.Warning"
				   OnClick="SablonMentesNevvelAsync"
				   Disabled="@(string.IsNullOrWhiteSpace(_sablonNev) || _feldolgozas)">
			Mentés
		</MudButton>
		</DialogActions>
	</MudDialog>

@code {
	[Parameter] public int? MeresId { get; set; }
	[Parameter] public int? SablonId { get; set; }

	private bool _sablonMod => MeresId is null or 0;
	private bool _betoltes = true;
	private bool _feldolgozas;
	private Meres? _meres;
	private JegyzokonyvAdatok _adatok = new();
	private List<MellekletJegyzokonyv> _mellekletek = [];
	private bool _legutolsoFelujitasElott;
	private int _aktívTab = 0;
	private int _vbfMeresTipusId;
	private string _sablonNev = "";
	private string _sablonLeiras = "";
	private bool _sablonNevDialogNyitva;

	protected override async Task OnInitializedAsync()
	{
		if (_sablonMod)
		{
			var meresTipusok = await MeresTipusService.GetAllAsync();
			_vbfMeresTipusId = meresTipusok
				.FirstOrDefault(m => m.Nev.Contains("Időszakos VBF", StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

			if (SablonId is > 0)
			{
				var meglevo = await VizsgalatiSablonService.GetByIdAsync(SablonId.Value);
				if (meglevo is not null)
				{
					_sablonNev = meglevo.Nev;
					_sablonLeiras = meglevo.Leiras ?? "";
					if (!string.IsNullOrEmpty(meglevo.AdatokJson))
					{
						try
						{
							_adatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
								meglevo.AdatokJson,
								new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
							) ?? new();
						}
						catch { _adatok = new(); }
					}
				}
				else
				{
					Snackbar.Add("A sablon nem található!", Severity.Error);
					Navigation.NavigateTo("/admin/jegyozokonyv-sablon");
					return;
				}
			}
			else
			{
				_adatok = new JegyzokonyvAdatok();
			}

			_adatok.Aramkorok ??= new();
			if (_adatok.Aramkorok.Count == 0) _adatok.Aramkorok.Add(new AramkorSor());

			_betoltes = false;
			return;
		}

		// Valódi mérés betöltési ág
		try
		{
			if (MeresId is > 0)
			{
				_meres = await MeresService.GetByIdAsync(MeresId.Value);
				if (_meres is not null && !string.IsNullOrEmpty(_meres.JegyzokonyvAdatokJson))
				{
					try
					{
						_adatok = System.Text.Json.JsonSerializer.Deserialize<JegyzokonyvAdatok>(
							_meres.JegyzokonyvAdatokJson,
							new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
						) ?? new();
					}
					catch { _adatok = new(); }
				}

				// ✅ Ha van már mentett jegyzőkönyvszám → módosítás-jelölés hozzáadása
				if (!string.IsNullOrWhiteSpace(_adatok.JegyzokonyvSzam))
				{
					_adatok.ModositasokSzama++;
					_adatok.JegyzokonyvSzam = ModositasJelolessel(_adatok.JegyzokonyvSzam, _adatok.ModositasokSzama);
				}

				_mellekletek = await MellekletService.GetByMeresIdAsync(MeresId.Value);

				_adatok.Aramkorok ??= new();
				if (_adatok.Aramkorok.Count == 0) _adatok.Aramkorok.Add(new AramkorSor());
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Hiba a mérés betöltésekor: {ex.Message}", Severity.Error);
		}
		finally
		{
			_betoltes = false;
		}
	}

	/// <summary>
	/// Eltávolítja a meglévő /Mn jelölést (ha van), majd hozzáfűzi az újat.
	/// Pl.: "VBF-2024-001" → "VBF-2024-001/M1"
	///      "VBF-2024-001/M1" → "VBF-2024-001/M2"
	/// </summary>

	private static string ModositasJelolessel(string jegyzokonyvSzam, int modositasokSzama)
	{
		var alap = System.Text.RegularExpressions.Regex.Replace(
			jegyzokonyvSzam, @"/M\d+$", "");
		return $"{alap}/M{modositasokSzama}";
	}


	private async Task SablonMentesAsync()
	{
		_feldolgozas = true;
		try
		{
			var cegId = TenantService.IsInRole(FelhasznaloSzerepkor.Admin)
				? (int?)null
				: TenantService.GetCurrentCegId();

			var tetelek = await SablonService.GetTetelek(_vbfMeresTipusId, 5, cegId);
			tetelek.AddRange(await SablonService.GetTetelek(_vbfMeresTipusId, 6, cegId));
			tetelek.AddRange(await SablonService.GetTetelek(_vbfMeresTipusId, 7, cegId));

			var map = new Dictionary<int, string>();
			foreach (var tetel in tetelek)
			{
				var ertek = GetErtekByFelirat(tetel.Felirat);
				if (!string.IsNullOrEmpty(ertek))
					map[tetel.Id] = ertek;
			}

			await SablonService.SablonAlapertelmezettekFrissiteseAsync(map, cegId);
			Snackbar.Add($"Sablon mentve! ({map.Count} tétel frissítve)", Severity.Success);
			Navigation.NavigateTo("/admin/jegyozokonyv-sablon");
		}
		catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
		finally { _feldolgozas = false; }
	}

	private string GetErtekByFelirat(string felirat)
	{
		return felirat switch
		{
			var f when f.Contains("termékszabvány") => _adatok.Ellen5_Me_A,
			var f when f.Contains("MSZ HD 60364 szabványsorozat") => _adatok.Ellen5_Me_B,
			var f when f.Contains("látható sérülés") => _adatok.Ellen5_Me_C,
			_ => string.Empty
		};
	}

	private async Task MentesEsLetoltésAsync()
	{
		_feldolgozas = true;
		try
		{
				// MeresService.MentesJegyzokonyvAdatokkalAsync(MeresId, _adatok)  →
	await MeresService.MentesJegyzokonyvAdatokkalAsync(MeresId ?? 0, _adatok);


			var meresTipus = await MeresTipusService.GetByIdAsync(_meres!.MeresTipusId);
			var sablonId = meresTipus?.SablonId ?? "VBF_KIF_MINTA";

			var wordBytes = await WordService.GeneralasAsync(MeresId ?? 0, _adatok, sablonId);
			if (wordBytes is { Length: > 0 })
			{
				var fajlNev = $"{(_adatok.JegyzokonyvSzam ?? $"VBF-{MeresId:D6}").Replace("/", "-")}.docx";
				using var streamRef = new DotNetStreamReference(new MemoryStream(wordBytes));
				await JS.InvokeVoidAsync("downloadFileFromStream", fajlNev, streamRef);
			}

			await MellekletekLetrehozasa();
			_mellekletek = await MellekletService.GetByMeresIdAsync(MeresId ?? 0);
			Snackbar.Add("Mentés és generálás sikeres!", Severity.Success);
		}
		catch (Exception ex) { Snackbar.Add($"Hiba: {ex.Message}", Severity.Error); }
		finally { _feldolgozas = false; }
	}

	private void MellekletMegnyitas(MellekletJegyzokonyv m)
	{
		Navigation.NavigateTo(m.Tipus switch
		{
			"AVK" => $"/avk-szerkeszto/{m.Id}",
			"HVM" => $"/hvm-szerkeszto/{m.Id}",
			_     => m.MellekletMeresId.HasValue ? $"/jegyzokonyv/{m.MellekletMeresId.Value}" : $"/meresek"
		});
	}

	private void Vissza() => Navigation.NavigateTo($"/jegyzokonyv/{MeresId}");

	// ── Dátum segédek ──────────────────────────────────────────────
	private string GetSzamitottDatum(int evek) =>
		_meres?.Datum.AddYears(evek).ToString("yyyy.MM.dd") ?? "-";

	private string SzamitottDatum =>
		GetSzamitottDatum(_adatok?.HataridoTipus is "307" or "308" or "309" ? 6 : 3);

	private void VisszaallitSzamitottDatumra()
	{
		if (DateTime.TryParseExact(SzamitottDatum, "yyyy.MM.dd",
			System.Globalization.CultureInfo.InvariantCulture,
			System.Globalization.DateTimeStyles.None, out var d))
		{
			_adatok.KovetkezoFelulvizsgalatDatum = d;
		}
	}

	// ── Hibák ──────────────────────────────────────────────────────
	private void OnHibaBKitoltve(string v) { _adatok.HibakB = v; if (!string.IsNullOrWhiteSpace(v)) _adatok.VegsoMinosites = "NEM FELELT MEG"; }
	private void OnHibaCKitoltve(string v) { _adatok.HibakC = v; if (!string.IsNullOrWhiteSpace(v)) _adatok.VegsoMinosites = "NEM FELELT MEG"; }

	// ── Mellékletek ──────────────────────────────────────────────────
	private string _mellekletekSzamaAuto => new[] {
		_adatok.MellekletHibavedelem, _adatok.MellekletAvk, _adatok.MellekletSzigeteles,
		_adatok.MellekletVillam, _adatok.MellekletVillamNem
	}.Count(x => x) + " db";

	private void GeneraltMellekletSzamok()
	{
		var alap = string.IsNullOrWhiteSpace(_adatok.JegyzokonyvSzam)
			? $"VBF-{DateTime.Now:yyyy}-MELL" : _adatok.JegyzokonyvSzam;
		_adatok.HibavedelmiJkv = _adatok.MellekletHibavedelem ? $"{alap}/HVM" : "";
		_adatok.AvkJegyzokonyv = _adatok.MellekletAvk         ? $"{alap}/AVK" : "";
		_adatok.SzigetelesiJkv = _adatok.MellekletSzigeteles  ? $"{alap}/SZI" : "";
		_adatok.VillamJkv      = _adatok.MellekletVillam      ? $"{alap}/VVN" : "";
		_adatok.VillamNemJkv   = _adatok.MellekletVillamNem   ? $"{alap}/VVN-NEM" : "";
	}

	// ── Áramkörök ──────────────────────────────────────────────────
	private void AramkorHozzaad() => _adatok.Aramkorok.Add(new AramkorSor());
	private void AramkorTorles(int idx) { if (idx >= 0 && idx < _adatok.Aramkorok.Count) _adatok.Aramkorok.RemoveAt(idx); }
	private void OnAramkorMezoValtozas()
	{
		var u = _adatok.Aramkorok.LastOrDefault();
		if (u != null && !string.IsNullOrWhiteSpace(u.HelyisegNev) && !string.IsNullOrWhiteSpace(u.Leiras))
			_adatok.Aramkorok.Add(new AramkorSor());
	}

	// ── Felújítás év ───────────────────────────────────────────────
	private string GetFelujitasEv()
	{
		var e = _adatok.LegutolsoFelujitas;
		return string.IsNullOrEmpty(e) || e == "Ismeretlen" ? "Ismeretlen" : e.TrimStart('<');
	}
	private void OnFelujitasEvValtozas(string ev)
	{
		_adatok.LegutolsoFelujitas = ev == "Ismeretlen" ? "Ismeretlen"
			: (_legutolsoFelujitasElott ? $"<{ev}" : ev);
		if (ev == "Ismeretlen") _legutolsoFelujitasElott = false;
	}
	private void OnFelujitasElottValtozas(bool elott)
	{
		_legutolsoFelujitasElott = elott;
		var ev = GetFelujitasEv();
		if (ev != "Ismeretlen") _adatok.LegutolsoFelujitas = elott ? $"<{ev}" : ev;
	}

	// ── Ellen5 getter/setter-ek ─────────────────────────────────────
	private string GetEllen5(string bet, bool me) => me ? bet switch
	{
		"a"=>_adatok.Ellen5_Me_A,"b"=>_adatok.Ellen5_Me_B,"c"=>_adatok.Ellen5_Me_C,
		"d"=>_adatok.Ellen5_Me_D,"e"=>_adatok.Ellen5_Me_E,"f"=>_adatok.Ellen5_Me_F,
		"g"=>_adatok.Ellen5_Me_G,"h"=>_adatok.Ellen5_Me_H,"i"=>_adatok.Ellen5_Me_I,
		"j"=>_adatok.Ellen5_Me_J,"k"=>_adatok.Ellen5_Me_K,"l"=>_adatok.Ellen5_Me_L,
		"m"=>_adatok.Ellen5_Me_M,"n"=>_adatok.Ellen5_Me_N,"o"=>_adatok.Ellen5_Me_O,
		"p"=>_adatok.Ellen5_Me_P,_=>"" 
	} : bet switch { "a"=>_adatok.Ellen5_Sz_A,"b"=>_adatok.Ellen5_Sz_B,"c"=>_adatok.Ellen5_Sz_C,_=>"" };

