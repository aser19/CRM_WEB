@page "/idoszakos-vbf/{MeresId:int}"
@page "/idoszakos-vbf/sablon"
@page "/idoszakos-vbf/sablon/{SablonId:int}"
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Services
@inject IMeresService MeresService
@inject IMeresTipusService MeresTipusService
@inject IJegyzokonyvWordService WordService
@inject IMellekletJegyzokonyvService MellekletService
@inject IJegyzokonyvSablonService SablonService
@inject ITenantService TenantService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IVizsgalatiSablonService VizsgalatiSablonService	

<PageTitle>Időszakos VBF szerkesztő</PageTitle>

@if (_betoltes)
{
	<MudProgressCircular Indeterminate="true" Class="mt-8" />
}
else if (_meres == null && !_sablonMod)
{
	<MudAlert Severity="Severity.Error">A mérés nem található.</MudAlert>
}
else
{
	@if (_sablonMod)
	{
		<MudAlert Severity="Severity.Warning" Class="mb-3" Icon="@Icons.Material.Filled.Edit">
			🎨 <strong>Sablon szerkesztési mód</strong> — A kitöltött értékek az alapértelmezett sablonba mentődnek, nem jön létre mérés.
		</MudAlert>
	}

	<MudText Typo="Typo.h5" Class="mb-2">
		<MudIcon Icon="@(_sablonMod ? Icons.Material.Filled.Tune : Icons.Material.Filled.ElectricBolt)" Class="mr-2" />
		@(_sablonMod ? "Időszakos VBF — Sablon szerkesztő" : $"Időszakos VBF — {(_adatok.JegyzokonyvSzam ?? $"Mérés #{MeresId}")}")
		@if (_sablonMod)
		{
			<MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-1">SABLON MÓD</MudChip>
		}
	</MudText>

	@* Fejléc infó - sablon módban elrejtve *@
	@if (!_sablonMod)
	{
		<MudPaper Class="pa-3 mb-4" Elevation="1">
			<MudGrid>
				<MudItem xs="12" md="4">
					<MudTextField Value="@_adatok.Megrendelo" Label="Megrendelő"
								  Variant="Variant.Outlined" ReadOnly="true"
								  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
				</MudItem>
				<MudItem xs="12" md="4">
					<MudTextField Value="@_adatok.VizsgalatHelye" Label="Vizsgálat helye"
								  Variant="Variant.Outlined" ReadOnly="true"
								  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
				</MudItem>
				<MudItem xs="12" md="4">
					<MudTextField Value="@_adatok.FelulvizsgaloNev" Label="Felelős felülvizsgáló"
								  Variant="Variant.Outlined" ReadOnly="true"
								  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
				</MudItem>
			</MudGrid>
		</MudPaper>
	}

	<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
			 ActivePanelIndex="_aktívTab"
			 ActivePanelIndexChanged="OnTabValtozasAsync">


		@* ===== 3. OLDAL ===== *@
		<MudTabPanel Text="3. oldal" Icon="@Icons.Material.Filled.FactCheck">
			<MudGrid>
				<MudItem xs="12">
					<MudText Typo="Typo.h6" Class="mb-4">
						<MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
						Minősítő irat (3. oldal)
					</MudText>
				</MudItem>

				<MudItem xs="12" Class="mt-4">
					<MudText Typo="Typo.subtitle2" Class="mb-2">
						Az érvényességi feltételek betartása esetén a villamos berendezés következő időszakos villamos biztonsági felülvizsgálatát:
					</MudText>

					@* 3 éves csoport *@
					<MudRadioGroup T="string" Value="_adatok.KovetkezoFelulvizsgalatTipus"
								   ValueChanged="@((string v) => { _adatok.KovetkezoFelulvizsgalatTipus = v; _adatok.HataridoTipus = null; _adatok.HataridoEgyeb = null; VisszaallitSzamitottDatumra(); StateHasChanged(); })"
								   Class="d-flex flex-column gap-1">
						<MudRadio Value="@("50kW")" Color="Color.Primary" Dense="true" Style="width:100%">
							az épületnek nem minősülő műtárgy <strong>50 kW</strong>-ot meghaladó csatlakozási teljesítményű villamos berendezésén
						</MudRadio>
						<MudRadio Value="@("32A")" Color="Color.Primary" Dense="true" Style="width:100%">
							a fázisonként <strong>32 A</strong>-nél nagyobb névleges áramerősségű túráramvédelemmel korlátozott villamos berendezésén
						</MudRadio>
						<MudRadio Value="@("VMBSZ")" Color="Color.Primary" Dense="true" Style="width:100%">
							a <strong>VMBSZ</strong> szerint lakóépület, kommunális épület, valamint egyéb épület villamos berendezésén
						</MudRadio>
						<MudRadio Value="@("RV300")" Color="Color.Primary" Dense="true" Style="width:100%">
							<strong>≥300 kg/l</strong> robbanásveszélyes (RV) osztályú anyagot tartalmazó helyiségekben és szabadtéren
						</MudRadio>
						<MudRadio Value="@("egyeb305")" Color="Color.Primary" Dense="true" Style="width:100%">
							egyéb, itt nem szereplő esetekben:
						</MudRadio>
					</MudRadioGroup>

					@if (_adatok.KovetkezoFelulvizsgalatTipus == "egyeb305")
					{
						<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-1 ml-6">
							<MudTextField @bind-Value="_adatok.KovetkezoFelulvizsgalatEgyeb"
										  Variant="Variant.Outlined" Style="max-width:350px;" Margin="Margin.Dense"
										  Placeholder="Egyéb eset leírása..."
										  HelperText="Kötelező, legalább 5 karakter"
										  Error="@(_adatok.KovetkezoFelulvizsgalatTipus == "egyeb305" && (_adatok.KovetkezoFelulvizsgalatEgyeb?.Trim().Length ?? 0) < 5)"
										  ErrorText="Legalább 5 karaktert írj be!" />
						</MudStack>
					}

					@if (_adatok.KovetkezoFelulvizsgalatTipus is "50kW" or "32A" or "VMBSZ" or "RV300" or "egyeb305")
					{
						<MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
							a kiadási dátumtól számított <strong>3 éven belül, legkésőbb: @GetSzamitottDatum(3)-ig</strong> kell elvégezni.
						</MudAlert>
					}

					@* 6 éves csoport *@
					<MudRadioGroup T="string" Value="_adatok.HataridoTipus"
								   ValueChanged="@((string v) => { _adatok.HataridoTipus = v; _adatok.KovetkezoFelulvizsgalatTipus = null; _adatok.KovetkezoFelulvizsgalatEgyeb = null; VisszaallitSzamitottDatumra(); StateHasChanged(); })"
								   Class="d-flex flex-column gap-1 mt-3">
						<MudRadio Value="@("307")" Color="Color.Primary" Dense="true" Style="width:100%">
							a lakóépületek villamos berendezésén (kivéve: lakások, ha Ib ≤ 32 A és IΔn ≤ 30 mA)
						</MudRadio>
						<MudRadio Value="@("308")" Color="Color.Primary" Dense="true" Style="width:100%">
							egyéb (robbanásveszélyes /RV/ osztályú anyagot NEM tartalmazó) helyiségekben és térségekben
						</MudRadio>
						<MudRadio Value="@("309")" Color="Color.Primary" Dense="true" Style="width:100%">
							egyéb, itt nem szereplő esetekben:
						</MudRadio>
					</MudRadioGroup>

					@* 3091 szövegmező – csak ha "309" van kiválasztva *@
					@if (_adatok.HataridoTipus == "309")
					{
						<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-1 ml-6">
							<MudTextField @bind-Value="_adatok.HataridoEgyeb"
										  Variant="Variant.Outlined"
										  Style="max-width: 350px;" Margin="Margin.Dense"
										  Placeholder="Egyéb eset leírása..."
										  HelperText="Kötelező, legalább 5 karakter"
										  Error="@(_adatok.HataridoTipus == "309" && (_adatok.HataridoEgyeb?.Trim().Length ?? 0) < 5)"
										  ErrorText="Legalább 5 karaktert írj be!" />
						</MudStack>
					}

					@if (_adatok.HataridoTipus is "307" or "308" or "309")
					{
						<MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
							a kiadási dátumtól számított <strong>6 éven belül, legkésőbb: @GetSzamitottDatum(6)-ig</strong> kell elvégezni.
						</MudAlert>
					}
				</MudItem>

				<MudItem xs="12" Class="mt-2">
					<MudTextField @bind-Value="_adatok.MinositoIratMegjegyzes" Label="Megjegyzés"
								  Variant="Variant.Outlined" Lines="3"
								  Placeholder="Megjegyzések a minősítő irathoz..." />
				</MudItem>

				@* Jogszabályok / szabványok *@
				@if (_adatok.KijeloltJogszabalyok.Any())
				{
					var jogszabalyok = _adatok.KijeloltJogszabalyok.Where(j => !j.IsSzabvany).OrderBy(j => j.Szam).ToList();
					var szabvanyok   = _adatok.KijeloltJogszabalyok.Where(j => j.IsSzabvany).OrderBy(j => j.Szam).ToList();

					<MudItem xs="12" Class="mt-4"><MudDivider /></MudItem>

					@if (jogszabalyok.Any())
					{
						<MudItem xs="12" Class="mt-3">
							<MudText Typo="Typo.subtitle1" Class="mb-2">
								<MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />Kapcsolódó jogszabályok
							</MudText>
							<MudGrid Spacing="1">
								@foreach (var j in jogszabalyok)
								{
									<MudItem xs="12" md="4" Style="display:flex;align-items:flex-start;">
										<MudCheckBox @bind-Value="j.Kivalasztva" Color="Color.Primary" Dense="true">
											<span style="font-size:0.8rem;line-height:1.3;"><strong>@j.Szam</strong> – @j.Cim</span>
										</MudCheckBox>
									</MudItem>
								}
							</MudGrid>
						</MudItem>
					}

					@if (szabvanyok.Any())
					{
						<MudItem xs="12" Class="mt-3">
							<MudText Typo="Typo.subtitle1" Class="mb-2">
								<MudIcon Icon="@Icons.Material.Filled.Rule" Class="mr-2" />Kapcsolódó szabványok
							</MudText>
							<MudGrid Spacing="1">
								@foreach (var sz in szabvanyok)
								{
									<MudItem xs="12" md="4" Style="display:flex;align-items:flex-start;">
										<MudCheckBox @bind-Value="sz.Kivalasztva" Color="Color.Primary" Dense="true">
											<span style="font-size:0.8rem;line-height:1.3;"><strong>@sz.Szam</strong> – @sz.Cim</span>
										</MudCheckBox>
									</MudItem>
								}
							</MudGrid>
						</MudItem>
					}
				}

				@* Következő felülvizsgálat dátuma *@
				<MudItem xs="12" Class="mt-4"><MudDivider /></MudItem>
				<MudItem xs="12" Class="mt-3">
					<MudText Typo="Typo.subtitle1" Class="mb-2">
						<MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" />
						Következő felülvizsgálat határideje
					</MudText>
				</MudItem>
				<MudItem xs="12" md="5">
					<MudDatePicker Date="_adatok.KovetkezoFelulvizsgalatDatum"
								   DateChanged="@((DateTime? d) => _adatok.KovetkezoFelulvizsgalatDatum = d)"
								   Label="Határidő (manuálisan felülírható)"
								   Variant="Variant.Outlined" DateFormat="yyyy.MM.dd" Clearable="true"
								   HelperText="@($"Javasolt: {SzamitottDatum}")" />
				</MudItem>
				<MudItem xs="12" md="4" Class="d-flex align-center gap-2">
					<MudAlert Severity="Severity.Info" Dense="true" Class="flex-grow-1" Style="margin:0;">
						<strong>Számított határidő:</strong> @SzamitottDatum
					</MudAlert>
					<MudTooltip Text="Visszaállítás a számított értékre">
						<MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Primary"
									   Size="Size.Small" OnClick="@(() => VisszaallitSzamitottDatumra())" />
					</MudTooltip>
				</MudItem>

				@* Hibák *@
				<MudItem xs="12" Class="mt-4"><MudDivider /></MudItem>
				<MudItem xs="12" Class="mt-3">
					<MudText Typo="Typo.subtitle1" Class="mb-2">Talált hibák kategóriánként</MudText>
					<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
						Csak a talált hibákat töltsd ki. Ha egy kategóriában nincs hiba, hagyd üresen.
					</MudAlert>
				</MudItem>
				<MudItem xs="12">
					<MudTextField Value="_adatok.HibakB" ValueChanged="@((string v) => OnHibaBKitoltve(v))"
								  Label="B kategória – Életveszélyes hibák" Variant="Variant.Outlined" Lines="3"
								  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Warning" AdornmentColor="Color.Error"
								  Placeholder="pl. Hiányzó védőföldelés..." />
				</MudItem>
				<MudItem xs="12">
					<MudTextField Value="_adatok.HibakC" ValueChanged="@((string v) => OnHibaCKitoltve(v))"
								  Label="C kategória – Súlyos hibák" Variant="Variant.Outlined" Lines="3"
								  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Error" AdornmentColor="Color.Warning"
								  Placeholder="pl. Túlterhelés..." />
				</MudItem>
				<MudItem xs="12">
					<MudTextField @bind-Value="_adatok.HibakD" Label="D kategória – Karbantartást igénylő hibák"
								  Variant="Variant.Outlined" Lines="3"
								  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Build" AdornmentColor="Color.Info" />
				</MudItem>
				<MudItem xs="12">
					<MudTextField @bind-Value="_adatok.HibakE" Label="E kategória – Felújítást igénylő hibák"
								  Variant="Variant.Outlined" Lines="3"
								  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.HomeRepairService" AdornmentColor="Color.Secondary" />
				</MudItem>

				@* Mellékletek *@
				<MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
				<MudItem xs="12">
					<MudText Typo="Typo.subtitle1" Class="mb-2">Mellékletek</MudText>
					<MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
						A kipipált mellékletekhez automatikusan generálódik a hivatkozási szám.
					</MudText>
				</MudItem>
				<MudItem xs="12" sm="6" md="4">
					<MudCheckBox T="bool" Value="_adatok.MellekletHibavedelem"
								 ValueChanged="@((bool v) => { _adatok.MellekletHibavedelem = v; GeneraltMellekletSzamok(); })"
								 Label="Hibavédelmi jgyk (Hurok)" Color="Color.Primary" />
					@if (_adatok.MellekletHibavedelem)
					{ <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-8">@_adatok.HibavedelmiJkv</MudText> }
				</MudItem>
				<MudItem xs="12" sm="6" md="4">
					<MudCheckBox T="bool" Value="_adatok.MellekletAvk"
								 ValueChanged="@((bool v) => { _adatok.MellekletAvk = v; GeneraltMellekletSzamok(); })"
								 Label="Áramvédő kapcsolók" Color="Color.Primary" />
					@if (_adatok.MellekletAvk)
					{ <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-8">@_adatok.AvkJegyzokonyv</MudText> }
				</MudItem>
				<MudItem xs="12" sm="6" md="4">
					<MudCheckBox T="bool" Value="_adatok.MellekletSzigeteles"
								 ValueChanged="@((bool v) => { _adatok.MellekletSzigeteles = v; GeneraltMellekletSzamok(); })"
								 Label="Szigetelés ellenállás mérés" Color="Color.Primary" />
					@if (_adatok.MellekletSzigeteles)
					{ <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-8">@_adatok.SzigetelesiJkv</MudText> }
				</MudItem>
				<MudItem xs="12" sm="6" md="4">
					<MudCheckBox T="bool" Value="_adatok.MellekletVillam"
								 ValueChanged="@((bool v) => { _adatok.MellekletVillam = v; if (v) _adatok.MellekletVillamNem = false; GeneraltMellekletSzamok(); })"
								 Label="Norma szerinti Villám" Color="Color.Primary" />
					@if (_adatok.MellekletVillam)
					{ <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-8">@_adatok.VillamJkv</MudText> }
				</MudItem>
				<MudItem xs="12" sm="6" md="4">
					<MudCheckBox T="bool" Value="_adatok.MellekletVillamNem"
								 ValueChanged="@((bool v) => { _adatok.MellekletVillamNem = v; if (v) _adatok.MellekletVillam = false; GeneraltMellekletSzamok(); })"
								 Label="Nem norma szerinti Villám" Color="Color.Primary" />
					@if (_adatok.MellekletVillamNem)
					{ <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-8">@_adatok.VillamNemJkv</MudText> }
				</MudItem>
				<MudItem xs="12" sm="6" md="4">
					<MudTextField Value="@_mellekletekSzamaAuto" Label="Mellékletek száma (auto)"
								  Variant="Variant.Outlined" ReadOnly="true"
								  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
				</MudItem>

				@* Végső minősítés *@
				<MudItem xs="12"><MudDivider Class="my-3" /></MudItem>
				<MudItem xs="12">
					<MudText Typo="Typo.subtitle1" Class="mb-2">Végső minősítés</MudText>
					<MudToggleGroup T="string" Value="_adatok.VegsoMinosites"
									ValueChanged="@((string v) => _adatok.VegsoMinosites = v)"
									Color="Color.Primary" Rounded="true" CheckMark="true">
						<MudToggleItem Value="@("MEGFELELT")" Text="Megfelelt" />
						<MudToggleItem Value="@("NEM FELELT MEG")" Text="Nem felelt meg" />
					</MudToggleGroup>
				</MudItem>
				@if (!string.IsNullOrWhiteSpace(_adatok.HibakB) || !string.IsNullOrWhiteSpace(_adatok.HibakC))
				{
					<MudItem xs="12">
						<MudAlert Severity="Severity.Warning" Dense="true">
							B vagy C kategóriás hiba esetén a végső minősítés általában <strong>NEM FELELT MEG</strong>!
						</MudAlert>
					</MudItem>
				}
				<MudItem xs="12">
					<MudTextField @bind-Value="_adatok.MinositoMegjegyzes" Label="Minősítő megjegyzés (opcionális)"
								  Variant="Variant.Outlined" Lines="2"
								  Placeholder="pl. A hibák kijavítása után a berendezés üzembe helyezhető." />
				</MudItem>
			</MudGrid>
		</MudTabPanel>

		@* ===== 4. OLDAL ===== *@
		<MudTabPanel Text="4. oldal" Icon="@Icons.Material.Filled.ElectricBolt">
			<MudGrid>
				<MudItem xs="12">
					<MudText Typo="Typo.h6" Class="mb-4">
						<MudIcon Icon="@Icons.Material.Filled.ElectricBolt" Class="mr-2" />
						Villamos berendezés adatai (4. oldal)
					</MudText>
				</MudItem>

				<MudItem xs="12">
					<MudText Typo="Typo.subtitle1" Class="mb-2">I. Névleges feszültség</MudText>
					<MudRadioGroup T="string" @bind-Value="_adatok.NevlegesFeszultsegTipus" Class="d-flex flex-row gap-4">
						<MudRadio Value="@("1fazis")" Color="Color.Primary">230 V (1 fázis)</MudRadio>
						<MudRadio Value="@("3fazis")" Color="Color.Primary">3×230 V / 400 V (3 fázis)</MudRadio>
					</MudRadioGroup>
				</MudItem>

				<MudItem xs="12" Class="mt-3">
					<MudText Typo="Typo.subtitle1" Class="mb-2">II. Földelési típus</MudText>
					<MudRadioGroup T="string" @bind-Value="_adatok.FoldelesiTipusKod" Class="d-flex flex-column gap-1">
						<MudRadio Value="@("szonda")" Color="Color.Primary">A – Szonda (függőleges)</MudRadio>
						<MudRadio Value="@("vizszintes")" Color="Color.Primary">B – Vízszintes</MudRadio>
						<MudRadio Value="@("mindketto")" Color="Color.Primary">A + B – Mindkettő</MudRadio>
					</MudRadioGroup>
				</MudItem>

				<MudItem xs="12" Class="mt-3">
					<MudText Typo="Typo.subtitle1" Class="mb-2">III. Alapvető érintésvédelmi mód</MudText>
					<MudTextField @bind-Value="_adatok.ErintesvedelmiMod" Label="Érintésvédelmi mód"
								  Variant="Variant.Outlined" Placeholder="pl. TN-C-S" />
				</MudItem>

				<MudItem xs="12"><MudDivider Class="my-3" /></MudItem>

				<MudItem xs="12">
					<MudText Typo="Typo.subtitle1" Class="mb-2">Áramütés-elleni védelmi módok</MudText>
					<MudStack Spacing="1">
						<MudCheckBox @bind-Value="_adatok.Vedelem404" Color="Color.Primary" Dense="true">A táplálás önműködő lekapcsolása (TN-/TT-/IT-rendszer)</MudCheckBox>
						<MudCheckBox @bind-Value="_adatok.Vedelem405" Color="Color.Primary" Dense="true">Kettős vagy megerősített szigetelés</MudCheckBox>
