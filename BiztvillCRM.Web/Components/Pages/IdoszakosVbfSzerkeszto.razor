	private async Task KovetkezoOldalAsync()
	{
		await OnTabValtozasAsync(_aktívTab + 1);
	}

	private async Task SablonMentesNevvelAsync()
	{
		try
		{
			// Szerkesztésnél ha _sablonNev üres, ne engedje
			if (string.IsNullOrWhiteSpace(_sablonNev))
			{
				Snackbar.Add("A sablon neve nem lehet üres!", Severity.Warning);
				return;
			}

			if (_vbfMeresTipusId == 0)
			{
				Snackbar.Add("Nem sikerült azonosítani a mérés típust!", Severity.Error);
				return;
			}

			_feldolgozas = true;
			StateHasChanged();

			var cegId = TenantService.IsInRole(FelhasznaloSzerepkor.Admin)
				? (int?)null
				: TenantService.GetCurrentCegId();

			var json = System.Text.Json.JsonSerializer.Serialize(_adatok);

			var sablon = new VizsgalatiSablon
			{
				Id = SablonId ?? 0,
				MeresTipusId = _vbfMeresTipusId,
				CegId = cegId,
				Nev = _sablonNev,
				Leiras = _sablonLeiras,
				AdatokJson = json,
				Aktiv = true
			};

			await VizsgalatiSablonService.MentesAsync(sablon);
			Snackbar.Add($"Sablon mentve: {_sablonNev}", Severity.Success);
			_sablonNevDialogNyitva = false;
			Navigation.NavigateTo("/admin/jegyozokonyv-sablon");
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Hiba mentés közben: {ex.Message}", Severity.Error);
		}
		finally
		{
			_feldolgozas = false;
		}
	}

	private async Task OnTabValtozasAsync(int ujTab)
	{
		if (ujTab > 0 && _aktívTab == 0)
		{
			var vanKivalasztva = !string.IsNullOrEmpty(_adatok.KovetkezoFelulvizsgalatTipus)
								 || !string.IsNullOrEmpty(_adatok.HataridoTipus);
			if (!vanKivalasztva)
			{
				Snackbar.Add("Legalább egy időszakos felülvizsgálati kategóriát kötelező választani!", Severity.Warning);
				return;
			}
			if (_adatok.KovetkezoFelulvizsgalatTipus == "egyeb305" &&
				(_adatok.KovetkezoFelulvizsgalatEgyeb?.Trim().Length ?? 0) < 5)
			{
				Snackbar.Add("Az egyéb eset leírása kötelező (legalább 5 karakter)!", Severity.Warning);
				return;
			}
			if (_adatok.HataridoTipus == "309" &&
				(_adatok.HataridoEgyeb?.Trim().Length ?? 0) < 5)
			{
				Snackbar.Add("Az egyéb eset leírása kötelező (legalább 5 karakter)!", Severity.Warning);
				return;
			}
		}
		if (ujTab > 1 && _aktívTab <= 1)
		{
			var vanKivalasztva = _adatok.Vedelem404 || _adatok.Vedelem405 ||
								 _adatok.Vedelem406 || _adatok.Vedelem407 ||
								 _adatok.Vedelem408 || _adatok.Vedelem409;
			if (!vanKivalasztva)
			{
				Snackbar.Add("Legalább egy védelmi módot kötelező választani!", Severity.Warning);
				return;
			}
		}
		_aktívTab = ujTab;
		await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
	}

	private async Task MellekletekLetrehozasa()
	{
		var tetelek = new List<(bool aktiv, string tipus, string szam)>
		{
			(_adatok.MellekletHibavedelem, "HVM", _adatok.HibavedelmiJkv),
			(_adatok.MellekletAvk,         "AVK", _adatok.AvkJegyzokonyv),
			(_adatok.MellekletSzigeteles,  "SZI", _adatok.SzigetelesiJkv),
			(_adatok.MellekletVillam,      "VVN", _adatok.VillamJkv),
			(_adatok.MellekletVillamNem,   "VVN-NEM", _adatok.VillamNemJkv),
		};
		foreach (var (aktiv, tipus, szam) in tetelek.Where(t => t.aktiv))
			await MellekletService.LetrehozVagyFrissitAsync(MeresId ?? 0, tipus, szam);

	}
