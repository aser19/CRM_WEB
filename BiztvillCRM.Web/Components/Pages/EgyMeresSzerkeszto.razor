    private void Vissza() => Navigation.NavigateTo("/meresek");

    private bool ValidacioOk()
    {
        var hibak = new List<string>();

        // 1. Kitöltetlen mérési pontok
        foreach (var p in _adatok.MeresiPontok.Where(p => !p.TeljeskituoltE))
        {
            var hianyzok = string.Join(", ", p.HianyzoPontok());
            hibak.Add($"{p.Sorszam}. mérési pont – hiányzik: {hianyzok}");
        }

        // 2. ÁVK kipipálva de üres
        var avkKipipalt = _adatok.MeresiPontok.Where(p => p.AVKCsatolva).ToList();
        if (avkKipipalt.Any())
        {
            var avkSorok = _adatok.AvkSorok ?? [];
            if (!avkSorok.Any())
            {
                hibak.Add($"{avkKipipalt.Count} mérési pontnál ÁVK kipipálva, de az ÁVK táblázat üres!");
            }
            else
            {
                foreach (var (s, i) in avkSorok.Select((s, i) => (s, i)).Where(x => !x.s.TeljeskitoltottE))
                    hibak.Add($"ÁVK {i + 1}. sor hiányos – típus vagy mért IΔn hiányzik!");
            }
        }

        if (hibak.Any())
        {
            // Egyetlen snackbar az összes hibával
            var uzenet = string.Join("\n", hibak.Select(h => $"⚠️ {h}"));
            Snackbar.Add(uzenet, Severity.Error, o =>
            {
                o.VisibleStateDuration = 8000;
                o.ShowCloseIcon = true;
            });
            return false;
        }

        return true;
    }
