@page "/admin/hitelesites-csoportok"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Services.Interfaces
@inject IHitelesitesCsoportService HitelesitesCsoportService
@inject IEszkozTipusService EszkozTipusService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Hitelesítési csoportok</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Hitelesítési csoportok</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    Olyan eszköztípusoknál használd, ahol a főhitelesítéshez (pl. 15 éves tartály hitelesítés)
    közbenső vizsgálatok szükségesek (pl. 5 évente tömörségi, évente lyukadásjelző).
</MudAlert>

<MudPaper Class="pa-4">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_kereses" Label="Keresés" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                      Immediate="true" Style="max-width:350px;" />
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="UjMegnyitasa">Új csoport</MudButton>
    </MudStack>

    <MudDataGrid T="HitelesitesCsoport" Items="_szurtLista" Hover="true" Striped="true"
                 Loading="_betoltes" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="c => c.Nev" Title="Csoport neve" />
            <TemplateColumn Title="Főhitelesítés (eszköztípus)">
                <CellTemplate>
                    @if (context.Item.FoEszkozTipus is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Star">
                            @context.Item.FoEszkozTipus.Nev
                            (@context.Item.FoEszkozTipus.HitelesitesiIdotartamHonap hónap)
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">–</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Közbenső vizsgálatok">
                <CellTemplate>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var tag in context.Item.Tagok.OrderBy(t => t.Sorrend))
                        {
                            <MudTooltip Text="@tag.Megjegyzes">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(tag.Kotelezo ? Color.Warning : Color.Default)"
                                         Icon="@(tag.Kotelezo ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)">
                                    @tag.EszkozTipus?.Nev (@tag.EszkozTipus?.HitelesitesiIdotartamHonap hónap)
                                </MudChip>
                            </MudTooltip>
                        }
                        @if (!context.Item.Tagok.Any())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Nincs közbenső vizsgálat</MudText>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="c => c.Leiras" Title="Leírás" />
            <TemplateColumn Title="Műveletek" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => SzerkesztesMegnyitasa(context.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" Size="Size.Small"
                                       OnClick="() => TorlesMegerosites(context.Item)" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText>Nincs hitelesítési csoport felvéve.</MudText></NoRecordsContent>
    </MudDataGrid>
</MudPaper>

<!-- Szerkesztő dialógus -->
<MudDialog @bind-Visible="_dialogNyitva"
           Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
            @(_szerkesztesAlatt?.Id > 0 ? "Csoport szerkesztése" : "Új hitelesítési csoport")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_szerkesztesAlatt is not null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_szerkesztesAlatt.Nev"
                                  Label="Csoport neve *" Required="true"
                                  Placeholder="Pl. Tartály 15 éves hitelesítési ciklus" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_szerkesztesAlatt.Leiras"
                                  Label="Leírás" Lines="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int?" @bind-Value="_szerkesztesAlatt.FoEszkozTipusId"
                               Label="Főhitelesítés eszköztípusa *"
                               Clearable="true"
                               HelperText="A végső, hosszú időszakú hitelesítés típusa (pl. Tartály – 180 hónap)"
                               ToStringFunc="@(id => id.HasValue ? (_eszkozTipusok.FirstOrDefault(t => t.Id == id)?.Nev ?? "") : "")">
                        @foreach (var t in _eszkozTipusok)
                        {
                            <MudSelectItem Value="@((int?)t.Id)">
                                @t.Nev (@t.HitelesitesiIdotartamHonap hónap)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1">Közbenső vizsgálatok</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="UjTagHozzaadasa">
                            Hozzáadás
                        </MudButton>
                    </MudStack>
                </MudItem>

                @foreach (var tag in _szerkesztesAlatt.Tagok.OrderBy(t => t.Sorrend))
                {
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudGrid>
                                <MudItem xs="12" md="5">
                                    <MudSelect T="int" @bind-Value="tag.EszkozTipusId"
                                               Label="Eszköztípus (közbenső vizsgálat) *"
                                               ToStringFunc="@(id => _eszkozTipusok.FirstOrDefault(t => t.Id == id)?.Nev ?? "")">
                                        @foreach (var t in _eszkozTipusok)
                                        {
                                            <MudSelectItem Value="@t.Id">
                                                @t.Nev (@t.HitelesitesiIdotartamHonap hónap)
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="4" md="2">
                                    <MudNumericField T="int" @bind-Value="tag.Sorrend"
                                                     Label="Sorrend" Min="0" />
                                </MudItem>
                                <MudItem xs="4" md="2" Class="d-flex align-center">
                                    <MudCheckBox @bind-Value="tag.Kotelezo"
                                                 Label="Kötelező" Color="Color.Warning" />
                                </MudItem>
                                <MudItem xs="4" md="2">
                                    <MudTextField @bind-Value="tag.Megjegyzes" Label="Megjegyzés" />
                                </MudItem>
                                <MudItem xs="12" md="1" Class="d-flex align-center justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   OnClick="() => TagTorles(tag)" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                }

                @if (!_szerkesztesAlatt.Tagok.Any())
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Még nincs közbenső vizsgálat felvéve. Kattints a „Hozzáadás" gombra!
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogNyitva = false">Mégse</MudButton>
        <MudButton OnClick="MentesAsync" Color="Color.Primary"
                   Variant="Variant.Filled" Disabled="_mentes">
            @(_mentes ? "Mentés..." : "Mentés")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<HitelesitesCsoport> _lista = new();
    private List<EszkozTipus> _eszkozTipusok = new();
    private string _kereses = "";
    private bool _betoltes = true;
    private bool _dialogNyitva = false;
    private bool _mentes = false;
    private HitelesitesCsoport? _szerkesztesAlatt;

    private IEnumerable<HitelesitesCsoport> _szurtLista =>
        _lista.Where(c => string.IsNullOrWhiteSpace(_kereses) ||
            c.Nev.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ||
            (c.Leiras?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        _eszkozTipusok = await EszkozTipusService.GetAllAsync();
        await BetoltesAsync();
    }

    private async Task BetoltesAsync()
    {
        _betoltes = true;
        _lista = await HitelesitesCsoportService.GetAllAsync();
        _betoltes = false;
    }

    private void UjMegnyitasa()
    {
        _szerkesztesAlatt = new HitelesitesCsoport();
        _dialogNyitva = true;
    }

    private void SzerkesztesMegnyitasa(HitelesitesCsoport csoport)
    {
        _szerkesztesAlatt = new HitelesitesCsoport
        {
            Id = csoport.Id,
            Nev = csoport.Nev,
            Leiras = csoport.Leiras,
            FoEszkozTipusId = csoport.FoEszkozTipusId,
            Aktiv = csoport.Aktiv,
            Tagok = csoport.Tagok.Select(t => new HitelesitesCsoportTag
            {
                Id = t.Id,
                EszkozTipusId = t.EszkozTipusId,
                Kotelezo = t.Kotelezo,
                Sorrend = t.Sorrend,
                Megjegyzes = t.Megjegyzes
            }).ToList()
        };
        _dialogNyitva = true;
    }

    private void UjTagHozzaadasa()
    {
        if (_szerkesztesAlatt is null) return;
        var kovetkezoSorrend = _szerkesztesAlatt.Tagok.Count > 0
            ? _szerkesztesAlatt.Tagok.Max(t => t.Sorrend) + 1
            : 1;
        _szerkesztesAlatt.Tagok.Add(new HitelesitesCsoportTag
        {
            EszkozTipusId = _eszkozTipusok.FirstOrDefault()?.Id ?? 0,
            Kotelezo = true,
            Sorrend = kovetkezoSorrend
        });
    }

    private void TagTorles(HitelesitesCsoportTag tag)
        => _szerkesztesAlatt?.Tagok.Remove(tag);

    private async Task MentesAsync()
    {
        if (_szerkesztesAlatt is null) return;

        if (string.IsNullOrWhiteSpace(_szerkesztesAlatt.Nev))
        {
            Snackbar.Add("A csoport neve kötelező!", Severity.Warning);
            return;
        }
        if (_szerkesztesAlatt.Tagok.Any(t => t.EszkozTipusId == 0))
        {
            Snackbar.Add("Minden közbenső vizsgálatnál válassz eszköztípust!", Severity.Warning);
            return;
        }

        _mentes = true;
        try
        {
            if (_szerkesztesAlatt.Id == 0)
                await HitelesitesCsoportService.CreateAsync(_szerkesztesAlatt);
            else
                await HitelesitesCsoportService.UpdateAsync(_szerkesztesAlatt);

            Snackbar.Add("Sikeres mentés!", Severity.Success);
            _dialogNyitva = false;
            await BetoltesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
        }
        finally { _mentes = false; }
    }

    private async Task TorlesMegerosites(HitelesitesCsoport csoport)
    {
        var result = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törli a(z) \"{csoport.Nev}\" csoportot?",
            yesText: "Törlés", cancelText: "Mégse");

        if (result == true)
        {
            try
            {
                await HitelesitesCsoportService.DeleteAsync(csoport.Id);
                Snackbar.Add("Törölve.", Severity.Success);
                await BetoltesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Hiba: {ex.Message}", Severity.Error);
            }
        }
    }
}