@page "/admin/jegyozokonyv-sablon"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,CegAdmin")]
@using BiztvillCRM.Services.Interfaces
@using BiztvillCRM.Shared.Models
@using BiztvillCRM.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@inject IVizsgalatiSablonService VizsgalatiSablonService
@inject IMeresTipusService MeresTipusService
@inject ITenantService TenantService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Jegyzőkönyv sablonok - Biztovill CRM</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Jegyzőkönyv sablonok</MudText>
    <MudSpacer />
    @if (_aktivMeresTipus is not null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo($"/idoszakos-vbf/sablon"))">
            Új sablon — @_aktivMeresTipus.Nev
        </MudButton>
    }
</MudStack>

@if (_betoltes)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true"
             ActivePanelIndexChanged="TabValtas" PanelClass="pa-0">
        @foreach (var mt in _meresTipusok.Where(m => string.IsNullOrEmpty(m.MellekletTipusKod)))
        {
            var sablonok = _sablonok.Where(s => s.MeresTipusId == mt.Id).ToList();
            <MudTabPanel Text="@mt.Nev" BadgeData="@(sablonok.Any() ? sablonok.Count.ToString() : null)"
                         BadgeColor="Color.Primary">

                <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3 pb-0">
                    <MudText Typo="Typo.subtitle1">
                        <strong>@mt.Nev</strong>
                        <MudText Typo="Typo.caption" Class="ml-2" Color="Color.Secondary">
                            (@sablonok.Count sablon)
                        </MudText>
                    </MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => Navigation.NavigateTo("/idoszakos-vbf/sablon"))">
                        Új sablon
                    </MudButton>
                </MudStack>

                <MudPaper Elevation="0" Class="pa-3 mb-2">
                    @if (!sablonok.Any())
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            Még nincs mentett sablon ehhez a mérés típushoz.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Style="background:transparent">
                            <thead>
                                <tr>
                                    <th style="width:30px"></th>
                                    <th>Név</th>
                                    <th>Leírás</th>
                                    <th style="width:80px">Típus</th>
                                    <th style="width:100px">Mentve</th>
                                    <th style="width:50px">Aktív</th>
                                    <th style="width:80px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in sablonok.OrderBy(s => s.Nev))
                                {
                                    <tr>
                                        <td>
                                            @if (s.AdminSablon)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Lock"
                                                         Color="Color.Info" Size="Size.Small" Title="Admin sablon" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Business"
                                                         Color="Color.Success" Size="Size.Small" Title="Céges sablon" />
                                            }
                                        </td>
                                        <td><strong>@s.Nev</strong></td>
                                        <td>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@s.Leiras</MudText>
                                        </td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(s.AdminSablon ? Color.Info : Color.Success)"
                                                     Variant="Variant.Outlined">
                                                @(s.AdminSablon ? "Admin" : "Saját")
                                            </MudChip>
                                        </td>
                                        <td>
                                            <MudText Typo="Typo.caption">
                                                @((s.Modositva ?? s.Letrehozva).ToString("yyyy.MM.dd"))
                                            </MudText>
                                        </td>
                                        <td>
                                            <MudIcon Icon="@(s.Aktiv ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                     Color="@(s.Aktiv ? Color.Success : Color.Error)"
                                                     Size="Size.Small" />
                                        </td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary" Size="Size.Small"
                                                           OnClick="@(() => Navigation.NavigateTo($"/idoszakos-vbf/sablon/{s.Id}"))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error" Size="Size.Small"
                                                           OnClick="@(() => SablonTorles(s))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>

            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private List<MeresTipus> _meresTipusok = [];
    private List<VizsgalatiSablon> _sablonok = [];
    private bool _betoltes = true;
    private bool _isAdmin;
    private int? _aktualisCegId;
    private MeresTipus? _aktivMeresTipus;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = TenantService.IsInRole(FelhasznaloSzerepkor.Admin);
        _aktualisCegId = TenantService.GetCurrentCegId();
        _meresTipusok = await MeresTipusService.GetAllAsync();
        _aktivMeresTipus = _meresTipusok.FirstOrDefault();
        await LoadSablonok();
    }

    private void TabValtas(int index)
    {
        _aktivMeresTipus = _meresTipusok.ElementAtOrDefault(index);
    }

    private async Task LoadSablonok()
    {
        _betoltes = true;
        _sablonok = [];
        foreach (var mt in _meresTipusok)
        {
            var lista = await VizsgalatiSablonService.GetAllAsync(mt.Id, _isAdmin ? null : _aktualisCegId);
            _sablonok.AddRange(lista);
        }
        _betoltes = false;
    }

    private async Task SablonTorles(VizsgalatiSablon sablon)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Törlés megerősítése",
            $"Biztosan törlöd a(z) \"{sablon.Nev}\" sablont?",
            yesText: "Igen, törlöm", cancelText: "Mégse");
        if (confirm == true)
        {
            await VizsgalatiSablonService.TorlesAsync(sablon.Id);
            Snackbar.Add("Sablon törölve.", Severity.Info);
            await LoadSablonok();
        }
    }
}