@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject BiztvillCRM.Services.Interfaces.ITenantService TenantService

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="1" Color="Color.Primary">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-3">Biztovill CRM</MudText>
                <MudSpacer />
                
                <!-- Felhasználó információ -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Class="d-none d-sm-block">@_felhasznaloNev</MudText>
                    @if (_isAdmin)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ml-1">Admin</MudChip>
                    }
                </MudStack>
                
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" Style="height: 24px; align-self: center;" />
                
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="@ToggleDarkMode" Title="Téma váltás" />
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" 
                               OnClick="Kijelentkezes" Title="Kijelentkezés" />
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Mini">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private string _felhasznaloNev = "";
    private bool _isAdmin = false;

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1565C0",
            Secondary = "#FF6F00",
            AppbarBackground = "#1565C0",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
            DrawerBackground = "#FAFAFA",
            DrawerText = "#424242",
            Success = "#2E7D32",
            Warning = "#F57F17",
            Error = "#C62828",
            Info = "#0277BD"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#42A5F5",
            Secondary = "#FFB74D",
            AppbarBackground = "#1E1E1E",
            Background = "#121212",
            Surface = "#1E1E1E",
            DrawerBackground = "#1E1E1E",
            DrawerText = "#E0E0E0"
        }
    };

    protected override void OnInitialized()
    {
        _felhasznaloNev = TenantService.GetCurrentUserName();
        _isAdmin = TenantService.IsInRole(BiztvillCRM.Shared.Enums.FelhasznaloSzerepkor.Admin);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
    
    private void Kijelentkezes()
    {
        Navigation.NavigateTo("/kijelentkezes", forceLoad: true);
    }
}