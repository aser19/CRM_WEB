@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@MenuValtas" />
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="@Vissza" title="Vissza" />
        <MudText Typo="Typo.h6" Class="ml-2">BiztvillCRM.Mobile</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Inherit" Href="about" title="Névjegy" />
    </MudAppBar>
    <MudDrawer @bind-Open="_menuNyitva" Elevation="2" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuNyitva = true;

    private void MenuValtas() => _menuNyitva = !_menuNyitva;

    private async Task Vissza()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
