@page "/hatosagok"
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@using BiztvillCRM.Shared.Dtos.Mobile

<MudText Typo="Typo.h5" Class="mb-2">Hatóságok</MudText>
<MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mb-3"
           OnClick="BetoltesAsync" Disabled="@_betoltesFolyamatban" StartIcon="@Icons.Material.Filled.Refresh">
    @(_betoltesFolyamatban ? "Betöltés..." : "Frissítés a szerverről")
</MudButton>

<MudTextField @bind-Value="_kereses" Immediate="true" Placeholder="Keresés (név)" Class="mb-3" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

@if (_lista is null)
{
    <MudText>Betöltés...</MudText>
}
else if (_hiba is not null)
{
    <MudText Color="Color.Error">@_hiba</MudText>
}
else if (_szurtLista.Count == 0)
{
    <MudText>Nincs megjeleníthető hatóság.</MudText>
}
else
{
    <MudList T="string" Clickable="true">
        @foreach (var h in _szurtLista)
        {
            <MudListItem OnClick="@(() => Megtekintes(h.Id))">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1"><b>@h.Nev</b></MudText>
                    <MudText Typo="Typo.body2">Rövidítés: @h.Rovidites</MudText>
                </div>
            </MudListItem>
            <MudDivider />
        }
    </MudList>
}

@code {
    private List<HatosagListItemDto>? _lista;
    private bool _betoltesFolyamatban;
    private string _kereses = string.Empty;
    private string? _hiba;

    private List<HatosagListItemDto> _szurtLista => string.IsNullOrWhiteSpace(_kereses) || _lista is null
        ? _lista ?? new()
        : _lista.Where(h => h.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false).ToList();

    protected override async Task OnInitializedAsync()
    {
        await BetoltesAsync();
    }

    private async Task BetoltesAsync()
    {
        _betoltesFolyamatban = true;
        _hiba = null;
        try
        {
            _lista = await ApiClient.GetHatosagokAsync();
        }
        catch
        {
            _hiba = "Nincs hálózati kapcsolat, az adatok nem elérhetők.";
            _lista ??= new();
        }
        finally
        {
            _betoltesFolyamatban = false;
        }
    }

    private void Megtekintes(int id) => NavigationManager.NavigateTo($"/hatosagok/{id}");
}
