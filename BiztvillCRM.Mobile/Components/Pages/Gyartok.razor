@page "/gyartok"
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@using BiztvillCRM.Shared.Dtos.Mobile

<MudText Typo="Typo.h5" Class="mb-2">Gyártók</MudText>
<MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mb-3"
           OnClick="BetoltesAsync" Disabled="@_betoltesFolyamatban" StartIcon="@Icons.Material.Filled.Refresh">
    @(_betoltesFolyamatban ? "Betöltés..." : "Frissítés a szerverről")
</MudButton>

<MudTextField @bind-Value="_kereses" Immediate="true" Placeholder="Keresés (név, ország)" Class="mb-3" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

@if (_lista is null)
{
    <MudText>Betöltés...</MudText>
}
else if (_hiba is not null)
{
    <MudText Color="Color.Error">@_hiba</MudText>
}
else if (_szurtLista.Count == 0)
{
    <MudText>Nincs megjeleníthető gyártó.</MudText>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var csoport in _csoportositva!)
        {
            <MudExpansionPanel Text="@($"{csoport.Key} ({csoport.Count()})")">
                <MudList T="string" Clickable="true">
                    @foreach (var g in csoport)
                    {
                        <MudListItem OnClick="@(() => Megtekintes(g.Id))">
                            <MudText Typo="Typo.body1"><b>@g.Nev</b></MudText>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private List<GyartoListItemDto>? _lista;
    private bool _betoltesFolyamatban;
    private string _kereses = string.Empty;
    private string? _hiba;

    private List<GyartoListItemDto> _szurtLista => string.IsNullOrWhiteSpace(_kereses) || _lista is null
        ? _lista ?? new()
        : _lista.Where(g => (g.Nev?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false) ||
                             (g.Orszag?.Contains(_kereses, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private IEnumerable<IGrouping<string, GyartoListItemDto>>? _csoportositva =>
        _szurtLista
            .GroupBy(g => string.IsNullOrWhiteSpace(g.Orszag) ? "Ismeretlen ország" : g.Orszag!)
            .OrderBy(g => g.Key);

    protected override async Task OnInitializedAsync()
    {
        await BetoltesAsync();
    }

    private async Task BetoltesAsync()
    {
        _betoltesFolyamatban = true;
        _hiba = null;
        try
        {
            _lista = await ApiClient.GetGyartokAsync();
        }
        catch
        {
            _hiba = "Nincs hálózati kapcsolat, az adatok nem elérhetők.";
            _lista ??= new();
        }
        finally
        {
            _betoltesFolyamatban = false;
        }
    }

    private void Megtekintes(int id) => NavigationManager.NavigateTo($"/gyartok/{id}");
}
