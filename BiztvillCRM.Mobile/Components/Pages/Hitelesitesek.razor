@page "/hitelesitesek"
@inject OfflineCacheService OfflineCacheService
@inject NavigationManager NavigationManager
@using BiztvillCRM.Mobile.Data

<MudText Typo="Typo.h5" Class="mb-2">Hitelesítések</MudText>
<MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mb-3"
           OnClick="FrissitesAsync" Disabled="@_frissitesFolyamatban" StartIcon="@Icons.Material.Filled.Refresh">
    @(_frissitesFolyamatban ? "Frissítés..." : "Frissítés a szerverről")
</MudButton>

@if (_lista is null)
{
    <MudText>Betöltés...</MudText>
}
else if (_lista.Count == 0)
{
    <MudText>Nincs megjeleníthető hitelesítés.</MudText>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var csoport in _csoportositva!)
        {
            <MudExpansionPanel Text="@($"{csoport.Key} ({csoport.Count()})")">
                <MudList T="string" Clickable="true">
                    @foreach (var h in csoport)
                    {
                        <MudListItem OnClick="@(() => Megtekintes(h.Id))">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body1"><b>@h.EszkozTipusNev</b> - @h.Datum.ToString("yyyy.MM.dd")</MudText>
                                <MudText Typo="Typo.body2">Lejárat: @(h.LejaratDatum?.ToString("yyyy.MM.dd") ?? "-")</MudText>
                                <MudText Typo="Typo.body2">Státusz: @h.HitelesitesStatusz</MudText>
                            </div>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private List<CachedHitelesites>? _lista;
    private IEnumerable<IGrouping<string, CachedHitelesites>>? _csoportositva;
    private bool _frissitesFolyamatban;

    protected override async Task OnInitializedAsync()
    {
        _lista = await OfflineCacheService.GetHitelesitesekCacheAsync();
        Csoportosit();
    }

    private void Csoportosit()
    {
        _csoportositva = _lista?
            .GroupBy(h => string.IsNullOrWhiteSpace(h.UgyfelNev) ? "Ismeretlen ügyfél" : h.UgyfelNev!)
            .OrderBy(g => g.Key);
    }

    private async Task FrissitesAsync()
    {
        _frissitesFolyamatban = true;
        try
        {
            await OfflineCacheService.SzinkronizalAsync();
            _lista = await OfflineCacheService.GetHitelesitesekCacheAsync();
            Csoportosit();
        }
        catch
        {
            // nincs hálózat - az offline cache (korábban letöltött adatok) marad érvényben
        }
        finally
        {
            _frissitesFolyamatban = false;
        }
    }

    private void Megtekintes(int id) => NavigationManager.NavigateTo($"/hitelesitesek/{id}");
}
